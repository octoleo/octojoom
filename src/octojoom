function cliOptionNames() {
  # Extract only option labels from this small case, never environment values.
  declare -f cliOptionVariable | sed -nE 's/^[[:space:]]*((--[a-z][a-z-]*|-[a-z])([[:space:]]*\|[[:space:]]*(--[a-z][a-z-]*|-[a-z]))*)\).*/\1/p' | tr '|' '\n' | tr -d ' ' | grep '^--'
  printf '%s\n' --help --yes --sudo --non-interactive --input-json --quiet --verbose --no-progress --all --short --follow --move-files --update --uninstall
}

function cliHasValue() {
  local key requested="$1"
  case "$requested" in
    VDM_SITES) requested=VDM_CONTAINER;; VDM_FILE) requested=VDM_INPUT_FILE;;
    VDM_QUIET) requested=OCTOJOOM_QUIET;; VDM_VERBOSE) requested=OCTOJOOM_VERBOSE;;
  esac
  for key in "${OCTOJOOM_CLI_KEYS[@]}"; do [ "$key" != "$requested" ] || return 0; done
  return 1
}

function cliApplyValues() {
  local index variable value
  for index in "${!OCTOJOOM_CLI_KEYS[@]}"; do
    variable="${OCTOJOOM_CLI_KEYS[index]}" value="${OCTOJOOM_CLI_VALUES[index]}"
    case "$variable" in
      VDM_TABLES) continue;;
      VDM_PROGRESS)
        [ "$value" != true ] || OCTOJOOM_NO_PROGRESS=false
        [ "$value" != false ] || OCTOJOOM_NO_PROGRESS=true;;
      OCTOJOOM_NO_PROGRESS)
        [ "$value" != true ] || VDM_PROGRESS=false
        [ "$value" != false ] || VDM_PROGRESS=true;;
    esac
    printf -v "$variable" '%s' "$value"
  done
  if cliHasValue VDM_CONTAINER; then
    if [ "${#OCTOJOOM_CLI_SITES[@]}" -gt 0 ]; then VDM_SITES=("${OCTOJOOM_CLI_SITES[@]}"); VDM_CONTAINER="${VDM_SITES[0]}"
    else VDM_SITES=("$VDM_CONTAINER"); fi
  fi
  if cliHasValue VDM_TABLES; then VDM_TABLES=("${OCTOJOOM_CLI_TABLES[@]}"); fi
  if cliHasValue VDM_INPUT_FILE; then VDM_FILE="$VDM_INPUT_FILE"; fi
  if cliHasValue OCTOJOOM_QUIET; then VDM_QUIET="$OCTOJOOM_QUIET"; fi
  if cliHasValue OCTOJOOM_VERBOSE; then VDM_VERBOSE="$OCTOJOOM_VERBOSE"; fi
}

function cliRememberValue() {
  local variable="$1" value="$2"
  if [ "$variable" = VDM_DB_ENGINE ] && [ "$value" = postgresql ]; then value=postgres; fi
  case "$variable" in
    VDM_CONTAINER) OCTOJOOM_CLI_SITES+=("$value"); printf -v "$variable" '%s' "$value";;
    VDM_TABLES) OCTOJOOM_CLI_TABLES+=("$value");;
    *) printf -v "$variable" '%s' "$value";;
  esac
  OCTOJOOM_CLI_KEYS+=("$variable")
  OCTOJOOM_CLI_VALUES+=("$value")
}

function cliBoolean() {
  case "$1" in true|yes|1) printf true;; false|no|0) printf false;; *) return 17;; esac
}

function cliReadJSON() {
  local input="$1" json option value variable
  command -v jq >/dev/null 2>&1 || { echo >&2 'ERROR: JSON transport requires jq. Install jq or use ordinary command options.'; return 17; }
  if [ "$input" = - ]; then json=$(cat); else json=$(cat -- "$input") || return 17; fi
  if ! printf '%s' "$json" | jq -e '
    def text: type == "string" and (contains("\u0000") | not);
    def selection: text or (type == "array" and length > 0 and all(.[]; text and length > 0));
    type == "object" and (keys - ["type","task","container","action","options","args"] | length == 0)
    and ((.options // {}) | type == "object")
    and ((.args // []) | type == "array" and all(.[]; text))
    and ([.type,.task,.action] | all(.[]; . == null or text))
    and (.container == null or (.container | selection))
    and ((.options // {}) | to_entries | all(.[];
      if .key == "container" or .key == "table" then (.value | selection)
      else (.value | type == "string" or type == "boolean" or type == "number")
        and (.value | tostring | contains("\u0000") | not) end))' >/dev/null; then
    echo >&2 'ERROR: Invalid JSON request; use type, task, container, action, options and a string args array. Only container and table selections accept nonempty string arrays.'
    return 17
  fi
  # Structured requests default to headless unless the request explicitly opts
  # into interactive collection; direct command flags still have final priority.
  cliRememberValue OCTOJOOM_NON_INTERACTIVE true
  while IFS= read -r -d '' option && IFS= read -r -d '' value; do
    case "$option" in
      yes) variable=VDM_FORCE;; sudo) variable=VDM_SUDO_ACCESS;;
      non-interactive) variable=OCTOJOOM_NON_INTERACTIVE;;
      quiet) variable=OCTOJOOM_QUIET;; verbose) variable=OCTOJOOM_VERBOSE;;
      no-progress) variable=OCTOJOOM_NO_PROGRESS;; all) variable=VDM_ALL;;
      short) variable=VDM_SHORT;; follow) variable=VDM_FOLLOW;; move-files) variable=VDM_MOVE_FILES;;
      *) variable=$(cliOptionVariable "--$option") || { echo >&2 "ERROR: Unknown JSON option: $option"; return 17; };;
    esac
    case "$variable" in
      VDM_CONTAINER|VDM_TABLES) [ -n "$value" ] || { echo >&2 'ERROR: Site and table selections cannot be empty.'; return 17; };;
    esac
    cliRememberValue "$variable" "$value"
    [ "$variable" != VDM_DOMAIN ] || cliRememberValue VDM_ARG_DOMAIN true
  done < <(printf '%s' "$json" | jq -j '(.options // {}) + ({type,task,container,action} | with_entries(select(.value != null))) | to_entries[] | .key as $key | (if (.value | type) == "array" then .value[] else .value end) | $key,"\u0000",tostring,"\u0000"')
  OCTOJOOM_ARGS=()
  while IFS= read -r -d '' value; do OCTOJOOM_ARGS+=("$value"); done < <(printf '%s' "$json" | jq -j '.args // [] | .[] | ., "\u0000"')
}

# Parse JSON first; direct flags always win, regardless of their position.
function parseCLI() {
  local option variable value json_file='' index direct_sites=false direct_tables=false
  local -a original=("$@")
  OCTOJOOM_CLI_ACTION=''
  OCTOJOOM_CLI_KEYS=()
  OCTOJOOM_CLI_VALUES=()
  OCTOJOOM_CLI_SITES=() OCTOJOOM_CLI_TABLES=()
  VDM_SITES=() VDM_TABLES=()
  OCTOJOOM_ARGS=()
  OCTOJOOM_OUTPUT=text
  OCTOJOOM_NON_INTERACTIVE=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --) break;;
      --output=*) OCTOJOOM_OUTPUT="${1#*=}";;
      --output) [ "$#" -lt 2 ] || OCTOJOOM_OUTPUT="$2";;
      --input-json=*) [ -z "$json_file" ] || return 17; json_file="${1#*=}";;
      --input-json) [ -z "$json_file" ] && [ "$#" -ge 2 ] || return 17; json_file="$2"; shift;;
    esac
    shift
  done
  for option in "${original[@]}"; do
    [ "$option" != --input-json= ] || { echo >&2 'ERROR: --input-json requires a file or -.'; return 17; }
  done
  [ -z "$json_file" ] || cliReadJSON "$json_file" || return $?
  set -- "${original[@]}"
  while [ "$#" -gt 0 ]; do
    option="${1%%=*}"
    variable=''
    case "$1" in
      -h|--help) OCTOJOOM_CLI_ACTION=help; shift; continue;;
      --input-json=*) shift; continue;; --input-json) shift 2; continue;;
      --update|--uninstall)
        [ -z "$OCTOJOOM_CLI_ACTION" ] || { echo >&2 'ERROR: Only one action may be requested.'; return 17; }
        OCTOJOOM_CLI_ACTION="${1#--}"; shift; continue;;
      -y|--yes) cliRememberValue VDM_FORCE true; shift; continue;;
      --sudo) cliRememberValue VDM_SUDO_ACCESS true; shift; continue;;
      --non-interactive) cliRememberValue OCTOJOOM_NON_INTERACTIVE true; shift; continue;;
      --quiet|--verbose)
        variable=$(cliOptionVariable "$1")
        value=true
        if [ "$#" -gt 1 ]; then
          case "$2" in true|false|yes|no|1|0) value="$2"; shift;; esac
        fi
        cliRememberValue "$variable" "$value"; shift; continue;;
      --no-progress) cliRememberValue OCTOJOOM_NO_PROGRESS true; shift; continue;;
      --all) cliRememberValue VDM_ALL true; shift; continue;;
      --short) cliRememberValue VDM_SHORT true; shift; continue;;
      --follow) cliRememberValue VDM_FOLLOW true; shift; continue;;
      --move-files) cliRememberValue VDM_MOVE_FILES true; shift; continue;;
      --) shift; OCTOJOOM_ARGS=("$@"); break;;
    esac
    variable=$(cliOptionVariable "$option") || { echo >&2 "ERROR: Unknown option or argument: $1"; return 17; }
    if [[ "$1" == *=* ]]; then value="${1#*=}"
    elif [ "$#" -ge 2 ] && [[ "$2" != --* ]] && { [[ "$2" != -* ]] || [ "$2" = - ]; }; then value="$2"; shift
    else echo >&2 "ERROR: ${option} requires a non-empty option argument."; return 17; fi
    case "$variable" in
      VDM_J_EXTENSIONS_URLS|VDM_J_CLI_COMMANDS|VDM_error_reporting|VDM_LABEL) ;;
      *) [ -n "$value" ] || { echo >&2 "ERROR: ${option} requires a non-empty option argument."; return 17; };;
    esac
    case "$variable" in
      VDM_CONTAINER) if ! "$direct_sites"; then OCTOJOOM_CLI_SITES=(); direct_sites=true; fi;;
      VDM_TABLES) if ! "$direct_tables"; then OCTOJOOM_CLI_TABLES=(); direct_tables=true; fi;;
    esac
    cliRememberValue "$variable" "$value"
    [ "$variable" != VDM_DOMAIN ] || cliRememberValue VDM_ARG_DOMAIN true
    shift
  done
  for index in "${!OCTOJOOM_CLI_KEYS[@]}"; do
    variable="${OCTOJOOM_CLI_KEYS[index]}"
    case "$variable" in
      VDM_FORCE|VDM_SUDO_ACCESS|OCTOJOOM_NON_INTERACTIVE|OCTOJOOM_QUIET|OCTOJOOM_VERBOSE|OCTOJOOM_NO_PROGRESS|VDM_ALL|VDM_SHORT|VDM_FOLLOW|VDM_MOVE_FILES|VDM_AUTO_INSTALL|VDM_ENABLE|VDM_CUSTOMIZE|VDM_PERSISTENCE|VDM_DB_PERSISTENCE|VDM_MAILCATCHER|VDM_PHPMYADMIN|VDM_SAVE_DEFAULTS|VDM_PHP_SETTINGS|VDM_SECURE|VDM_SECURE_CLOUDFLARE|VDM_FREE_PORTS|VDM_UPDATE_HOST|VDM_REMOVE_DEPLOYMENTS|VDM_REMOVE_CONFIG|VDM_REMOVE_DATA|VDM_TIMESTAMP|VDM_OVERWRITE|VDM_DELETE_SOURCE|VDM_PROGRESS|VDM_PRE_BACKUP|VDM_CONFIRM)
        value=$(cliBoolean "${OCTOJOOM_CLI_VALUES[index]}") || { echo >&2 "ERROR: $variable requires true or false."; return 17; }
        OCTOJOOM_CLI_VALUES[index]="$value";;
    esac
  done
  cliApplyValues
  cliValidateDataOptions || return $?
  case "$OCTOJOOM_OUTPUT" in text|json) ;; *) echo >&2 'ERROR: --output must be text or json.'; return 17;; esac
  if [ "$OCTOJOOM_OUTPUT" = json ]; then
    if [ "${VDM_TASK:-}" = shell ] || { [ "${VDM_TASK:-}" = database ] && [ "${VDM_ACTION:-}" = console ]; } || { [ "${VDM_TASK:-}" = logs ] && [ "${VDM_FOLLOW:-false}" = true ]; }; then echo >&2 'ERROR: Terminal and streaming commands require --output text.'; return 17; fi
    command -v jq >/dev/null 2>&1 || { echo >&2 'ERROR: JSON output requires jq.'; return 17; }
  fi
  cliRememberValue VDM_FORCE "${VDM_FORCE:-false}"
  cliRememberValue VDM_ARG_DOMAIN "${VDM_ARG_DOMAIN:-false}"
  return 0
}

# Validate request syntax without inspecting a database, creating a directory,
# or resolving saved operation defaults. Destructive choices are checked again
# by their shared action handlers before touching data.
function cliValidateDataOptions() {
  local variable value
  for variable in VDM_DB_ENGINE VDM_DATA_MODE VDM_COMPRESSION VDM_FORMAT VDM_SCOPE VDM_RETENTION VDM_TARGET VDM_IMPORT_MODE; do
    cliHasValue "$variable" || continue
    value="${!variable}"
    case "$variable:$value" in
      VDM_DB_ENGINE:mariadb|VDM_DB_ENGINE:mysql|VDM_DB_ENGINE:postgres|VDM_DATA_MODE:preserve|VDM_DATA_MODE:clone|VDM_DATA_MODE:fresh|VDM_COMPRESSION:none|VDM_COMPRESSION:gzip|VDM_COMPRESSION:custom|VDM_FORMAT:tar.gz|VDM_FORMAT:zip|VDM_SCOPE:full|VDM_SCOPE:website|VDM_SCOPE:database|VDM_SCOPE:files|VDM_TARGET:new|VDM_TARGET:current|VDM_IMPORT_MODE:fresh|VDM_IMPORT_MODE:replace|VDM_IMPORT_MODE:merge) ;;
      VDM_RETENTION:*) [[ "$value" =~ ^[0-9]+$ ]] || { echo >&2 'ERROR: --retention requires a nonnegative count.'; return 17; };;
      *) printf 'ERROR: Invalid choice for %s; see --help.\n' "$variable" >&2; return 17;;
    esac
  done
  if [ "${OCTOJOOM_QUIET:-false}" = true ] && [ "${OCTOJOOM_VERBOSE:-false}" = true ]; then
    echo >&2 'ERROR: Choose --quiet or --verbose, not both.'; return 17
  fi
  if [ "${#VDM_SITES[@]}" -gt 1 ]; then
    case "${VDM_CONTAINER_TYPE:-joomla}/${VDM_TASK:-}/${VDM_ACTION:-}" in
      joomla/database/export|joomla/backup/create) ;;
      *) echo >&2 'ERROR: Repeated --container is supported by database export and backup create.'; return 17;;
    esac
  fi
  case "${VDM_CONTAINER_TYPE:-joomla}/${VDM_TASK:-}" in
    joomla/database|joomla/backup)
      if [ "${VDM_ALL:-false}" = true ] && [ "${#VDM_SITES[@]}" -gt 0 ]; then
        echo >&2 'ERROR: Choose --all or explicit --container selections.'; return 17
      fi
      if [ "${VDM_ALL:-false}" = true ]; then
        case "${VDM_TASK}/${VDM_ACTION:-}" in database/export|backup/create) ;;
          *) echo >&2 'ERROR: --all is supported by database export and backup create.'; return 17;; esac
      fi
      if { [ "${#VDM_SITES[@]}" -gt 1 ] || [ "${VDM_ALL:-false}" = true ]; } && cliHasValue VDM_INPUT_FILE; then
        echo >&2 'ERROR: Batch operations need --destination, not a shared --file.'; return 17
      fi;;
  esac
  return 0
}

function cliDataPreflight() {
  local site action="${VDM_ACTION:-}"
  cliValidateDataOptions || return $?
  for site in "${VDM_SITES[@]}"; do
    isValidDomain "$site" || { echo >&2 'ERROR: Each --container must name a valid site hostname.'; return 17; }
  done
  case "${VDM_TASK}:$action" in
    database:export|database:tables|database:import|database:execute|database:change|database:console|backup:create|backup:list|backup:delete|backup:cleanup)
      if [ "${VDM_ALL:-false}" != true ] && ! isValidDomain "${VDM_CONTAINER:-}"; then
        echo >&2 'ERROR: This operation requires --container.'; return 17
      fi;;
    backup:verify|backup:restore) ;;
    *) echo >&2 'ERROR: Supply a supported database or backup --action; see --help.'; return 17;;
  esac
  case "${VDM_TASK}:$action" in
    database:console) echo >&2 'ERROR: The SQL console requires an interactive terminal. Use --action execute --file for automation.'; return 17;;
    database:change)
      if ! cliHasValue VDM_DB_ENGINE || ! cliHasValue VDM_DB_IMAGE || ! cliHasValue VDM_DATA_MODE ||
        ! cliHasValue VDM_CONFIRM || [ "${VDM_CONFIRM:-false}" != true ]; then
        echo >&2 'ERROR: Database change requires explicit --engine, --database-image, --data-mode and --confirm yes.'; return 17
      fi;;
    database:import)
      cliHasValue VDM_IMPORT_MODE || { echo >&2 'ERROR: Database import requires explicit --import-mode fresh, replace or merge.'; return 17; }
      case "${VDM_IMPORT_MODE:-}" in fresh|replace|merge) ;; *) echo >&2 'ERROR: Database import requires --import-mode fresh, replace or merge.'; return 17;; esac;;
    backup:delete|backup:cleanup)
      if ! cliHasValue VDM_CONFIRM || [ "${VDM_CONFIRM:-false}" != true ]; then
        echo >&2 'ERROR: Backup deletion and cleanup require explicit --confirm yes.'; return 17
      fi;;
    backup:restore)
      cliHasValue VDM_TARGET || { echo >&2 'ERROR: Restore requires explicit --target new or current.'; return 17; }
      case "${VDM_TARGET:-}" in
        new) ;;
        current)
          isValidDomain "${VDM_CONTAINER:-}" || { echo >&2 'ERROR: Restore to current requires --container.'; return 17; }
          if ! cliHasValue VDM_PRE_BACKUP || ! cliHasValue VDM_CONFIRM ||
            [ "${VDM_PRE_BACKUP:-false}" != true ] || [ "${VDM_CONFIRM:-false}" != true ]; then
            echo >&2 'ERROR: Restore to current requires explicit --pre-backup yes and --confirm yes.'; return 17
          fi;;
        *) echo >&2 'ERROR: Restore requires --target new or current.'; return 17;;
      esac;;
  esac
  case "${VDM_TASK}:$action" in
    database:import|database:execute|backup:verify|backup:restore|backup:delete)
      [ -n "${VDM_INPUT_FILE:-${VDM_FILE:-}}" ] || { echo >&2 'ERROR: This operation requires --file.'; return 17; };;
  esac
  return 0
}

# The public task names are discovered from the executable's existing dispatch
# convention. Listing them never calls a handler, Docker, or a remote registry.
function cliTaskNames() {
  local name
  while read -r _ _ name; do
    [[ "$name" == "${1:-joomla}__TRuST__"* ]] && printf '%s\n' "${name#*__TRuST__}"
  done < <(declare -F)
  return 0
}

function cliComplete() {
  local previous="${1:-}" current="${2:-}" type="${3:-joomla}" task="${4:-}" path item
  case "$type" in joomla|openssh|traefik|portainer|settings|domains|directory) ;; *) return 0;; esac
  case "$previous" in
    --type) printf '%s\n' joomla openssh traefik portainer settings domains directory;;
    --task) cliTaskNames "$type";;
    --container)
      for path in "${VDM_REPO_PATH}/${type}/available/"*/docker-compose.yml; do
        [ -f "$path" ] || continue; item="${path%/*}"; printf '%s\n' "${item##*/}"
      done;;
    --action)
      case "$type/$task" in
        joomla/database) printf '%s\n' change export import tables console execute;;
        joomla/backup) printf '%s\n' create list verify restore delete cleanup;;
        *) printf '%s\n' show list inspect apply set switch settings path read replace script complete change export import tables console execute create verify restore delete cleanup;;
      esac;;
    --engine|--db-engine) printf '%s\n' mariadb mysql postgres;;
    --data-mode) printf '%s\n' preserve clone fresh;;
    --compression) printf '%s\n' none gzip custom;;
    --format) printf '%s\n' tar.gz zip;; --scope) printf '%s\n' full website database files;;
    --target) printf '%s\n' new current;; --import-mode) printf '%s\n' fresh replace merge;;
    --output) printf '%s\n' text json;; --webserver) printf '%s\n' apache nginx;;
    --mode) printf '%s\n' basic expert;; --direction) printf '%s\n' push pull;;
    --config-kind) printf '%s\n' compose env;; --channel) printf '%s\n' master staging;;
    --enable|--secure|--cloudflare|--customize|--auto-install|--persistence|--db-persistence|--save-defaults|--mailcatcher|--phpmyadmin|--php-settings) printf '%s\n' true false;;
    --timestamp|--overwrite|--delete-source|--progress|--pre-backup|--confirm) printf '%s\n' yes no;;
    --file|--input-json|--repo-path|--project-path|--ssh-dir|--ssh-keys|--mount-base|--destination|--archive) compgen -f -- "$current";;
    --table|--database-image|--db-image|--label|--retention|--timestamp-pattern) :;;
    --image-tag)
      # Cached catalogues contain public tag names only. Tab never refreshes them.
      for path in "${VDM_SRC_PATH}/cache/"php-tags-*; do [ ! -f "$path" ] || cat "$path"; done;;
    *) cliOptionNames;;
  esac | while IFS= read -r item; do [[ "$item" != "$current"* ]] || printf '%s\n' "$item" || return; done
  return 0
}

function cliCompletionScript() {
  cat <<'COMPLETION'
# OctoJoom Bash completion. Installed and maintained by octojoom.
_octojoom_complete() {
  local current="${COMP_WORDS[COMP_CWORD]}" previous='' prefix='' type=joomla task='' word value index
  (( COMP_CWORD == 0 )) || previous="${COMP_WORDS[COMP_CWORD-1]}"
  if [ "$previous" = = ] && (( COMP_CWORD > 1 )); then previous="${COMP_WORDS[COMP_CWORD-2]}"; fi
  [ "$current" != = ] || current=''
  for ((index=1; index<COMP_CWORD; index++)); do
    word="${COMP_WORDS[index]}"
    case "$word" in
      --type|--task)
        value="${COMP_WORDS[index+1]}"
        [ "$value" != = ] || value="${COMP_WORDS[index+2]}"
        if [ "$word" = --type ]; then type="$value"; else task="$value"; fi;;
      --type=*) type="${word#*=}";; --task=*) task="${word#*=}";;
    esac
  done
  case "$current" in --*=*) previous="${current%%=*}"; prefix="${previous}="; current="${current#*=}";; esac
  COMPREPLY=()
  while IFS= read -r word; do COMPREPLY+=("${prefix}$word"); done < <(command octojoom --complete "$previous" "$current" "$type" "$task" 2>/dev/null)
  }
complete -o filenames -F _octojoom_complete octojoom
# A function is necessary: only the caller's shell can change its own directory.
octojoom_cd() {
  local directory
  directory=$(command octojoom --type joomla --task path --container "${1:-}" --non-interactive) || return
  [ -d "$directory" ] || return 1
  cd -- "$directory" || return
  }
COMPLETION
}

function installShellIntegration() {
  local directory="${VDM_HOME_PATH}/.local/share/bash-completion/completions" file startup line temporary login_file
  createPrivateDirectory -p "$directory" || return 1
  file="$directory/octojoom"
  temporary=$(mktemp "$directory/.octojoom.XXXXXX") || return 1
  if ! cliCompletionScript >"$temporary" || ! chmod 600 "$temporary" || ! mv -f "$temporary" "$file"; then rm -f "$temporary"; return 1; fi
  # Bash's programmable completion is builtin; the loader also works without
  # the optional system bash-completion package on macOS and Git Bash.
  # shellcheck disable=SC2016 # Expanded by the user's next Bash, not the installer.
  line='[ -z "${BASH_VERSION:-}" ] || [ ! -f "$HOME/.local/share/bash-completion/completions/octojoom" ] || . "$HOME/.local/share/bash-completion/completions/octojoom" # octojoom shell integration'
  # Do not introduce .bash_profile ahead of a user's existing login file.
  login_file="${VDM_HOME_PATH}/.bash_profile"
  for startup in "${VDM_HOME_PATH}/.bash_profile" "${VDM_HOME_PATH}/.bash_login" "${VDM_HOME_PATH}/.profile"; do
    if [ -f "$startup" ]; then login_file="$startup"; break; fi
  done
  for startup in "${VDM_HOME_PATH}/.bashrc" "$login_file"; do
    if [ -L "$startup" ] && [ ! -f "$startup" ]; then echo >&2 "NOTICE: Shell startup link has no target: $startup"; continue; fi
    [ -f "$startup" ] || (umask 077; touch "$startup") || return 1
    grep -Fq '# octojoom shell integration' "$startup" || printf '\n%s\n' "$line" >>"$startup" || return 1
  done
}

function removeShellIntegration() {
  local file temporary
  rm -f -- "${VDM_HOME_PATH}/.local/share/bash-completion/completions/octojoom" || return 1
  for file in "${VDM_HOME_PATH}/.bashrc" "${VDM_HOME_PATH}/.bash_profile" "${VDM_HOME_PATH}/.bash_login" "${VDM_HOME_PATH}/.profile"; do
    [ -f "$file" ] || continue
    temporary=$(mktemp "${file}.XXXXXX") || return 1
    if ! cp -p "$file" "$temporary" || ! sed '/# octojoom shell integration$/d' "$file" >"$temporary"; then rm -f "$temporary"; return 1; fi
    if [ -L "$file" ]; then
      cat "$temporary" >"$file" || { rm -f "$temporary"; return 1; }
      rm -f "$temporary"
    elif ! mv -f "$temporary" "$file"; then rm -f "$temporary"; return 1; fi
  done
}

function cliResolvePaths() {
  case "$OSTYPE" in linux*) OS_NUMBER=1;; darwin*) OS_NUMBER=2;; msys*|cygwin*) OS_NUMBER=3;; *) OS_NUMBER=0;; esac
  VDM_HOME_PATH="${OCTOJOOM_HOME:-}"
  if [ -z "$VDM_HOME_PATH" ]; then
    case "$OS_NUMBER" in
      1) VDM_HOME_PATH="/home/${USER}";; 2) VDM_HOME_PATH="/Users/${USER}";; 3) VDM_HOME_PATH="/c/Users/${USER}";;
      *) echo >&2 'ERROR: Unsupported operating system.'; return 1;;
    esac
  fi
  local home_path="$VDM_HOME_PATH" src_path="${VDM_HOME_PATH}/.config/octojoom"
  VDM_SRC_PATH="$src_path"
  [ ! -f "$src_path/.env" ] || loadEnvFile "$src_path/.env" || return 1
  VDM_HOME_PATH="$home_path"
  VDM_SRC_PATH="$src_path"
  cliApplyValues
  : "${VDM_REPO_PATH:=${VDM_HOME_PATH}/Docker}"
  : "${VDM_PROJECT_PATH:=${VDM_HOME_PATH}/Projects}"
  case "$OSTYPE" in linux*) OS_NUMBER=1;; darwin*) OS_NUMBER=2;; msys*|cygwin*) OS_NUMBER=3;; *) OS_NUMBER=0;; esac
  export VDM_REPO_PATH VDM_PROJECT_PATH
}

function cliResolveTarget() {
  if [ -n "${VDM_CONTAINER:-}" ]; then
    : "${VDM_CONTAINER_TYPE:=joomla}"; : "${VDM_TASK:=enable}"
  elif [ -n "${VDM_DOMAIN:-}" ] && [ -n "${VDM_SUBDOMAIN:-}" ]; then
    VDM_CONTAINER="${VDM_SUBDOMAIN}.${VDM_DOMAIN}"
  fi
}

function cliPreflight() {
  if [ -z "${VDM_CONTAINER_TYPE:-}" ] || [ -z "${VDM_TASK:-}" ]; then echo >&2 'ERROR: Supply --type and --task in noninteractive mode.'; return 17; fi
  isFunc "${VDM_CONTAINER_TYPE}__TRuST__${VDM_TASK}" || { echo >&2 "ERROR: Unsupported container type or task: ${VDM_CONTAINER_TYPE}/${VDM_TASK}."; return 17; }
  if [ "${VDM_TASK}" = edit ]; then echo >&2 'ERROR: Editing requires a terminal. Use --task config --action read or replace.'; return 17; fi
  case "${VDM_CONTAINER_TYPE}/${VDM_TASK}" in
    joomla/database|joomla/backup) cliDataPreflight || return $?;;
    joomla/bulk)
      if isFunc joomlaBulkPreflight; then joomlaBulkPreflight || return $?; fi;;
    joomla/setup)
      if isFunc joomlaSetupPreflight; then joomlaSetupPreflight || return $?; fi;;
    openssh/setup)
      local variable value mount
      if [ -f "$VDM_REPO_PATH/openssh/.env" ]; then loadEnvFile "$VDM_REPO_PATH/openssh/.env" || return 1; cliApplyValues; fi
      : "${VDM_ENV_KEY:=${VDM_KEY^^}}"
      if [[ "${VDM_ENV_KEY:-}" =~ ^[A-Za-z]+$ ]]; then
        variable="VDM_${VDM_ENV_KEY^^}_PUBLIC_KEY_DIR"; value="${!variable:-}"; : "${VDM_PUBLIC_KEY_U_DIR:=$value}"
        variable="VDM_${VDM_ENV_KEY^^}_PROJECT_DIR"; value="${!variable:-}"; : "${VDM_PROJECT_U_DIR:=$value}"
      fi
      for variable in VDM_DOMAIN VDM_USER_NAME VDM_KEY VDM_PORT VDM_PUBLIC_KEY_U_DIR VDM_PROJECT_U_DIR VDM_MOUNT_DIRS; do
        [ -n "${!variable:-}" ] || { echo >&2 "ERROR: Missing setup input: $variable"; return 17; }
      done
      isValidDomain "$VDM_DOMAIN" || return 17
      [[ "$VDM_USER_NAME" =~ ^[a-z][a-z0-9-]{0,31}$ && "$VDM_PORT" =~ ^[0-9]{1,5}$ && "$VDM_KEY" =~ ^[A-Za-z]+$ && "$VDM_ENV_KEY" =~ ^[A-Za-z]+$ ]] || return 17
      [ ! -e "$VDM_REPO_PATH/openssh/available/$VDM_USER_NAME.$VDM_DOMAIN" ] || { echo >&2 'ERROR: That OpenSSH container already exists.'; return 17; }
      local -a mounts=()
      read -r -a mounts <<<"$VDM_MOUNT_DIRS"
      for mount in "${mounts[@]}"; do mount="${mount//\"/}"; isSafeProjectName "$mount" && [ -d "$VDM_PROJECT_U_DIR/$mount" ] || return 17; done
      [ "$((10#$VDM_PORT))" -ge 1 ] && [ "$((10#$VDM_PORT))" -le 65535 ] && [ "$((10#$VDM_PORT))" -ne 22 ] || return 17
      [ -d "$VDM_PUBLIC_KEY_U_DIR" ] && [ -d "$VDM_PROJECT_U_DIR" ] || return 17
      : "${VDM_ENV_KEY:=${VDM_KEY^^}}"; : "${VDM_PUID:=$(id -u)}"; : "${VDM_PGID:=$(id -g)}"
      : "${VDM_PUBLIC_KEY_GLOBAL_DIR:=${VDM_PUBLIC_KEY_U_DIR%/*}}";;
    traefik/setup|portainer/setup)
      if [ -f "$VDM_REPO_PATH/$VDM_CONTAINER_TYPE/.env" ]; then loadEnvFile "$VDM_REPO_PATH/$VDM_CONTAINER_TYPE/.env" || return 1; cliApplyValues; fi
      isValidDomain "${VDM_DOMAIN:-}" || { echo >&2 'ERROR: Setup requires --domain.'; return 17; }
      if [ "${VDM_SECURE:-false}" = true ] && [ "${VDM_CONTAINER_TYPE}" = traefik ]; then
        [ -n "${VDM_SECURE_EMAIL:-}" ] || { echo >&2 'ERROR: HTTPS setup requires --secure-email.'; return 17; }
        [ "${VDM_SECURE_CLOUDFLARE:-false}" != true ] || [ -n "${VDM_CLOUDFLARE_DNS_API_TOKEN:-}" ] || return 17
      fi
      [ "$VDM_CONTAINER_TYPE" != portainer ] || : "${VDM_SUBDOMAIN:=port}";;
    joomla/enable|joomla/disable|openssh/enable|openssh/disable|joomla/delete|openssh/delete|joomla/clone)
      isValidDomain "${VDM_CONTAINER:-}" || { echo >&2 'ERROR: This task requires --container.'; return 17; }
      [ -f "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available/${VDM_CONTAINER}/docker-compose.yml" ] || return 1
      if [ "$VDM_TASK" = clone ]; then
        if ! [[ "${VDM_KEY:-}" =~ ^[A-Za-z]+$ ]] || [ -z "${VDM_DOMAIN:-}" ] || [ -z "${VDM_SUBDOMAIN:-}" ]; then echo >&2 'ERROR: Clone also requires destination --key, --domain and --sub-domain.'; return 17; fi
      fi;;
  esac
  if isFunc cliPreflightOtherTask; then cliPreflightOtherTask || return $?; fi
  return 0
}

function cliDispatch() {
  case "${OCTOJOOM_CLI_ACTION:-}" in
    help) showHelp;; update) runUpdate;; uninstall) runUninstall;; *) main;;
  esac
}

function cliFailure() {
  local status="$1"
  if [ "${OCTOJOOM_OUTPUT:-text}" = json ] && command -v jq >/dev/null 2>&1; then
    jq -n --arg task "${VDM_TASK:-${OCTOJOOM_CLI_ACTION:-}}" --arg action "${VDM_ACTION:-}" --arg container "${VDM_CONTAINER:-}" --argjson status "$status" '{success:false,task:$task,action:$action,container:$container,data:null,error:"Invalid request or unavailable configuration; see stderr for details.",exit_status:$status}'
  fi
  return "$status"
}

function cliExecute() {
  local result status=0 task="${VDM_TASK:-${OCTOJOOM_CLI_ACTION:-}}" site="${VDM_CONTAINER:-}" action="${VDM_ACTION:-}"
  if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then
    result=$(cliDispatch) || status=$?
    printf '%s' "$result" | jq -Rs --arg task "$task" --arg action "$action" --arg container "$site" --argjson status "$status" \
      '{success:($status == 0),task:$task,action:$action,container:$container,data:(if length == 0 then null else (try fromjson catch .) end),error:(if $status == 0 then null else "Operation failed; see stderr for details." end),exit_status:$status}'
    return "$status"
  fi
  cliDispatch
}

# The lightweight entry never runs installers or writes config while answering
# help, completion, read-only tasks or an invalid/incomplete headless request.
function cliStart() {
  VDM_ARG_DOMAIN=false VDM_FORCE=false
  if [ "${1:-}" = --complete ]; then
    shift
    OCTOJOOM_CLI_KEYS=() OCTOJOOM_CLI_VALUES=()
    cliResolvePaths >/dev/null 2>&1 || return 0
    cliComplete "$@"
    return
  fi
  parseCLI "$@" || { cliFailure $?; return $?; }
  [ "$OCTOJOOM_CLI_ACTION" != help ] || { showHelp; return; }
  cliResolvePaths || { cliFailure $?; return $?; }
  cliResolveTarget
  if [ "${OCTOJOOM_NON_INTERACTIVE}" = true ]; then
    if [ -z "$OCTOJOOM_CLI_ACTION" ]; then cliPreflight || { cliFailure $?; return $?; }; fi
    : "${VDM_SECURE:=false}"; : "${VDM_SECURE_CLOUDFLARE:=false}"
    : "${VDM_MULTI_DOMAIN:=false}"; : "${VDM_UPDATE_HOST:=false}"; : "${VDM_EXPERT_MODE:=false}"
  fi
  if [[ "${VDM_TASK:-}" == setup || "${VDM_TASK:-}" == bulk ]]; then
    createPrivateDirectory -p "$VDM_SRC_PATH" "$VDM_REPO_PATH" "$VDM_PROJECT_PATH" || return 1
    setEnvVariable "VDM_REPO_PATH=\"${VDM_REPO_PATH}\"" || return 1
    setEnvVariable "VDM_PROJECT_PATH=\"${VDM_PROJECT_PATH}\"" || return 1
    installShellIntegration || return 1
    setNetworks >&2 || return $?
  fi
  cliExecute
}

# defaults
VDM_ARG_DOMAIN=false
VDM_FORCE=false
parseCLI "$@" || exit $?
if [ "${OCTOJOOM_CLI_ACTION}" = help ]; then
  showHelp
  quitProgram
fi

