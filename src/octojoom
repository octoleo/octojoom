# Explicit uninstall choices are independent: removing the executable never
# implies deleting deployment configuration or persistent website/database data.
function cliUninstall() {
  local type saved_type="${VDM_CONTAINER_TYPE:-}" directory
  case "${VDM_ACTION:-}" in script|complete|selected) ;; *) echo >&2 'ERROR: --uninstall requires --action script, complete or selected in noninteractive mode.'; return 17;; esac
  if [ "$VDM_ACTION" = complete ]; then VDM_REMOVE_DEPLOYMENTS=true VDM_REMOVE_CONFIG=true; fi
  if [ "${VDM_REMOVE_DEPLOYMENTS:-false}" = true ] || [ "${VDM_REMOVE_DATA:-false}" = true ]; then
    for directory in "$VDM_REPO_PATH" "$VDM_PROJECT_PATH"; do [ ! -d "$directory" ] || validateOctojoomRemovalPath "$directory" || return 1; done
    for type in joomla openssh traefik portainer; do
      VDM_CONTAINER_TYPE="$type"
      if [[ "$type" == joomla || "$type" == openssh ]]; then
        ! hasDirectories "$type/enabled" || "${type}__TRuST__down" || return $?
      elif [ -f "$VDM_REPO_PATH/$type/docker-compose.yml" ]; then "${type}__TRuST__disable" || return $?; fi
    done
    VDM_CONTAINER_TYPE="$saved_type"
  fi
  [ "${VDM_REMOVE_CONFIG:-false}" != true ] || [ ! -d "$VDM_SRC_PATH" ] || validateOctojoomRemovalPath "$VDM_SRC_PATH" || return 1
  [ "${VDM_REMOVE_DEPLOYMENTS:-false}" != true ] || [ ! -d "$VDM_REPO_PATH" ] || removeOctojoomDirectory "$VDM_REPO_PATH" || return 1
  [ "${VDM_REMOVE_DATA:-false}" != true ] || [ ! -d "$VDM_PROJECT_PATH" ] || removeOctojoomDirectory "$VDM_PROJECT_PATH" || return 1
  [ "${VDM_REMOVE_CONFIG:-false}" != true ] || [ ! -d "$VDM_SRC_PATH" ] || removeOctojoomDirectory "$VDM_SRC_PATH" || return 1
  removeShellIntegration || return 1
  [ ! -f /usr/local/bin/octojoom ] || cliSudo rm -f /usr/local/bin/octojoom || return 1
        removeShellIntegration || return 1
}

