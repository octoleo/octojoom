# we set a home path based on OS
# (OCTOJOOM_HOME replaces it when set, so the test suite never touches a real home)
VDM_HOME_PATH="${OCTOJOOM_HOME:-}"
[ -n "${VDM_HOME_PATH}" ] || case "$OS_NUMBER" in
  1) # Linux
    VDM_HOME_PATH="/home/${USER}"
    ;;
  2) # macOS
    VDM_HOME_PATH="/Users/${USER}"
    ;;
  3) # Windows (MSYS/Cygwin)
    VDM_HOME_PATH="/c/Users/${USER}"
    ;;
  *)
    echo >&2 "ERROR: Unsupported operating system."
    exit 1
    ;;
esac
# Set the src folder path based on OS
VDM_SRC_PATH="${VDM_HOME_PATH}/.config/octojoom"
# Create the folder if not set
createPrivateDirectory -p "${VDM_SRC_PATH}" || exit 1
# first run switch
VDM_FIRST_RUN=false
OCTOJOOM_RESOLVED_HOME_PATH="${VDM_HOME_PATH}"
OCTOJOOM_RESOLVED_SRC_PATH="${VDM_SRC_PATH}"
# load the globals
if [ -f "${VDM_SRC_PATH}/.env" ]; then
  loadEnvFile "${VDM_SRC_PATH}/.env" || exit 1
fi
VDM_HOME_PATH="${OCTOJOOM_RESOLVED_HOME_PATH}"
VDM_SRC_PATH="${OCTOJOOM_RESOLVED_SRC_PATH}"
VDM_FIRST_RUN=false
unset OCTOJOOM_RESOLVED_HOME_PATH OCTOJOOM_RESOLVED_SRC_PATH
# Restore explicit CLI options after loading saved defaults.
for cli_index in "${!OCTOJOOM_CLI_KEYS[@]}"; do
  printf -v "${OCTOJOOM_CLI_KEYS[cli_index]}" '%s' "${OCTOJOOM_CLI_VALUES[cli_index]}"
done
unset cli_index OCTOJOOM_CLI_KEYS OCTOJOOM_CLI_VALUES
# Resolve targets after loading defaults so a saved domain can accompany a
# CLI subdomain. Tasks operating on all containers need no individual target.
if [ -n "${VDM_CONTAINER}" ]; then
  VDM_CONTAINER_TYPE="${VDM_CONTAINER_TYPE:-joomla}"
  VDM_TASK="${VDM_TASK:-enable}"
fi
if [ -z "${VDM_CONTAINER}" ] && [ -n "${VDM_CONTAINER_TYPE}" ] &&
  [ -n "${VDM_TASK}" ] && [ -n "${VDM_DOMAIN}" ]; then
  sub="${VDM_SUBDOMAIN:-}"
  if [ -z "${sub}" ]; then
    case "${VDM_CONTAINER_TYPE}" in
      portainer) sub=port ;;
      traefik) sub=traefik ;;
      openssh) sub="${VDM_USER_NAME:-}" ;;
    esac
  fi
  [ -z "${sub}" ] || VDM_CONTAINER="${sub}.${VDM_DOMAIN}"
  unset sub
fi
# Update/uninstall use the saved paths but do not initialize new deployments.
case "${OCTOJOOM_CLI_ACTION}" in
  update) runUpdate; exit $? ;;
  uninstall) runUninstall; exit $? ;;
esac
# get repo path where store the container deploy scripts
while [ ${#VDM_REPO_PATH} -le 1 ] || [ ! -d "${VDM_REPO_PATH}" ]; do
  # creat the path if it exist
  if [ ${#VDM_REPO_PATH} -ge 1 ] && (whiptail --yesno "Can we create the ${VDM_REPO_PATH} repository folder" \
    --title "Create the Path" --backtitle "${BACK_TITLE}" 8 112); then
    mkdir -p "${VDM_REPO_PATH}" || exit 1
  else
    # get the value
    VDM_REPO_PATH=$(getInput "Enter the repository path where we can store the containers' docker-composer.yml deployment files." \
      "${VDM_HOME_PATH}/Docker" 'Enter Repository Path') || exit $?
    # keep asking if empty or does exist
    if [ ${#VDM_REPO_PATH} -ge 1 ] && [ ! -d "${VDM_REPO_PATH}" ] && (whiptail --yesno "Can we create the ${VDM_REPO_PATH} repository folder" \
      --title "Create the Path" --backtitle "${BACK_TITLE}" 8 112); then
      mkdir -p "${VDM_REPO_PATH}" || exit 1
    elif [ ${#VDM_REPO_PATH} -le 1 ]; then
      showError "You must set a repository path where we can store the containers' docker-composer.yml deployment files."
    fi
  fi
  # trip switch of first run
  VDM_FIRST_RUN=true
done
# add this value if not set variable
setEnvVariable "VDM_REPO_PATH=\"${VDM_REPO_PATH}\"" || exit $?
# get repo path where store the container deploy scripts
while [ ${#VDM_PROJECT_PATH} -le 1 ] || [ ! -d "${VDM_PROJECT_PATH}" ]; do
  # create the path if it exist
  if [ ${#VDM_PROJECT_PATH} -ge 1 ] && (whiptail --yesno "Can we create the ${VDM_PROJECT_PATH} projects' folder" \
    --title "Create the Path" --backtitle "${BACK_TITLE}" 8 112); then
    mkdir -p "${VDM_PROJECT_PATH}" || exit 1
  else
    # get the value
    VDM_PROJECT_PATH=$(getInput "Enter the projects' path where we can store the containers' persistent volumes." \
      "${VDM_HOME_PATH}/Projects" "Enter Projects' Path") || exit $?
    # keep asking if empty or does exist
    if [ ${#VDM_PROJECT_PATH} -ge 1 ] && [ ! -d "${VDM_PROJECT_PATH}" ] && (whiptail --yesno "Can we create the ${VDM_PROJECT_PATH} projects folder" \
      --title "Create the Path" --backtitle "${BACK_TITLE}" 8 112); then
      mkdir -p "${VDM_PROJECT_PATH}" || exit 1
    elif [ ${#VDM_PROJECT_PATH} -le 1 ]; then
      showError "You must set a projects' path where we can store the containers' persistent volumes."
    fi
  fi
  # trip switch of first run
  VDM_FIRST_RUN=true
done
# add this value if not set variable
setEnvVariable "VDM_PROJECT_PATH=\"${VDM_PROJECT_PATH}\"" || exit $?
# set these globally
export VDM_REPO_PATH
export VDM_PROJECT_PATH
# if this is the first run we should setup traefik
$VDM_FIRST_RUN && {
  # set traefik as the container type
  : "${VDM_CONTAINER_TYPE:=traefik}"
  # and enable it
  : "${VDM_TASK:=setup}"
  # first setup the network
  setNetworks || exit $?
  # trigger main
  main || exit $?
  # clear it again
  VDM_CONTAINER_TYPE=''
  VDM_TASK=''
}

