# Parse all options before performing an action. Values passed explicitly on the
# command line override the saved global config loaded later.
# Resolve expert configuration views without losing selected-site ENV precedence.
function cliSudo() {
  if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then sudo -n "$@"; else sudo "$@"; fi
}

function cliConfigPath() {
  local kind="${VDM_CONFIG_KIND:-compose}" type="${VDM_CONTAINER_TYPE:-}" site="${VDM_CONTAINER:-}"
  case "$type" in
    settings) printf '%s/.env\n' "$VDM_SRC_PATH";;
    joomla|openssh)
      if [ -n "$site" ]; then
        isValidDomain "$site" || return 17
        [ -f "$VDM_REPO_PATH/$type/available/$site/docker-compose.yml" ] || return 1
        case "$kind" in
          compose) printf '%s/%s/available/%s/docker-compose.yml\n' "$VDM_REPO_PATH" "$type" "$site";;
          env) getContainerEnvFile "$type" "$site" available;; *) return 17;;
        esac
      elif [ "$kind" = env ]; then printf '%s/%s/.env\n' "$VDM_REPO_PATH" "$type"
      else echo >&2 'ERROR: Select a container for its Compose configuration.'; return 17; fi;;
    traefik|portainer)
      case "$kind" in compose) printf '%s/%s/docker-compose.yml\n' "$VDM_REPO_PATH" "$type";; env) printf '%s/%s/.env\n' "$VDM_REPO_PATH" "$type";; *) return 17;; esac;;
    *) return 17;;
  esac
}

# Read the normalized Compose identity without a jq dependency. A replacement
# may change options, but must not silently select a different Docker project.
function cliComposeProjectName() {
  local model name
  model=$(migrationRunCompose "$1" "$2" --project-directory "$3" config) || return 1
  name=$(printf '%s\n' "$model" | awk '/^name:[[:space:]]/ {count++; sub(/^name:[[:space:]]*/, ""); value=$0} END {if (count != 1) exit 1; print value}') || return 1
  decodeEnvValue "$name" name || return 1
  [[ "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || return 1
  printf '%s\n' "$name"
}

function cliConfiguration() {
  local file kind="${VDM_CONFIG_KIND:-compose}" candidate backup compose='' env_file='' running='' service status=0
  local candidate_compose candidate_env project_directory original_project candidate_project
  file=$(cliConfigPath) || return $?
  [ -n "$file" ] || return 1
  case "${VDM_ACTION:-path}" in
    path) printf '%s\n' "$file";;
    read) cat -- "$file";;
    replace)
      if [ ! -f "${VDM_INPUT_FILE:-}" ] || [ -L "$VDM_INPUT_FILE" ] || [ ! -f "$file" ] || [ -L "$file" ]; then echo >&2 'ERROR: Replacement requires --file with a regular file and an existing configuration.'; return 17; fi
      [ "$VDM_CONTAINER_TYPE" != settings ] || kind='env'
      candidate=$(mktemp "${file}.candidate.XXXXXX") || return 1
      if ! cp "$VDM_INPUT_FILE" "$candidate" || ! chmod 600 "$candidate"; then rm -f "$candidate"; return 1; fi
      if [ "$kind" = env ] && ! (loadEnvFile "$candidate"); then rm -f "$candidate"; return 17; fi
      if [ "$VDM_CONTAINER_TYPE" != settings ]; then
        if [ -n "${VDM_CONTAINER:-}" ]; then compose="$VDM_REPO_PATH/$VDM_CONTAINER_TYPE/available/$VDM_CONTAINER/docker-compose.yml"
        elif [[ "$VDM_CONTAINER_TYPE" == traefik || "$VDM_CONTAINER_TYPE" == portainer ]]; then compose="$VDM_REPO_PATH/$VDM_CONTAINER_TYPE/docker-compose.yml"; fi
        if [ -n "$compose" ]; then
          env_file=$(getContainerEnvFile "$VDM_CONTAINER_TYPE" "${VDM_CONTAINER:-}" available)
          project_directory="${compose%/*}"
          candidate_compose="$compose" candidate_env="$env_file"
          [ "$kind" != env ] || candidate_env="$candidate"
          [ "$kind" != compose ] || candidate_compose="$candidate"
          if ! original_project=$(cliComposeProjectName "$env_file" "$compose" "$project_directory") ||
            ! candidate_project=$(cliComposeProjectName "$candidate_env" "$candidate_compose" "$project_directory"); then
            echo >&2 'ERROR: Cannot validate the original and replacement Compose project identities.'
            rm -f "$candidate"; return 1
          fi
          if [ "$original_project" != "$candidate_project" ]; then
            echo >&2 'ERROR: Configuration replacement cannot change the Compose project name.'
            rm -f "$candidate"; return 17
          fi
          # Observe the ORIGINAL configuration before publishing. A candidate
          # must never redirect discovery to a different project or service set.
          running=$(migrationRunCompose "$env_file" "$compose" --project-directory "$project_directory" ps --status running --services) || { rm -f "$candidate"; return 1; }
        fi
      fi
      backup=$(mktemp "${file}.backup.XXXXXX") || { rm -f "$candidate"; return 1; }
      if ! cp -p "$file" "$backup" || ! mv -f "$candidate" "$file"; then rm -f "$candidate" "$backup"; return 1; fi
      if [ -n "$compose" ] && [ -n "$running" ]; then
        local -a services=()
        while IFS= read -r service; do [ -z "$service" ] || services+=("$service"); done <<<"$running"
        migrationRunCompose "$env_file" "$compose" --project-directory "$project_directory" up -d --no-deps "${services[@]}" || status=$?
        if [ "$status" -ne 0 ]; then
          cp -p "$backup" "$file" || { echo >&2 "ERROR: Restore the retained configuration: $backup"; return "$status"; }
          migrationRunCompose "$env_file" "$compose" --project-directory "$project_directory" up -d --no-deps "${services[@]}" || echo >&2 "ERROR: Configuration restored; runtime recovery failed. Backup: $backup"
          return "$status"
        fi
      fi
      printf 'Configuration saved. Previous file: %s\n' "$backup";;
    *) echo >&2 'ERROR: Configuration action must be path, read or replace.'; return 17;;
  esac
}

