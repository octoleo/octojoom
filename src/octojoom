# we must get a random key
function getRandomPass() {
  getRandomString "${1:-128}" 'A-HJ-NP-Za-km-z2-9'
}

# we must get a random key
function getRandomName() {
  getRandomString "${1:-128}" 'A-Za-z'
}

# Read finite chunks so the random producer always terminates. C locale makes
# arbitrary random bytes safe for BSD tr; avoiding tr | head also avoids SIGPIPE.
function getRandomString() {
  local length="${1:-128}" alphabet="$2" result='' chunk
  if [[ ! "$length" =~ ^[1-9][0-9]{0,4}$ ]] || [ "$length" -gt 65536 ]; then
    printf 'Random string length must be between 1 and 65536.\n' >&2
    return 1
  fi
  while [ "${#result}" -lt "$length" ]; do
    chunk=$(set -o pipefail; LC_ALL=C head -c 1024 /dev/urandom | LC_ALL=C tr -dc "$alphabet") || return 1
    result+="$chunk"
  done
  printf '%s' "${result:0:length}"
}

