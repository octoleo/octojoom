# to set a global multiple domain file and values
function saveMultiDomain() {
  # set some locals
  local domain_name
  local src_path_domain
  # Whitespace-only input is an empty selection; malformed domains are refused.
  domain_name="${1:-}"
  [[ "${domain_name}" =~ [^[:space:]] ]] || return 0
  if ! isValidDomain "${domain_name}"; then
    echo >&2 "ERROR: Invalid domain: ${domain_name}"
    return 17
  fi
  src_path_domain="${VDM_SRC_PATH}/.domains"
  # check that we have a domain string
  if [ -n "${domain_name}" ]; then
    # make sure the folder exists
    mkdir -p "${VDM_SRC_PATH}" || return 1
    # if the file does not exist, create it and set the proper permissions
    if [ ! -f "${src_path_domain}" ]; then
      touch "${src_path_domain}" || return 1
      chmod 600 "${src_path_domain}" || return 1
    fi
    # check if the domain is not already in the file, and if not, add it
    if ! grep -Fxq -- "${domain_name}" "${src_path_domain}"; then
      printf '%s\n' "${domain_name}" >>"${src_path_domain}" || return 1
    fi
  fi
  # we return true
  return 0
}

# Delete a global environment variable from .env
function deleteEnvVariable() {
	# Key we want to remove
	local env_key="${1:-}"

	# Only proceed if key provided and file exists
	[ -z "${env_key}" ] && return 0
	[ ! -f "${VDM_SRC_PATH}/.env" ] && return 0

	# Escape regex special chars in the key
	local safe_key
	safe_key="$(printf '%s\n' "${env_key}" | sed 's/[]\/$*.^|[]/\\&/g')"

	# Create temporary file
	local tmp_file="${VDM_SRC_PATH}/.env_tmp"

	# Filter the .env file and remove matching line(s)
	if grep -E -v "^${safe_key}=.*$" "${VDM_SRC_PATH}/.env" > "${tmp_file}"; then
		# Preserve original permissions (GNU stat, then BSD stat on macOS)
		local env_mode
		env_mode=$(stat -c '%a' "${VDM_SRC_PATH}/.env" 2>/dev/null || stat -f '%Lp' "${VDM_SRC_PATH}/.env" 2>/dev/null)
		[ -n "${env_mode}" ] && chmod "${env_mode}" "${tmp_file}"
		mv "${tmp_file}" "${VDM_SRC_PATH}/.env"
	else
		rm -f "${tmp_file}"
		return 1
	fi

	return 0
}

# delete multiple domains
function deleteMultiDomains() {
  local menu_options=()
  local domains domain answer remove remove_domain tmp_file filter_status
  local array_answer=()
  local i=0
  local domain_file="${VDM_SRC_PATH}/.domains"

  if [ -f "${domain_file}" ] && readarray -t domains <"${domain_file}"; then
    if [ "${#domains[@]}" -gt 0 ]; then
      for domain in "${domains[@]}"; do
        [ -n "${domain}" ] || continue
        menu_options+=("${domain}" "${domain}" "OFF")
        i=$((i + 1))
      done

      [ "${i}" -gt 0 ] || return 0

      answer=$(whiptail --title "Delete Domains" --checklist \
        "Select the domain/s you would like to delete" 20 112 $i \
        "${menu_options[@]}" \
        --backtitle "${BACK_TITLE}" --nocancel --notags 3>&1 1>&2 2>&3) || return 1

      if [ -n "${answer}" ]; then
        IFS=' ' read -r -a array_answer <<<"${answer[@]}"
        for remove in "${array_answer[@]}"; do
          remove_domain="${remove//\"/}"
          tmp_file=$(mktemp "${domain_file}.XXXXXX") || return 1
          # Keep the domain list private when replacing it atomically.
          if ! cp -p -- "${domain_file}" "${tmp_file}"; then
            rm -f -- "${tmp_file}"
            return 1
          fi
          grep -Fvx -- "${remove_domain}" "${domain_file}" >"${tmp_file}"
          filter_status=$?
          # grep returns 1 when the last entry is removed: that is success.
          if [ "${filter_status}" -le 1 ]; then
            mv -- "${tmp_file}" "${domain_file}" || { rm -f -- "${tmp_file}"; return 1; }
          else
            rm -f -- "${tmp_file}"
            return "${filter_status}"
          fi
        done
      fi
    fi
  fi
}

# Match whole host aliases, ignoring comments, whitespace and letter case.
function hostFileHasHost() {
  local hostname="$1" host_file="$2"
  [ -f "${host_file}" ] || return 1
  awk -v hostname="${hostname}" '
    { sub(/\r$/, ""); sub(/#.*/, "") }
    { for (i = 2; i <= NF; i++) if (tolower($i) == tolower(hostname)) found = 1 }
    END { exit !found }
  ' "${host_file}"
}

# check if expert mode is on
function isExpert() {
  # check if its set
  if [ -n "${VDM_EXPERT_MODE}" ] && [ "${VDM_EXPERT_MODE}" = "true" ]; then
    # is expert
    return 0
  else
    # not expert
    return 1
  fi
}

# check if some thing is a function
function isFunc() {
