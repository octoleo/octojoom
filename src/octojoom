# OCTOJOOM V4: cli
# Native jq on Windows must not rewrite data arguments or emit CRLF. File
# operands are translated explicitly; JSON strings and jq programs stay literal.
function jq() {
  case "${OSTYPE:-}" in
    msys*|cygwin*)
      local argument filter_seen=false positional_values=false
      local -a jq_args=(-b)
      while [ "$#" -gt 0 ]; do
        argument="$1"; shift
        case "$argument" in
          --arg|--argjson)
            [ "$#" -ge 2 ] || { command jq "$argument" "$@"; return $?; }
            jq_args+=("$argument" "$1" "$2"); shift 2 ;;
          --rawfile|--slurpfile|--argfile)
            [ "$#" -ge 2 ] || return 2
            jq_args+=("$argument" "$1" "$(cygpath -m -- "$2")"); shift 2 ;;
          -f|--from-file|-L)
            [ "$#" -ge 1 ] || return 2
            jq_args+=("$argument" "$(cygpath -m -- "$1")"); shift
            [ "$argument" = -L ] || filter_seen=true ;;
          --indent)
            [ "$#" -ge 1 ] || return 2
            jq_args+=("$argument" "$1"); shift ;;
          --args|--jsonargs) positional_values=true; jq_args+=("$argument") ;;
          --) jq_args+=("$argument") ;;
          -*) jq_args+=("$argument") ;;
          *)
            if [ "$filter_seen" = false ]; then
              jq_args+=("$argument"); filter_seen=true
            elif [ "$positional_values" = true ]; then jq_args+=("$argument")
            else jq_args+=("$(cygpath -m -- "$argument")"); fi ;;
        esac
      done
      MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' command jq "${jq_args[@]}"
      ;;
    *) command jq "$@" ;;
  esac
}

# OctoJoom 4 command contract. All handlers are shared with the site TUI.
# JSON is parsed as data by jq; no request value is evaluated as shell code.
function v4Error() {
  local message="${1:-The operation failed.}" status="${2:-1}"
  V4_ERROR="$message"
  if [ -n "${V4_ERROR_FILE:-}" ]; then printf '%s' "$message" > "$V4_ERROR_FILE"; fi
  printf 'ERROR: %s\n' "$message" >&2
  return "$status"
}

function v4Get() {
  local key="$1" fallback="${2:-}" request="${V4_REQUEST:-}"
  [ -n "$request" ] || request='{}'
  key=$(v4OptionKey "$key")
  jq -r --arg key "$key" --arg fallback "$fallback" '
    if has($key) and .[$key] != null then
      .[$key] | if type == "array" or type == "object" then tojson else tostring end
    else $fallback end' <<< "$request"
}

function v4Has() {
  local request="${V4_REQUEST:-}"
  [ -n "$request" ] || request='{}'
  jq -e --arg key "$(v4OptionKey "$1")" 'has($key) and .[$key] != null' <<< "$request" >/dev/null
}

function v4Require() {
  local key value missing=()
  for key in "$@"; do
    value=$(v4Get "$key") || return 2
    [ -n "$value" ] || missing+=("${key//_/-}")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    v4Error "Required options are missing: ${missing[*]}. Supply flags or a schema_version 1 JSON configuration." 2
    return 2
  fi
}

function v4Confirm() {
  if [ "$(v4Get yes false)" != true ]; then
    v4Error 'This operation changes existing data. Supply --yes after reviewing the target.' 2
    return 2
  fi
}

function v4Result() {
  local result="${1:-null}"
  jq -e -s 'length == 1' <<< "$result" >/dev/null 2>&1 || {
    v4Error 'The action produced an invalid structured result.' 1
    return 1
  }
  if [ -n "${V4_RESULT_FILE:-}" ]; then
    printf '%s\n' "$result" > "$V4_RESULT_FILE"
  else
    printf '%s\n' "$result"
  fi
}

# Fields are deliberately discoverable. Schema evolution requires a new version.
function v4RequestSchema() {
  cat <<'JSON'
