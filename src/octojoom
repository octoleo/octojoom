# Get a selected remote system
function getRemoteSystem() {
  # The selected folder
  local answer

  if [ -f "${VDM_HOME_PATH}/.ssh/config" ]; then
    # We start the selection array
    local selected=()
    # Our counter
    local i=0
    # Add the remote systems
    while IFS= read -r remote_system; do
      # Load the remote systems
      selected+=("${remote_system}" "${remote_system}" "OFF")
      # Increment our pointer
      if [ "$i" -le 10 ]; then
        i=$((i + 1))
      fi
    done < <(awk 'tolower($1) == "host" { for (i = 2; i <= NF && $i !~ /^#/; i++) if ($i !~ /[*!?]/) print $i }' \
      "${VDM_HOME_PATH}/.ssh/config" | sort -u)

    # Add manual input option
    selected+=("Enter manually" "Enter manually" "OFF")

    # now make the selection
    answer=$(whiptail --title "Remote Systems" --radiolist \
      "Select the remote system you would like to use." 20 112 $i \
      "${selected[@]}" --backtitle "${BACK_TITLE}" --notags 3>&1 1>&2 2>&3)

    if [[ $answer == "Enter manually" ]]; then
      answer=$(getInputNow "Enter the remote host manually:" "" "Remote Host")
    fi
  else
    answer=$(getInputNow "Enter the remote host:" "" "Remote Host")
  fi

  # Return the answer
  echo "${answer:-none_selected}"
}

# get a selected migration type
function getMigrationType() {
  # the selected folder
  local answer
  # we start the selection array
  local selected=()
  # our counter
  local i=2
  # now check if this dir has sub dirs
  selected+=("push" "Push to Remote System" "ON")
  selected+=("pull" "Pull from Remote System" "OFF")
  # now make the selection
  answer=$(whiptail --title "Migration Type" --radiolist \
    "What kind of migration will be preformed?" 20 112 $i \
    "${selected[@]}" --backtitle "${BACK_TITLE}" --nocancel --notags 3>&1 1>&2 2>&3)
  # return the answer
  echo "${answer:-push}"
}

# Check if the remote .env file exists using the remote user's home directory
function remoteEnvFileExists() {
  local remote_system="$1"

  # Expand HOME on the remote host, never on the local machine.
  ssh -- "${remote_system}" '[ -f "$HOME/.config/octojoom/.env" ]'
}

# Quote one argument for the remote POSIX shell (including embedded apostrophes).
function quoteRemoteArgument() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

# Migration destinations must name a directory below an absolute base path.
function isSafeMigrationPath() {
  local path="$1"
  [[ "${path}" == /* && "${path}" != / && "${path}" != *$'\n'* ]] || return 1
  case "/${path#/}/" in
  *'/../'* | *'/./'* | *'//'*) return 1 ;;
  esac
}

# Get a specific value from the remote .env file using the remote user's home directory
function getRemoteEnvValue() {
  local remote_system="$1"
  local env_key="$2"
  local remote_env_value

  if [[ ! "${env_key}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] ||
    ! remoteEnvFileExists "${remote_system}" ||
    ! remote_env_value=$(ssh -- "${remote_system}" "grep \"^${env_key}=\" \"\$HOME/.config/octojoom/.env\""); then
    printf '%s\n' none_found
    return 1
  fi
  # Match local dotenv loading: the last assignment wins, and values are data.
  remote_env_value="${remote_env_value##*$'\n'}"
  if ! decodeEnvValue "${remote_env_value#*=}" remote_env_value || [ -z "${remote_env_value}" ]; then
    printf '%s\n' none_found
    return 1
  fi
  printf '%s\n' "${remote_env_value}"
}

# Pull the remote container migration
function pullContainerMigration() {
  # set some local variables
  local local_path="$1"
  local container_path="$2"
  local remote="$3"
  local remote_repo_path

  if ! remote_repo_path=$(getRemoteEnvValue "${remote}" "VDM_REPO_PATH") ||
    [ "${remote_repo_path}" = none_found ]; then
    showError "Remote system does not appear to have ${PROGRAM_NAME} installed, or your access was denied. Therefore the migration has been cancelled!"
    return 1
  fi
  pullRemoteFolder "${local_path}" "${remote_repo_path%/}/${container_path}" "${remote}"
}

# Push the remote container migration
function pushContainerMigration() {
  # set some local variables
  local local_path="$1"
  local container_path="$2"
  local remote="$3"
  local remote_repo_path

  if ! remote_repo_path=$(getRemoteEnvValue "${remote}" "VDM_REPO_PATH") ||
    [ "${remote_repo_path}" = none_found ]; then
    showError "Remote system does not appear to have ${PROGRAM_NAME} installed, or your access was denied. Therefore the migration has been cancelled!"
    return 1
  fi
  local remote_path="${remote_repo_path%/}/${container_path}" tar_path
  if ! [ -d "${local_path}" ] || ! isSafeMigrationPath "${remote_path}"; then
    showError "Migration failed: the source directory or remote destination is invalid."
    return 1
  fi
  if ! tar_path=$(tarAndMoveTempBackup "${local_path}" "${local_path}"); then
    showError "The PUSH failed while creating the container archive."
    return 1
  fi
  pushArchivedMigration "${tar_path}" "${remote_path}" "${remote}" || return 1
  showNotice "The PUSH of ${local_path} to ${remote}:${remote_path} was a success." 13
  return 0
}

# Pull the remote directory migration
function pullDirectoryMigration() {
  # set some local variables
  local local_path="$1"
  local directory_name="$2"
  local remote="$3"
  local remote_project_path

  if ! remote_project_path=$(getRemoteEnvValue "${remote}" "VDM_PROJECT_PATH") ||
    [ "${remote_project_path}" = none_found ]; then
    showError "Remote system does not appear to have ${PROGRAM_NAME} installed, or your access was denied. Therefore the migration has been cancelled!"
    return 1
  fi
  pullRemoteFolder "${local_path}" "${remote_project_path%/}/${directory_name}" "${remote}"
}

# Package on the source host and verify the single downloaded archive before
# extracting or replacing any existing local data.
function pullRemoteFolder() {
  local local_path="$1" remote_path="$2" remote="$3"
  local staging_path workspace remote_workspace remote_tar backup_path keep_backup=false
  if ! isSafeMigrationPath "${local_path}" || ! isSafeMigrationPath "${remote_path}" ||
    [ -L "${local_path}" ] || ! remoteFolderExists "${remote_path}" "${remote}"; then
    showError "The PULL failed: the source directory is unavailable or a migration path is invalid."
    return 1
  fi
  if ! mkdir -p -- "$(dirname "${local_path}")" ||
    ! workspace=$(mktemp -d "${local_path}.migration.XXXXXX"); then
    showError "The PULL failed: could not create a local staging directory."
    return 1
  fi
  staging_path="${workspace}/payload"
  # The archive is created privately on the source, including when root access
  # is needed to read project files. Nothing is rsynced as a loose directory.
  if ! remote_workspace=$(ssh -- "${remote}" "umask 077;
    [ ! -L $(quoteRemoteArgument "${remote_path}") ] || exit 1;
    workspace=\$(mktemp -d \"\${TMPDIR:-/tmp}/octojoom-pull.XXXXXX\") || exit 1;
    trap 'rm -rf -- \"\$workspace\"' 0;
    if tar -czf \"\$workspace/archive.tar.gz\" -C $(quoteRemoteArgument "${remote_path}") . ||
      sudo -n tar -czf \"\$workspace/archive.tar.gz\" -C $(quoteRemoteArgument "${remote_path}") .; then
      printf '%s\\n' \"\$workspace\"; trap - 0;
    else exit 1; fi") || ! isSafeMigrationPath "${remote_workspace}" ||
    [[ ! "${remote_workspace##*/}" =~ ^octojoom-pull\.[[:alnum:]]{6}$ ]]; then
    rm -rf -- "${workspace}"
    showError "The PULL failed while packaging the remote source; the local directory was preserved."
    return 1
  fi
  remote_tar="${remote_workspace}/archive.tar.gz"
  if ! rsync -av --protect-args -- "${remote}:${remote_tar}" "${workspace}/archive.tar.gz" ||
    ! transferTarWasSuccessful "${workspace}/archive.tar.gz" "${remote_tar}" "${remote}" ||
    ! migrationValidateTar "${workspace}/archive.tar.gz" folder ||
    ! mkdir -- "${staging_path}" ||
    ! tar --no-same-owner -xzf "${workspace}/archive.tar.gz" -C "${staging_path}"; then
    removeRemoteFolder "${remote_workspace}" "${remote}" || true
    rm -rf -- "${workspace}" || sudo rm -rf -- "${workspace}"
    showError "The PULL of ${remote}:${remote_path} failed; the local directory was preserved."
    return 1
  fi
  if ! removeRemoteFolder "${remote_workspace}" "${remote}"; then
    rm -rf -- "${workspace}" || sudo rm -rf -- "${workspace}"
    showError "The PULL stopped because the remote temporary archive could not be removed: ${remote}:${remote_workspace}"
    return 1
  fi
  backup_path="${local_path}_backup_$(date +%Y%m%d%H%M%S)_${BASHPID}_${RANDOM}"
  if [ -e "${local_path}" ]; then
    if whiptail --yesno "${USER^}, would you like to retain a backup of the local directory?" \
      --title "Backup Local" --backtitle "${BACK_TITLE}" 15 112; then
      keep_backup=true
    fi
    if [ -e "${backup_path}" ] || ! mv -- "${local_path}" "${backup_path}"; then
      rm -rf -- "${workspace}" || sudo rm -rf -- "${workspace}"
      showError "The PULL failed: could not preserve the local directory."
      return 1
    fi
  fi
  if ! mv -- "${staging_path}" "${local_path}"; then
    if [ -e "${backup_path}" ] && ! mv -- "${backup_path}" "${local_path}"; then
      showError "The PULL publication and rollback failed. The original directory is retained at ${backup_path}."
    else
      showError "The PULL failed while publishing the verified directory."
    fi
    rm -rf -- "${workspace}" || sudo rm -rf -- "${workspace}"
    return 1
  fi
  rm -rf -- "${workspace}" || sudo rm -rf -- "${workspace}" || return 1
  if [ "${keep_backup}" = false ] && [ -e "${backup_path}" ] &&
    ! (rm -rf -- "${backup_path}" || sudo rm -rf -- "${backup_path}"); then
    showError "The PULL completed, but the previous directory could not be removed: ${backup_path}"
    return 1
  fi
  showNotice "The PULL of ${remote}:${remote_path} to ${local_path} was a success." 13
  return 0
}

# Transfer exactly one compressed archive into a private destination workspace.
# The source archive remains available for recovery until publication succeeds.
function pushArchivedMigration() {
  local tar_path="$1" remote_path="$2" remote="$3" workspace remote_tar staging_path
  if ! [ -f "${tar_path}" ] || ! isSafeMigrationPath "${remote_path}" ||
    ! migrationValidateTar "${tar_path}" folder; then
    showError "The PUSH failed: the archive contains an unsupported or unsafe entry. The local archive was retained at ${tar_path}."
    return 1
  fi
  if ! workspace=$(ssh -- "${remote}" "umask 077; mkdir -p -- $(quoteRemoteArgument "$(dirname "${remote_path}")") &&
    mktemp -d $(quoteRemoteArgument "${remote_path}.migration.XXXXXX")") ||
    ! isSafeMigrationPath "${workspace}" || [[ "${workspace}" != "${remote_path}.migration."* ]]; then
    showError "The PUSH failed while creating a private remote workspace. The local archive was retained at ${tar_path}."
    return 1
  fi
  remote_tar="${workspace}/archive.tar.gz"
  staging_path="${workspace}/payload"
  if ! moveTarToRemote "${tar_path}" "${remote_tar}" "${remote}" ||
    ! transferTarWasSuccessful "${tar_path}" "${remote_tar}" "${remote}" ||
    ! remoteUntarGz "${remote_tar}" "${staging_path}" "${remote}" ||
    ! publishRemoteMigration "${staging_path}" "${remote_path}" "${remote}"; then
    removeRemoteFolder "${workspace}" "${remote}" || true
    showError "The PUSH to ${remote}:${remote_path} failed. The local archive was retained at ${tar_path}."
    return 1
  fi
  if ! removeRemoteFolder "${workspace}" "${remote}" || ! rm -f -- "${tar_path}"; then
    showError "The PUSH completed, but temporary archive cleanup failed. Check ${remote}:${workspace} and ${tar_path}."
    return 1
  fi
}

# Publish a verified staging directory, retaining the original if the rename fails.
function publishRemoteMigration() {
  local staging_path="$1" remote_path="$2" remote="$3" keep_backup=false
  local quoted_staging quoted_path quoted_backup backup_path publish_status
  isSafeMigrationPath "${staging_path}" && isSafeMigrationPath "${remote_path}" || return 1
  if remoteFolderExists "${remote_path}" "${remote}" &&
    whiptail --yesno "${USER^}, would you like to backup the remote directory?" \
      --title "Backup Remote" --backtitle "${BACK_TITLE}" 15 112; then
    keep_backup=true
  fi
  backup_path="${remote_path}_backup_$(date +%Y%m%d%H%M%S)_${BASHPID}_${RANDOM}"
  quoted_staging=$(quoteRemoteArgument "${staging_path}")
  quoted_path=$(quoteRemoteArgument "${remote_path}")
  quoted_backup=$(quoteRemoteArgument "${backup_path}")
  if ssh -- "${remote}" "[ -d ${quoted_staging} ] && [ ! -e ${quoted_backup} ] || exit 20;
    if [ -e ${quoted_path} ]; then mv -- ${quoted_path} ${quoted_backup} || exit 20; fi;
    if mv -- ${quoted_staging} ${quoted_path}; then
      if [ '${keep_backup}' = false ] && [ -e ${quoted_backup} ]; then
        rm -rf -- ${quoted_backup} || sudo -n rm -rf -- ${quoted_backup} || exit 22;
      fi;
    else
      if [ -e ${quoted_backup} ]; then mv -- ${quoted_backup} ${quoted_path} || exit 23; fi;
      exit 21;
    fi"; then
    return 0
  else
    publish_status=$?
  fi
  case "${publish_status}" in
    22) showError "The verified migration was published, but the previous directory could not be removed: ${remote}:${backup_path}" ;;
    23) showError "Remote publication and rollback failed. The original directory is retained at ${remote}:${backup_path}." ;;
    255) showError "The SSH connection failed during publication. Check ${remote}:${remote_path} and the recovery backup ${backup_path} before retrying." ;;
  esac
  return 1
}

# Push the remote directory migration
function pushDirectoryMigration() {
  # set some local variables
  local local_path="$1"
  local directory_name="$2"
  local remote="$3"
  local remote_project_path

  if ! remote_project_path=$(getRemoteEnvValue "${remote}" "VDM_PROJECT_PATH") ||
    [ "${remote_project_path}" = none_found ]; then
    showError "Remote system does not appear to have ${PROGRAM_NAME} installed, or your access was denied. Therefore the migration has been cancelled!"
    return 1
  fi
  local backup_dir tar_path remote_path
  remote_path="${remote_project_path%/}/${directory_name}"
  if ! [ -d "${local_path}" ] || ! isSafeMigrationPath "${remote_path}"; then
    showError "Migration failed: the source directory or remote destination is invalid."
    return 1
  fi
  if ! backup_dir=$(createTempBackup "${local_path}"); then
    showError "The PUSH failed while creating a temporary backup."
    return 1
  fi
  if ! chownBackup "${backup_dir}" || ! tar_path=$(tarAndMoveTempBackup "${local_path}" "${backup_dir}"); then
    sudo rm -rf -- "${backup_dir}"
    showError "The PUSH failed while preparing the archive."
    return 1
  fi
  if ! (rm -rf -- "${backup_dir}" || sudo rm -rf -- "${backup_dir}"); then
    showError "The PUSH failed while removing the temporary copy. The local archive was retained at ${tar_path}."
    return 1
  fi
  pushArchivedMigration "${tar_path}" "${remote_path}" "${remote}" || return 1
  if whiptail --yesno "${USER^}, would you like to fix the permissions of this remote directory?\nWe will start ${PROGRAM_NAME} on the remote server; navigate to the fix, and exit when done." \
    --title "Permissions Fix" --backtitle "${BACK_TITLE}" 15 112; then
    connectToRemoteSystem "${remote}" || return 1
  fi
  showNotice "The PUSH of ${local_path} to ${remote}:${remote_path} was a success." 13
  return 0
}

# Create a temporary backup of the folder with root access
function createTempBackup() {
  local source_dir="$1"
  local backup_dir
  [ -d "${source_dir}" ] || return 1
  backup_dir=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-backup.XXXXXX") || return 1
  if ! sudo cp -a -- "${source_dir}/." "${backup_dir}/"; then
    sudo rm -rf -- "${backup_dir}"
    return 1
  fi
  printf '%s\n' "${backup_dir}"
}

# Create a private temporary tar.gz archive without overwriting an existing backup.
function tarAndMoveTempBackup() {
  local source_dir="$1"
  local backup_dir="$2"
  local tar_path
  [ -d "${source_dir}" ] && [ -d "${backup_dir}" ] || return 1
  tar_path=$(mktemp "${TMPDIR:-/tmp}/octojoom-archive.XXXXXX") || return 1
  if ! tar -czf "${tar_path}" -C "${backup_dir}" .; then
    rm -f -- "${tar_path}"
    return 1
  fi
  printf '%s\n' "${tar_path}"
}

# Change the ownership of the backup directory to the current user
function chownBackup() {
  local backup_dir="$1"
  sudo chown -R "$(id -u):$(id -g)" -- "${backup_dir}"
}

# Check if the folder exists on the remote server
function remoteFolderExists() {
  local remote_path="$1"
  local remote="$2"

  ssh -- "${remote}" "[ -d $(quoteRemoteArgument "${remote_path}") ]"
}

# run Octojoom on a remote system
function connectToRemoteSystem() {
  # set some local variables
  local remote_system="${1:-none_set}"
  # get remote system
  if [ "${remote_system}" == "none_set" ]; then
    remote_system=$(getRemoteSystem)
  fi
  # make sure we have a remote
  if [ ${#remote_system} -ge 2 ] && [ "${remote_system}" != "none_selected" ]; then
    showNotice "We will first validate that the remote system has ${PROGRAM_NAME,,} config settings in place!" 13
    if remoteEnvFileExists "${remote_system}"; then
      if (whiptail --yesno "${USER^} we found ${PROGRAM_NAME,,} config settings on the ${remote_system}. Please take note of the following important information.\n\nSince we will start ${PROGRAM_NAME,,} on ${remote_system} it will not look that different, seeing that it has the same user graphical interface. Yet, whatever changes you make on ${remote_system} WILL PERMINANTLY effect this remote system, and can not be undone!!!\n\nAre you ready to connect to ${remote_system}:${PROGRAM_NAME,,}?" \
        --title "Confirm ${remote_system} Connection" --backtitle "${BACK_TITLE}" 15 112); then
        showNotice "Connection to ${remote_system} will now be made!" 13
        if ! ssh -t -- "${remote_system}" "bash octojoom"; then
          showError "The connection or remote ${PROGRAM_NAME} session failed."
          return 1
        fi
        showNotice "You have been disconnected from ${remote_system}!" 13
        return 0
      else
        showNotice "The connection to ${remote_system} was cancelled!" 13
        return 1
      fi
    else
      showError "Remote system does not appear to have ${PROGRAM_NAME,,} installed, or your access was denied. Therefore the connection has been closed!"
      return 1
    fi
  fi
  showError "Connection to the remote system was cancelled since no remote system was selected."
  return 1
}

# Change the ownership of the remote folder to the current user
function chownRemoteFolder() {
  local remote_path="$1"
  local remote="$2"

  isSafeMigrationPath "${remote_path}" || return 1
  # Use the remote account's IDs, which need not match the local username.
  ssh -t -- "${remote}" "sudo chown -R \"\$(id -u):\$(id -g)\" -- $(quoteRemoteArgument "${remote_path}")"
}

# Check if the folder exists on the remote server, and if so, rename it for backup purposes
function backupRemoteFolder() {
  local remote_path="$1"
  local remote="$2"
  local backup_name quoted_path quoted_backup
  isSafeMigrationPath "${remote_path}" || return 1
  backup_name="${remote_path}_backup_$(date +%Y%m%d%H%M%S)_${BASHPID}_${RANDOM}"
  quoted_path=$(quoteRemoteArgument "${remote_path}")
  quoted_backup=$(quoteRemoteArgument "${backup_name}")
  ssh -- "${remote}" "[ -d ${quoted_path} ] && [ ! -e ${quoted_backup} ] && mv -- ${quoted_path} ${quoted_backup}"
}

# remove the remote folder
function removeRemoteFolder() {
  local remote_path="$1"
  local remote="$2"
  isSafeMigrationPath "${remote_path}" || return 1
  ssh -- "${remote}" "if [ -d $(quoteRemoteArgument "${remote_path}") ]; then \
    rm -rf -- $(quoteRemoteArgument "${remote_path}") || sudo -n rm -rf -- $(quoteRemoteArgument "${remote_path}"); fi"
}

# Prep remote folder
function prepRemoteFolder() {
  local remote_path="$1"
  local remote="$2"

  isSafeMigrationPath "${remote_path}" || return 1
  ssh -- "${remote}" "mkdir -p -- $(quoteRemoteArgument "${remote_path}")"
}

# Remotely extract a tar.gz file to a specified folder on the remote host
function remoteUntarGz() {
  local remote_file_path="$1"
  local remote_extract_path="$2"
  local remote="$3"

  isSafeMigrationPath "${remote_file_path}" && isSafeMigrationPath "${remote_extract_path}" || return 1
  local remote_script
  # Send the validator with the operation so legacy remote installations also
  # reject traversal, links and special entries before writing archive contents.
  remote_script="$(declare -f migrationValidateTar)
    migrationValidateTar $(quoteRemoteArgument "${remote_file_path}") folder &&
    [ ! -e $(quoteRemoteArgument "${remote_extract_path}") ] &&
    (umask 077; mkdir -- $(quoteRemoteArgument "${remote_extract_path}")) &&
    tar --no-same-owner -xzf $(quoteRemoteArgument "${remote_file_path}") -C $(quoteRemoteArgument "${remote_extract_path}") &&
    rm -f -- $(quoteRemoteArgument "${remote_file_path}")"
  ssh -- "${remote}" "bash -c $(quoteRemoteArgument "${remote_script}")"
}

# Transfer the folder to the remote server using rsync
function syncFolder() {
  local local_path="$1"
  local remote_path="$2"
  local remote="$3"
  rsync -avz --protect-args --delete -- "${local_path}/" "${remote}:${remote_path}/"
}

# Move/copy the local tar file to the remote server
function moveTarToRemote() {
  local local_path="$1"
  local remote_path="$2"
  local remote="$3"

  # rsync protects remote paths with spaces and quotes on all supported SSH versions.
  [ -f "${local_path}" ] || return 1
  rsync -av --protect-args -- "${local_path}" "${remote}:${remote_path}"
}

# Sync the local folder to the remote server and remove the local backup
function syncWithRemote() {
  local local_path="$1"
  local remote_path="$2"
  local remote="$3"

  prepRemoteFolder "${remote_path}" "${remote}" || return 1

  syncFolder "${local_path}" "${remote_path}" "${remote}"
}

# Check if the transfer was successful by comparing local and remote directory contents
function transferWasSuccessful() {
  local local_path="$1"
  local remote_path="$2"
  local remote="$3"

  local rsync_output
  # Quiet itemized output includes changed files, metadata, and deletions.
  rsync_output=$(rsync -az --protect-args --dry-run --checksum --delete --itemize-changes \
    --out-format='%i %n%L' -- "${local_path}/" "${remote}:${remote_path}/") || return 1
  [ -z "${rsync_output}" ]
}

# Check if the transfer was successful by comparing local and remote zip file checksums
function transferTarWasSuccessful() {
  local local_path="$1"
  local remote_path="$2"
  local remote="$3"

  local local_checksum remote_checksum quoted_path
  [ -f "${local_path}" ] || return 1
  if command -v sha256sum >/dev/null 2>&1; then
    local_checksum=$(sha256sum -- "${local_path}") || return 1
  else
    local_checksum=$(shasum -a 256 -- "${local_path}") || return 1
  fi
  quoted_path=$(quoteRemoteArgument "${remote_path}")
  remote_checksum=$(ssh -- "${remote}" "if command -v sha256sum >/dev/null 2>&1; then \
    sha256sum -- ${quoted_path}; else shasum -a 256 -- ${quoted_path}; fi") || return 1
  local_checksum="${local_checksum%% *}"
  remote_checksum="${remote_checksum%% *}"
  [[ "${local_checksum}" =~ ^[[:xdigit:]]{64}$ && "${remote_checksum}" =~ ^[[:xdigit:]]{64}$ &&
    "${local_checksum}" = "${remote_checksum}" ]]
}

