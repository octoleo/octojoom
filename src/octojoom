  unset VDM_J_SITE_NAME
  unset VDM_J_USERNAME
  unset VDM_J_USER
  unset VDM_J_EMAIL
  unset VDM_J_PASSWORD
  unset VDM_J_EXTENSIONS_URLS
  unset VDM_J_CLI_COMMANDS
  # container lower
  unset vdm_database_name
  unset vdm_database_user
  unset vdm_database_pass
  unset vdm_database_rootpass
  # return a success
  return 0
  )
}

# return the Joomla Container setup yml
function joomlaContainer() {

  vdm_container_user=''
  if [ -n "${VDM_PUID}" ] && [ -n "${VDM_PGID}" ]; then
    vdm_container_user="
      - APACHE_RUN_USER=\${VDM_${VDM_ENV_KEY^^}_PUID}
      - APACHE_RUN_GROUP=\${VDM_${VDM_ENV_KEY^^}_PGID}"
  fi

  local web_health web_labels database_environment database_health database_image database_joomla_type=''
  database_image="${VDM_DB_IMAGE:-mariadb:latest}"
  if [ "${VDM_DB_IMAGE+x}" = x ]; then database_image="\${VDM_${VDM_ENV_KEY^^}_DB_IMAGE}"; fi
  case "${VDM_DB_ENGINE:-mariadb}" in
    postgres)
      database_environment=$(getYMLine3 "- POSTGRES_DB=\${VDM_${VDM_ENV_KEY^^}_DB}")
      database_environment+=$(getYMLine3 "- POSTGRES_USER=\${VDM_${VDM_ENV_KEY^^}_DB_USER}")
      database_environment+=$(getYMLine3 "- POSTGRES_PASSWORD=\${VDM_${VDM_ENV_KEY^^}_DB_PASS}")
      # shellcheck disable=SC2016 # Compose escapes defer expansion to the container.
      database_health='["CMD-SHELL", "pg_isready -h 127.0.0.1 -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]'
      database_joomla_type=$(getYMLine3 '- JOOMLA_DB_TYPE=pgsql')
      ;;
    mysql)
      database_environment=$(getYMLine3 "- MYSQL_DATABASE=\${VDM_${VDM_ENV_KEY^^}_DB}")
      database_environment+=$(getYMLine3 "- MYSQL_USER=\${VDM_${VDM_ENV_KEY^^}_DB_USER}")
      database_environment+=$(getYMLine3 "- MYSQL_PASSWORD=\${VDM_${VDM_ENV_KEY^^}_DB_PASS}")
      database_environment+=$(getYMLine3 "- MYSQL_ROOT_PASSWORD=\${VDM_${VDM_ENV_KEY^^}_DB_ROOT}")
      # shellcheck disable=SC2016
      database_health='["CMD-SHELL", "MYSQL_PWD=\"$$MYSQL_PASSWORD\" mysql --protocol=tcp --host=127.0.0.1 --user=\"$$MYSQL_USER\" --database=\"$$MYSQL_DATABASE\" --execute=\"SELECT 1\" --silent"]'
      ;;
    *)
      database_environment=$(getYMLine3 "- MARIADB_DATABASE=\${VDM_${VDM_ENV_KEY^^}_DB}")
      database_environment+=$(getYMLine3 "- MARIADB_USER=\${VDM_${VDM_ENV_KEY^^}_DB_USER}")
      database_environment+=$(getYMLine3 "- MARIADB_PASSWORD=\${VDM_${VDM_ENV_KEY^^}_DB_PASS}")
      database_environment+=$(getYMLine3 "- MARIADB_ROOT_PASSWORD=\${VDM_${VDM_ENV_KEY^^}_DB_ROOT}")
      database_health='["CMD-SHELL", "mariadb-admin ping --silent"]'
      ;;
  esac
  web_health='["CMD", "curl", "-f", "http://localhost/"]'
  web_health="${VDM_WEB_HEALTH:-$web_health}"
  web_labels=$(getYMLine3 '- "traefik.enable=true"')
  web_labels+=$(getYMLine3 "- \"traefik.http.routers.joomla${VDM_KEY}.rule=Host(\`${VDM_SUBDOMAIN}.${VDM_DOMAIN}\`)\"")
  web_labels+="${VDM_JOOMLA_SECURE_LABELS}"
  web_labels="${VDM_WEB_LABELS:-$web_labels}"

  cat <<EOF
services:
  mariadb${VDM_KEY}:
    image: ${database_image}
    container_name: mariadb${VDM_KEY}
    restart: unless-stopped

    environment:${database_environment}

    volumes:${VDM_DB_VOLUMES_MOUNT}

    networks:
      - traefik

    healthcheck:
      test: ${database_health}
      interval: 20s
      timeout: 5s
      retries: 5

  joomla${VDM_KEY}:
    image: ${VDM_J_REPO}:${VDM_JV}
    container_name: joomla${VDM_KEY}
    restart: unless-stopped${VDM_WEB_WORKING_DIR:-}

    # Internal service port; FPM is never published to the host.
    expose:
      - "${VDM_WEB_EXPOSE:-80}"

    environment:${vdm_container_user}${database_joomla_type}
      - JOOMLA_DB_HOST=mariadb${VDM_KEY}:${VDM_DATABASE_PORT:-3306}
      - JOOMLA_DB_NAME=\${VDM_${VDM_ENV_KEY^^}_DB}
      - JOOMLA_DB_USER=\${VDM_${VDM_ENV_KEY^^}_DB_USER}
      - JOOMLA_DB_PASSWORD=\${VDM_${VDM_ENV_KEY^^}_DB_PASS}${VDM_EXTRA_JOOMLA_ENV}

    depends_on:
      mariadb${VDM_KEY}:
        condition: service_healthy

    volumes:${VDM_JOOMLA_VOLUMES_MOUNT}

    networks:
      - traefik

     # Easy basic limits
#    deploy:
#      resources:
#        limits:
#          cpus: '1.5'
#          memory: 2G
#        reservations:
#          memory: 512M

    healthcheck:
      test: ${web_health}
      interval: 30s
      timeout: 5s
      retries: 5

    labels:${web_labels}${VDM_WEB_SERVICE:-}
EOF
  if [ "${VDM_PHPMYADMIN:-true}" = true ] && [ "${VDM_DB_ENGINE:-mariadb}" != postgres ]; then
    cat <<EOF

  phpmyadmin${VDM_KEY}:
    image: phpmyadmin/phpmyadmin
    container_name: phpmyadmin${VDM_KEY}
    restart: unless-stopped

    # Implicit internal Traefik only.
    expose:
      - "80"

    environment:
      PMA_HOST: mariadb${VDM_KEY}
      PMA_PORT: 3306
      UPLOAD_LIMIT: 300M

    depends_on:
      mariadb${VDM_KEY}:
        condition: service_healthy

    networks:
      - traefik

    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.phpmyadmin${VDM_KEY}.rule=Host(\`${VDM_SUBDOMAIN}db.${VDM_DOMAIN}\`)"${VDM_PHPMYADMIN_SECURE_LABELS}
EOF
  fi
  cat <<EOF
${VDM_EXTRA_CONTAINER_STUFF}

networks:
  traefik:
    external: true
    name: ${VDM_TRAEFIK_GATEWAY:-traefik_webgateway}

${VDM_VOLUMES}

EOF
}

# Webserver changes edit the block style emitted by Octojoom. These readers
# deliberately reject aliases/flow service definitions; they are not YAML parsers.
function joomlaServiceBlock() {
  local file="$1" service="$2"
  [[ "$service" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || return 1
  awk -v service="$service" '
    /^services:[[:space:]]*$/ {services=1; next}
    /^[^[:space:]#][^:]*:/ {services=0; active=0}
    services && /^  [^[:space:]#][^:]*:/ {
      active=($0 == "  " service ":")
      if(active) found++
    }
    active {print; if($0 ~ /\t|[[:space:]][&*][A-Za-z]|^[[:space:]]*<<:/) unsafe=1}
    END {if(found!=1 || unsafe) exit 1}
  ' "$file"
}

# Read one direct service property, retaining its comments and nested content.
function joomlaServiceProperty() {
  local file="$1" service="$2" property="$3" block
  block=$(joomlaServiceBlock "$file" "$service") || return 1
  printf '%s\n' "$block" | awk -v property="$property" '
    /^    [A-Za-z_][A-Za-z0-9_-]*:/ {
      name=$0; sub(/^    /,"",name); sub(/:.*/,"",name)
      active=(name==property); if(active) found++
    }
    active {print}
    END {if(found>1) exit 1}
  '
}

# Replace/add/remove one direct property, leaving other service text untouched.
# An empty replacement removes the property. SOURCE and DEST must differ.
function joomlaSetServiceProperty() {
  local source="$1" destination="$2" service="$3" property="$4" replacement="$5" block
  [ "$source" != "$destination" ] && [ ! "$source" -ef "$destination" ] || return 1
  block=$(joomlaServiceBlock "$source" "$service") || return 1
  [ -n "$block" ] || return 1
  awk -v service="$service" -v property="$property" -v replacement="$replacement" '
    function emit( line) {
      while((getline line < replacement)>0) print line
      close(replacement); emitted=1
    }
    function finish() {if(active && !emitted) emit(); active=0; skip=0}
    /^services:[[:space:]]*$/ {services=1}
    /^[^[:space:]#][^:]*:/ && !/^services:/ {finish(); services=0}
    services && /^  [^[:space:]#][^:]*:/ {
      finish(); active=($0=="  " service ":"); if(active) found++
    }
    active && /^    [A-Za-z_][A-Za-z0-9_-]*:/ {
      name=$0; sub(/^    /,"",name); sub(/:.*/,"",name)
      skip=(name==property)
      if(skip) {count++; if(!emitted) emit()}
    }
    !skip {print}
    END {finish(); if(found!=1 || count>1) exit 1}
  ' "$source" > "$destination"
}

# Replace a complete service block or insert a new one at the end of services.
function joomlaSetServiceBlock() {
  local source="$1" destination="$2" service="$3" replacement="$4"
  [ "$source" != "$destination" ] && [ ! "$source" -ef "$destination" ] || return 1
  awk -v service="$service" -v replacement="$replacement" '
    function emit( line) {
      while((getline line < replacement)>0) print line
      close(replacement); emitted=1
    }
    /^services:[[:space:]]*$/ {services=1; section++}
    /^[^[:space:]#][^:]*:/ && !/^services:/ {
      if(services && !emitted) emit()
      services=0; skip=0
    }
    services && /^  [^[:space:]#][^:]*:/ {
      skip=($0=="  " service ":")
      if(skip) {count++; if(!emitted) emit()}
    }
    !skip {print}
    END {if(services && !emitted) emit(); if(section!=1 || count>1) exit 1}
  ' "$source" > "$destination"
}

# Root paths are deliberately project-relative and cannot escape the data mount.
function joomlaValidateDocumentRoot() {
  local root="${1:-.}" part
  [ "$root" = . ] && return 0
  [[ "$root" != /* && "$root" != */ && "$root" != *'//'*
    && "$root" =~ ^[A-Za-z0-9_./-]+$ ]] || return 1
  local -a parts=()
  IFS=/ read -r -a parts <<< "$root"
  for part in "${parts[@]}"; do
    [[ "$part" != . && "$part" != .. && -n "$part" ]] || return 1
  done
}

function getJoomlaDocumentRoot() {
  (
    readJoomlaSiteFacts "$1" || exit 1
    [ -n "${VDM_SITE_DOCROOT:-}" ] || exit 1
    printf '%s\n' "$VDM_SITE_DOCROOT"
  )
}

# Keep PHP handling separate from SEF routing: a missing .php file must return
# 404, and /api/ requests must use Joomla's API front controller.
function joomlaNginxConfiguration() {
  local service="$1" root="$2"
  [[ "$service" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ && "$root" =~ ^/[A-Za-z0-9_./-]+$ ]] || return 1
  cat <<EOF_NGINX
# Octojoom Joomla webserver. Editable; preserve the root and FPM service together.
server {
    listen 80;
    server_name _;
    root ${root};
    index index.php index.html;
    client_max_body_size 256m;

    location = /__octojoom_health { access_log off; return 204; }
    location ~ /\\. { deny all; }
    location ~* (configuration\\.php|\\.(ini|log|sql|bak|dist|sh)|composer\\.(json|lock))$ { deny all; }
    location / { try_files \$uri \$uri/ /index.php?\$query_string; }
    location /administrator/ { try_files \$uri \$uri/ /administrator/index.php?\$query_string; }
    location /api/ { try_files \$uri \$uri/ /api/index.php?\$query_string; }
    location ~ \\.php(?:/|$) {
        fastcgi_split_path_info ^(.+?\\.php)(/.*)$;
        set \$joomla_path_info \$fastcgi_path_info;
        try_files \$fastcgi_script_name =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        fastcgi_param PATH_INFO \$joomla_path_info;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass ${service}:9000;
    }
 }
EOF_NGINX
}

function joomlaApacheConfiguration() {
  local root="$1"
  [[ "$root" =~ ^/[A-Za-z0-9_./-]+$ ]] || return 1
  cat <<EOF_APACHE
# Octojoom Joomla document root. Other Apache configuration stays in the image.
<VirtualHost *:80>
    DocumentRoot "${root}"
    <Directory "${root}">
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    ErrorLog /proc/self/fd/2
    CustomLog /proc/self/fd/1 combined
</VirtualHost>
EOF_APACHE
}

# Keep custom Apache directives when updating the two paths we generated.
# Unrecognized vhosts must be edited explicitly rather than overwritten.
function joomlaStageApacheConfiguration() {
  local source="$1" destination="$2" root="$3"
  [[ "$root" =~ ^/[A-Za-z0-9_./-]+$ ]] || return 1
  if [ ! -e "$source" ] && [ ! -L "$source" ]; then
    joomlaApacheConfiguration "$root" > "$destination"
    return $?
  fi
  if [ ! -f "$source" ] || [ -L "$source" ] || ! grep -qF '# Octojoom Joomla document root.' "$source"; then
    printf 'Custom Apache configuration must have its DocumentRoot and Directory paths edited explicitly.\n' >&2
    return 1
  fi
  awk -v root="$root" '
    FNR==NR {
      if(tolower($0) ~ /^[[:space:]]*documentroot[[:space:]]+/) {
        count++
        if($0 !~ /^[[:space:]]*DocumentRoot "\/[^"]+"[[:space:]]*$/) invalid=1
        old=$0; sub(/^[[:space:]]*DocumentRoot "/,"",old); sub(/"[[:space:]]*$/,"",old)
      }
      next
    }
    FNR==1 {if(count!=1 || invalid) exit 1}
    /^[[:space:]]*DocumentRoot / {
      at=index($0,old); print substr($0,1,at-1) root substr($0,at+length(old)); next
    }
    /^[[:space:]]*<Directory "[^"]+">[[:space:]]*$/ {
      path=$0; sub(/^[[:space:]]*<Directory "/,"",path); sub(/">[[:space:]]*$/,"",path)
      if(path==old) {
        directories++; at=index($0,old)
        print substr($0,1,at-1) root substr($0,at+length(old)); next
      }
    }
    {print}
    END {if(count!=1 || invalid || directories!=1) exit 1}
  ' "$source" "$source" > "$destination" || {
    printf 'Apache configuration has ambiguous document-root directives; edit its paths explicitly.\n' >&2
    return 1
  }
}

# Add/replace only Octojoom's own companion mount. User mounts at that target
# must be handled explicitly rather than silently overwritten.
function joomlaWebCompanionMount() {
  local source="$1" destination="$2" service="$3" filename="$4" target="$5" directory="$6"
  local property="$directory/mounts" line filtered="$directory/mounts.next"
  joomlaServiceProperty "$source" "$service" volumes > "$property" || return 1
  [ -s "$property" ] || printf '    volumes:\n' > "$property"
  : > "$filtered"
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" == *":${target}"* || "$line" == *"target: ${target}"* ]]; then
      [[ "$line" == *"./${filename}:${target}:ro"* ]] || {
        printf 'A custom mount already controls %s; edit that configuration explicitly.\n' "$target" >&2
        return 1
      }
    else
      printf '%s\n' "$line" >> "$filtered"
    fi
  done < "$property"
  printf '      - "./%s:%s:ro"\n' "$filename" "$target" >> "$filtered"
  joomlaSetServiceProperty "$source" "$destination" "$service" volumes "$filtered"
}

# Split ordinary list-style labels without moving application/tooling metadata
# from the PHP service to Nginx. Unfamiliar label syntax is operation-specific.
function joomlaWebRouteLabels() {
  local source="$1" service="$2" routes="$3" retained="$4" line found=false route_found=false
  local block
  block=$(joomlaServiceProperty "$source" "$service" labels) || return 1
  : > "$routes"; : > "$retained"
  [ -n "$block" ] || return 0
  printf '    labels:\n' > "$routes"
  printf '    labels:\n' > "$retained"
  while IFS= read -r line; do
    [[ "$line" = '    labels:' || "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ "$line" =~ ^[[:space:]]+-[[:space:]]+ ]] || {
      printf 'Webserver switching currently requires list-style labels; convert only this property before retrying.\n' >&2
      return 1
    }
    if [[ "$line" = *traefik.* ]]; then
      printf '%s\n' "$line" >> "$routes"; route_found=true
    else
      printf '%s\n' "$line" >> "$retained"; found=true
    fi
  done <<< "$block"
  "$found" || : > "$retained"
  "$route_found" || : > "$routes"
}

# Convert only recognized service structure, preserving the original image's
# environment, entrypoint, commands, mounts, resources and unrelated services.
# Traffic-bearing properties move to HTTP Nginx; FPM never inherits host ports.
function joomlaRewriteWebserverCompose() {
  local source="$1" destination="$2" service="$3" nginx="$4" flavor="$5" image="$6" nginx_image="$7" work="$8"
  local current="$work/compose.current" next="$work/compose.next" property web="$work/nginx-service" mount="$work/web-mount"
  [[ "$flavor" == apache || "$flavor" == nginx ]] || return 1
  [[ "$image" =~ ^[A-Za-z0-9][A-Za-z0-9./:@_-]+$ && "$nginx_image" =~ ^[A-Za-z0-9][A-Za-z0-9./:@_-]+$ ]] || return 1
  cp "$source" "$current" || return 1
  joomlaServiceBlock "$current" "$service" > "$work/php-service" || {
    printf 'Webserver changes require a block-style web service without YAML anchors.\n' >&2; return 1;
  }
  local command_value
  command_value=$(joomlaServiceProperty "$current" "$service" command) || return 1
  if [ -n "$command_value" ]; then
    case "$command_value" in
      '    command: ["apache2-foreground"]'|'    command: apache2-foreground'|'    command: ["php-fpm"]'|'    command: php-fpm')
        if [ "$flavor" = nginx ]; then
          printf '    command: ["php-fpm"]\n' > "$work/property"
        else
          printf '    command: ["apache2-foreground"]\n' > "$work/property"
        fi
        joomlaSetServiceProperty "$current" "$next" "$service" command "$work/property" && mv "$next" "$current" || return 1
        ;;
      *) printf 'The web service has a custom command; adapt it explicitly for the selected Apache/FPM image before switching.\n' >&2; return 2 ;;
    esac
  fi
  printf '    image: %s\n' "$image" > "$work/property"
  joomlaSetServiceProperty "$current" "$next" "$service" image "$work/property" && mv "$next" "$current" || return 1
  if [ "$flavor" = nginx ]; then
    # Keep the original HTTP healthcheck available for the return to Apache.
    joomlaServiceProperty "$source" "$service" healthcheck > "$work/apache-healthcheck.yml" || return 1
    # A pre-existing service with this name is user configuration, unless it was
    # generated by this operation (repeat setting the same flavor is a no-op).
    if joomlaServiceBlock "$current" "$nginx" >/dev/null 2>&1; then
      printf 'The service %s already exists; refusing to replace it.\n' "$nginx" >&2; return 1
    fi
    joomlaServiceProperty "$current" "$service" volumes > "$work/volumes" || return 1
    # Root short syntax is intentionally bounded; spaces in quoted bind paths work.
    # Long-syntax mounts are supported through their semantic facts below.
    if command -v jq >/dev/null 2>&1 && [ -n "${VDM_SITE_MOUNT_TYPE:-}" ] && [ -n "${VDM_SITE_MOUNT_SOURCE:-}" ]; then
      printf '      - type: %s\n        source: %s\n        target: %s\n        read_only: true\n' \
        "$VDM_SITE_MOUNT_TYPE" "$(printf '%s' "$VDM_SITE_MOUNT_SOURCE" | jq -Rs .)" \
        "$(printf '%s' "$VDM_SITE_MOUNT_TARGET" | jq -Rs .)" > "$mount"
    else
      awk '
        /^[[:space:]]*-/ && /:\/var\/www\/html(:[a-z,]+)?"?[[:space:]]*$/ {
          line=$0; sub(/:[a-z,]+"?[[:space:]]*$/,"\"",line)
          sub(/"?[[:space:]]*$/,"",line); sub(/^[[:space:]]*-[[:space:]]*"?/,"",line)
          print "      - \"" line ":ro\""; found++
        }
        END {if(found!=1) exit 1}
      ' "$work/volumes" > "$mount" || {
        printf 'Cannot resolve the website mount for Nginx; inspect its Compose volume.\n' >&2; return 1;
      }
    fi
    joomlaWebRouteLabels "$current" "$service" "$work/route-labels" "$work/retained-labels" || return 1
    {
      printf '  %s:\n    # Octojoom managed HTTP companion\n    image: %s\n    restart: unless-stopped\n' "$nginx" "$nginx_image"
      printf '    depends_on:\n      %s:\n        condition: service_healthy\n' "$service"
      printf '    volumes:\n'; cat "$mount"
      printf '      - "./nginx.conf:/etc/nginx/conf.d/default.conf:ro"\n'
      for property in networks ports expose; do
        joomlaServiceProperty "$current" "$service" "$property" || return 1
      done
      cat "$work/route-labels"
      printf '    healthcheck:\n      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1/__octojoom_health"]\n      interval: 10s\n      timeout: 5s\n      retries: 12\n'
    } > "$web" || return 1
    [ -s "$work/retained-labels" ] || printf '    labels:\n' > "$work/retained-labels"
    printf '      - "traefik.enable=false"\n' >> "$work/retained-labels"
    joomlaSetServiceProperty "$current" "$next" "$service" labels "$work/retained-labels" && mv "$next" "$current" || return 1
    for property in ports expose; do
      : > "$work/property"
      joomlaSetServiceProperty "$current" "$next" "$service" "$property" "$work/property" && mv "$next" "$current" || return 1
    done
    cat > "$work/property" <<'FPM_HEALTH'
    healthcheck:
      test: ["CMD", "php", "-r", "exit(@fsockopen('127.0.0.1', 9000) ? 0 : 1);"]
      interval: 10s
      timeout: 5s
      retries: 12
FPM_HEALTH
    joomlaSetServiceProperty "$current" "$next" "$service" healthcheck "$work/property" && mv "$next" "$current" || return 1
    joomlaSetServiceBlock "$current" "$next" "$nginx" "$web" && mv "$next" "$current" || return 1
  else
    joomlaServiceBlock "$current" "$nginx" > "$web" || return 1
    grep -qF '# Octojoom managed HTTP companion' "$web" || {
      printf 'This Nginx service was configured manually; retain it and edit its routing explicitly.\n' >&2; return 1;
    }
    joomlaWebRouteLabels "$current" "$nginx" "$work/route-labels" "$work/nginx-extra-labels" || return 1
    [ ! -s "$work/nginx-extra-labels" ] || {
      printf 'The Nginx companion has custom non-routing labels; retain those explicitly before removing it.\n' >&2; return 1;
    }
    joomlaWebRouteLabels "$current" "$service" "$work/disabled-labels" "$work/php-labels" || return 1
    if [ -s "$work/php-labels" ]; then
      tail -n +2 "$work/route-labels" >> "$work/php-labels"
    else
      cp "$work/route-labels" "$work/php-labels" || return 1
    fi
    joomlaSetServiceProperty "$current" "$next" "$service" labels "$work/php-labels" && mv "$next" "$current" || return 1
    for property in ports expose; do
      joomlaServiceProperty "$current" "$nginx" "$property" > "$work/property" || return 1
      joomlaSetServiceProperty "$current" "$next" "$service" "$property" "$work/property" && mv "$next" "$current" || return 1
    done
    if [ -f "$work/restore-healthcheck.yml" ]; then
      cp "$work/restore-healthcheck.yml" "$work/property" || return 1
    else
      cat > "$work/property" <<'APACHE_HEALTH'
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/"]
      interval: 30s
      timeout: 5s
      retries: 5
APACHE_HEALTH
    fi
    joomlaSetServiceProperty "$current" "$next" "$service" healthcheck "$work/property" && mv "$next" "$current" || return 1
    : > "$web"
    joomlaSetServiceBlock "$current" "$next" "$nginx" "$web" && mv "$next" "$current" || return 1
  fi
  cp "$current" "$destination"
}

# Compose reports native Windows host paths while Git Bash settings may use
# /c/... paths. Normalize host paths only; container paths stay literal Linux.
function joomlaWebHostPath() {
  if [ "${OS_NUMBER:-0}" = 3 ] && command -v cygpath >/dev/null 2>&1; then
    cygpath -am -- "$1"
  else
    printf '%s\n' "$1"
  fi
}

# Validate stopped-site configuration without activating its Compose project.
# Use the actual candidate image, environment and mounts, replacing companions
# with their staged files. Every existing mount is read-only; temporary runtime
# directories are private tmpfs. This is syntax validation, not a route probe.
function joomlaValidateStagedWebConfiguration() {
  local compose="$1" env_file="$2" directory="$3" service="$4" flavor="$5"
  local model selected image mount type source target index value companion_target
  command -v jq >/dev/null 2>&1 || return 1
  model=$(migrationRunCompose "$env_file" "$compose" --project-directory "$directory" config --format json) || return 1
  selected=$(printf '%s' "$model" | jq -ec --arg service "$service" '.services[$service]') || return 1
  image=$(printf '%s' "$selected" | jq -er '.image') || return 1
  if ! printf '%s' "$selected" | jq -e '((.configs // [])|length)==0 and ((.secrets // [])|length)==0' >/dev/null; then
    printf 'Stopped-site syntax validation requires explicit file mounts for webserver configs and secrets.\n' >&2
    return 1
  fi
  local -a args=(run --rm --network none --read-only --tmpfs '/tmp:rw,nosuid,noexec' --tmpfs '/var/run:rw,nosuid,noexec' --tmpfs '/var/cache/nginx:rw,nosuid,noexec' )
  value=$(printf '%s' "$selected" | jq -r '.user // empty') || return 1
  [ -z "$value" ] || args+=(--user "$value")
  while IFS= read -r -d '' value; do args+=(--env "$value"); done < <(
    printf '%s' "$selected" | jq -j '.environment // {} | to_entries[] | select(.value != null) | .key + "=" + (.value|tostring) + "\u0000"'
  )
  while IFS= read -r mount; do
    type=$(printf '%s' "$mount" | jq -r '.type') || return 1
    source=$(printf '%s' "$mount" | jq -r '.source // empty') || return 1
    target=$(printf '%s' "$mount" | jq -er '.target') || return 1
    case "$type" in
      bind)
        source=$(joomlaWebHostPath "$source") || return 1
        for ((index=0; index<${#OCTOJOOM_SITE_FILE_TARGETS[@]}; index++)); do
          companion_target=$(joomlaWebHostPath "${OCTOJOOM_SITE_FILE_TARGETS[$index]}") || return 1
          [ "$source" != "$companion_target" ] || source=$(joomlaWebHostPath "${OCTOJOOM_SITE_FILE_SOURCES[$index]}") || return 1
        done
        [ -e "$source" ] || { printf 'A required webserver mount does not exist: %s\n' "$source" >&2; return 1; }
        ;;
      volume)
        if [ -z "$source" ] || ! printf '%s' "$mount" | jq -e '(.volume.subpath // "")==""' >/dev/null; then
          printf 'Stopped-site syntax validation cannot resolve an anonymous volume or volume subpath.\n' >&2; return 1
        fi
        source=$(printf '%s' "$model" | jq -er --arg name "$source" '.volumes[$name].name // $name') || return 1
        docker volume inspect "$source" >/dev/null || return 1
        ;;
      *) printf 'Stopped-site syntax validation does not support mount type %s.\n' "$type" >&2; return 1 ;;
    esac
    [[ "$source" != *','* && "$source" != *$'\n'* && "$target" != *','* && "$target" != *$'\n'* ]] || return 1
    args+=(--mount "type=$type,source=$source,target=$target,readonly")
  done < <(printf '%s' "$selected" | jq -c '.volumes // [] | .[]')
  if [ "$flavor" = nginx ]; then
    # The generated FPM service is deliberately stopped. Resolve only that
    # known hostname for static parsing; no network or backend is contacted.
    args+=(--add-host "${VDM_SITE_SERVICE}:127.0.0.1" --entrypoint nginx "$image" -t)
  else
    # shellcheck disable=SC2016 # Expanded only inside the isolated container.
    args+=(--entrypoint sh "$image" -c 'mkdir -p "${APACHE_RUN_DIR:-/var/run/apache2}" && exec apache2ctl -t')
  fi
  # Host bind sources are already native on Windows. Do not let Git Bash
  # rewrite the container destinations or the native command arguments.
  MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' docker "${args[@]}" || {
    printf 'Candidate %s configuration failed native syntax validation; the stopped site is unchanged.\n' "$flavor" >&2
    return 1
  }
}

# Test syntax plus application paths inside the affected HTTP container. Real
# external route/database verification is shared with the PHP action when present.
function joomlaVerifyWebConfiguration() {
  local site="$1" service root flavor
  readJoomlaSiteFacts "$site" || return 1
  service="$VDM_SITE_SERVICE" root="$VDM_SITE_DOCROOT" flavor="$VDM_SITE_WEBSERVER"
  if [ "$flavor" = nginx ]; then
    joomlaSiteCompose "$site" exec -T "nginx${VDM_SITE_KEY}" nginx -t >/dev/null || return 1
    # Observe response status AND Joomla API JSON; a generic Nginx 404 is not
    # evidence that the API front controller works. Also test denial paths.
    # shellcheck disable=SC2016 # Literal PHP executed in the selected container.
    joomlaSiteCompose "$site" exec -T "$service" php -r '
      $base=$argv[1];
      $fail=static function($path,$code,$reason) {fwrite(STDERR,"Web verification failed for ".$path." (HTTP ".$code."): ".$reason."\n"); exit(1);};
      foreach (["/", "/administrator/", "/api/index.php/v1/content/articles", "/configuration.php", "/octojoom-missing-script.php"] as $path) {
        // Joomla API content negotiation requires a supported Accept header.
        $accept=strpos($path,"/api/")===0 ? "application/vnd.api+json" : "*/*";
        $context=stream_context_create(["http"=>["ignore_errors"=>true,"timeout"=>15,"follow_location"=>0,"header"=>"Accept: ".$accept."\r\n"]]);
        $body=@file_get_contents($base.$path,false,$context); $code=0;
        foreach($http_response_header ?? [] as $line) if(preg_match("~^HTTP/[0-9.]+ ([0-9]+)~",$line,$m)) $code=(int)$m[1];
        if($body===false || !$code || $code>=500) $fail($path,$code,"request failed");
        if($path==="/configuration.php") { if($code!==403) $fail($path,$code,"expected configuration access denial"); continue; }
        if($path==="/octojoom-missing-script.php") { if($code!==404) $fail($path,$code,"expected missing script response"); continue; }
        if(strpos($path,"/api/")===0) {
          $json=json_decode($body,true);
          if(!is_array($json) || (!isset($json["errors"]) && !isset($json["data"]) && !isset($json["links"]))) $fail($path,$code,"expected Joomla API JSON");
          if(!in_array($code,[200,401,403,404],true)) $fail($path,$code,"unexpected API response");
        } elseif($code<200 || $code>=400) $fail($path,$code,"expected an application page");
      }
    ' "http://nginx${VDM_SITE_KEY}" || return 1
  else
    joomlaSiteCompose "$site" exec -T "$service" apache2ctl -t >/dev/null || return 1
    joomlaSiteCompose "$site" exec -T "$service" curl --fail --silent --output /dev/null http://127.0.0.1/ || return 1
  fi
  # shellcheck disable=SC2016 # Literal PHP, not shell variables.
  joomlaSiteCompose "$site" exec -T "$service" php -r \
    'exit(is_file($argv[1]."/index.php") && is_file($argv[1]."/configuration.php") ? 0 : 1);' "$root" || return 1
  if isFunc joomlaRuntimeValidatePublished; then
    joomlaRuntimeValidatePublished "$site" || return 1
  fi
}

# Inspect website content in a non-installing, network-isolated PHP process.
function joomlaReadOnlyRootPHP() {
  local site="$1" source="$VDM_SITE_MOUNT_SOURCE" type="$VDM_SITE_MOUNT_TYPE" config
  shift
  [[ "$type" = bind || "$type" = volume ]] || return 1
  if [ "$type" = volume ]; then
    command -v jq >/dev/null 2>&1 || return 1
    config=$(joomlaSiteCompose "$site" config --format json) || return 1
    source=$(printf '%s' "$config" | jq -er --arg name "$source" '.volumes[$name].name // $name') || return 1
    docker volume inspect "$source" >/dev/null || return 1
  fi
  [[ "$source" != *','* && "$source" != *$'\n'* && "$VDM_SITE_MOUNT_TARGET" != *','* ]] || return 1
  docker run --rm --network none --read-only --mount "type=${type},source=${source},target=${VDM_SITE_MOUNT_TARGET},readonly" \
    --entrypoint php "$VDM_SITE_IMAGE" "$@"
}

function joomlaHasCustomHtaccess() {
  local site="$1" root="$3" status
  # 0 custom, 1 distributed/no file, 2 unreadable: failures must not mean safe.
  # shellcheck disable=SC2016 # Literal PHP, not shell variables.
  joomlaReadOnlyRootPHP "$site" -r \
    '$root=$argv[1]; if(!is_file($root."/.htaccess")) exit(0); if(!is_readable($root."/.htaccess")) exit(2); if(!is_file($root."/htaccess.txt")) exit(10); $normalize=function($file){$lines=preg_split("~\\R~",file_get_contents($file)); return implode("\n",array_filter(array_map("trim",$lines),function($line){return $line !== "" && strpos($line,"#") !== 0 && strpos($line,"Options -Indexes") !== 0;}));}; exit($normalize($root."/.htaccess") === $normalize($root."/htaccess.txt") ? 0 : 10);' "$root" >/dev/null 2>&1
  status=$?
  case "$status" in 0) return 1 ;; 10) return 0 ;; *) return 2 ;; esac
}

function joomla__TRuST__webserver() {
  (
    local site="${VDM_CONTAINER:-}" choice="${VDM_WEBSERVER:-}" action="${VDM_ACTION:-show}" work image flavor root nginx_image
    [ -n "$site" ] || { printf 'Select a website with --container.\n' >&2; exit 2; }
    readJoomlaSiteFacts "$site" || exit 1
    [ "$action" = show ] && { printf '%s\n' "$VDM_SITE_WEBSERVER"; exit 0; }
    [ "$action" = set ] || { printf 'Unknown webserver action: %s\n' "$action" >&2; exit 2; }
    if [ -z "$choice" ]; then
      [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] || { printf '%s\n' '--webserver is required.' >&2; exit 2; }
      choice=$(whiptail --title 'Website webserver' --backtitle "$BACK_TITLE" --menu "Current: ${VDM_SITE_WEBSERVER}" 15 80 3 \
        apache 'Apache' nginx 'Nginx with PHP-FPM' 3>&1 1>&2 2>&3) || exit 0
    fi
    [[ "$choice" = apache || "$choice" = nginx ]] || { printf 'Choose apache or nginx.\n' >&2; exit 2; }
    [ "$choice" != "$VDM_SITE_WEBSERVER" ] || { printf 'Webserver is already %s.\n' "$choice"; exit 0; }
    [[ -n "$VDM_SITE_KEY" && -n "$VDM_SITE_ENV_KEY" && -n "$VDM_SITE_SERVICE" ]] || exit 1
    root="$VDM_SITE_DOCROOT" nginx_image="${VDM_NGINX_IMAGE:-nginx:stable-alpine}"
    flavor=apache; [ "$choice" != nginx ] || flavor=fpm
    local requested_tag=''
    if isFunc cliHasValue && cliHasValue VDM_JV; then requested_tag="${VDM_JV:-}"; fi
    image=$(joomlaRuntimeSelectImage "$site" "$flavor" "$requested_tag") || exit 1
    if [ "$choice" = nginx ]; then
      docker pull "$nginx_image" >&2 || exit 1
      if [ -z "${VDM_NGINX_CONFIG:-}" ]; then
        local htaccess_status=0
        joomlaHasCustomHtaccess "$site" "$VDM_SITE_SERVICE" "$root" || htaccess_status=$?
        if [ "$htaccess_status" -eq 0 ]; then
          printf 'Custom Apache .htaccess rules need an explicit Nginx equivalent (--nginx-config FILE). The existing site is unchanged.\n' >&2
          exit 2
        elif [ "$htaccess_status" -ne 1 ]; then
          printf 'Unable to inspect Apache rules safely; the existing site is unchanged.\n' >&2
          exit 1
        fi
      fi
    fi
    work=$(mktemp -d "$VDM_SITE_DIR/.webserver.XXXXXX") || exit 1
    trap 'rm -rf "$work"' EXIT
    if [ "$choice" = apache ] && [ -f "$VDM_SITE_DIR/apache-healthcheck.yml" ]; then
      cp "$VDM_SITE_DIR/apache-healthcheck.yml" "$work/restore-healthcheck.yml" || exit 1
    fi
    joomlaRewriteWebserverCompose "$VDM_SITE_COMPOSE" "$work/docker-compose.yml" "$VDM_SITE_SERVICE" "nginx${VDM_SITE_KEY}" \
      "$choice" "$image" "$nginx_image" "$work" || exit 1
    siteWriteScopedEnv "$VDM_SITE_COMPOSE" "$VDM_SITE_ENV" "$VDM_SITE_ENV_KEY" "$work/.env" || exit 1
    writeEnvVariable "$work/.env" "VDM_${VDM_SITE_ENV_KEY}_WEBSERVER=$choice" true || exit 1
    writeEnvVariable "$work/.env" "VDM_${VDM_SITE_ENV_KEY}_IMAGE=$image" true || exit 1
    local -a OCTOJOOM_SITE_FILE_TARGETS=() OCTOJOOM_SITE_FILE_SOURCES=() OCTOJOOM_SITE_START_SERVICES=() OCTOJOOM_SITE_STOP_SERVICES=()
    joomlaPHPStageExistingOverrides "$site" "$work" "$image" || exit 1
    if [ "$choice" = nginx ]; then
      if [ -n "${VDM_NGINX_CONFIG:-}" ]; then
        [ -f "$VDM_NGINX_CONFIG" ] && [ ! -L "$VDM_NGINX_CONFIG" ] || exit 1
        cp "$VDM_NGINX_CONFIG" "$work/nginx.conf" || exit 1
      else
        joomlaNginxConfiguration "$VDM_SITE_SERVICE" "$root" > "$work/nginx.conf" || exit 1
      fi
      OCTOJOOM_SITE_FILE_TARGETS+=("$VDM_SITE_DIR/nginx.conf" "$VDM_SITE_DIR/apache-healthcheck.yml")
      OCTOJOOM_SITE_FILE_SOURCES+=("$work/nginx.conf" "$work/apache-healthcheck.yml")
      # Official FPM uses its pool user, not Apache's environment variables.
      local puid='' pgid='' model
      migrationReadEnvValue "$VDM_SITE_ENV" "VDM_${VDM_SITE_ENV_KEY}_PUID" puid || :
      migrationReadEnvValue "$VDM_SITE_ENV" "VDM_${VDM_SITE_ENV_KEY}_PGID" pgid || :
      if [ -z "$puid$pgid" ]; then
        model=$(joomlaSiteCompose "$site" config --format json) || exit 1
        puid=$(printf '%s' "$model" | jq -r --arg service "$VDM_SITE_SERVICE" '.services[$service].environment.APACHE_RUN_USER // empty') || exit 1
        pgid=$(printf '%s' "$model" | jq -r --arg service "$VDM_SITE_SERVICE" '.services[$service].environment.APACHE_RUN_GROUP // empty') || exit 1
      fi
      if [ -n "$puid$pgid" ]; then
        puid="${puid#\#}" pgid="${pgid#\#}"
        [[ "$puid" =~ ^([0-9]+|[A-Za-z_][A-Za-z0-9_-]*)$ && "$pgid" =~ ^([0-9]+|[A-Za-z_][A-Za-z0-9_-]*)$ ]] || exit 1
        docker run --rm --entrypoint sh "$image" -c 'test -d /usr/local/etc/php-fpm.d' || exit 1
        printf '[www]\nuser = %s\ngroup = %s\n' "$puid" "$pgid" > "$work/php-fpm-user.conf"
        joomlaWebCompanionMount "$work/docker-compose.yml" "$work/compose.next" "$VDM_SITE_SERVICE" php-fpm-user.conf /usr/local/etc/php-fpm.d/zz-octojoom-user.conf "$work" && mv "$work/compose.next" "$work/docker-compose.yml" || exit 1
        OCTOJOOM_SITE_FILE_TARGETS+=("$VDM_SITE_DIR/php-fpm-user.conf")
        OCTOJOOM_SITE_FILE_SOURCES+=("$work/php-fpm-user.conf")
      fi
      OCTOJOOM_SITE_START_SERVICES+=("nginx${VDM_SITE_KEY}")
    else
      OCTOJOOM_SITE_STOP_SERVICES+=("nginx${VDM_SITE_KEY}")
      OCTOJOOM_SITE_START_SERVICES+=("$VDM_SITE_SERVICE")
      if [ "$root" != /var/www/html ] || [ -e "$VDM_SITE_DIR/apache.conf" ] || [ -L "$VDM_SITE_DIR/apache.conf" ]; then
        joomlaStageApacheConfiguration "$VDM_SITE_DIR/apache.conf" "$work/apache.conf" "$root" || exit 1
        joomlaWebCompanionMount "$work/docker-compose.yml" "$work/compose.next" "$VDM_SITE_SERVICE" apache.conf /etc/apache2/sites-enabled/000-default.conf "$work" && mv "$work/compose.next" "$work/docker-compose.yml" || exit 1
        OCTOJOOM_SITE_FILE_TARGETS+=("$VDM_SITE_DIR/apache.conf")
        OCTOJOOM_SITE_FILE_SOURCES+=("$work/apache.conf")
      fi
    fi
    local companion
    for companion in "${OCTOJOOM_SITE_FILE_SOURCES[@]}"; do chmod 644 "$companion" || exit 1; done
    if [ "$VDM_SITE_RUNNING" = stopped ]; then
      local syntax_service="$VDM_SITE_SERVICE"
      [ "$choice" != nginx ] || syntax_service="nginx${VDM_SITE_KEY}"
      joomlaValidateStagedWebConfiguration "$work/docker-compose.yml" "$work/.env" "$VDM_SITE_DIR" "$syntax_service" "$choice" || exit 1
    fi
    # shellcheck disable=SC2034 # Consumed by the shared publication helper.
    local OCTOJOOM_SITE_VALIDATE_FUNCTION=joomlaVerifyWebConfiguration
    sitePublishConfiguration "$site" "$work/docker-compose.yml" "$work/.env" "$VDM_SITE_SERVICE" || exit 1
    printf 'Webserver set to %s using %s.\n' "$choice" "$image"
  )
}

# A stopped one-shot PHP process reads the mount without invoking installation.
# Selecting a root never creates it or moves content.
function joomlaCheckDocumentRoot() {
  local site="$1" root="$3"
  # shellcheck disable=SC2016 # Literal PHP, not shell variables.
  joomlaReadOnlyRootPHP "$site" -r \
    '$root=$argv[1]; $base=realpath($argv[2]); $path=realpath($root); exit($base !== false && $path !== false && ($path === $base || strpos($path,$base."/")===0) && is_file($path."/index.php") && is_file($path."/configuration.php") ? 0 : 1);' "$root" "$VDM_SITE_MOUNT_TARGET" >/dev/null
}

# Explicit moves use a private staging directory in the same bind mount, then
# rename complete entries. Existing destinations and shared mounts are refused.
# This intentionally does not claim a portable named-volume move operation.
function joomlaMoveDocumentRoot() {
  local source="$1" destination="$2" base="$3" item other
  # Check every ancestor before creating anything, including missing descendants
  # of a symlink. A late realpath check could already have written outside base.
  if migrationPathHasSymlink "$base" || migrationPathHasSymlink "$source" || migrationPathHasSymlink "$destination"; then
    printf 'Document-root moves cannot traverse symlinked paths.\n' >&2
    return 1
  fi
  [ -d "$source" ] && [ ! -L "$source" ] && [ ! -e "$destination" ] && [ ! -L "$destination" ] || return 1
  [[ "$source/" == "$base/"* && "$destination/" == "$base/"* && "$source" != "$destination" ]] || return 1
  # A parent destination would mix content; choose an empty sibling or child.
  [[ "$source/" != "$destination/"* ]] || return 1
  [ -f "$source/index.php" ] && [ -f "$source/configuration.php" ] || return 1
  local parent="${destination%/*}" canonical canonical_base ancestor
  # macOS exposes /var and /tmp through standard /private aliases. Compare
  # physical paths on both sides after the ancestor safety check above.
  canonical_base=$(cd "$base" && pwd -P) || return 1
  for other in "$VDM_REPO_PATH/joomla/available"/*/docker-compose.yml; do
    if [ ! -f "$other" ] || [ "$other" = "$VDM_SITE_COMPOSE" ]; then continue; fi
    if (
      readJoomlaSiteFacts "$(basename "$(dirname "$other")")" || exit 1
      [ "$VDM_SITE_MOUNT_TYPE" = bind ] || exit 1
      local shared="$VDM_SITE_MOUNT_SOURCE"
      # Check both lexical nesting (including not-yet-created roots) and
      # existing physical paths, which may use a different host alias.
      [[ "$shared/" == "$base/"* || "$base/" == "$shared/"* ]] && exit 0
      [ -d "$shared" ] || exit 1
      shared=$(cd "$shared" && pwd -P) || exit 1
      [[ "$shared/" == "$canonical_base/"* || "$canonical_base/" == "$shared/"* ]]
    ); then
      printf 'Another site shares or overlaps this bind mount. Move its data explicitly after separating the sites.\n' >&2
      return 1
    fi
  done
  if [[ "$destination/" = "$source/"* ]]; then
    ancestor="${destination#"$source/"}"; ancestor="${ancestor%%/*}"
    [ ! -e "$source/$ancestor" ] && [ ! -L "$source/$ancestor" ] || return 1
  fi
  runPrivileged mkdir -p "$parent" || return 1
  canonical=$(cd "$parent" && pwd -P) || return 1
  [[ "$canonical/" == "$canonical_base/"* || "$canonical" = "$canonical_base" ]] || return 1
  runPrivileged mkdir "$destination" || return 1
  if [ "${OS_NUMBER:-0}" != 3 ]; then
    local ownership mode
    ownership=$(stat -c '%u:%g' "$source" 2>/dev/null || stat -f '%u:%g' "$source") || return 1
    mode=$(stat -c '%a' "$source" 2>/dev/null || stat -f '%Lp' "$source") || return 1
    runPrivileged chown "$ownership" "$destination" && runPrivileged chmod "$mode" "$destination" || return 1
  fi
  local -a moved=()
  while IFS= read -r -d '' item; do
    # The target may be a nested child. Keep its ancestors in place.
    [[ "$destination/" == "$item/"* ]] && continue
    if ! runPrivileged mv "$item" "$destination/"; then
      for item in "${moved[@]}"; do runPrivileged mv "$destination/${item##*/}" "$source/" || return 1; done
      runPrivileged rmdir "$destination" 2>/dev/null || :
      return 1
    fi
    moved+=("$item")
  done < <(find "$source" -mindepth 1 -maxdepth 1 -print0)
  return 0
}

# Only literal Joomla path properties below the old root are realigned. Keep
# custom external log/tmp directories and every other configuration property.
function joomlaPatchMovedRootConfiguration() {
  local source="$1" destination="$2" old_root="$3" new_root="$4"
  awk -v old="$old_root" -v new="$new_root" '
    /^[[:space:]]*public[[:space:]]+[$](log_path|tmp_path)[[:space:]]*=/ {
      line=$0; quote=sprintf("%c",39)
      pattern="^[[:space:]]*public[[:space:]]+[$](log_path|tmp_path)[[:space:]]*=[[:space:]]*" quote
      if(line !~ pattern) {print; next}
      value=line; sub(pattern,"",value)
      if(value !~ quote ";[[:space:]]*$") {print; next}
      sub(quote ";[[:space:]]*$","",value)
      if(value==old || index(value,old "/")==1) {
        before=line; sub(quote ".*$","",before)
        print before quote new substr(value,length(old)+1) quote ";"; next
      }
    }
    {print}
  ' "$source" > "$destination"
}

function joomlaRestoreMovedRoot() {
  local source="$1" destination="$2" item failed=0
  while IFS= read -r -d '' item; do
    [ ! -e "$source/${item##*/}" ] && runPrivileged mv "$item" "$source/" || failed=1
  done < <(find "$destination" -mindepth 1 -maxdepth 1 -print0)
  [ "$failed" -eq 0 ] && runPrivileged rmdir "$destination"
}

function joomla__TRuST__docroot() {
  (
    local site="${VDM_CONTAINER:-}" requested="${VDM_DOCROOT-}" action="${VDM_ACTION:-show}" work root flavor current_relative files_moved=false keep_work=false old_host new_host
    [ -n "$site" ] || { printf 'Select a website with --container.\n' >&2; exit 2; }
    readJoomlaSiteFacts "$site" || exit 1
    [ "$action" = show ] && { printf '%s\n' "$VDM_SITE_DOCROOT"; exit 0; }
    [ "$action" = set ] || { printf 'Unknown document-root action: %s\n' "$action" >&2; exit 2; }
    if [ -z "${VDM_SITE_MOUNT_TARGET:-}" ] || [ -z "${VDM_SITE_ENV_KEY:-}" ]; then
      printf 'Cannot resolve the website mount or ENV key.\n' >&2; exit 1
    fi
    current_relative="${VDM_SITE_DOCROOT#"${VDM_SITE_MOUNT_TARGET}/"}"
    [ "$VDM_SITE_DOCROOT" != "$VDM_SITE_MOUNT_TARGET" ] || current_relative=.
    if [ -z "$requested" ]; then
      [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] || { printf '%s\n' '--docroot is required.' >&2; exit 2; }
      requested=$(getInput 'Select an existing Joomla directory relative to the website mount (. keeps its root). Files are not moved.' "$current_relative" 'Website document root') || exit 0
    fi
    joomlaValidateDocumentRoot "$requested" || { printf 'Document root must stay inside the website mount (no absolute paths, . or .. components).\n' >&2; exit 2; }
    [ "$requested" != "$current_relative" ] || { printf 'Document root is unchanged.\n'; exit 0; }
    root="${VDM_SITE_MOUNT_TARGET%/}"; [ "$requested" = . ] || root+="/$requested"
    flavor="$VDM_SITE_WEBSERVER"
    [[ "$flavor" = apache || "$flavor" = nginx ]] || { printf 'Document-root changes require an identified Apache or Nginx service.\n' >&2; exit 1; }
    if [ "${VDM_MOVE_FILES:-false}" = true ]; then
      if [ "$VDM_SITE_MOUNT_TYPE" != bind ] || [ -z "$VDM_SITE_HOST_PATH" ]; then
        printf 'Automatic moves support independent bind mounts. For named volumes, move files explicitly and select the resulting root.\n' >&2; exit 2
      fi
      old_host="$VDM_SITE_HOST_PATH" new_host="$VDM_SITE_MOUNT_SOURCE"
      [ "$requested" = . ] || new_host+="/$requested"
      if [ -e "$new_host" ] || [ -L "$new_host" ]; then
        printf 'Move destination already exists: %s\n' "$new_host" >&2; exit 2
      fi
      # Do not move an application while it is serving requests.
      [ "$VDM_SITE_RUNNING" = stopped ] || { printf 'Stop this website before explicitly moving its files.\n' >&2; exit 2; }
    else
      joomlaCheckDocumentRoot "$site" "$VDM_SITE_SERVICE" "$root" || { printf 'The selected directory is not an existing installed Joomla root inside this mount.\n' >&2; exit 2; }
    fi
    work=$(mktemp -d "$VDM_SITE_DIR/.docroot.XXXXXX") || exit 1
    trap 'if "$keep_work"; then printf "Document-root recovery files retained in %s.\n" "$work" >&2; else rm -rf "$work"; fi' EXIT
    cp "$VDM_SITE_COMPOSE" "$work/docker-compose.yml" || exit 1
    siteWriteScopedEnv "$VDM_SITE_COMPOSE" "$VDM_SITE_ENV" "$VDM_SITE_ENV_KEY" "$work/.env" || exit 1
    writeEnvVariable "$work/.env" "VDM_${VDM_SITE_ENV_KEY}_DOCROOT=$requested" true || exit 1
    printf '    working_dir: "%s"\n' "$root" > "$work/property"
    joomlaSetServiceProperty "$work/docker-compose.yml" "$work/compose.next" "$VDM_SITE_SERVICE" working_dir "$work/property" && mv "$work/compose.next" "$work/docker-compose.yml" || exit 1
    local -a OCTOJOOM_SITE_FILE_TARGETS=() OCTOJOOM_SITE_FILE_SOURCES=()
    if [ "$flavor" = nginx ]; then
      if [ ! -f "$VDM_SITE_DIR/nginx.conf" ] || ! grep -qF '# Octojoom Joomla webserver.' "$VDM_SITE_DIR/nginx.conf"; then
        printf 'This site uses custom Nginx configuration. Change its root and FastCGI paths explicitly.\n' >&2; exit 2
      fi
      # Preserve user directives; only the one plain root declaration changes.
      awk -v root="$root" '/^[[:space:]]*root[[:space:]]+[^;]+;[[:space:]]*$/ {print "    root " root ";"; count++; next} {print} END {if(count!=1) exit 1}' \
        "$VDM_SITE_DIR/nginx.conf" > "$work/nginx.conf" || exit 1
      OCTOJOOM_SITE_FILE_TARGETS+=("$VDM_SITE_DIR/nginx.conf")
      OCTOJOOM_SITE_FILE_SOURCES+=("$work/nginx.conf")
    else
      # Verify the published Apache layout before mounting a vhost into it.
      docker run --rm --entrypoint sh "$VDM_SITE_IMAGE" -c 'test -d /etc/apache2/sites-enabled && command -v apache2ctl >/dev/null' || {
        printf 'The selected image does not expose the supported Apache configuration path.\n' >&2; exit 2;
      }
      joomlaStageApacheConfiguration "$VDM_SITE_DIR/apache.conf" "$work/apache.conf" "$root" || exit 1
      joomlaWebCompanionMount "$work/docker-compose.yml" "$work/compose.next" "$VDM_SITE_SERVICE" apache.conf /etc/apache2/sites-enabled/000-default.conf "$work" && mv "$work/compose.next" "$work/docker-compose.yml" || exit 1
      OCTOJOOM_SITE_FILE_TARGETS+=("$VDM_SITE_DIR/apache.conf")
      OCTOJOOM_SITE_FILE_SOURCES+=("$work/apache.conf")
    fi
    siteValidateCompose "$work/docker-compose.yml" "$work/.env" "$VDM_SITE_DIR" || exit 1
    if [ "$VDM_SITE_RUNNING" = stopped ]; then
      local syntax_service="$VDM_SITE_SERVICE"
      [ "$flavor" != nginx ] || syntax_service="nginx${VDM_SITE_KEY}"
      joomlaValidateStagedWebConfiguration "$work/docker-compose.yml" "$work/.env" "$VDM_SITE_DIR" "$syntax_service" "$flavor" || exit 1
    fi
    if [ "${VDM_MOVE_FILES:-false}" = true ]; then
      cp -p "$old_host/configuration.php" "$work/configuration.original.php" || exit 1
      joomlaPatchMovedRootConfiguration "$old_host/configuration.php" "$work/configuration.php" "$VDM_SITE_DOCROOT" "$root" || exit 1
      keep_work=true
      joomlaMoveDocumentRoot "$old_host" "$new_host" "$VDM_SITE_MOUNT_SOURCE" || exit 1
      files_moved=true
      if ! runPrivileged tee "$new_host/configuration.php" < "$work/configuration.php" >/dev/null; then
        runPrivileged tee "$new_host/configuration.php" < "$work/configuration.original.php" >/dev/null || :
        if joomlaRestoreMovedRoot "$old_host" "$new_host"; then
          keep_work=false
        else
          printf 'Moved files need recovery at %s.\n' "$new_host" >&2
        fi
        exit 1
      fi
    fi
    local companion
    for companion in "${OCTOJOOM_SITE_FILE_SOURCES[@]}"; do chmod 644 "$companion" || exit 1; done
    # shellcheck disable=SC2034 # Consumed by the shared publication helper.
    local OCTOJOOM_SITE_VALIDATE_FUNCTION=joomlaVerifyWebConfiguration
    local -a affected=("$VDM_SITE_SERVICE")
    [ "$flavor" != nginx ] || affected+=("nginx${VDM_SITE_KEY}")
    if ! sitePublishConfiguration "$site" "$work/docker-compose.yml" "$work/.env" "${affected[@]}"; then
      if "$files_moved"; then
        runPrivileged tee "$new_host/configuration.php" < "$work/configuration.original.php" >/dev/null || :
        if joomlaRestoreMovedRoot "$old_host" "$new_host"; then
          keep_work=false
        else
          printf 'Configuration was not applied. File recovery needs attention: %s -> %s\n' "$new_host" "$old_host" >&2
        fi
      fi
      exit 1
    fi
    keep_work=false
    printf 'Document root set to %s.\n' "$root"
  )
}

# Setup hooks keep new choices within the existing questionnaire and generator.
function joomlaSetupWebChoices() {
  local choice image probe discovered answer_status
  VDM_WEBSERVER="${VDM_WEBSERVER:-apache}"
  VDM_DOCROOT="${VDM_DOCROOT:-.}"
  if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ]; then
    probe=$(joomlaRuntimeProbeImage "${VDM_J_REPO}:${VDM_JV}") || return 1
    discovered=$(printf '%s' "$probe" | jq -er '.flavor + " / PHP " + .php') || return 1
    if getInputYesNo "Selected image: ${discovered}. Keep the selected webserver (${VDM_WEBSERVER})?" 'Joomla webserver' 8 80; then
      :
    else
      answer_status=$?
      [ "$answer_status" -eq 1 ] || return "$answer_status"
      choice=$(whiptail --title 'Joomla webserver' --backtitle "$BACK_TITLE" --menu 'Select the webserver' 15 80 2 apache 'Apache' nginx 'Nginx with PHP-FPM' 3>&1 1>&2 2>&3) || return 2
      VDM_WEBSERVER="$choice"
    fi
    if getInputYesNo "Use the usual Joomla document root (${VDM_DOCROOT})?" 'Joomla document root' 8 80; then
      :
    else
      answer_status=$?
      [ "$answer_status" -eq 1 ] || return "$answer_status"
      VDM_DOCROOT=$(getInput 'Project-relative directory, or . for the website mount root' "$VDM_DOCROOT" 'Joomla document root') || return 2
    fi
  fi
  [[ "$VDM_WEBSERVER" = apache || "$VDM_WEBSERVER" = nginx ]] && joomlaValidateDocumentRoot "$VDM_DOCROOT" || return 2
  # Setup has no installed site yet; compare the selected image directly.
  if [ "$VDM_WEBSERVER" = nginx ]; then
    image=$(joomlaRuntimeSelectSetupFlavor fpm) || return 1
  else
    image=$(joomlaRuntimeSelectSetupFlavor apache) || return 1
  fi
  VDM_J_REPO="${image%:*}" VDM_JV="${image##*:}"
}

# A published candidate is selected by its observed Joomla and PHP versions,
# using the shared published-tag discovery and runtime probes.
function joomlaRuntimeSelectSetupFlavor() {
  local flavor="$1" selected="${VDM_J_REPO}:${VDM_JV}"
  joomlaRuntimeSelectImageForFlavor "$selected" "$flavor"
}

# The official Joomla FPM entrypoint copies a fresh installation as www-data
# when started as root; Apache user variables do not change that owner. Pool
# overrides alone would make a new custom-UID site unable to write its files.
function joomlaValidateNewFpmOwnership() {
  local image="$1" requested_uid="$2" requested_gid="$3" ownership
  [[ "$requested_uid" =~ ^[0-9]+$ && "$requested_gid" =~ ^[0-9]+$ ]] || return 2
  ownership=$(docker run --rm --network none --read-only --entrypoint sh "$image" -c \
    'test -d /usr/local/etc/php-fpm.d || exit 1; uid=$(id -u) || exit 1; gid=$(id -g) || exit 1; if [ "$uid" = 0 ]; then uid=$(id -u www-data) || exit 1; gid=$(id -g www-data) || exit 1; fi; printf "%s:%s\n" "$uid" "$gid"') || {
    printf 'The selected FPM image does not expose a verifiable installation owner.\n' >&2; return 1
  }
  if [ "$ownership" != "$requested_uid:$requested_gid" ]; then
    printf 'New FPM installations use image UID/GID %s; requested %s:%s would not own the initialized files. Use the image IDs or create with Apache first and switch the installed site.\n' \
      "$ownership" "$requested_uid" "$requested_gid" >&2
    return 2
  fi
}

function joomlaSetupWebPrepare() {
  local dir="${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available/${VDM_SUBDOMAIN}.${VDM_DOMAIN}" root=/var/www/html
  VDM_WEBSERVER="${VDM_WEBSERVER:-apache}" VDM_DOCROOT="${VDM_DOCROOT:-.}"
  [[ "$VDM_WEBSERVER" = apache || "$VDM_WEBSERVER" = nginx ]] && joomlaValidateDocumentRoot "$VDM_DOCROOT" || return 2
  [ "$VDM_DOCROOT" = . ] || root+="/${VDM_DOCROOT}"
  VDM_WEB_WORKING_DIR='' VDM_WEB_SERVICE='' VDM_WEB_HEALTH='' VDM_WEB_LABELS='' VDM_WEB_EXPOSE='80'
  if [ "$root" != /var/www/html ]; then
    VDM_WEB_WORKING_DIR=$(getYMLine2 "working_dir: \"${root}\"")
  fi
  if [ "$VDM_WEBSERVER" = nginx ]; then
    local selected_image
    selected_image=$(joomlaRuntimeSelectSetupFlavor fpm) || return 1
    VDM_J_REPO="${selected_image%:*}" VDM_JV="${selected_image##*:}"
    if [ -n "${VDM_PUID:-}${VDM_PGID:-}" ]; then
      joomlaValidateNewFpmOwnership "$selected_image" "${VDM_PUID:-}" "${VDM_PGID:-}" || return $?
    fi
    createPrivateDirectory -p "$dir" || return 1
    joomlaNginxConfiguration "joomla${VDM_KEY}" "$root" > "$dir/nginx.conf" || return 1
    if [ -n "${VDM_PUID:-}${VDM_PGID:-}" ]; then
      [[ "${VDM_PUID:-}" =~ ^[0-9]+$ && "${VDM_PGID:-}" =~ ^[0-9]+$ ]] || return 1
      printf '[www]\nuser = %s\ngroup = %s\n' "$VDM_PUID" "$VDM_PGID" > "$dir/php-fpm-user.conf" || return 1
      chmod 644 "$dir/php-fpm-user.conf" || return 1
      VDM_JOOMLA_VOLUMES_MOUNT+=$(getYMLine3 '- "./php-fpm-user.conf:/usr/local/etc/php-fpm.d/zz-octojoom-user.conf:ro"')
    fi
    VDM_WEB_EXPOSE=9000
    # shellcheck disable=SC2089 # Serialized YAML consumed by the generator.
    VDM_WEB_HEALTH='["CMD", "php", "-r", "exit(@fsockopen('\''127.0.0.1'\'', 9000) ? 0 : 1);"]'
    VDM_WEB_LABELS=$(getYMLine3 '- "traefik.enable=false"')
    VDM_WEB_SERVICE=$(getYMLine1 "nginx${VDM_KEY}:")
    VDM_WEB_SERVICE+=$(getYMLine2 "# Octojoom managed HTTP companion")
    VDM_WEB_SERVICE+=$(getYMLine2 "image: ${VDM_NGINX_IMAGE:-nginx:stable-alpine}")
    VDM_WEB_SERVICE+=$(getYMLine2 'restart: unless-stopped')
    VDM_WEB_SERVICE+=$(getYMLine2 'depends_on:')
    VDM_WEB_SERVICE+=$(getYMLine3 "joomla${VDM_KEY}:")
    VDM_WEB_SERVICE+=$'\n        condition: service_healthy'
    VDM_WEB_SERVICE+=$(getYMLine2 'volumes:')
    # Only the root data mount is shared with the HTTP server, read-only.
    local root_mount
    root_mount=$(printf '%s\n' "$VDM_JOOMLA_VOLUMES_MOUNT" | sed -nE 's#^[[:space:]]*-[[:space:]]*"?([^"]*:/var/www/html)"?[[:space:]]*$#\1#p')
    [ -n "$root_mount" ] && [[ "$root_mount" != *$'\n'* ]] || return 1
    VDM_WEB_SERVICE+=$(getYMLine3 "- \"${root_mount}:ro\"")
    VDM_WEB_SERVICE+=$(getYMLine3 '- "./nginx.conf:/etc/nginx/conf.d/default.conf:ro"')
    VDM_WEB_SERVICE+=$(getYMLine2 'networks:')
    VDM_WEB_SERVICE+=$(getYMLine3 '- traefik')
    VDM_WEB_SERVICE+=$(getYMLine2 'labels:')
    VDM_WEB_SERVICE+=$(getYMLine3 '- "traefik.enable=true"')
    VDM_WEB_SERVICE+=$(getYMLine3 "- \"traefik.http.routers.joomla${VDM_KEY}.rule=Host(\`${VDM_SUBDOMAIN}.${VDM_DOMAIN}\`)\"")
    VDM_WEB_SERVICE+="${VDM_JOOMLA_SECURE_LABELS}"
    if [[ "$VDM_JOOMLA_SECURE_LABELS" != *'loadbalancer.server.port='* ]]; then
      VDM_WEB_SERVICE+=$(getYMLine3 "- \"traefik.http.services.joomla${VDM_KEY}.loadbalancer.server.port=80\"")
    fi
    VDM_WEB_SERVICE+=$(getYMLine2 'healthcheck:')
    VDM_WEB_SERVICE+=$(getYMLine3 'test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1/__octojoom_health"]')
    VDM_WEB_SERVICE+=$(getYMLine3 'interval: 10s')
    VDM_WEB_SERVICE+=$(getYMLine3 'timeout: 5s')
    VDM_WEB_SERVICE+=$(getYMLine3 'retries: 12')
  elif [ "$root" != /var/www/html ]; then
    docker run --rm --entrypoint sh "${VDM_J_REPO}:${VDM_JV}" -c 'test -d /etc/apache2/sites-enabled && command -v apache2ctl >/dev/null' || return 1
    createPrivateDirectory -p "$dir" || return 1
    joomlaApacheConfiguration "$root" > "$dir/apache.conf" || return 1
    VDM_JOOMLA_VOLUMES_MOUNT+=$(getYMLine3 '- "./apache.conf:/etc/apache2/sites-enabled/000-default.conf:ro"')
  fi
  local companion
  for companion in "$dir/nginx.conf" "$dir/apache.conf"; do
    [ ! -f "$companion" ] || chmod 644 "$companion" || return 1
  done
  # shellcheck disable=SC2090 # Data exported to the generator, never executed.
  export VDM_WEB_WORKING_DIR VDM_WEB_SERVICE VDM_WEB_HEALTH VDM_WEB_LABELS VDM_WEB_EXPOSE
}

#####################################################################################################################VDM
######################################## BULK SETUP JOOMLA
function joomla__TRuST__bulk() {
  (
  local VDM_TASK=bulk
  local OCTOJOOM_SETUP_COLLECT_ENV=true OCTOJOOM_SETUP_ENV_APPROVED=false
  local -a OCTOJOOM_SETUP_ASSIGNMENTS=()
  # load this container type globals
  # shellcheck disable=SC1090
  if [ -f "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" ]; then
    loadEnvFile "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" || return 1
  fi
  if isFunc cliApplyValues; then cliApplyValues; fi
  joomlaSetupDefaults || return $?
  if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then joomlaBulkPreflight || return $?; fi
  # we need to pull these values from the env if set
  local vdm_key
  local vdm_subdomain
  local vdm_bulk_database_name="${vdm_database_name:-}"
  local vdm_bulk_database_user="${vdm_database_user:-}"
  local vdm_bulk_database_pass="${vdm_database_pass:-}"
  local vdm_database_name vdm_database_user vdm_database_pass
  local vdm_database_rootpass
  local vdm_middlewares
  # get the Joomla image source
  setImageSource || return $?
  # set the domain
  setDomain || return $?
  # get the sub domain if not set TODO get dynamic joomla domain name
  setSubDomain "subdomain" "joomla" || return $?
  vdm_subdomain="${VDM_SUBDOMAIN}"
  joomlaSetupCustomization || return $?
  if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then
    : "${vdm_bulk_database_name:=vdm_io}" "${vdm_bulk_database_user:=vdm_user}"
    [ -n "$vdm_bulk_database_pass" ] || vdm_bulk_database_pass=$(getRandomPass 20) || return $?
  fi
  # check if we have secure switch set
  setSecureState || return $?
  # setup letsencrypt stuff
  VDM_REMOVE_SECURE=''
  VDM_ENTRY_POINT="websecure"
  VDM_HTTP_SCHEME="https://"
  VDM_CERT_RESOLVER="vdmresolver"
  if $VDM_SECURE; then
    setSecureCloudflareState "joomla" || return $?
    vdm_middlewares="joomla-security"
    if $VDM_SECURE_CLOUDFLARE; then
      VDM_CERT_RESOLVER="cfresolver"
      vdm_middlewares="cloudflare,joomla-security"
    fi
  else
    VDM_REMOVE_SECURE="#"
    VDM_ENTRY_POINT="web"
    VDM_HTTP_SCHEME="http://"
  fi
  # get the database name needed
  while [ ${#vdm_bulk_database_name} -le 1 ]; do
    # get the value
    vdm_bulk_database_name=$(getInput "Enter Database Name\n[Text with no spaces that is only underscore and alphabetical]" \
      "vdm_io" 'Enter Database Name') || return $?
    # keep asking if empty or does exist
    [ ${#vdm_bulk_database_name} -ge 1 ] || {
      showError "You must enter a database name!"
    }
  done
  # get the database user name needed
  while [ ${#vdm_bulk_database_user} -le 1 ]; do
    # get the value
    vdm_bulk_database_user=$(getInput "Enter Database Username\n[Text with no spaces that is only underscore and alphabetical]" \
      "vdm_user" 'Enter Database Username') || return $?
    # keep asking if empty or does exist
    [ ${#vdm_bulk_database_user} -ge 1 ] || {
      showError "You must enter a database username!"
    }
  done
  # get the database user password needed
  while [ ${#vdm_bulk_database_pass} -le 1 ]; do
    # get the value
    vdm_bulk_database_pass=$(getPassword "Enter Database User Password" \
      "$(getRandomPass 20)" 'Enter Database User Password') || return $?
    # keep asking if empty or does exist
    [ ${#vdm_bulk_database_pass} -ge 1 ] || {
      showError "You must enter a database user password!"
    }
  done
  joomlaSetupDatabaseCredentials "$vdm_bulk_database_name" "$vdm_bulk_database_user" "$vdm_bulk_database_pass" || return $?
  # only if in expert mode set the container user detail id needed
  if isExpert; then
    # if this is our octoleo images we can also set the user ID and user-group ID
    setContainerUser "$(id -u)" || return $?
  fi
  # add PHP settings
  set_php_settings=false
  VDM_PHP_PROJECT_PATH="bulk"
  export VDM_PHP_PROJECT_PATH
  local customization_status
  if isExpert || [ "${VDM_CUSTOMIZE:-false}" = true ] || [ "${VDM_PHP_SETTINGS:-false}" = true ]; then
    if setPHPSettings; then
      set_php_settings=true
    else
      customization_status=$?
      [ "$customization_status" -eq 1 ] || return "$customization_status"
    fi
  fi
  # customize docker-entrypoint.sh
  set_docker_entry_point=false
  VDM_ENTRY_PROJECT_PATH="bulk"
  export VDM_ENTRY_PROJECT_PATH
  if isExpert; then
    if setDockerEntrypoint; then
      set_docker_entry_point=true
    else
      customization_status=$?
      [ "$customization_status" -eq 1 ] || return "$customization_status"
    fi
  fi
  # set persistence
  persistence_volume=false
  persistence_db=false
  # only if in expert mode
  if { isExpert || [ "${VDM_PERSISTENCE+x}" = x ]; } && joomlaSetupPersistence VDM_PERSISTENCE 'Joomla website files and folders'; then
    persistence_volume=true
  fi
  # only if in expert mode
  if { isExpert || [ "${VDM_DB_PERSISTENCE+x}" = x ]; } && joomlaSetupPersistence VDM_DB_PERSISTENCE 'Joomla database'; then
    persistence_db=true
  fi
  # ask if we should add mailcatcher
  enable_mailcatcher=false
  if joomlaSetupBoolean VDM_MAILCATCHER "Would you also like to enable mailcatcher for these ${VDM_CONTAINER_TYPE^} containers" "Enable Mailcatcher" defaultno; then
      enable_mailcatcher=true
  fi
  # we only do autodeploy for Joomla 4.3 and above
  enable_autodeploy=false
  enable_extension_autodeploy=false
  enable_command_autodeploy=false
  if joomlaImageSupportsAutoInstall; then
    # get website setup details
    setJoomlaWebsiteDetails || return $?
    if [ "${VDM_AUTO_INSTALL:-false}" = true ] && [[ -n "${VDM_J_EMAIL}" ]]; then
      enable_autodeploy=true
      if [[ -n "${VDM_J_EXTENSIONS_URLS}" && "${#VDM_J_EXTENSIONS_URLS}" -gt 2 ]]; then
        enable_extension_autodeploy=true
      fi
      if [[ -n "${VDM_J_CLI_COMMANDS}" && "${#VDM_J_CLI_COMMANDS}" -gt 2 ]]; then
        enable_command_autodeploy=true
      fi
    fi
  fi
  # add the projects path
  setContainerEnvVariable "VDM_PROJECT_PATH=\"${VDM_PROJECT_PATH}\"" || return $?
  ##########################
  ### export all we need
  # global
  export VDM_CONTAINER_TYPE
  export VDM_REPO_PATH
  export VDM_PROJECT_PATH
  # container
  export VDM_REMOVE_SECURE
  export VDM_ENTRY_POINT
  export VDM_CERT_RESOLVER
  export VDM_HTTP_SCHEME
  export VDM_PERSISTENCE
  export VDM_NOT_PERSISTENCE
  # get the number of containers
  setNumberContainers || return $?
  # ask if we should continue to enable
  enable_containers=false
  if joomlaSetupBoolean VDM_ENABLE "Would you also like to enable all these ${VDM_CONTAINER_TYPE^} containers" "Enable Containers" defaultno; then
      enable_containers=true
  fi
  joomlaBulkPreflight || return $?
  # loop the number of containers
  for (( i=1; i<=VDM_NUMBER_CONTAINERS; i++ ))
  do
    vdm_key=$(getRandomName 5)
    VDM_KEY="${vdm_key,,}"
    VDM_ENV_KEY="${vdm_key^^}"
    VDM_SUBDOMAIN="${vdm_subdomain}${i}"
    vdm_database_name="${vdm_bulk_database_name}${i}"
    vdm_database_user="${vdm_bulk_database_user}${i}"
    vdm_database_pass="${vdm_bulk_database_pass}${i}"
    vdm_database_rootpass=''
    if [ "$VDM_DB_ENGINE" != postgres ]; then vdm_database_rootpass=$(getRandomPass 30) || return $?; fi
    # reset some globals
    VDM_EXTRA_CONTAINER_STUFF=''
    VDM_EXTRA_JOOMLA_ENV=''
    # check that we got the details
    if [ -n "${VDM_PUID}" ] && [ -n "${VDM_PGID}" ]; then
      setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_PUID=\"#${VDM_PUID}\"" || return $?
      setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_PGID=\"#${VDM_PGID}\"" || return $?
    fi
    # add this value if not set variable
    setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_DB=\"${vdm_database_name}\"" || return $?
    # add this value if not set variable
    setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_DB_USER=\"${vdm_database_user}\"" || return $?
    # add this value if not set variable
    setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_DB_PASS=\"${vdm_database_pass}\"" || return $?
    # add this value if not set variable
    if [ "$VDM_DB_ENGINE" != postgres ]; then setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_DB_ROOT=\"${vdm_database_rootpass}\"" || return $?; fi
    # we only do autodeploy for Joomla 4.3 and above
    if $enable_autodeploy; then
      # add extra Joomla envs
      setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_JOOMLA_DB_TYPE=\"${VDM_DATABASE_DRIVER:-mysqli}\"" || return $?
      local database_prefix
      database_prefix=$(joomlaSetupDatabasePrefix) || return $?
      setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_JOOMLA_DB_PREFIX=\"${database_prefix}\"" || return $?
      setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_JOOMLA_SITE_NAME=\"${VDM_J_SITE_NAME} ${i}\"" || return $?
      setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_JOOMLA_ADMIN_USERNAME=\"${VDM_J_USERNAME}\"" || return $?
      setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_JOOMLA_ADMIN_USER=\"${VDM_J_USER}\"" || return $?
      setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_JOOMLA_ADMIN_EMAIL=\"${VDM_J_EMAIL}\"" || return $?
      setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_JOOMLA_ADMIN_PASSWORD=\"${VDM_J_PASSWORD}\"" || return $?
      if [ "$VDM_DB_ENGINE" != postgres ]; then VDM_EXTRA_JOOMLA_ENV+=$(getYMLine3 "- JOOMLA_DB_TYPE=\${VDM_${VDM_ENV_KEY^^}_JOOMLA_DB_TYPE}"); fi
      VDM_EXTRA_JOOMLA_ENV+=$(getYMLine3 "- JOOMLA_DB_PREFIX=\${VDM_${VDM_ENV_KEY^^}_JOOMLA_DB_PREFIX}")
      VDM_EXTRA_JOOMLA_ENV+=$(getYMLine3 "- JOOMLA_SITE_NAME=\${VDM_${VDM_ENV_KEY^^}_JOOMLA_SITE_NAME}")
      VDM_EXTRA_JOOMLA_ENV+=$(getYMLine3 "- JOOMLA_ADMIN_USERNAME=\${VDM_${VDM_ENV_KEY^^}_JOOMLA_ADMIN_USERNAME}")
      VDM_EXTRA_JOOMLA_ENV+=$(getYMLine3 "- JOOMLA_ADMIN_USER=\${VDM_${VDM_ENV_KEY^^}_JOOMLA_ADMIN_USER}")
      VDM_EXTRA_JOOMLA_ENV+=$(getYMLine3 "- JOOMLA_ADMIN_EMAIL=\${VDM_${VDM_ENV_KEY^^}_JOOMLA_ADMIN_EMAIL}")
      VDM_EXTRA_JOOMLA_ENV+=$(getYMLine3 "- JOOMLA_ADMIN_PASSWORD=\${VDM_${VDM_ENV_KEY^^}_JOOMLA_ADMIN_PASSWORD}")
      if $enable_extension_autodeploy; then
        # add extra Joomla envs
        setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_EXTENSIONS_URLS=\"${VDM_J_EXTENSIONS_URLS}\"" || return $?
        VDM_EXTRA_JOOMLA_ENV+=$(getYMLine3 "- JOOMLA_EXTENSIONS_URLS=\${VDM_${VDM_ENV_KEY^^}_EXTENSIONS_URLS}")
      fi
      if $enable_command_autodeploy; then
        # add extra Joomla envs
        setContainerEnvVariable "VDM_${VDM_ENV_KEY^^}_CLI_COMMANDS=\"${VDM_J_CLI_COMMANDS}\"" || return $?
        VDM_EXTRA_JOOMLA_ENV+=$(getYMLine3 "- JOOMLA_CLI_COMMANDS=\${VDM_${VDM_ENV_KEY^^}_CLI_COMMANDS}")
      fi
    fi
    # set persistence
    reset_volume=true
    VDM_JOOMLA_VOLUMES_MOUNT=$(getYMLine3 "- \"\${VDM_PROJECT_PATH}/${VDM_KEY}/joomla:/var/www/html\"")
    VDM_DB_VOLUMES_MOUNT=$(getYMLine3 "- \"\${VDM_PROJECT_PATH}/${VDM_KEY}/db:${VDM_DATABASE_MOUNT:-/var/lib/mysql}\"")
    VDM_VOLUMES='volumes:'
    if ! $persistence_volume; then
      VDM_JOOMLA_VOLUMES_MOUNT=$(getYMLine3 "- ${VDM_KEY,,}_web:/var/www/html")
      VDM_VOLUMES+=$(getYMLine1 "${VDM_KEY,,}_web:")
      reset_volume=false
    fi
    if ! $persistence_db; then
      VDM_DB_VOLUMES_MOUNT=$(getYMLine3 "- ${VDM_KEY,,}_db:${VDM_DATABASE_MOUNT:-/var/lib/mysql}")
      VDM_VOLUMES+=$(getYMLine1 "${VDM_KEY,,}_db:")
      reset_volume=false
    fi
    # add PHP settings
    if $set_php_settings; then
      VDM_JOOMLA_VOLUMES_MOUNT+=$(getYMLine3 "- \"\${VDM_PROJECT_PATH}/${VDM_PHP_PROJECT_PATH}/php.ini:${VDM_PHP_INI_TARGET:-/var/www/html/php.ini}\"")
    fi
    # customize docker-entrypoint.sh
    if $set_docker_entry_point; then
      VDM_JOOMLA_VOLUMES_MOUNT+=$(getYMLine3 "- \"\${VDM_PROJECT_PATH}/${VDM_ENTRY_PROJECT_PATH}/entrypoint.sh:/entrypoint.sh\"")
    fi
    # check if we have to reset the volume value
    $reset_volume && VDM_VOLUMES=''
    # add the mailcatcher if needed
    if $enable_mailcatcher; then
      VDM_EXTRA_CONTAINER_STUFF=$(getYMLine1 "mailcatcher${VDM_KEY}:")
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine2 "image: schickling/mailcatcher")
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine2 "container_name: mailcatcher${VDM_KEY}")
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine2 "restart: unless-stopped")
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine2 "networks:")
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine3 "- traefik")
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine2 "labels:")
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine3 "# mailcatcher")
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine3 "- \"traefik.enable=true\"")
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine3 "- \"traefik.http.routers.mailcatcher${VDM_KEY}.rule=Host(\`${VDM_SUBDOMAIN}mail.${VDM_DOMAIN}\`)\"")
      if $VDM_SECURE; then
        VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine3 "- \"traefik.http.routers.mailcatcher${VDM_KEY}.entrypoints=${VDM_ENTRY_POINT}\"")
        VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine3 "- \"traefik.http.routers.mailcatcher${VDM_KEY}.tls.certresolver=${VDM_CERT_RESOLVER}\"")
      fi
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine3 "- \"traefik.http.routers.mailcatcher${VDM_KEY}.service=mailcatcher${VDM_KEY}\"")
      VDM_EXTRA_CONTAINER_STUFF+=$(getYMLine3 "- \"traefik.http.services.mailcatcher${VDM_KEY}.loadbalancer.server.port=1080\"")
      VDM_EXTRA_JOOMLA_ENV+=$(getYMLine3 "- JOOMLA_SMTP_HOST=mailcatcher${VDM_KEY}:1025")
    fi
    # setup letsencrypt stuff
    VDM_JOOMLA_SECURE_LABELS=''
    VDM_PHPMYADMIN_SECURE_LABELS=''
    if $VDM_SECURE; then
      # add joomla labels
      VDM_JOOMLA_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.routers.joomla${VDM_KEY}.entrypoints=${VDM_ENTRY_POINT}\"")
      VDM_JOOMLA_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.routers.joomla${VDM_KEY}.tls.certresolver=${VDM_CERT_RESOLVER}\"")
      VDM_JOOMLA_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.routers.joomla${VDM_KEY}.service=joomla${VDM_KEY}\"")
      VDM_JOOMLA_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.routers.joomla${VDM_KEY}.middlewares=${vdm_middlewares}\"")
      VDM_JOOMLA_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.services.joomla${VDM_KEY}.loadbalancer.server.port=80\"")
      # add phpmyadmin labels
      VDM_PHPMYADMIN_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.routers.phpmyadmin${VDM_KEY}.entrypoints=${VDM_ENTRY_POINT}\"")
      VDM_PHPMYADMIN_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.routers.phpmyadmin${VDM_KEY}.tls.certresolver=${VDM_CERT_RESOLVER}\"")
      VDM_PHPMYADMIN_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.routers.phpmyadmin${VDM_KEY}.service=phpmyadmin${VDM_KEY}\"")
      VDM_PHPMYADMIN_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.routers.phpmyadmin${VDM_KEY}.middlewares=${vdm_middlewares}\"")
      VDM_PHPMYADMIN_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.services.phpmyadmin${VDM_KEY}.loadbalancer.server.port=80\"")
    fi
    # global
    export VDM_KEY
    export VDM_ENV_KEY
    export VDM_SUBDOMAIN
    # container
    export VDM_VOLUMES
    export VDM_JOOMLA_VOLUMES_MOUNT
    export VDM_DB_VOLUMES_MOUNT
    export VDM_EXTRA_CONTAINER_STUFF
    export VDM_JOOMLA_SECURE_LABELS
    export VDM_PHPMYADMIN_SECURE_LABELS
    export VDM_EXTRA_JOOMLA_ENV
    # container lower
    export vdm_database_name
    export vdm_database_user
    export vdm_database_pass
    export vdm_database_rootpass
    if isFunc joomlaSetupWebPrepare; then joomlaSetupWebPrepare || return $?; fi
    joomlaSaveSetupChoices || return $?
    joomlaPublishSetup || return $?
    OCTOJOOM_SETUP_ASSIGNMENTS=("VDM_PROJECT_PATH=\"${VDM_PROJECT_PATH}\"")
    # enable the container
    if $enable_containers; then
      # we set the container details
      export VDM_CONTAINER="${VDM_SUBDOMAIN}.${VDM_DOMAIN}"
      # then we enable it
      enableContainer "${VDM_CONTAINER_TYPE}" || return $?
    fi
  done
  if [ "${VDM_SAVE_DEFAULTS:-false}" = true ]; then joomlaSaveSetupDefaults || return $?; fi
  ##########################
  ### unset all no longer needed
  # container
  unset VDM_SUBDOMAIN
  unset VDM_J_REPO
  unset VDM_ENTRY_REPO
  unset VDM_JV
  unset VDM_KEY
  unset VDM_ENV_KEY
  unset VDM_REMOVE_SECURE
  unset VDM_ENTRY_POINT
  unset VDM_CERT_RESOLVER
  unset VDM_HTTP_SCHEME
  unset VDM_PERSISTENCE
  unset VDM_NOT_PERSISTENCE
  unset VDM_VOLUMES
  unset VDM_JOOMLA_VOLUMES_MOUNT
  unset VDM_DB_VOLUMES_MOUNT
  unset VDM_NUMBER_CONTAINERS
  unset VDM_PHP_PROJECT_PATH
  unset VDM_ENTRY_PROJECT_PATH
  unset VDM_EXTRA_CONTAINER_STUFF
  unset VDM_WEB_WORKING_DIR VDM_WEB_SERVICE VDM_WEB_HEALTH VDM_WEB_LABELS VDM_WEB_EXPOSE
  unset VDM_WEBSERVER VDM_DOCROOT VDM_NGINX_IMAGE VDM_NGINX_CONFIG
  unset VDM_JOOMLA_SECURE_LABELS
  unset VDM_PHPMYADMIN_SECURE_LABELS
  unset VDM_J_SITE_NAME
  unset VDM_J_USERNAME
  unset VDM_J_USER
  unset VDM_J_EMAIL
  unset VDM_J_PASSWORD
  unset VDM_J_EXTENSIONS_URLS
  unset VDM_J_CLI_COMMANDS
  # container lower
  unset vdm_database_name
  unset vdm_database_user
  unset vdm_database_pass
  unset vdm_database_rootpass
  # return a success
  return 0
  )
}

#####################################################################################################################VDM
######################################## SETUP OPENSSH
function openssh__TRuST__setup() {
  # load this container type globals
  # shellcheck disable=SC1090
  if [ -f "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" ]; then
    loadEnvFile "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" || return 1
  fi
  cliApplyValues
  # get the ssh port if not set
  while ! [[ "${VDM_PORT:-}" =~ ^[0-9]{1,5}$ ]] ||
    [ "$((10#${VDM_PORT:-0}))" -lt 1 ] || [ "$((10#${VDM_PORT:-0}))" -gt 65535 ] ||
    [ "$((10#${VDM_PORT:-0}))" -eq 22 ]; do
    # get the value
    VDM_PORT=$(getInput 'Enter ssh port to use\n[do not use 22]' '' 'Enter Port') || return $?
    # keep asking
    if ! [[ "${VDM_PORT}" =~ ^[0-9]{1,5}$ ]] ||
      [ "$((10#${VDM_PORT:-0}))" -lt 1 ] || [ "$((10#${VDM_PORT:-0}))" -gt 65535 ] ||
      [ "$((10#${VDM_PORT:-0}))" -eq 22 ]; then
      showError "Enter an SSH port from 1 to 65535, excluding port 22."
    fi
  done
  VDM_PORT=$((10#${VDM_PORT}))
  # set the main domain if not set
  setMainDomain || return $?
  # get the username if not set
  while ! [[ "${VDM_USER_NAME:-}" =~ ^[a-z][a-z0-9-]{0,31}$ ]] ||
    [ -d "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available/${VDM_USER_NAME}.${VDM_DOMAIN}" ]; do
    # get the value
    VDM_USER_NAME=$(getInput 'Enter username of the container\n[Start with a lowercase letter; use lowercase letters, digits and hyphens, up to 32 characters]' 'ubuntu' 'Enter Username') || return $?
    # keep asking if empty or does exist
    if ! [[ "${VDM_USER_NAME}" =~ ^[a-z][a-z0-9-]{0,31}$ ]]; then
      showError "Enter a username of up to 32 characters, starting with a lowercase letter and using lowercase letters, digits and hyphens."
    elif [ -d "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available/${VDM_USER_NAME}.${VDM_DOMAIN}" ]; then
      showError "The username:${VDM_USER_NAME} is already used. Select another"
    elif [ ${#VDM_USER_NAME} -le 1 ]; then
      showError "You must enter a username for the container"
    fi
  done
  # be sure to set the container USER ID
  setContainerUser 33 || return $?
  # get the key if not set
  setUniqueKey "Enter key used for container naming." || return $?
  # get the env key if not set
  setEnvironmentKey || return $?
  # we check if it was set
  [ ${#VDM_PUBLIC_KEY_GLOBAL_DIR} -le 1 ] && VDM_PUBLIC_KEY_GLOBAL_DIR="${VDM_PUBLIC_KEY_DIR:-}"
  # get the global directory of the ssh public keys if not set
  while [ ${#VDM_PUBLIC_KEY_GLOBAL_DIR} -le 1 ] || [ ! -d "${VDM_PUBLIC_KEY_GLOBAL_DIR}" ]; do
    # creat the path if it exist
    if [ ${#VDM_PUBLIC_KEY_GLOBAL_DIR} -ge 1 ] && \
      getInputYesNo "Can we create the ${VDM_PUBLIC_KEY_GLOBAL_DIR} ssh folder" \
      "Create the Path" 8 112; then
      createPrivateDirectory -p "${VDM_PUBLIC_KEY_GLOBAL_DIR}" || return $?
    else
      # get the value
      VDM_PUBLIC_KEY_GLOBAL_DIR=$(getInput "Enter the ssh path where we can select the ssh key folders from." \
        "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.ssh" 'Enter SSH Path') || return $?
      # keep asking if empty or does exist
      if [ ${#VDM_PUBLIC_KEY_GLOBAL_DIR} -ge 1 ] && [ ! -d "${VDM_PUBLIC_KEY_GLOBAL_DIR}" ] && \
        getInputYesNo "Can we create the ${VDM_PUBLIC_KEY_GLOBAL_DIR} ssh folder" \
        "Create the Path" 8 112; then
        createPrivateDirectory -p "${VDM_PUBLIC_KEY_GLOBAL_DIR}" || return $?
      elif [ ${#VDM_PUBLIC_KEY_GLOBAL_DIR} -le 1 ]; then
        showError "You must set a ssh path where we can select the ssh key folders from."
      fi
    fi
  done
  # set the global key env string for the ssh keys
  VDM_ENV_PUBLIC_KEY_U_DIR="VDM_${VDM_ENV_KEY^^}_PUBLIC_KEY_DIR"
  cliHasValue VDM_PUBLIC_KEY_U_DIR || VDM_PUBLIC_KEY_U_DIR=${!VDM_ENV_PUBLIC_KEY_U_DIR}
  # get the directory of this containers public keys if not set
  while [ ${#VDM_PUBLIC_KEY_U_DIR} -le 1 ] || [ ! -d "${VDM_PUBLIC_KEY_U_DIR}" ]; do
    # creat the path if it exist
    if [ ${#VDM_PUBLIC_KEY_U_DIR} -ge 1 ] && \
      getInputYesNo "Can we create this (${VDM_PUBLIC_KEY_U_DIR}) containers' ssh public keys folder" \
      "Create the Path" 8 112; then
      createPrivateDirectory -p "${VDM_PUBLIC_KEY_U_DIR}" || return $?
    else
      # get the value
      VDM_PUBLIC_KEY_U_DIR=$(getSelectedDirectory "Select the containers' ssh public keys folder." \
        "${VDM_PUBLIC_KEY_GLOBAL_DIR}" "${VDM_KEY,,}" 'Select Folder') || return $?
      # keep asking if empty or does exist
      if [ ${#VDM_PUBLIC_KEY_U_DIR} -ge 1 ]; then
        # add the parent dir back
        VDM_PUBLIC_KEY_U_DIR="${VDM_PUBLIC_KEY_GLOBAL_DIR}/${VDM_PUBLIC_KEY_U_DIR}"
        # check if this directory exist
        if [ ! -d "${VDM_PUBLIC_KEY_U_DIR}" ] && \
          getInputYesNo "Can we create this (${VDM_PUBLIC_KEY_U_DIR}) containers' ssh public keys folder" \
          "Create the Path" 8 112; then
          createPrivateDirectory -p "${VDM_PUBLIC_KEY_U_DIR}" || return $?
          # TODO add option to add keys?
        fi
      else
        showError "You must set a containers' ssh public keys folder."
      fi
    fi
  done
  # we must get the project path
  VDM_ENV_PROJECT_DIR="VDM_${VDM_ENV_KEY^^}_PROJECT_DIR"
  cliHasValue VDM_PROJECT_U_DIR || VDM_PROJECT_U_DIR=${!VDM_ENV_PROJECT_DIR}
  # get the directory of the ssh public keys if not set
  while [ ${#VDM_PROJECT_U_DIR} -le 1 ] || [ ! -d "${VDM_PROJECT_U_DIR}" ]; do
    # creat the path if it exist
    if [ ${#VDM_PROJECT_U_DIR} -ge 1 ] && \
      getInputYesNo "Can we create the ${VDM_PROJECT_U_DIR} parent mounting directory" \
      "Create the Path" 8 112; then
      createPrivateDirectory -p "${VDM_PROJECT_U_DIR}" || return $?
    else
      # get the value
      VDM_PROJECT_U_DIR=$(getInput "Enter the parent path where we can select the folders to mount to this container." \
        "${VDM_PROJECT_PATH}" 'Enter Path') || return $?
      # keep asking if empty or does exist
      if [ ${#VDM_PROJECT_U_DIR} -ge 1 ] && [ ! -d "${VDM_PROJECT_U_DIR}" ] && \
        getInputYesNo "Can we create the ${VDM_PROJECT_U_DIR} parent mounting directory" \
        "Create the Path" 8 112; then
        createPrivateDirectory -p "${VDM_PROJECT_U_DIR}" || return $?
      elif [ ${#VDM_PROJECT_U_DIR} -le 1 ]; then
        showError "You must set a parent mounting directory path where we can select the folders to mount to this container."
      fi
    fi
  done
  # now load the mounting volumes
  while [ ${#VDM_MOUNT_DIRS} -le 1 ]; do
    # get the value
    VDM_MOUNT_DIRS=$(getSelectedDirectories "Select the directories to mount to this container." \
      "${VDM_PROJECT_U_DIR}" 'Select Folders') || return $?
    # keep asking if empty or does exist
    if [ ${#VDM_MOUNT_DIRS} -le 1 ]; then
      showError "You must set the directories to mount to this container."
    fi
  done
  # convert the string to an array
  IFS=' ' read -r -a vdm_mount_dirs_array <<<"${VDM_MOUNT_DIRS[@]}"
  # build the mount projects
  VDM_VOLUMES_MOUNT=$(getYMLine3 "- \${${VDM_ENV_PUBLIC_KEY_U_DIR}}:/config/ssh_public_keys")
  # loop over the directories to build the
  for mDir in "${vdm_mount_dirs_array[@]}"; do
    # set the full path
    mDir="${mDir//\"/}"
    # when we mount a joomla volume we may not want to mount the database
    mFull="${VDM_PROJECT_U_DIR}/${mDir}/joomla"
    # add to mount projects
    if [ -d "${mFull}" ] && \
      getInputYesNo "Should we ONLY mount the (joomla website files) ${mDir}/joomla directory" \
      "Mount Joomla" 8 112; then
      VDM_VOLUMES_MOUNT+=$(getYMLine3 "- \${VDM_${VDM_ENV_KEY^^}_PROJECT_DIR}/${mDir}/joomla:/app/${mDir}")
    else
      VDM_VOLUMES_MOUNT+=$(getYMLine3 "- \${VDM_${VDM_ENV_KEY^^}_PROJECT_DIR}/${mDir}:/app/${mDir}")
    fi
  done
  # add this value if not set variable
  setContainerEnvVariable "${VDM_ENV_PROJECT_DIR}=\"${VDM_PROJECT_U_DIR}\"" || return $?
  # add this value if not set variable
  setContainerEnvVariable "VDM_PUBLIC_KEY_GLOBAL_DIR=\"${VDM_PUBLIC_KEY_GLOBAL_DIR}\"" || return $?
  # add this value if not set variable
  setContainerEnvVariable "${VDM_ENV_PUBLIC_KEY_U_DIR}=\"${VDM_PUBLIC_KEY_U_DIR}\"" || return $?
  ##########################
  ### export all we need
  # global
  export VDM_CONTAINER_TYPE
  export VDM_REPO_PATH
  export VDM_PROJECT_PATH
  # container
  export VDM_PORT
  export VDM_USER_NAME
  export VDM_PUBLIC_KEY_GLOBAL_DIR
  export VDM_PUBLIC_KEY_U_DIR
  export VDM_VOLUMES_MOUNT
  export VDM_PROJECT_U_DIR
  saveContainerCompose opensshContainer "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available/${VDM_USER_NAME}.${VDM_DOMAIN}/docker-compose.yml" || return 1
  # saved the file
  showNotice "Saved ${VDM_CONTAINER_TYPE}:docker-compose.yml file.\nSetup of this container is complete!"
  # ask if we should continue to enable
  if [ "${VDM_ENABLE:-false}" = true ] || { [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] && getInputYesNo "Would you also like to enable this ${VDM_CONTAINER_TYPE^} container" \
    "Enable Container" 8 112 "defaultno"; }; then
    # we set the container details
    export VDM_CONTAINER="${VDM_USER_NAME}.${VDM_DOMAIN}"
    # then we enable it
    enableContainer "${VDM_CONTAINER_TYPE}" || return $?
  fi
  ##########################
  ### unset all no longer needed
  # container
  unset VDM_PORT
  unset VDM_USER_NAME
  unset VDM_KEY
  unset VDM_ENV_KEY
  unset VDM_PUBLIC_KEY_GLOBAL_DIR
  unset VDM_PUBLIC_KEY_U_DIR
  unset VDM_VOLUMES_MOUNT
  unset VDM_PROJECT_U_DIR
  # return a success
  return 0
}

# return the Openssh Container setup yml
function opensshContainer() {
  # we build the yml file
  cat <<EOF
services:
  openssh-server-${VDM_KEY}:
    image: lscr.io/linuxserver/openssh-server
    container_name: openssh-server-${VDM_KEY}
    restart: unless-stopped
    hostname: ${VDM_DOMAIN:-vdm.dev}
    environment:
      - PUID=${VDM_PUID}
      - PGID=${VDM_PGID}
      - TZ=${VDM_TZ:-Africa/Windhoek}
      - PUBLIC_KEY_DIR=/config/ssh_public_keys
      - SUDO_ACCESS=${VDM_SUDO_ACCESS:-false}
      - USER_NAME=${VDM_USER_NAME:-ubuntu}
    volumes:${VDM_VOLUMES_MOUNT}
    ports:
      - ${VDM_PORT}:2222
    networks:
      - openssh

networks:
  openssh:
    external: true
    name: ${VDM_OPENSSH_GATEWAY:-openssh_gateway}
EOF
}

