# Format 2 extends the existing manifest.env / compose / project package. SQL is
# logical database data; no database engine's raw files enter a portable backup.
function joomlaBackupError() {
  printf 'Backup: %s\n' "$*" >&2
  return 1
}

function joomlaBackupSafeMember() {
  local member="${1#./}"
  member="${member%/}"
  [[ -n "$member" && "$member" != /* && "$member" != *\\* && "$member" != *[![:print:]]* ]] || return 1
  case "/$member/" in *'/../'*|*'/./'*|*'//'*) return 1;; esac
  case "$member" in manifest.env|compose|compose/*|project|project/*) ;; *) return 1;; esac
}

function joomlaBackupManifest() {
  local file="$1" line name value seen=' ' scope='' engine='' version='' required
  [ -f "$file" ] && [ ! -L "$file" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ ^(VDM_MIGRATION_[A-Z_]+)=(.*)$ ]] || return 1
    name="${BASH_REMATCH[1]}"
    decodeEnvValue "${BASH_REMATCH[2]}" value || return 1
    [[ "$seen" != *" $name "* && "$value" != *[![:print:]]* ]] || return 1
    seen+="$name "
    case "$name" in
      VDM_MIGRATION_FORMAT) [ "$value" = 2 ] || return 1; version="$value";;
      VDM_MIGRATION_CONTAINER) isValidDomain "$value" || return 1;;
      VDM_MIGRATION_KEY|VDM_MIGRATION_ENV_KEY) [[ "$value" =~ ^[A-Za-z]+$ ]] || return 1;;
      VDM_MIGRATION_PROJECT_FOLDER) isSafeProjectName "$value" || return 1;;
      VDM_MIGRATION_SCOPE) case "$value" in full|website|database|files) scope="$value";; *) return 1;; esac;;
      VDM_MIGRATION_PAYLOAD) [ "$value" = logical ] || return 1;;
      VDM_MIGRATION_DB_PREFIX) [[ "$value" =~ ^[A-Za-z0-9_]*$ ]] || return 1;;
      VDM_MIGRATION_DB_ENGINE) case "$value" in mysql|mariadb|postgres|none) engine="$value";; *) return 1;; esac;;
      VDM_MIGRATION_CREATED) [[ "$value" =~ ^[0-9]{10,}$ ]] || return 1;;
      VDM_MIGRATION_LABEL) [[ ${#value} -le 80 ]] || return 1;;
      VDM_MIGRATION_DOCROOT) [[ "$value" = . || "$value" =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ ]] || return 1; case "/$value/" in *'/../'*) return 1;; esac;;
      *) return 1;;
    esac
  done < "$file"
  for required in FORMAT CONTAINER KEY ENV_KEY PROJECT_FOLDER SCOPE PAYLOAD DB_ENGINE DB_PREFIX CREATED LABEL DOCROOT; do
    [[ "$seen" = *" VDM_MIGRATION_${required} "* ]] || return 1
  done
  [ "$version" = 2 ] && { [ "$scope" = files ] || [ "$engine" != none ]; }
}

function joomlaBackupValidateArchive() {
  local archive="$1" names types member normalized
  local -A member_seen=()
  [ -f "$archive" ] && [ ! -L "$archive" ] || return 1
  case "$archive" in
    *.zip)
      command -v unzip >/dev/null 2>&1 || { joomlaBackupError 'ZIP restore requires unzip.'; return 1; }
      UNZIP='' UNZIPOPT='' unzip -P '' -tqq "$archive" >/dev/null 2>&1 || return 1
      names=$(UNZIP='' UNZIPOPT='' unzip -Z -1 "$archive") || return 1
      types=$(UNZIP='' UNZIPOPT='' unzip -Z -l "$archive") || return 1
      # Unix link/special-file attributes must not be interpreted by extraction.
      while IFS= read -r member; do
        case "$member" in l?????????*|b?????????*|c?????????*|p?????????*|s?????????*) return 1;; esac
      done <<< "$types"
      while IFS= read -r member; do
        member="${member%$'\r'}"
        joomlaBackupSafeMember "$member" || return 1
        normalized="${member#./}"; normalized="${normalized%/}"
        [ -z "${member_seen[$normalized]+set}" ] || return 1
        member_seen["$normalized"]=1
      done <<< "$names"
      [ -n "$names" ]
      ;;
    *) migrationValidateTar "$archive" bundle;;
  esac
}

# Relative path metadata is validated before any privileged ownership changes.
# Both formats carry this table, so ZIP restores the same modes/UIDs/GIDs as tar.
function joomlaBackupFileMetadata() {
  (
    umask 077
    local package="$1" path relative mode uid gid extra work stat_option stat_format
    local -a backup_roots=() backup_batch_paths=()
    work=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-file-metadata.XXXXXXXX") || exit 1
    trap 'rm -rf -- "$work"' EXIT
    for path in "$package/project/joomla" "$package/project/extra"; do [ ! -d "$path" ] || backup_roots+=("$path"); done
    : > "$work/paths"; : > "$work/stat"
    if [ "${#backup_roots[@]}" -gt 0 ]; then
      runPrivileged find "${backup_roots[@]}" -depth -print0 > "$work/paths" || exit 1
    fi
    if stat -c '%a' "$package" >/dev/null 2>&1; then stat_option=-c; stat_format=$'%a\t%u\t%g\t%n'
    else stat_option=-f; stat_format=$'%Lp\t%u\t%g\t%N'; fi
    while IFS= read -r -d '' path; do
      relative="${path#"$package/"}"
      joomlaBackupSafeMember "$relative" || exit 1
      backup_batch_paths+=("$path")
      if [ "${#backup_batch_paths[@]}" -ge 200 ]; then
        runPrivileged stat "$stat_option" "$stat_format" "${backup_batch_paths[@]}" >> "$work/stat" || exit 1
        backup_batch_paths=()
      fi
    done < "$work/paths"
    if [ "${#backup_batch_paths[@]}" -gt 0 ]; then runPrivileged stat "$stat_option" "$stat_format" "${backup_batch_paths[@]}" >> "$work/stat" || exit 1; fi
    : > "$work/metadata"
    while IFS=$'\t' read -r mode uid gid path extra; do
      [[ -z "$extra" && "$mode" =~ ^[01]?[0-7]{3}$ && "$uid" =~ ^[0-9]{1,10}$ && "$gid" =~ ^[0-9]{1,10}$ && "$path" == "$package/"* ]] || exit 1
      printf '%s\t%s\t%s\t%s\n' "$mode" "$uid" "$gid" "${path#"$package/"}" >> "$work/metadata" || exit 1
    done < "$work/stat"
    cat "$work/metadata" > "$package/project/files.meta"
  )
}

function joomlaBackupApplyMetadata() {
  (
    umask 077
    local package="$1" mode uid gid path extra work previous='' group
    local -A metadata_seen=()
    local -a backup_roots=() backup_batch_paths=()
    [ -f "$package/project/files.meta" ] && [ ! -L "$package/project/files.meta" ] || exit 1
    work=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-apply-metadata.XXXXXXXX") || exit 1
    trap 'rm -rf -- "$work"' EXIT
    while IFS=$'\t' read -r mode uid gid path extra; do
      [[ -z "$extra" && "$mode" =~ ^[01]?[0-7]{3}$ && "$uid" =~ ^[0-9]{1,10}$ && "$gid" =~ ^[0-9]{1,10}$ ]] || exit 1
      joomlaBackupSafeMember "$path" || exit 1
      [[ "$path" != ./* && "$path" != */ ]] || exit 1
      case "$path" in project/joomla|project/joomla/*|project/extra|project/extra/*) ;; *) exit 1;; esac
      [ -z "${metadata_seen[$path]+set}" ] && [ -e "$package/$path" ] && [ ! -L "$package/$path" ] || exit 1
      metadata_seen["$path"]=1
    done < "$package/project/files.meta"
    for path in "$package/project/joomla" "$package/project/extra"; do [ ! -d "$path" ] || backup_roots+=("$path"); done
    : > "$work/paths"
    if [ "${#backup_roots[@]}" -gt 0 ]; then find "${backup_roots[@]}" -print0 > "$work/paths" || exit 1; fi
    while IFS= read -r -d '' path; do
      [ -n "${metadata_seen[${path#"$package/"}]+set}" ] || exit 1
      [ ! -L "$path" ] && { [ -f "$path" ] || [ -d "$path" ]; } || exit 1
    done < "$work/paths"
    # Deeper paths must precede parents; equal-depth paths cannot be ancestors.
    # Group equal settings at each depth so alternating directories/files do not
    # turn a Joomla tree into thousands of individual sudo/chown/chmod calls.
    awk -F '\t' 'BEGIN {OFS="\t"} {depth=split($4,parts,"/"); print depth,$0}' "$package/project/files.meta" > "$work/depth" || exit 1
    LC_ALL=C sort -t $'\t' -k1,1nr -k2,2 -k3,3n -k4,4n "$work/depth" > "$work/sorted" || exit 1
    cut -f2- "$work/sorted" > "$work/ordered" || exit 1
    while IFS=$'\t' read -r mode uid gid path extra; do
      group="$mode:$uid:$gid"
      if [ "${#backup_batch_paths[@]}" -gt 0 ] && { [ "$group" != "$previous" ] || [ "${#backup_batch_paths[@]}" -ge 200 ]; }; then
        runPrivileged chown "${previous#*:}" "${backup_batch_paths[@]}" && runPrivileged chmod "${previous%%:*}" "${backup_batch_paths[@]}" || exit 1
        backup_batch_paths=()
      fi
      backup_batch_paths+=("$package/$path"); previous="$group"
    done < "$work/ordered"
    if [ "${#backup_batch_paths[@]}" -gt 0 ]; then
      runPrivileged chown "${previous#*:}" "${backup_batch_paths[@]}" && runPrivileged chmod "${previous%%:*}" "${backup_batch_paths[@]}" || exit 1
    fi
  )
}

# Hash batches of validated filenames, keeping filenames with spaces literal.
# Callers supply a checked NUL inventory; failures cannot be lost in a pipeline.
function joomlaBackupHashInventory() {
  local package="$1" inventory="$2" output="$3" path line digest relative
  local -a backup_batch_paths=() hash_command=(sha256sum -b)
  command -v sha256sum >/dev/null 2>&1 || hash_command=(shasum -a 256 -b)
  : > "$output.raw" || return 1
  while IFS= read -r -d '' path; do
    relative="${path#"$package/"}"
    [[ "$path" == "$package/"* ]] && joomlaBackupSafeMember "$relative" || return 1
    [ "$relative" != project/checksums ] || continue
    backup_batch_paths+=("$path")
    if [ "${#backup_batch_paths[@]}" -ge 200 ]; then
      runPrivileged "${hash_command[@]}" -- "${backup_batch_paths[@]}" >> "$output.raw" || return 1
      backup_batch_paths=()
    fi
  done < "$inventory"
  if [ "${#backup_batch_paths[@]}" -gt 0 ]; then runPrivileged "${hash_command[@]}" -- "${backup_batch_paths[@]}" >> "$output.raw" || return 1; fi
  : > "$output" || return 1
  while IFS= read -r line; do
    digest="${line:0:64}" path="${line:66}"
    [[ "$digest" =~ ^[a-f0-9]{64}$ && ( "${line:64:2}" = '  ' || "${line:64:2}" = ' *' ) && "$path" == "$package/"* ]] || return 1
    printf '%s\t%s\n' "$digest" "${path#"$package/"}" >> "$output" || return 1
  done < "$output.raw"
}

function joomlaBackupChecksums() {
  (
    umask 077
    local package="$1" work
    work=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-checksums.XXXXXXXX") || exit 1
    trap 'rm -rf -- "$work"' EXIT
    runPrivileged find "$package/manifest.env" "$package/compose" "$package/project" -type f -print0 > "$work/paths" || exit 1
    joomlaBackupHashInventory "$package" "$work/paths" "$work/checksums" || exit 1
    cat "$work/checksums" > "$package/project/checksums"
  )
}

function joomlaBackupVerifyChecksums() {
  (
    umask 077
    local package="$1" digest path extra work count=0
    local -A checksum_seen=()
    [ -s "$package/project/checksums" ] && [ ! -L "$package/project/checksums" ] || exit 1
    work=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-verify-checksums.XXXXXXXX") || exit 1
    trap 'rm -rf -- "$work"' EXIT
    while IFS=$'\t' read -r digest path extra; do
      [[ -z "$extra" && "$digest" =~ ^[a-f0-9]{64}$ ]] && joomlaBackupSafeMember "$path" || exit 1
      [[ "$path" != ./* && "$path" != */ ]] || exit 1
      [ -z "${checksum_seen[$path]+set}" ] && [ "$path" != project/checksums ] && [ -f "$package/$path" ] && [ ! -L "$package/$path" ] || exit 1
      checksum_seen["$path"]="$digest"
    done < "$package/project/checksums"
    find "$package" -type f -print0 > "$work/paths" || exit 1
    joomlaBackupHashInventory "$package" "$work/paths" "$work/checksums" || exit 1
    while IFS=$'\t' read -r digest path; do
      [ "${checksum_seen[$path]:-}" = "$digest" ] || exit 1
      count=$((count+1))
    done < "$work/checksums"
    [ "$count" -eq "${#checksum_seen[@]}" ]
  )
}

function joomlaBackupExtract() {
  local archive="$1" destination="$2" version scope digest expected contents
  [ -d "$destination" ] && ! migrationPathHasSymlink "$destination" || return 1
  contents=$(find "$destination" -mindepth 1 -print -quit) || return 1
  [ -z "$contents" ] || return 1
  chmod 700 "$destination" || return 1
  joomlaBackupValidateArchive "$archive" || { joomlaBackupError 'Archive has unsafe paths, unsupported file types, or damaged compression.'; return 1; }
  if [ -f "$archive.sha256" ]; then
    read -r expected < "$archive.sha256"
    [[ "$expected" =~ ^[a-f0-9]{64}$ ]] || return 1
    digest=$(migrationArchiveDigest "$archive") || return 1
    [ "$expected" = "$digest" ] || { joomlaBackupError 'Archive checksum does not match.'; return 1; }
  fi
  case "$archive" in
    *.zip) UNZIP='' UNZIPOPT='' unzip -P '' -qq "$archive" -d "$destination" || return $?;;
    *) TAR_OPTIONS='' tar --no-same-owner --no-same-permissions -xzf "$archive" -C "$destination" || return $?;;
  esac
  migrationValidateTree "$destination" || return 1
  chmod -R u+rwX "$destination" || return 1
  migrationReadEnvValue "$destination/manifest.env" VDM_MIGRATION_FORMAT version || return 1
  if [ "$version" = 1 ]; then
    migrationValidateManifest "$destination/manifest.env" && migrationValidateScopedEnv "$destination/compose/docker-compose.yml" "$destination/compose/.env"
    return $?
  fi
  if ! joomlaBackupManifest "$destination/manifest.env" || ! joomlaBackupVerifyChecksums "$destination"; then
    joomlaBackupError 'Archive metadata or payload checksums are invalid.'; return 1
  fi
  migrationReadEnvValue "$destination/manifest.env" VDM_MIGRATION_SCOPE scope || return 1
  [ "$scope" = files ] || [ -s "$destination/project/database.sql" ] || return 1
  [ "$scope" = database ] || [ -d "$destination/project/joomla" ] || return 1
  [ "$scope" != full ] || { [ -f "$destination/compose/docker-compose.yml" ] && [ -f "$destination/compose/.env" ]; } || return 1
  if [ -f "$destination/compose/docker-compose.yml" ] || [ -f "$destination/compose/.env" ]; then
    migrationValidateScopedEnv "$destination/compose/docker-compose.yml" "$destination/compose/.env" || {
      joomlaBackupError 'Archive environment is incomplete or contains settings outside this site.'; return 1;
    }
  fi
  joomlaBackupApplyMetadata "$destination" || return 1
  chmod 700 "$destination" "$destination/compose" || return 1
  chmod 600 "$destination/manifest.env" "$destination/project/checksums" "$destination/project/files.meta" || return 1
}

# Compose uses native Windows host paths; filesystem guards need Git Bash paths.
# Check aliases before conversion so cygpath cannot conceal traversal. Container
# targets and named volumes must never pass through this host-only helper.
function joomlaBackupFilesystemPath() {
  local path="$1"
  if [ "${OS_NUMBER:-0}" = 3 ]; then path="${path//\\//}"; fi
  [[ -n "$path" && "$path" != *[![:print:]]* ]] || return 1
  case "$path/" in *'/../'*|*'/./'*|*'//'*) return 1;; esac
  if [ "${OS_NUMBER:-0}" = 3 ] && command -v cygpath >/dev/null 2>&1; then
    cygpath -au -- "$path"
  else
    printf '%s\n' "$path"
  fi
}

# Capture only referenced site-local dependencies; unrelated or externally
# supplied mounts are a precise full-backup limitation, never silently omitted.
# shellcheck disable=SC2016
function joomlaBackupDependencies() {
  local site="$1" package="$2" config="$3" db="$4" project_root="$5" path type target service relative source actual site_root website_source
  site_root=$(joomlaBackupFilesystemPath "$VDM_SITE_DIR") || return 1
  if [ -n "$project_root" ]; then project_root=$(joomlaBackupFilesystemPath "$project_root") || return 1; fi
  website_source="$VDM_SITE_MOUNT_SOURCE"
  if [ "$VDM_SITE_MOUNT_TYPE" = bind ]; then website_source=$(joomlaBackupFilesystemPath "$website_source") || return 1; fi
  if grep -qE '^[[:space:]]*(include|extends|build|env_file):' "$VDM_SITE_COMPOSE"; then
    joomlaBackupError 'Complete backup requires in-file Compose services and literal environment references; include/extends/build/env_file must be resolved explicitly.'; return 1
  fi
  while IFS=$'\t' read -r service type source target; do
    [ -n "$service" ] || continue
    if [ "$type" = bind ]; then source=$(joomlaBackupFilesystemPath "$source") || return 1; fi
    if [ "$source" = "$website_source" ] && [ "$target" = "$VDM_SITE_MOUNT_TARGET" ]; then continue; fi
    if [ "$service" = "$db" ] && [[ "$target" = /var/lib/mysql || "$target" = /var/lib/postgresql* ]]; then continue; fi
    [ "$type" = bind ] || { joomlaBackupError "Additional volume on $service cannot be captured as a complete project."; return 1; }
    case "$source" in
      "$site_root/"*) relative="${source#"$site_root/"}"; path="$package/compose/$relative";;
      *)
        if [ -n "$project_root" ] && [[ "$source" == "$project_root/"* ]]; then
          relative="${source#"$project_root/"}"; path="$package/project/extra/$relative"
        else joomlaBackupError "Required external mount is not site-local: $source"; return 1; fi;;
    esac
    joomlaBackupSafeMember "${path#"$package/"}" && ! migrationPathHasSymlink "$source" && [ -e "$source" ] || return 1
    if [ -d "$source" ]; then migrationValidateTree "$source" || return 1; else [ -f "$source" ] || return 1; fi
    if [ ! -e "$path" ]; then mkdir -p "${path%/*}" && runPrivileged cp -a "$source" "$path" || return 1; fi
  done < <(printf '%s' "$config" | joomlaSiteJSON -r '.services|to_entries[]|.key as $s|.value.volumes[]?|[$s,.type,.source,.target]|@tsv')
  while IFS= read -r source; do
    [ -n "$source" ] || continue
    source=$(joomlaBackupFilesystemPath "$source") || return 1
    case "$source" in "$site_root/"*) relative="${source#"$site_root/"}";; *) joomlaBackupError 'External Compose config/secret files cannot be captured automatically.'; return 1;; esac
    joomlaBackupSafeMember "compose/$relative" && ! migrationPathHasSymlink "$source" && [ -f "$source" ] || return 1
    mkdir -p "$package/compose/$(dirname "$relative")" || return 1
    [ -e "$package/compose/$relative" ] || cp -p "$source" "$package/compose/$relative" || return 1
  done < <(printf '%s' "$config" | joomlaSiteJSON -r '(.configs//{}),(.secrets//{})|.[]|.file//empty')
  # External Docker configs/secrets have no readable portable payload here.
  printf '%s' "$config" | joomlaSiteJSON -e '[((.configs//{}),(.secrets//{}))|.[]|select(.external==true)]|length==0' >/dev/null || return 1
  # Hook paths are site-local payload; importing never enables them implicitly.
  for target in HOOK_PRE_START HOOK_POST_START HOOK_PRE_STOP HOOK_POST_STOP; do
    migrationReadEnvValue "$VDM_SITE_ENV" "VDM_${VDM_SITE_ENV_KEY}_${target}" source || continue
    [ -n "$source" ] || continue
    case "$source" in
      ./*) relative="${source#./}";;
      *) source=$(joomlaBackupFilesystemPath "$source") || return 1
        case "$source" in "$site_root/"*) relative="${source#"$site_root/"}";; *) joomlaBackupError 'A configured hook is outside the selected site directory.'; return 1;; esac;;
    esac
    joomlaBackupSafeMember "compose/$relative" && ! migrationPathHasSymlink "$VDM_SITE_DIR/$relative" && [ -f "$VDM_SITE_DIR/$relative" ] || return 1
    actual="$package/compose/$relative"
    mkdir -p "${actual%/*}" && cp -p "$VDM_SITE_DIR/$relative" "$actual" && chmod 600 "$actual" || return 1
    writeEnvVariable "$package/compose/.env" "VDM_${VDM_SITE_ENV_KEY}_${target}=./$relative" true || return 1
  done
  writeEnvVariable "$package/compose/.env" "VDM_${VDM_SITE_ENV_KEY}_HOOKS_ENABLED=false" true
}

# Stream the website through tar for both binds and named volumes. The existing
# published application image supplies tar; no custom image or Dockerfile exists.
function joomlaBackupCopyWebsite() {
  local destination="$1" source mount stream status=0
  mkdir -p "$destination" || return 1
  case "$VDM_SITE_MOUNT_TYPE" in
    bind)
      source=$(joomlaBackupFilesystemPath "$VDM_SITE_MOUNT_SOURCE") || return 1
      ! migrationPathHasSymlink "$source" && migrationValidateTree "$source" || return 1
      runPrivileged cp -a "$source/." "$destination/" || return $?
      ;;
    volume)
      source="$VDM_SITE_VOLUME_NAME"
      [[ -n "$source" && "$source" != *,* ]] && docker volume inspect "$source" >/dev/null 2>&1 || return 1
      mount="type=volume,src=$source,dst=/octojoom-site,readonly"
      stream=$(mktemp "${TMPDIR:-/tmp}/octojoom-volume.XXXXXX") || return 1
      # Validate before extracting an untrusted filesystem tree into the host.
      MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' docker run --rm --network none --read-only --user 0:0 --entrypoint tar --env TAR_OPTIONS= --mount "$mount" "$VDM_SITE_IMAGE" -czpf - -C /octojoom-site . > "$stream" || status=$?
      if [ "$status" -eq 0 ]; then migrationValidateTar "$stream" folder || status=$?; fi
      if [ "$status" -eq 0 ]; then TAR_OPTIONS='' runPrivileged tar --numeric-owner --same-owner -xzpf "$stream" -C "$destination" || status=$?; fi
      rm -f "$stream"
      [ "$status" -eq 0 ] || return "$status"
      ;;
    *) joomlaBackupError 'The website mount could not be resolved.'; return 1;;
  esac
  migrationValidateTree "$destination"
}

function joomlaBackupRestoreWebsiteVolume() {
  local directory="$1" volume="$2" image="$3"
  [[ "$volume" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] && migrationValidateTree "$directory" || return 1
  docker volume inspect "$volume" >/dev/null 2>&1 || docker volume create "$volume" >/dev/null || return 1
  (set -o pipefail; TAR_OPTIONS='' runPrivileged tar --numeric-owner -cpf - -C "$directory" . |
    MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' docker run --rm -i --network none --read-only --user 0:0 --entrypoint tar --env TAR_OPTIONS= --mount "type=volume,src=$volume,dst=/octojoom-site" "$image" -xpf - -C /octojoom-site)
}

# Restores exactly the previous running set. Starting a stopped database to dump
# it never enables a website or leaves its application service running.
function joomlaBackupResume() {
  local site="$1" previous="$2" database="$3" db_started="$4" service status=0
  if [ "$db_started" = true ]; then joomlaSiteCompose "$site" stop "$database" >/dev/null 2>&1 || status=$?; fi
  while IFS= read -r service; do
    [ -n "$service" ] || continue
    joomlaSiteCompose "$site" start "$service" >/dev/null 2>&1 || status=$?
  done <<< "$previous"
  return "$status"
}

# Exact-path API shared by menus, batch, engine changes, cloning and transfer.
# No completed filename appears until copy, SQL export, metadata and compression
# have all succeeded. Publication uses adjacent files and preserves old backups.
# shellcheck disable=SC2016
function joomlaBackupCreate() {
  (
    set +x
    umask 077
    local site="$1" archive="$2" scope="${3:-full}" format="${4:-tar.gz}" overwrite="${5:-false}"
    local package='' temporary='' lock='' running='' database='' db_started=false paused=false result=0 config engine=none backup_prefix='' source_lock='' source_locked=false key env_key project relative name value digest suffix original='' original_digest=''
    case "$scope:$format" in full:tar.gz|website:tar.gz|database:tar.gz|files:tar.gz|full:zip|website:zip|database:zip|files:zip) ;; *) joomlaBackupError 'Choose full, website, database or files scope and tar.gz or zip format.'; exit 17;; esac
    command -v jq >/dev/null 2>&1 || { joomlaBackupError 'Backup inspection requires jq.'; exit 1; }
    [ "$format" != zip ] || command -v zip >/dev/null 2>&1 || { joomlaBackupError 'ZIP creation requires zip.'; exit 1; }
    case "$archive" in /*) ;; *) archive="$PWD/$archive";; esac
    [[ "$archive" != *[![:print:]]* && "$archive" != *\\* ]] && [ ! -L "$archive" ] && ! migrationPathHasSymlink "${archive%/*}" || exit 1
    createPrivateDirectory -p "${archive%/*}" || exit 1
    [ ! -L "$archive.sha256" ] || exit 1
    if { [ -e "$archive" ] && [ ! -f "$archive" ]; } || { [ -e "$archive.sha256" ] && [ ! -f "$archive.sha256" ]; }; then
      joomlaBackupError 'Archive and checksum destinations must be regular files.'; exit 17
    fi
    if [ -e "$archive" ] && [ "$overwrite" != true ]; then joomlaBackupError 'Archive exists; choose an explicit overwrite policy.'; exit 17; fi
    resolveJoomlaSite "$site" || exit 1
    source_lock="$VDM_SITE_DIR/.octojoom-change.lock"
    if [ "${6:-false}" != true ]; then
      mkdir "$source_lock" 2>/dev/null || { joomlaBackupError 'Another operation is changing this site.'; exit 1; }
      source_locked=true
    fi
    lock="$archive.lock"
    mkdir "$lock" 2>/dev/null || { [ "$source_locked" != true ] || rmdir "$source_lock"; joomlaBackupError 'This archive is already being written.'; exit 1; }
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    trap '
      result=$?
      if "$paused"; then joomlaBackupResume "$site" "$running" "$database" "$db_started" || { joomlaBackupError "Source services could not be returned to their prior state."; result=1; }; fi
      [ -z "$package" ] || runPrivileged rm -rf -- "$package"
      [ -z "$temporary" ] || rm -f -- "$temporary" "$temporary.sha256"
      if [ -n "$original" ] && [ -f "$original" ]; then mv -f -- "$original" "$archive" || result=1; fi
      if [ -n "$original_digest" ] && [ -f "$original_digest" ]; then mv -f -- "$original_digest" "$archive.sha256" || result=1; fi
      [ -z "$lock" ] || rmdir "$lock" || result=1
      [ "$source_locked" != true ] || rmdir "$source_lock" || result=1
      exit "$result"
    ' EXIT
    readJoomlaSiteFacts "$site" || exit 1
    key="${VDM_SITE_KEY:-unknown}" env_key="${VDM_SITE_ENV_KEY:-UNKNOWN}"
    project="$key"
    if getJoomlaComposeIdentity "$VDM_SITE_COMPOSE"; then project="${VDM_SRC_PROJECT_FOLDER:-$key}"; fi
    config=$(joomlaSiteCompose "$site" config --format json 2>/dev/null) || exit $?
    database=$(printf '%s' "$config" | joomlaSiteJSON -r '[.services|to_entries[]|select((.value.image//"")|test("(^|/)(mysql|mariadb|postgres)(:|@|$)"))|.key]|if length==1 then .[0] else empty end') || exit 1
    if [ "$scope" != files ] && [ -z "$database" ]; then joomlaBackupError 'A single local supported database service is required.'; exit 1; fi
    package=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-backup.XXXXXX") || exit 1
    mkdir "$package/compose" "$package/project" "$package/project/extra" || exit 1
    # Configuration also accompanies website/SQL archives to permit an independent
    # destination. Only full scope captures its additional deployment dependencies.
    cp "$VDM_SITE_COMPOSE" "$package/compose/docker-compose.yml" || exit 1
    siteWriteScopedEnv "$VDM_SITE_COMPOSE" "$VDM_SITE_ENV" "$env_key" "$package/compose/.env" || exit 1
    if [ "$scope" = full ] || [ "$scope" = website ]; then
      local project_base project_root=''
      if migrationReadEnvValue "$VDM_SITE_ENV" VDM_PROJECT_PATH project_base; then project_root="$project_base/$project"; fi
      joomlaBackupDependencies "$site" "$package" "$config" "$database" "$project_root" || exit 1
    fi
    running=$(joomlaSiteCompose "$site" ps --status running --services 2>/dev/null) || exit $?
    paused=true
    while IFS= read -r name; do
      [ -z "$name" ] || [ "$name" = "$database" ] || joomlaSiteCompose "$site" stop "$name" >/dev/null || exit $?
    done <<< "$running"
    if [ "$scope" != files ]; then
      if ! printf '%s\n' "$running" | grep -qxF "$database"; then
        db_started=true
        joomlaSiteCompose "$site" up -d --no-deps "$database" >/dev/null || exit $?
      fi
      local attempt ready=false
      for ((attempt=0; attempt<30; attempt++)); do
        if joomlaDatabaseContext "$site" 2>/dev/null && joomlaDatabaseVerifyConnection "$site" >/dev/null 2>&1; then ready=true; break; fi
        sleep 2
      done
      "$ready" || { joomlaBackupError 'The database is not ready for logical export.'; exit 1; }
      engine="$VDM_DB_ENGINE" backup_prefix="$VDM_DB_PREFIX"
      joomlaDatabaseExport "$site" "$package/project/database.sql" none false >/dev/null || exit $?
      [ -s "$package/project/database.sql" ] || { joomlaBackupError 'Database export produced no SQL.'; exit 1; }
      # Database discovery may refresh globals; selected context is read again.
      readJoomlaSiteFacts "$site" || exit 1
    fi
    [ "$scope" = database ] || joomlaBackupCopyWebsite "$package/project/joomla" || exit $?
    joomlaBackupResume "$site" "$running" "$database" "$db_started" || exit $?
    paused=false
    relative="${VDM_SITE_DOCROOT#"$VDM_SITE_MOUNT_TARGET"}"; relative="${relative#/}"; relative="${relative:-.}"
    for suffix in FORMAT CONTAINER KEY ENV_KEY PROJECT_FOLDER SCOPE PAYLOAD DB_ENGINE DB_PREFIX CREATED LABEL DOCROOT; do
      case "$suffix" in FORMAT) value=2;; CONTAINER) value="$site";; KEY) value="$key";; ENV_KEY) value="$env_key";; PROJECT_FOLDER) value="$project";; SCOPE) value="$scope";; PAYLOAD) value=logical;; DB_ENGINE) value="$engine";; DB_PREFIX) value="${backup_prefix:-}";; CREATED) value=$(date -u +%s);; LABEL) value="${VDM_LABEL:-}";; DOCROOT) value="$relative";; esac
      formatEnvAssignment "VDM_MIGRATION_${suffix}=\"$value\"" >> "$package/manifest.env" || exit 1
    done
    joomlaBackupManifest "$package/manifest.env" && joomlaBackupFileMetadata "$package" && joomlaBackupChecksums "$package" || exit 1
    temporary=$(mktemp "$archive.partial.XXXXXX") || exit 1
    if [ "$format" = zip ]; then
      (cd "$package" && ZIPOPT='' runPrivileged zip -q -r - manifest.env compose project) > "$temporary" || exit $?
    else
      TAR_OPTIONS='' runPrivileged tar --numeric-owner -czf - -C "$package" manifest.env compose project > "$temporary" || exit $?
    fi
    chmod 600 "$temporary" || exit 1
    # The validator chooses format by extension, while the publication file is private.
    local validation="$package/verify.$format"
    ln "$temporary" "$validation" || cp "$temporary" "$validation" || exit 1
    joomlaBackupValidateArchive "$validation" || exit 1
    digest=$(migrationArchiveDigest "$temporary") || exit 1
    printf '%s\n' "$digest" > "$temporary.sha256" || exit 1
    if [ -e "$archive" ]; then original="$archive.previous.$$"; mv -- "$archive" "$original" || exit 1; fi
    if [ -e "$archive.sha256" ]; then original_digest="$archive.sha256.previous.$$"; mv -- "$archive.sha256" "$original_digest" || exit 1; fi
    mv -- "$temporary.sha256" "$archive.sha256" || exit 1
    mv -- "$temporary" "$archive" || { rm -f -- "$archive.sha256"; exit 1; }
    temporary=''
    [ -z "$original" ] || rm -f -- "$original" || exit 1
    [ -z "$original_digest" ] || rm -f -- "$original_digest" || exit 1
    original='' original_digest=''
    printf '%s\n' "$archive"
  )
}

function joomlaBackupSpace() {
  local archive="$1" destination="$2" size free
  size=$(du -k "$archive" | awk '{print $1}') || return 1
  free=$(df -Pk "$destination" | awk 'END {print $4}') || return 1
  if [[ ! "$size" =~ ^[0-9]+$ || ! "$free" =~ ^[0-9]+$ ]] || [ "$free" -le "$size" ]; then joomlaBackupError 'Insufficient destination space for the archive.'; return 1; fi
}

# Replace one ordinary short-syntax mount without regenerating the Compose file.
function joomlaBackupReplaceMount() {
  local source="$1" destination="$2" service="$3" target="$4" replacement="$5" read_only="${6:-false}"
  [[ "$replacement" != *[\"\$\\]* && "$replacement" != *[![:print:]]* ]] || return 1
  awk -v service="$service" -v target="$target" -v replacement="$replacement" -v read_only="$read_only" '
    /^services:/ {services=1}
    /^[^[:space:]#]/ && !/^services:/ {services=0}
    services && /^  [^[:space:]#]/ {selected=($0=="  "service":"); volumes=0}
    selected && /^    volumes:[[:space:]]*$/ {volumes=1; print; next}
    selected && /^    [^[:space:]#]/ {volumes=0}
    selected && volumes && index($0,":"target) {
      value=$0; sub(/^      -[[:space:]]*/,"",value); sub(/^"/,"",value); sub(/"[[:space:]]*$/,"",value)
      suffix=substr(value,index(value,":"target)+length(target)+1)
      if(suffix!="" && suffix !~ /^:[a-z,]+$/) {bad=1; exit}
      if($0 !~ /^      - /) {bad=1; exit}
      print "      - \""replacement":"target (read_only=="true"?":ro":"")"\""; changed++; next
    }
    {print}
    END {if(bad || changed!=1) exit 1}
  ' "$source" > "$destination" || { rm -f "$destination"; joomlaBackupError 'Restore requires an ordinary short-syntax data mount; the custom service was not changed.'; return 1; }
}

function joomlaBackupWaitDatabase() {
  local site="$1" attempt
  for ((attempt=0; attempt<60; attempt++)); do
    joomlaDatabaseContext "$site" >/dev/null 2>&1 && joomlaDatabaseVerifyConnection "$site" >/dev/null 2>&1 && return 0
    sleep 2
  done
  joomlaBackupError 'The restored database did not become ready.'
}

function joomlaBackupVerifyApplication() {
  local site="$1" attempt
  joomlaDatabaseVerifyConnection "$site" >/dev/null || return $?
  for ((attempt=0; attempt<30; attempt++)); do
    joomlaVerifyWebConfiguration "$site" >/dev/null 2>&1 && return 0
    sleep 2
  done
  joomlaBackupError 'Restored Joomla failed its application or published-route check.'
}


# Managed restore/engine changes may use absolute binds or unique volumes.
# Normalize only their data mounts in a PRIVATE copy before the existing identity
# rewrite. Other dependencies must be captured relative to the site/project.
# shellcheck disable=SC2016
function joomlaBackupPortableCompose() {
  local package="$1" key="$2" folder="$3" compose="$1/compose/docker-compose.yml" env="$1/compose/.env"
  local model project_base service type source target read_only relative replacement mode property compose_root project_root='' volume_definitions
  local -a retained_volumes=()
  compose_root=$(joomlaBackupFilesystemPath "$package/compose") || return 1
  # Named-only deployments do not reference VDM_PROJECT_PATH, so their scoped
  # environment correctly omits it. Only project-local dependency binds need it.
  if migrationReadEnvValue "$env" VDM_PROJECT_PATH project_base; then
    project_root=$(joomlaBackupFilesystemPath "$project_base/$folder") || return 1
  fi
  model=$(migrationRunCompose "$env" "$compose" --project-directory "$package/compose" config --format json) || return 1
  while IFS= read -r service; do
    [ -n "$service" ] || continue
    property="$package/volumes.property"
    printf '    volumes:\n' > "$property"
    while IFS=$'\t' read -r type source target read_only; do
      [ -n "$source" ] || continue
      if [ "$type" = bind ]; then source=$(joomlaBackupFilesystemPath "$source") || return 1; fi
      [[ "$target" == /* && "$target" != *[\"\$\\]* && "$target" != *[![:print:]]* ]] || return 1
      case "$target" in
        /var/www/html)
          if [ "$type" = volume ] && [ "$source" = "${key,,}_web" ]; then replacement="$source"; retained_volumes+=("$source")
          else replacement='${VDM_PROJECT_PATH}/'"$key/joomla"; fi;;
        /var/lib/mysql|/var/lib/postgresql|/var/lib/postgresql/data)
          if [ "$type" = volume ] && [ "$source" = "${key,,}_db" ]; then replacement="$source"; retained_volumes+=("$source")
          else replacement='${VDM_PROJECT_PATH}/'"$key/db"; fi;;
        *)
          [ "$type" = bind ] || { joomlaBackupError 'An additional named volume has no portable payload.'; return 1; }
          case "$source" in
            "$compose_root/"*) relative="${source#"$compose_root/"}"; replacement="./$relative";;
            *)
              if [ -n "$project_root" ] && [[ "$source" == "$project_root/"* ]]; then
                relative="${source#"$project_root/"}"; replacement='${VDM_PROJECT_PATH}/'"$key/$relative"
              else joomlaBackupError "An archived mount cannot be mapped into destination storage: $target"; return 1; fi;;
          esac;;
      esac
      [[ "$replacement" != *[\"\\]* && "$replacement" != *[![:print:]]* ]] || return 1
      mode=''; [ "$read_only" != true ] || mode=:ro
      printf '      - "%s:%s%s"\n' "$replacement" "$target" "$mode" >> "$property" || return 1
    done < <(printf '%s' "$model" | joomlaSiteJSON -r --arg service "$service" '.services[$service].volumes[]?|[.type,.source,.target,(.read_only//false)]|@tsv')
    joomlaSetServiceProperty "$compose" "$package/next.yml" "$service" volumes "$property" && mv "$package/next.yml" "$compose" || return 1
  done < <(printf '%s' "$model" | joomlaSiteJSON -r '.services|to_entries[]|select((.value.volumes//[]|length)>0)|.key')
  # A later compose down -v also removes declared but unused volumes. Drop old
  # managed storage declarations from this private destination copy, and let
  # retained canonical volumes acquire the destination project's own names.
  volume_definitions=$(joomlaSiteJSON -cn '$ARGS.positional|unique' --args "${retained_volumes[@]}") || return 1
  volume_definitions=$(printf '%s' "$model" | joomlaSiteJSON -c --argjson retained "$volume_definitions" '
    (.volumes//{}) | with_entries(select(.key as $key | $retained | index($key))) |
    if any(.[]; (.external//false) or ((.driver//"local")!="local") or ((.driver_opts//{})|length>0))
    then error("Independent restore cannot realign external or custom-driver volume storage")
    else with_entries(.value |= ((.//{}) | del(.name,.external))) end') || return 1
  awk '
    /^volumes:/ {section=1; count++; next}
    /^[^[:space:]#]/ {section=0}
    !section {print}
    END {if(count>1) exit 1}
  ' "$compose" > "$package/next.yml" || return 1
  printf '%s' "$volume_definitions" | joomlaSiteJSON -r '
    if length==0 then empty else "volumes:", (to_entries[] | "  \(.key): \(.value|tojson)") end
  ' >> "$package/next.yml" || return 1
  mv "$package/next.yml" "$compose" || return 1
  rm -f "$package/volumes.property"
}

# No archive, even one with valid checksums, may point a restored deployment at
# an arbitrary external bind, host credential or an existing data volume.
# shellcheck disable=SC2016
function joomlaBackupValidateDestination() {
  local model="$1" project="$2" directory="$3" require_fresh="${4:-true}" source type target volume path extra_root="${5:-}"
  project=$(joomlaBackupFilesystemPath "$project") || return 1
  directory=$(joomlaBackupFilesystemPath "$directory") || return 1
  if [ -n "$extra_root" ]; then extra_root=$(joomlaBackupFilesystemPath "$extra_root") || return 1; fi
  while IFS=$'\t' read -r type source target; do
    [ -n "$type" ] || continue
    case "$type" in
      bind)
        source=$(joomlaBackupFilesystemPath "$source") || return 1
        case "$source" in "$project/"*|"$directory/"*) ;; *) if [ -n "$extra_root" ] && [[ "$source" == "$extra_root/"* ]]; then ! migrationPathHasSymlink "$source" || return 1; else joomlaBackupError "Destination mount is outside this site: $target"; return 1; fi;; esac
        ! migrationPathHasSymlink "$source" || return 1;;
      volume)
        volume=$(printf '%s' "$model" | joomlaSiteJSON -r --arg source "$source" '.volumes[$source].name//empty') || return 1
        [ -n "$volume" ] || return 1
        if [ "$require_fresh" = true ] && docker volume inspect "$volume" >/dev/null 2>&1; then joomlaBackupError "Destination volume already exists: $volume"; return 1; fi;;
      *) joomlaBackupError "Unsupported destination mount type: $type"; return 1;;
    esac
  done < <(printf '%s' "$model" | joomlaSiteJSON -r '.services[].volumes[]?|[.type,.source,.target]|@tsv')
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    path=$(joomlaBackupFilesystemPath "$path") || return 1
    case "$path" in "$directory/"*) ;; *) joomlaBackupError 'Destination config/secret is outside this site.'; return 1;; esac
    ! migrationPathHasSymlink "$path" || return 1
  done < <(printf '%s' "$model" | joomlaSiteJSON -r '(.configs//{}),(.secrets//{})|.[]|.file//empty')
  printf '%s' "$model" | joomlaSiteJSON -e '[((.configs//{}),(.secrets//{}))|.[]|select(.external==true)]|length==0' >/dev/null
}
# Update only the generated FPM upstream in copied Nginx companion files.
function rewriteJoomlaNginxConfiguration() {
  local directory="$1" old_key="$2" new_key="$3" file temporary listing result=0
  [[ "$old_key" =~ ^[A-Za-z]+$ && "$new_key" =~ ^[A-Za-z]+$ ]] || return 1
  listing=$(mktemp) || return 1
  find "$directory" -type f -name '*nginx*.conf' -print0 > "$listing" || { rm -f "$listing"; return 1; }
  while IFS= read -r -d '' file; do
    temporary=$(mktemp) || { result=1; break; }
    if ! sed -E 's/(fastcgi_pass[[:space:]]+joomla)'"$old_key"'(:[0-9]+;)/\1'"$new_key"'\2/g' "$file" > "$temporary" ||
      ! runPrivileged tee "$file" < "$temporary" >/dev/null; then rm -f "$temporary"; result=1; break; fi
    rm -f "$temporary"
  done < "$listing"
  rm -f "$listing"
  return "$result"
}

# New destinations reserve independent project/Compose directories. Supported
# source labels, networks and companion files survive a narrow identity rewrite.
# shellcheck disable=SC2016
function joomlaBackupRestoreNew() {
  (
    set +x
    umask 077
    local archive="$1" site="$2" key="$3" package='' published=false result=0 version scope old_site old_key old_env old_folder env_key="${3^^}" root relative config target volume image database engine original_engine path needed free
    local destination="${VDM_REPO_PATH}/joomla/available/$2" project="${VDM_PROJECT_PATH}/$3"
    migrationDestinationAvailable "$key" "$site" || { joomlaBackupError 'Destination identity or storage is already in use.'; exit 17; }
    mkdir -p "$VDM_PROJECT_PATH" "${VDM_REPO_PATH}/joomla/available" || exit 1
    joomlaBackupSpace "$archive" "$VDM_PROJECT_PATH" || exit 1
    package=$(mktemp -d "$VDM_PROJECT_PATH/.backup-restore.XXXXXX") || exit 1
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    trap '
      result=$?
      if [ "$result" -ne 0 ] && "$published"; then
        joomlaSiteCompose "$site" stop >/dev/null 2>&1 || :
        joomlaBackupError "Restore failed; destination is retained stopped at $destination and $project for recovery."
      fi
      [ -z "$package" ] || runPrivileged rm -rf -- "$package"
      exit "$result"
    ' EXIT
    joomlaBackupExtract "$archive" "$package" || exit $?
    migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_FORMAT version || exit 1
    if [ "$version" = 1 ]; then
      runPrivileged rm -rf -- "$package"; package=''
      VDM_KEY="$key" VDM_TARGET_HOST="$site" OCTOJOOM_NON_INTERACTIVE=true importJoomlaMigration "$archive"
      exit $?
    fi
    migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_SCOPE scope || exit 1
    case "$scope" in full|website) ;; *) joomlaBackupError 'Database/files archives restore into an explicitly selected existing site.'; exit 17;; esac
    for path in CONTAINER KEY ENV_KEY PROJECT_FOLDER DOCROOT DB_ENGINE; do
      case "$path" in CONTAINER) target=old_site;; KEY) target=old_key;; ENV_KEY) target=old_env;; PROJECT_FOLDER) target=old_folder;; DOCROOT) target=relative;; DB_ENGINE) target=original_engine;; esac
      migrationReadEnvValue "$package/manifest.env" "VDM_MIGRATION_$path" "$target" || exit 1
    done
    [ -f "$package/compose/docker-compose.yml" ] && [ -f "$package/compose/.env" ] || exit 1
    joomlaBackupPortableCompose "$package" "$old_key" "$old_folder" || exit 1
    rewriteJoomlaComposeIdentity "$package/compose/docker-compose.yml" "$package/compose/rewritten.yml" "$old_key" "$key" "$old_env" "$env_key" "${old_site%%.*}" "${site%%.*}" "${old_site#*.}" "${site#*.}" "$old_key" || {
      joomlaBackupError 'The source deployment has a custom identity or data layout that cannot be safely realigned.'; exit 1;
    }
    mv "$package/compose/rewritten.yml" "$package/compose/docker-compose.yml" || exit 1
    cloneContainerEnvFile "$package/compose/.env" "$package/compose/env.new" "$old_env" "$env_key" && mv "$package/compose/env.new" "$package/compose/.env" || exit 1
    writeEnvVariable "$package/compose/.env" "VDM_PROJECT_PATH=$VDM_PROJECT_PATH" true || exit 1
    writeEnvVariable "$package/compose/.env" "VDM_${env_key}_HOOKS_ENABLED=false" true || exit 1
    rewriteJoomlaNginxConfiguration "$package/compose" "$old_key" "$key" || exit 1
    root="$package/project/joomla"; [ "$relative" = . ] || root+="/$relative"
    [ -f "$root/configuration.php" ] || { joomlaBackupError 'The archive contains no installed Joomla configuration.'; exit 1; }
    migrationPatchJoomlaSettings "$root/configuration.php" "$old_key" "$key" "$site" "${VDM_SECURE:-false}" || exit 1
    needed=$(runPrivileged du -sk "$package/project" | awk '{print $1}') || exit 1
    free=$(df -Pk "$VDM_PROJECT_PATH" | awk 'END {print $4}') || exit 1
    if [[ ! "$needed" =~ ^[0-9]+$ || ! "$free" =~ ^[0-9]+$ ]] || [ "$free" -le "$needed" ]; then joomlaBackupError 'Insufficient destination space for restored data.'; exit 1; fi
    mkdir "$project" "$destination" || exit 1
    published=true
    cp -a "$package/compose/." "$destination/" || exit 1
    chmod 700 "$destination"; chmod 600 "$destination/.env" "$destination/docker-compose.yml" || exit 1
    [ ! -d "$package/project/extra" ] || runPrivileged cp -a "$package/project/extra/." "$project/" || exit 1
    readJoomlaSiteFacts "$site" || exit 1
    config=$(joomlaSiteCompose "$site" config --format json 2>/dev/null) || exit 1
    joomlaBackupValidateDestination "$config" "$project" "$destination" true || exit 1
    image="$VDM_SITE_IMAGE"
    case "$VDM_SITE_MOUNT_TYPE" in
      bind)
        path=$(joomlaBackupFilesystemPath "$VDM_SITE_MOUNT_SOURCE") || exit 1
        target=$(joomlaBackupFilesystemPath "$project/joomla") || exit 1
        [ "$path" = "$target" ] || { joomlaBackupError 'Destination website bind escaped its reserved project.'; exit 1; }
        runPrivileged cp -a "$package/project/joomla" "$project/joomla" || exit 1;;
      volume) joomlaBackupRestoreWebsiteVolume "$package/project/joomla" "$VDM_SITE_VOLUME_NAME" "$image" || exit $?;;
      *) exit 1;;
    esac
    database=$(printf '%s' "$config" | joomlaSiteJSON -r '[.services|to_entries[]|select((.value.image//"")|test("(^|/)(mysql|mariadb|postgres)(:|@|$)"))|.key]|if length==1 then .[0] else empty end') || exit 1
    [ -n "$database" ] || exit 1
    joomlaSiteCompose "$site" config -q >/dev/null 2>&1 || exit 1
    joomlaSiteCompose "$site" up -d --no-deps "$database" >/dev/null || exit $?
    joomlaBackupWaitDatabase "$site" || exit 1
    engine="$VDM_DB_ENGINE"
    case "$original_engine:$engine" in postgres:postgres|mysql:mysql|mariadb:mariadb|mysql:mariadb|mariadb:mysql) ;; *) joomlaBackupError 'Cross-family database restoration is unsupported.'; exit 1;; esac
    joomlaDatabaseImport "$site" "$package/project/database.sql" fresh false >/dev/null || exit $?
    joomlaSiteCompose "$site" up -d >/dev/null || exit $?
    joomlaBackupVerifyApplication "$site" || exit 1
    if [ "${VDM_ENABLE:-false}" = true ]; then
      mkdir -p "${VDM_REPO_PATH}/joomla/enabled" || exit 1
      ln -s "$destination" "${VDM_REPO_PATH}/joomla/enabled/$site" || exit 1
    else
      joomlaSiteCompose "$site" stop >/dev/null || exit $?
    fi
    printf '%s\n' "$site"
  )
}


function joomlaBackupPublishFile() {
  local source="$1" destination="$2" work="$3" index saved='-'
  [[ "$destination" != *[![:print:]]* ]] && [ ! -L "$destination" ] || return 1
  mkdir -p "$work/original-files" "${destination%/*}" || return 1
  index=$(find "$work/original-files" -type f | wc -l)
  if [ -e "$destination" ]; then
    [ -f "$destination" ] || return 1
    saved="$work/original-files/$index"
    runPrivileged cp -a "$destination" "$saved" || return 1
  fi
  printf '%s\t%s\n' "$destination" "$saved" >> "$work/files.journal" || return 1
  runPrivileged cp -a "$source" "$destination"
}

function joomlaBackupRollbackFiles() {
  local work="$1" destination saved result=0
  [ -f "$work/files.journal" ] || return 0
  while IFS=$'\t' read -r destination saved; do
    if [ "$saved" = - ]; then runPrivileged rm -f -- "$destination" || result=1
    else runPrivileged cp -a "$saved" "$destination" || result=1; fi
  done < "$work/files.journal"
  return "$result"
}
# Keep original database storage and website files untouched while a fresh
# candidate is imported. On failure restore the previous deployment and running
# set; successful restore retains old storage for deliberate later cleanup.
# shellcheck disable=SC2016
function joomlaBackupRestoreCurrent() {
  (
    set +x
    umask 077
    local site="$1" archive="$2" package='' work='' result=0 published=false paused=false running='' database='' db_started=false
    local lock='' locked=false current_project_base current_project current_key current_env archived_key archived_env archived_project needed free
    local scope version source_site engine old_engine dbimage config service image source target relative config_file prefix host driver dbname dbuser dbpass original_dir original_env original_compose fresh_web state archived_root
    readJoomlaSiteFacts "$site" || exit 1
    current_key="$VDM_SITE_KEY" current_env="$VDM_SITE_ENV_KEY"
    getJoomlaComposeIdentity "$VDM_SITE_COMPOSE" || exit 1
    current_project="${VDM_SRC_PROJECT_FOLDER:-$current_key}"
    # Managed absolute/named mounts need no project-path interpolation. Use the
    # configured destination root when their complete scoped ENV omits it.
    if ! migrationReadEnvValue "$VDM_SITE_ENV" VDM_PROJECT_PATH current_project_base; then
      current_project_base="${VDM_PROJECT_PATH:-}"
      [ -n "$current_project_base" ] || { joomlaBackupError 'The configured project root is unavailable.'; exit 1; }
    fi
    original_dir="$VDM_SITE_DIR" original_env="$VDM_SITE_ENV" original_compose="$VDM_SITE_COMPOSE"
    package=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-restore-payload.XXXXXX") || exit 1
    work=$(mktemp -d "$original_dir/.restore.XXXXXX") || exit 1
    lock="$original_dir/.octojoom-change.lock"
    mkdir "$lock" 2>/dev/null || { runPrivileged rm -rf "$package" "$work"; joomlaBackupError 'Another operation is changing this site.'; exit 1; }
    locked=true
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    trap '
      result=$?
      if [ "$result" -ne 0 ] && "$published"; then
        if joomlaSiteCompose "$site" stop >/dev/null 2>&1 &&
          cp "$work/original.yml" "$original_compose" &&
          cp "$work/original.env" "$original_dir/.env"; then
          [ -f "$work/had-private-env" ] || rm -f "$original_dir/.env"
          joomlaBackupRollbackFiles "$work" || result=1
          joomlaSiteCompose "$site" up --no-start >/dev/null 2>&1 || result=1
          joomlaBackupResume "$site" "$running" "$database" false || result=1
          joomlaBackupError "Restore failed; original deployment/storage were restored. Candidate data is retained at $work."
        else
          joomlaBackupError "Restore failed and automatic recovery did not complete. Original configuration is retained at $work; inspect the site before restarting."
        fi
      elif "$paused"; then joomlaBackupResume "$site" "$running" "$database" "$db_started" || result=1; fi
      [ -z "$package" ] || runPrivileged rm -rf -- "$package"
      if [ "$result" -eq 0 ]; then runPrivileged rm -rf -- "$work" || result=1; fi
      [ "$locked" != true ] || rmdir "$lock" || result=1
      exit "$result"
    ' EXIT
    joomlaBackupExtract "$archive" "$package" || exit $?
    migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_FORMAT version || exit 1
    [ "$version" = 2 ] || { joomlaBackupError 'Cold format-1 archives restore only into a new independent destination.'; exit 17; }
    migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_SCOPE scope || exit 1
    migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_DB_ENGINE engine || exit 1
    migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_CONTAINER source_site || exit 1
    [ "$scope" != full ] || [ "$source_site" = "$site" ] || { joomlaBackupError 'Restore another site deployment as a new site.'; exit 17; }
    migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_KEY archived_key || exit 1
    migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_ENV_KEY archived_env || exit 1
    migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_PROJECT_FOLDER archived_project || exit 1
    if [ "$scope" = full ] && { [ "$current_key" != "$archived_key" ] || [ "$current_env" != "$archived_env" ] || [ "$current_project" != "$archived_project" ]; }; then
      joomlaBackupError 'The archived project identity differs; restore it as a new site.'; exit 17
    fi
    needed=$(runPrivileged du -sk "$package/project" | awk '{print $1}') || exit 1
    free=$(df -Pk "$original_dir" | awk 'END {print $4}') || exit 1
    if [[ ! "$needed" =~ ^[0-9]+$ || ! "$free" =~ ^[0-9]+$ ]] || [ "$free" -le "$needed" ]; then joomlaBackupError 'Insufficient space for restored files.'; exit 1; fi
    config=$(joomlaSiteCompose "$site" config --format json 2>/dev/null) || exit 1
    database=$(printf '%s' "$config" | joomlaSiteJSON -r '[.services|to_entries[]|select((.value.image//"")|test("(^|/)(mysql|mariadb|postgres)(:|@|$)"))|.key]|if length==1 then .[0] else empty end') || exit 1
    [ -n "$database" ] || exit 1
    running=$(joomlaSiteCompose "$site" ps --status running --services) || exit $?
    paused=true
    if ! printf '%s\n' "$running" | grep -qxF "$database"; then
      db_started=true
      joomlaSiteCompose "$site" up -d --no-deps "$database" >/dev/null || exit $?
    fi
    joomlaBackupWaitDatabase "$site" || exit 1
    old_engine="$VDM_DB_ENGINE" host="$VDM_DB_HOST" dbname="$VDM_DB_NAME" dbuser="$VDM_DB_USER" dbpass="$VDM_DB_PASSWORD" prefix="$VDM_DB_PREFIX"
    if [ "$old_engine" = postgres ]; then driver=pgsql; else driver=mysqli; fi
    case "$engine:$old_engine:$scope" in none:*:files|postgres:postgres:*|mysql:mysql:*|mariadb:mariadb:*|mysql:mariadb:*|mariadb:mysql:*) ;; *) joomlaBackupError 'Cross-family database restoration is unsupported.'; exit 17;; esac
    joomlaDatabaseCopyConfiguration "$site" "$work/target-configuration.php" || exit 1
    cp "$original_compose" "$work/original.yml" && cp "$original_env" "$work/original.env" || exit 1
    [ ! -f "$original_dir/.env" ] || : > "$work/had-private-env"
    joomlaSiteCompose "$site" stop >/dev/null || exit $?
    cp "$work/original.yml" "$work/candidate.yml" || exit 1
    siteWriteScopedEnv "$original_compose" "$original_env" "$VDM_SITE_ENV_KEY" "$work/candidate.env" || exit 1
    if [ "$scope" = full ]; then
      cp "$package/compose/docker-compose.yml" "$work/candidate.yml" && cp "$package/compose/.env" "$work/candidate.env" || exit 1
      writeEnvVariable "$work/candidate.env" "VDM_PROJECT_PATH=$current_project_base" true || exit 1
      config=$(migrationRunCompose "$work/candidate.env" "$work/candidate.yml" --project-directory "$package/compose" config --format json) || exit 1
      joomlaBackupValidateDestination "$config" "$current_project_base/$current_project" "$package/compose" false "$original_dir" || exit 1
    fi
    siteValidateCompose "$work/candidate.yml" "$work/candidate.env" "$original_dir" || exit 1
    published=true
    if [ "$scope" = full ]; then
      local file rel
      while IFS= read -r -d '' file; do
        rel="${file#"$package/compose/"}"
        case "$rel" in .env|docker-compose.yml) continue;; esac
        joomlaBackupPublishFile "$file" "$original_dir/$rel" "$work" || exit 1
      done < <(find "$package/compose" -type f -print0)
      while IFS= read -r -d '' file; do
        rel="${file#"$package/project/extra/"}"
        case "$rel" in db|db/*|joomla|joomla/*) joomlaBackupError 'Extra project files overlap application/database storage.'; exit 1;; esac
        joomlaBackupPublishFile "$file" "$current_project_base/$current_project/$rel" "$work" || exit 1
      done < <(runPrivileged find "$package/project/extra" -type f -print0)
    fi
    cp "$work/candidate.yml" "$original_compose" && cp "$work/candidate.env" "$original_dir/.env" || exit 1
    chmod 600 "$original_compose" "$original_dir/.env" || exit 1
    readJoomlaSiteFacts "$site" || exit 1
    image="$VDM_SITE_IMAGE" relative="${VDM_SITE_DOCROOT#"$VDM_SITE_MOUNT_TARGET"}" target="$VDM_SITE_MOUNT_TARGET"
    fresh_web="$original_dir/restore-data-$(date -u +%Y%m%dT%H%M%S)-$$"
    mkdir "$fresh_web" || exit 1
    if [ "$scope" = database ]; then
      joomlaBackupCopyWebsite "$fresh_web" || exit 1
      config_file="$fresh_web$relative/configuration.php"
      migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_DB_PREFIX prefix || exit 1
    else
      runPrivileged cp -a "$package/project/joomla/." "$fresh_web/" || exit 1
      migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_DOCROOT archived_root || exit 1
      if [ "$archived_root" = . ]; then archived_root=''; else archived_root="/$archived_root"; fi
      [ "$archived_root" = "$relative" ] || { joomlaBackupError 'Document-root layouts differ; restore as a new site.'; exit 17; }
      config_file="$fresh_web$relative/configuration.php"
      if [ "$scope" = files ]; then runPrivileged cp -p "$work/target-configuration.php" "$config_file" || exit 1
      else prefix=$(getJoomlaConfigValue "$config_file" dbprefix); fi
    fi
    if [ "$scope" = full ]; then
      config=$(joomlaSiteCompose "$site" config --format json) || exit 1
      host=$(printf '%s' "$config" | joomlaSiteJSON -r --arg s "$VDM_SITE_SERVICE" '.services[$s].environment.JOOMLA_DB_HOST//empty') || exit 1
      dbname=$(printf '%s' "$config" | joomlaSiteJSON -r --arg s "$VDM_SITE_SERVICE" '.services[$s].environment.JOOMLA_DB_NAME//empty') || exit 1
      dbuser=$(printf '%s' "$config" | joomlaSiteJSON -r --arg s "$VDM_SITE_SERVICE" '.services[$s].environment.JOOMLA_DB_USER//empty') || exit 1
      dbpass=$(printf '%s' "$config" | joomlaSiteJSON -r --arg s "$VDM_SITE_SERVICE" '.services[$s].environment.JOOMLA_DB_PASSWORD//empty') || exit 1
      # Compose serializes each literal dollar as $$; JConfig needs its runtime
      # value. Decode once without evaluating variables or shell expressions.
      host="${host//\$\$/\$}" dbname="${dbname//\$\$/\$}"
      dbuser="${dbuser//\$\$/\$}" dbpass="${dbpass//\$\$/\$}"
      [ -n "$host" ] && [ -n "$dbname" ] && [ -n "$dbuser" ] && [ -n "$dbpass" ] || exit 1
    fi
    joomlaDatabasePatchConfiguration "$config_file" "$work/patched.php" "$host" "$driver" "$dbname" "$dbuser" "$dbpass" "$prefix" || exit 1
    runPrivileged tee "$config_file" < "$work/patched.php" >/dev/null || exit 1
    config=$(joomlaSiteCompose "$site" config --format json) || exit 1
    source="$VDM_SITE_MOUNT_SOURCE"
    while IFS=$'\t' read -r service state; do
      [ -n "$service" ] || continue
      joomlaBackupReplaceMount "$original_compose" "$work/next.yml" "$service" "$target" "$fresh_web" "$state" && cp "$work/next.yml" "$original_compose" || exit 1
    done < <(printf '%s' "$config" | joomlaSiteJSON -r --arg source "$source" --arg target "$target" '.services|to_entries[]|.key as $s|.value.volumes[]?|select(.source==$source and .target==$target)|[$s,(.read_only//false)]|@tsv')
    if [ "$scope" != files ]; then
      dbimage=$(printf '%s' "$config" | joomlaSiteJSON -r --arg s "$database" '.services[$s].image') || exit 1
      mkdir "$work/database-stage" || exit 1
      joomlaDatabaseStageStorage "$site" "$old_engine" "$dbimage" "$work/database-stage" || exit $?
      cp "$VDM_DATABASE_STAGE_COMPOSE" "$original_compose" && cp "$VDM_DATABASE_STAGE_ENV" "$original_dir/.env" || exit 1
    fi
    joomlaSiteCompose "$site" config -q >/dev/null 2>&1 || exit 1
    joomlaSiteCompose "$site" up -d --no-deps "$database" >/dev/null || exit $?
    joomlaBackupWaitDatabase "$site" || exit 1
    if [ "$scope" != files ]; then joomlaDatabaseImport "$site" "$package/project/database.sql" fresh false >/dev/null || exit $?; fi
    joomlaSiteCompose "$site" up -d >/dev/null || exit $?
    joomlaBackupVerifyApplication "$site" || exit 1
    joomlaSiteCompose "$site" stop >/dev/null || exit $?
    joomlaBackupResume "$site" "$running" "$database" false || exit $?
    paused=false published=false
    printf '%s\n' "$site"
  )
}


function joomlaBackupResolveOptions() {
  local site="${1:-}" env='' key='' name suffix fallback value
  if [ -n "$site" ]; then
    resolveJoomlaSite "$site" || return 1
    env="$VDM_SITE_ENV"
    getJoomlaComposeIdentity "$VDM_SITE_COMPOSE" && key="$VDM_SRC_ENV_KEY"
  fi
  for suffix in PATH FORMAT SCOPE TIMESTAMP TIMESTAMP_PATTERN OVERWRITE RETENTION; do
    case "$suffix" in
      PATH) name=VDM_DESTINATION; fallback="${VDM_DEFAULT_BACKUP_PATH:-$VDM_HOME_PATH/Backups}";;
      FORMAT) name=VDM_FORMAT; fallback="${VDM_DEFAULT_BACKUP_FORMAT:-tar.gz}";;
      SCOPE) name=VDM_SCOPE; fallback="${VDM_DEFAULT_BACKUP_SCOPE:-full}";;
      TIMESTAMP) name=VDM_TIMESTAMP; fallback="${VDM_DEFAULT_BACKUP_TIMESTAMP:-true}";;
      TIMESTAMP_PATTERN) name=VDM_TIMESTAMP_PATTERN; fallback="${VDM_DEFAULT_BACKUP_TIMESTAMP_PATTERN:-%Y%m%dT%H%M%SZ}";;
      OVERWRITE) name=VDM_OVERWRITE; fallback="${VDM_DEFAULT_BACKUP_OVERWRITE:-false}";;
      RETENTION) name=VDM_RETENTION; fallback="${VDM_DEFAULT_BACKUP_RETENTION:-0}";;
    esac
    # Only this request's explicit options or the answers gathered once for an
    # interactive batch override the selected site's saved preferences.
    if [ "${VDM_BACKUP_OPTIONS_READY:-false}" != true ] && ! cliHasValue "$name"; then
      value="$fallback"
      [ -z "$key" ] || migrationReadEnvValue "$env" "VDM_${key}_BACKUP_${suffix}" value || value="$fallback"
      printf -v "$name" '%s' "$value"
    fi
  done
  case "$VDM_FORMAT" in tar.gz|zip) ;; *) return 17;; esac
  case "$VDM_SCOPE" in full|website|database|files) ;; *) return 17;; esac
  case "$VDM_TIMESTAMP:$VDM_OVERWRITE" in true:true|true:false|false:true|false:false) ;; *) return 17;; esac
  [[ "$VDM_RETENTION" =~ ^[0-9]{1,6}$ && -n "$VDM_DESTINATION" ]] || return 17
}

function joomlaBackupSaveOptions() {
  local site="$1" stage suffix value name env_key
  resolveJoomlaSite "$site" && getJoomlaComposeIdentity "$VDM_SITE_COMPOSE" || return 1
  env_key="$VDM_SRC_ENV_KEY"
  stage=$(mktemp "$VDM_SITE_DIR/.backup-env.XXXXXX") || return 1
  if ! siteWriteScopedEnv "$VDM_SITE_COMPOSE" "$VDM_SITE_ENV" "$env_key" "$stage"; then rm -f "$stage"; return 1; fi
  for suffix in PATH FORMAT SCOPE TIMESTAMP TIMESTAMP_PATTERN OVERWRITE RETENTION; do
    case "$suffix" in PATH) value="$VDM_DESTINATION";; FORMAT) value="$VDM_FORMAT";; SCOPE) value="$VDM_SCOPE";; TIMESTAMP) value="$VDM_TIMESTAMP";; TIMESTAMP_PATTERN) value="${VDM_TIMESTAMP_PATTERN:-%Y%m%dT%H%M%SZ}";; OVERWRITE) value="$VDM_OVERWRITE";; RETENTION) value="$VDM_RETENTION";; esac
    name="VDM_${env_key}_BACKUP_${suffix}"
    writeEnvVariable "$stage" "$name=\"$value\"" true || { rm -f "$stage"; return 1; }
  done
  mv -f "$stage" "$VDM_SITE_DIR/.env"
}

function joomlaBackupFilename() {
  local site="$1" label="${VDM_LABEL:-}" stamp=''
  [[ "$label" != *[!A-Za-z0-9\ ._-]* && ${#label} -le 80 ]] || { joomlaBackupError 'Use letters, numbers, spaces, dots, hyphens or underscores in a backup label.'; return 17; }
  label="${label// /-}"
  if [ "${VDM_TIMESTAMP:-true}" = true ]; then
    stamp=$(date -u +"${VDM_TIMESTAMP_PATTERN:-%Y%m%dT%H%M%SZ}") || return 17
    [[ -n "$stamp" && "$stamp" != *[!A-Za-z0-9._-]* ]] || { joomlaBackupError 'Timestamp pattern must produce a filename component without spaces or slashes.'; return 17; }
    stamp="-$stamp"
  fi
  printf '%s/%s-%s%s%s.%s\n' "${VDM_DESTINATION%/}" "$site" "$VDM_SCOPE" "${label:+-$label}" "$stamp" "$VDM_FORMAT"
}

function joomlaBackupReadManifest() {
  local archive="$1" destination="$2" version
  joomlaBackupValidateArchive "$archive" || return 1
  case "$archive" in
    *.zip) UNZIP='' UNZIPOPT='' unzip -p "$archive" manifest.env > "$destination" || return 1;;
    *) TAR_OPTIONS='' tar -xOzf "$archive" manifest.env > "$destination" 2>/dev/null || TAR_OPTIONS='' tar -xOzf "$archive" ./manifest.env > "$destination" 2>/dev/null || return 1;;
  esac
  migrationReadEnvValue "$destination" VDM_MIGRATION_FORMAT version || return 1
  if [ "$version" = 1 ]; then migrationValidateManifest "$destination"; else joomlaBackupManifest "$destination"; fi
}

# Inventory reads archive metadata, never site credentials or SQL. Scope and
# compression are explicit even when filenames have been renamed by the user.
function joomlaBackupList() {
  (
    local site="$1" directory="$2" archive manifest owner version scope format created label size
    manifest=$(mktemp "${TMPDIR:-/tmp}/octojoom-backup-list.XXXXXX") || exit 1
    chmod 600 "$manifest" || exit 1
    trap 'rm -f -- "$manifest"' EXIT
    [ -d "$directory" ] || exit 0
    for archive in "$directory/"*.tar.gz "$directory/"*.zip; do
      [[ "$archive" != *[![:print:]]* ]] || continue
      if [ ! -f "$archive" ] || [ -L "$archive" ]; then continue; fi
      joomlaBackupReadManifest "$archive" "$manifest" || continue
      migrationReadEnvValue "$manifest" VDM_MIGRATION_CONTAINER owner || continue
      [ "$owner" = "$site" ] || continue
      migrationReadEnvValue "$manifest" VDM_MIGRATION_FORMAT version || continue
      scope=full created=0 label='exact-engine cold'
      if [ "$version" = 2 ]; then
        migrationReadEnvValue "$manifest" VDM_MIGRATION_SCOPE scope || continue
        migrationReadEnvValue "$manifest" VDM_MIGRATION_CREATED created || continue
        migrationReadEnvValue "$manifest" VDM_MIGRATION_LABEL label || continue
      fi
      format=tar.gz; [[ "$archive" != *.zip ]] || format=zip
      size=$(wc -c < "$archive") || continue
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$created" "$scope" "$format" "${size// /}" "${label:--}" "$archive"
    done | sort -rn
  )
}

# shellcheck disable=SC2016
function joomlaBackupVerify() {
  (
    local archive="$1" package digest scope version
    package=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-backup-verify.XXXXXX") || exit 1
    trap 'runPrivileged rm -rf -- "$package"' EXIT
    joomlaBackupExtract "$archive" "$package" || exit $?
    digest=$(migrationArchiveDigest "$archive") || exit 1
    migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_FORMAT version || exit 1
    scope=full
    [ "$version" = 1 ] || migrationReadEnvValue "$package/manifest.env" VDM_MIGRATION_SCOPE scope || exit 1
    if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then
      joomlaSiteJSON -n --arg archive "$archive" --arg digest "$digest" --arg scope "$scope" --arg version "$version" '{archive:$archive,digest:$digest,scope:$scope,format_version:$version,verified:true}'
    else printf 'Verified %s (%s; SHA-256 %s)\n' "$archive" "$scope" "$digest"; fi
  )
}

function joomlaBackupDelete() {
  local site="$1" archive="$2" manifest owner result=0 directory archive_directory
  [ "${VDM_CONFIRM:-false}" = true ] || { joomlaBackupError 'Deletion requires explicit confirmation of the selected archive.'; return 17; }
  [[ "$archive" != *[![:print:]]* ]] && [ -n "${VDM_DESTINATION:-}" ] || return 17
  directory=$(cd "$VDM_DESTINATION" && pwd -P) || return 17
  archive_directory=$(cd "$(dirname "$archive")" && pwd -P) || return 17
  [ "$directory" = "$archive_directory" ] || { joomlaBackupError 'Deletion is restricted to the selected backup destination.'; return 17; }
  manifest=$(mktemp) || return 1
  chmod 600 "$manifest" || { rm -f "$manifest"; return 1; }
  joomlaBackupReadManifest "$archive" "$manifest" && migrationReadEnvValue "$manifest" VDM_MIGRATION_CONTAINER owner || result=1
  rm -f "$manifest"
  if [ "$result" -ne 0 ] || [ "$owner" != "$site" ]; then joomlaBackupError 'The archive does not belong to the selected site.'; return 17; fi
  rm -f -- "$archive" "$archive.sha256"
}

function joomlaBackupCleanup() {
  local site="$1" directory="$2" keep="$3" rows count=0 created scope format size label archive
  [[ "$keep" =~ ^[0-9]{1,6}$ ]] || return 17
  [ "$keep" -gt 0 ] || { printf 'Retention is disabled; no backups were deleted.\n' >&2; return 0; }
  rows=$(joomlaBackupList "$site" "$directory") || return 1
  while IFS=$'\t' read -r created scope format size label archive; do
    [ -n "$archive" ] || continue
    count=$((count+1)); [ "$count" -gt "$keep" ] || continue
    if [ "${VDM_CONFIRM:-false}" = true ]; then
      joomlaBackupDelete "$site" "$archive" || return $?
    fi
    printf '%s\n' "$archive"
  done <<< "$rows"
}

function joomlaBackupCreateQuestions() {
  local site="$1"
  joomlaBackupResolveOptions "$site" || return $?
  VDM_SCOPE=$(whiptail --menu 'Choose the backup contents. Full is the general-purpose portable logical backup.' 0 112 0 --title 'Backup Scope' --default-item "$VDM_SCOPE" \
    full 'Complete project: deployment, website and SQL' website 'Website/document root and SQL' database 'Database-only restore point' files 'Website files only; database excluded' 3>&1 1>&2 2>&3) || return 3
  if ! getInputYesNo "Use saved backup options?\nDestination: $VDM_DESTINATION\nFormat: $VDM_FORMAT; timestamp: $VDM_TIMESTAMP; overwrite: $VDM_OVERWRITE" 'Backup Options' 12 112; then
    VDM_DESTINATION=$(getInput 'Backup destination directory' "$VDM_DESTINATION" 'Backup Destination') || return 3
    VDM_FORMAT=$(whiptail --menu 'Archive compression' 0 112 0 --title 'Backup Format' --default-item "$VDM_FORMAT" tar.gz 'Ownership-preserving compressed tar' zip 'ZIP with validated file ownership metadata' 3>&1 1>&2 2>&3) || return 3
    VDM_TIMESTAMP=false; getInputYesNo 'Include a UTC timestamp in the archive filename?' 'Backup Timestamp' 8 112 && VDM_TIMESTAMP=true
    if [ "$VDM_TIMESTAMP" = true ]; then VDM_TIMESTAMP_PATTERN=$(getInput 'UTC date pattern used in backup filenames' "${VDM_TIMESTAMP_PATTERN:-%Y%m%dT%H%M%SZ}" 'Backup Timestamp Pattern') || return 3; fi
    VDM_OVERWRITE=false; getInputYesNo 'Allow replacement of an existing archive with the same filename?' 'Backup Overwrite' 8 112 defaultno && VDM_OVERWRITE=true
  fi
  VDM_LABEL=$(getInput 'Optional descriptive restore-point label' "${VDM_LABEL:-}" 'Backup Label') || return 3
  if getInputYesNo 'Save these options for this website?' 'Backup Defaults' 8 112; then joomlaBackupSaveOptions "$site" || return 1; fi
  getInputYesNo 'Website services will be paused while files and SQL are copied, then returned to their previous running state. Continue?' 'Consistent Backup' 10 112 || return 3
}

# One action implementation is used by CLI, selected-site menus and batch UI.
# shellcheck disable=SC2016
function joomla__TRuST__backup() {
  (
    set +x
    umask 077
    local action="${VDM_ACTION:-list}" site="${VDM_CONTAINER:-}" archive="${VDM_FILE:-${VDM_INPUT_FILE:-}}" target="${VDM_TARGET:-new}" destination key result=0 status=0 digest record records='' scope manifest source rows backup
    local -a sites=()
    local VDM_BACKUP_OPTIONS_READY=false
    case "$action" in
      verify) [ -n "$archive" ] || exit 17; joomlaBackupVerify "$archive"; exit $?;;
      restore)
        [ -n "$archive" ] && [ -f "$archive" ] || exit 17
        # Verify before any prebackup or destination mutation.
        joomlaBackupVerify "$archive" >/dev/null || exit $?
        if [ "$target" = new ]; then
          key="${VDM_KEY:-}"
          destination="${VDM_TARGET_HOST:-${VDM_SUBDOMAIN:-}.${VDM_DOMAIN:-}}"
          if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] && { [ -z "$key" ] || ! isValidDomain "$destination"; }; then
            key=$(getInput 'Destination project key (letters only)' "$key" 'Restore Project Key') || exit 3
            destination=$(getInput 'Destination hostname including subdomain and domain' "$destination" 'Restore Hostname') || exit 3
          fi
          joomlaBackupRestoreNew "$archive" "$destination" "$key" >/dev/null || exit $?
        elif [ "$target" = current ]; then
          if [ -z "$site" ] || [ "${VDM_CONFIRM:-false}" != true ] || [ "${VDM_PRE_BACKUP:-false}" != true ]; then joomlaBackupError 'Current-site restore requires --confirm yes and --pre-backup yes.'; exit 17; fi
          joomlaBackupResolveOptions "$site" || exit $?
          backup="$VDM_DESTINATION/$site-before-restore-$(date -u +%Y%m%dT%H%M%SZ)-$$.tar.gz"
          VDM_LABEL=before-restore joomlaBackupCreate "$site" "$backup" full tar.gz false >/dev/null || exit $?
          joomlaBackupVerify "$backup" >/dev/null || exit $?
          printf 'Pre-restore backup retained: %s\n' "$backup" >&2
          joomlaBackupRestoreCurrent "$site" "$archive" >/dev/null || exit $?
          destination="$site"
        else exit 17; fi
        if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then joomlaSiteJSON -n --arg archive "$archive" --arg destination_site "$destination" --arg pre_restore_backup "${backup:-}" '{archive:$archive,destination_site:$destination_site,pre_restore_backup:$pre_restore_backup,restored:true}'
        else printf 'Restored %s from %s\n' "$destination" "$archive"; fi
        exit 0;;
    esac
    if [ "$action" = create ]; then
      if [ "${VDM_ALL:-false}" = true ]; then while IFS= read -r source; do [ -z "$source" ] || sites+=("$source"); done < <(listJoomlaSites)
      elif [ "${#VDM_SITES[@]}" -gt 0 ]; then sites=("${VDM_SITES[@]}")
      elif [ -n "$site" ]; then sites=("$site")
      else exit 17; fi
      [ "${#sites[@]}" -gt 0 ] || exit 17
      if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] && ! cliHasValue VDM_TASK; then
        joomlaBackupCreateQuestions "${sites[0]}" || exit $?
        VDM_BACKUP_OPTIONS_READY=true
      fi
      for source in "${sites[@]}"; do
        status=0 destination='' scope='' digest=''
        joomlaBackupResolveOptions "$source" || status=$?
        if [ "$status" -eq 0 ]; then
          scope="$VDM_SCOPE"
          if [ -n "$archive" ]; then destination="$archive"; else destination=$(joomlaBackupFilename "$source") || status=$?; fi
        fi
        if [ "$status" -eq 0 ]; then joomlaBackupCreate "$source" "$destination" "$VDM_SCOPE" "$VDM_FORMAT" "$VDM_OVERWRITE" >/dev/null || status=$?; fi
        digest=''
        if [ "$status" -eq 0 ]; then digest=$(migrationArchiveDigest "$destination") || status=$?; fi
        [ "$status" -eq 0 ] || result="$status"
        if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then
          record=$(joomlaSiteJSON -nc --arg site "$source" --arg archive "${destination:-}" --arg digest "$digest" --arg scope "$scope" --argjson exit_status "$status" '{site:$site,archive:$archive,digest:$digest,scope:$scope,exit_status:$exit_status}') || exit 1
          records+="$record"$'\n'
        else printf '%s\t%s\t%s\n' "$source" "$status" "${destination:-unavailable}"; fi
      done
      [ "${OCTOJOOM_OUTPUT:-text}" != json ] || printf '%s' "$records" | joomlaSiteJSON -s '.'
      exit "$result"
    fi
    [ -n "$site" ] || exit 17
    joomlaBackupResolveOptions "$site" || exit $?
    case "$action" in
      list)
        rows=$(joomlaBackupList "$site" "$VDM_DESTINATION") || exit $?
        if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then printf '%s\n' "$rows" | joomlaSiteJSON -Rs 'split("\n")|map(select(length>0)|split("\t")|{created:.[0],scope:.[1],format:.[2],bytes:.[3],label:.[4],archive:.[5]})'
        elif [ -n "$rows" ]; then printf '%s\n' "$rows"; fi;;
      delete)
        [ -n "$archive" ] || exit 17
        joomlaBackupDelete "$site" "$archive" || exit $?
        if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then joomlaSiteJSON -n --arg site "$site" --arg archive "$archive" '{site:$site,archive:$archive,deleted:true}'; else printf 'Deleted %s\n' "$archive"; fi;;
      cleanup)
        rows=$(joomlaBackupCleanup "$site" "$VDM_DESTINATION" "$VDM_RETENTION") || exit $?
        if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then
          printf '%s' "$rows" | joomlaSiteJSON -Rs --arg site "$site" --arg retention "$VDM_RETENTION" --arg confirmed "${VDM_CONFIRM:-false}" '{site:$site,retention:$retention,deleted:($confirmed=="true"),archives:(split("\n")|map(select(length>0)))}'
        elif [ -n "$rows" ]; then printf '%s\n' "$rows"; fi;;
      *) exit 17;;
    esac
  )
}

function showJoomlaBackups() {
  local site="$1" action choice rows created scope format size label archive output status
  local VDM_CONTAINER="$1" VDM_ACTION VDM_FILE='' VDM_INPUT_FILE='' VDM_CONFIRM=false VDM_PRE_BACKUP=false VDM_TARGET
  local VDM_DESTINATION VDM_FORMAT VDM_SCOPE VDM_TIMESTAMP VDM_TIMESTAMP_PATTERN VDM_OVERWRITE VDM_RETENTION VDM_LABEL=''
  local VDM_ALL=false VDM_BACKUP_OPTIONS_READY=false
  local -a choices=() VDM_SITES=()
  while true; do
    joomlaBackupResolveOptions "$site" || return 1
    rows=$(joomlaBackupList "$site" "$VDM_DESTINATION") || return 1
    action=$(whiptail --menu "Backups for $site\nSaved destination: $VDM_DESTINATION\n${rows:-No restore points in this directory.}" 0 112 0 --title 'Backups and restore points' \
      create 'Create a backup' restore 'Restore an archive' verify 'Verify a backup' delete 'Delete a backup' cleanup 'Retention cleanup' back '<-- Return to website' 3>&1 1>&2 2>&3) || return 0
    case "$action" in
      back) return 0;;
      create) VDM_ACTION=create VDM_FILE='' VDM_INPUT_FILE=''; joomla__TRuST__backup || showError 'Backup did not complete.'; continue;;
      cleanup)
        VDM_RETENTION=$(getInput 'Keep this many newest backups (0 disables cleanup)' "$VDM_RETENTION" 'Backup Retention') || continue
        VDM_CONFIRM=false
        output=$(joomlaBackupCleanup "$site" "$VDM_DESTINATION" "$VDM_RETENTION") || { showError 'Invalid retention rule.'; continue; }
        if [ -n "$output" ] && getInputYesNo "Delete these selected-site backups?\n$output" 'Confirm Retention Cleanup' 16 112 defaultno; then
          VDM_CONFIRM=true; joomlaBackupCleanup "$site" "$VDM_DESTINATION" "$VDM_RETENTION" || showError 'Cleanup did not complete.'
          joomlaBackupSaveOptions "$site" || showError 'Retention preference could not be saved.'
        fi
        continue;;
    esac
    choices=()
    while IFS=$'\t' read -r created scope format size label archive; do
      [ -z "$archive" ] || choices+=("$archive" "$label | $scope | $format | $size bytes")
    done <<< "$rows"
    choices+=(manual 'Enter another archive path' back '<-- Back')
    choice=$(whiptail --menu 'Select the exact archive' 0 112 0 --title 'Backup Archive' "${choices[@]}" 3>&1 1>&2 2>&3) || continue
    [ "$choice" != back ] || continue
    if [ "$choice" = manual ]; then choice=$(getInput 'Archive path' '' 'Backup Archive') || continue; fi
    VDM_FILE="$choice" VDM_ACTION="$action" VDM_CONFIRM=false VDM_PRE_BACKUP=false
    case "$action" in
      restore)
        VDM_TARGET=new
        if ! getInputYesNo 'Restore as a new independent site?' 'Restore Destination' 8 112; then
          VDM_TARGET=current
          getInputYesNo "Replace the selected site $site using $choice? A verified full pre-restore backup will be retained." 'Restore Current Site' 12 112 defaultno || continue
          VDM_CONFIRM=true VDM_PRE_BACKUP=true
        fi;;
      delete) getInputYesNo "Delete this archive?\n$choice" 'Delete Backup' 10 112 defaultno || continue; VDM_CONFIRM=true;;
    esac
    status=0
    if [ "$action" = restore ]; then output=$(OCTOJOOM_OUTPUT=json joomla__TRuST__backup) || status=$?
    else output=$(joomla__TRuST__backup) || status=$?; fi
    if [ "$status" -eq 0 ] && [ "$action" = restore ] && [ "$VDM_TARGET" = new ]; then
      local restored_site
      restored_site=$(printf '%s' "$output" | joomlaSiteJSON -er '.destination_site') || return 1
      showNotice "Restored $restored_site."
      showJoomlaWebsiteInformation "$restored_site" true
      return $?
    elif [ "$status" -eq 0 ]; then showNotice "${output:-Backup action completed.}"
    else showError 'Backup action failed; retained recovery files and current state are reported above.'; fi
  done
}

function showJoomlaBackupSelection() {
  local action site selected
  local -a choices=() VDM_SITES=()
  local VDM_FILE='' VDM_INPUT_FILE=''
  local VDM_ALL=false VDM_ACTION=create VDM_CONTAINER=''
  action=$(whiptail --menu 'Choose websites to back up with shared options' 0 112 0 --title 'Back up websites' selected 'Select websites' all 'All configured websites' back '<-- Return to Joomla' 3>&1 1>&2 2>&3) || return 0
  case "$action" in
    back) return 0;;
    all) VDM_ALL=true;;
    selected)
      while IFS= read -r site; do [ -z "$site" ] || choices+=("$site" 'Website' OFF); done < <(listJoomlaSites)
      [ "${#choices[@]}" -gt 0 ] || { showNotice 'No websites are configured.'; return 0; }
      selected=$(whiptail --checklist 'Select websites' 0 112 0 --separate-output --title 'Back up websites' "${choices[@]}" 3>&1 1>&2 2>&3) || return 0
      while IFS= read -r site; do [ -z "$site" ] || VDM_SITES+=("$site"); done <<< "$selected"
      [ "${#VDM_SITES[@]}" -gt 0 ] || return 0;;
  esac
  joomla__TRuST__backup
}

######################################## CLONE HELPERS (no user interaction, so they can be tested)

# the env variable name suffixes a Joomla container reads through its env key (VDM_<ENV_KEY>_<suffix>)
# returned as an extended regular expression alternation
function getJoomlaEnvSuffixes() {
  echo 'DB|DB_USER|DB_PASS|DB_ROOT|DB_ENGINE|DB_IMAGE|DATABASE_EXPORT_DIR|DATABASE_IMPORT_DIR|DATABASE_COMPRESSION|DATABASE_TIMESTAMP|PUID|PGID|JOOMLA_[A-Z_]+|EXTENSIONS_URLS|CLI_COMMANDS|IMAGE|IMAGE_SOURCE|IMAGE_TAG|AUTO_INSTALL|PHPMYADMIN|PHP_IMAGE|PHP_MAX_EXECUTION_TIME|PHP_MAX_INPUT_TIME|PHP_MAX_INPUT_VARS|PHP_ERROR_REPORTING|PHP_UPLOAD_MAX_FILESIZE|PHP_POST_MAX_SIZE|PHP_MEMORY_LIMIT|WEBSERVER|DOCROOT|NGINX_IMAGE|SMTP_HOST|SMTP_PORT|SMTP_USERNAME|SMTP_PASSWORD|SMTP_SECURITY|SMTP_AUTH|SMTP_FROM|SMTP_FROM_NAME|HOOKS_ENABLED|HOOK_PRE_START|HOOK_POST_START|HOOK_PRE_STOP|HOOK_POST_STOP|BACKUP_PATH|BACKUP_FORMAT|BACKUP_RETENTION|BACKUP_SCOPE|BACKUP_TIMESTAMP|BACKUP_TIMESTAMP_PATTERN|BACKUP_OVERWRITE|TOOLS_IMAGE|TOOLS_ENABLED'
}

# Read a generated database reference in list or ordinary block-map notation.
# Several different scoped database identities are ambiguous and fail closed.
function getJoomlaComposeEnvKey() {
  local key
  key=$(awk '
    /^[[:space:]]*#/ {next}
    {
      line=$0; sub(/^[[:space:]]*(-[[:space:]]*)?["\047]?/, "", line)
      if(line !~ /^(MARIADB_DATABASE|MYSQL_DATABASE|POSTGRES_DB)[=:]/) next
      sub(/^[^=:]*[=:][[:space:]]*["\047]?/, "", line)
      sub(/["\047]?[[:space:]]*(#.*)?$/, "", line)
      if(line !~ /^[$][{]VDM_[A-Za-z]+_DB[}]$/) next
      sub(/^[$][{]VDM_/, "", line); sub(/_DB[}]$/, "", line); print line
    }
  ' "$1" | sort -u) || return 1
  [[ "$key" =~ ^[A-Za-z]+$ ]] || return 1
  printf '%s\n' "$key"
}

# read the identity of a Joomla container from its docker-compose.yml
# $1: path to the docker-compose.yml
# sets: VDM_SRC_KEY, VDM_SRC_ENV_KEY, VDM_SRC_PROJECT_FOLDER, VDM_SRC_MAILCATCHER,
#       VDM_SRC_NAMED_VOLUMES, VDM_SRC_SECURE
# returns 1 when the key or env key could not be found (hand written file)
function getJoomlaComposeIdentity() {
  local yml="${1:-}"
  VDM_SRC_KEY=''
  VDM_SRC_ENV_KEY=''
  VDM_SRC_PROJECT_FOLDER=''
  VDM_SRC_MAILCATCHER=false
  VDM_SRC_NAMED_VOLUMES=false
  VDM_SRC_SECURE=false
  [ -f "${yml}" ] || return 1
  # the key is the suffix of the database container name
  VDM_SRC_KEY=$(sed -nE 's/^[[:space:]]*container_name:[[:space:]]*mariadb([A-Za-z]+)[[:space:]]*$/\1/p' "${yml}" | head -n 1)
  # the env key is the middle part of the database name variable (comment lines are ignored)
  VDM_SRC_ENV_KEY=$(getJoomlaComposeEnvKey "${yml}") || return 1
  if [ ${#VDM_SRC_KEY} -lt 1 ] || [ ${#VDM_SRC_ENV_KEY} -lt 1 ]; then
    return 1
  fi
  # optional features
  grep -qE "^[[:space:]]*container_name:[[:space:]]*mailcatcher${VDM_SRC_KEY}[[:space:]]*$" "${yml}" && VDM_SRC_MAILCATCHER=true
  grep -qE "^[[:space:]]*-[[:space:]]*${VDM_SRC_KEY,,}_(web|db):/var/" "${yml}" && VDM_SRC_NAMED_VOLUMES=true
  grep -qE 'entrypoints=websecure|tls\.certresolver=' "${yml}" && VDM_SRC_SECURE=true
  # the project folder (persistent volume) named in the active bind mounts (comment lines are ignored)
  VDM_SRC_PROJECT_FOLDER=$(sed -nE '/^[[:space:]]*#/!s#^.*PROJECT_PATH[}]/([^/]+)/db:/var/lib/(mysql|postgresql(/data)?).*#\1#p' "${yml}" | head -n 1)
  [ -n "${VDM_SRC_PROJECT_FOLDER}" ] ||
    VDM_SRC_PROJECT_FOLDER=$(sed -nE '/^[[:space:]]*#/!s#^.*PROJECT_PATH[}]/([^/]+)/joomla:/var/www/html.*$#\1#p' "${yml}" | head -n 1)
  export VDM_SRC_KEY
  export VDM_SRC_ENV_KEY
  export VDM_SRC_PROJECT_FOLDER
  export VDM_SRC_MAILCATCHER
  export VDM_SRC_NAMED_VOLUMES
  export VDM_SRC_SECURE
  return 0
}

# escape a string for use inside an extended regular expression (also escapes the # delimiter)
function getEscapedRegex() {
  # shellcheck disable=SC2016
  printf '%s' "${1:-}" | sed -e 's/[][\.*^$(){}?+|#/]/\\&/g'
}

# write a copy of a Joomla docker-compose.yml with a new identity
# $1: source docker-compose.yml   $2: target docker-compose.yml
# $3: old key                     $4: new key
# $5: old env key                 $6: new env key
# $7: old sub-domain              $8: new sub-domain
# $9: old domain                  $10: new domain
# $11 (optional): the project folder the source mounts, when it is not the old key
# Keys are alphabetical only, so every token can be anchored on a non-letter.
# Lines with a Traefik Host() rule are handled on their own, so a domain that happens
# to contain a service name and the key (joomlasite.com with key site) is never touched.
# returns 1 when the source is missing or sed failed,
#         2 when a value of the source survived, or a host or mount is not the clone's own
function rewriteJoomlaComposeIdentity() {
  local src="${1:-}"
  local dst="${2:-}"
  local old_key="${3:-}"
  local new_key="${4:-}"
  local old_env="${5:-}"
  local new_env="${6:-}"
  local old_sub="${7:-}"
  local new_sub="${8:-}"
  local old_domain="${9:-}"
  local new_domain="${10:-}"
  local src_folder="${11:-$3}"
  local suffixes
  local old_domain_re
  local folder
  local folder_re
  local pattern
  local active
  local mount
  local mount_source
  local mount_target
  local mount_folder
  local mount_volume
  local host
  local -a sed_args=()
  local -a leftovers=()
  [ -f "${src}" ] && [ -n "${dst}" ] || return 1
  # Never truncate the source through the same path, hard link or symlink.
  [ "${src}" != "${dst}" ] && [ ! "${src}" -ef "${dst}" ] || return 1
  [[ "${old_key}" =~ ^[A-Za-z]+$ && "${new_key}" =~ ^[A-Za-z]+$ &&
    "${old_env}" =~ ^[A-Za-z]+$ && "${new_env}" =~ ^[A-Za-z]+$ &&
    "${old_sub}" =~ ^[A-Za-z]+$ && "${new_sub}" =~ ^[A-Za-z]+$ &&
    "${old_domain}" =~ ^[A-Za-z0-9.-]+$ && "${new_domain}" =~ ^[A-Za-z0-9.-]+$ ]] || return 1
  [ -n "${src_folder}" ] || src_folder="${old_key}"
  suffixes=$(getJoomlaEnvSuffixes)
  old_domain_re=$(getEscapedRegex "${old_domain}")
  # lines with a Traefik Host() rule: only the router name and the hosts change
  # shellcheck disable=SC2016
  sed_args+=(-e '/Host\(`/{')
  sed_args+=(-e 's/(routers\.)(mariadb|joomla|nginx|phpmyadmin|mailcatcher)'"${old_key}"'\./\1\2'"${new_key}"'./g')
  if [ "${old_sub}.${old_domain}" != "${new_sub}.${new_domain}" ]; then
    # shellcheck disable=SC2016
    sed_args+=(-e 's/Host\(`'"${old_sub}"'(db|mail)?\.'"${old_domain_re}"'`\)/Host(`'"${new_sub}"'\1.'"${new_domain}"'`)/g')
  fi
  sed_args+=(-e 'b' -e '}')
  # service names, container names, database host, SMTP host and Traefik router/service names
  # A migration may retain its key on another host; only renamed identities
  # are leftovers. The destination host and mount checks still apply below.
  if [ "${old_key}" != "${new_key}" ]; then
    sed_args+=(-e 's/(mariadb|joomla|nginx|phpmyadmin|mailcatcher)'"${old_key}"'([^A-Za-z]|$)/\1'"${new_key}"'\2/g')
    leftovers+=('(mariadb|joomla|nginx|phpmyadmin|mailcatcher)'"${old_key}"'([^A-Za-z]|$)')
  fi
  # bind mounts under the project path (joomla, db, php.ini, entrypoint.sh)
  for folder in "${src_folder}" "${old_key}"; do
    [ "${folder}" != "${new_key}" ] || continue
    folder_re=$(getEscapedRegex "${folder}")
    sed_args+=(-e 's#PROJECT_PATH[}]/'"${folder_re}"'/#PROJECT_PATH}/'"${new_key}"'/#g')
    leftovers+=('PROJECT_PATH[}]/'"${folder_re}"'/')
  done
  # named volumes (expert mode without persistence)
  if [ "${old_key,,}" != "${new_key,,}" ]; then
    sed_args+=(-e 's/(^|[^A-Za-z_])'"${old_key,,}"'_(web|db)([^A-Za-z_]|$)/\1'"${new_key,,}"'_\2\3/g')
    leftovers+=('(^|[^A-Za-z_])'"${old_key,,}"'_(web|db)([^A-Za-z_]|$)')
  fi
  # environment variable references (only the names a Joomla container reads)
  if [ "${old_env}" != "${new_env}" ]; then
    # shellcheck disable=SC2016
    sed_args+=(-e 's/[$][{]VDM_'"${old_env}"'_('"${suffixes}"')[}]/${VDM_'"${new_env}"'_\1}/g')
    leftovers+=('[$][{]VDM_'"${old_env}"'_('"${suffixes}"')[}]')
  fi
  sed -E "${sed_args[@]}" "${src}" > "${dst}" || return 1
  # the checks below look at the active lines only (comments never reach docker compose)
  active=$(sed -E '/^[[:space:]]*#/d' "${dst}")
  # make sure nothing of the old identity survived (host values are checked below)
  for pattern in "${leftovers[@]}"; do
    # shellcheck disable=SC2016
    if printf '%s\n' "${active}" | sed -E 's/Host\(`[^`]*`\)/Host()/g' | grep -qE "${pattern}"; then
      return 2
    fi
  done
  # a host rule must use the single backtick Host() form the rewrite understands
  # (double quotes, several hosts in one Host() or HostRegexp() cannot be renamed safely)
  # shellcheck disable=SC2016
  if printf '%s\n' "${active}" | sed -E 's/Host\(`[^`]*`\)//g' | grep -qE 'Host(Regexp|SNI|SNIRegexp)?\('; then
    return 2
  fi
  # every host must be one of the clone's own hosts (host names are not case sensitive)
  # shellcheck disable=SC2016
  while IFS= read -r host; do
    case "${host,,}" in
    "${new_sub,,}.${new_domain,,}" | "${new_sub,,}db.${new_domain,,}" | "${new_sub,,}mail.${new_domain,,}") ;;
    *) return 2 ;;
    esac
  done < <(printf '%s\n' "${active}" | grep -oE 'Host\(`[^`]*`\)' | sed -E 's/^Host\(`(.*)`\)$/\1/')
  # the long volume syntax is never written by ${PROGRAM_NAME}, and cannot be checked
  if printf '%s\n' "${active}" | grep -qE 'target:[[:space:]]*"?/var/(lib/mysql|lib/postgresql(/data)?|www/html)/?"?[[:space:]]*$'; then
    return 2
  fi
  # every database and web root mount must be the clone's own folder (or named volume)
  while IFS= read -r mount; do
    mount=$(printf '%s' "${mount}" | sed -E 's/^[[:space:]]*-[[:space:]]*//; s/^"//; s/"[[:space:]]*$//')
    mount_source="${mount%%:/var/*}"
    mount_target="${mount#"${mount_source}":}"
    case "${mount_target%%:*}" in
    /var/lib/mysql|/var/lib/postgresql|/var/lib/postgresql/data) mount_folder='db' mount_volume="${new_key,,}_db" ;;
    *) mount_folder='joomla' mount_volume="${new_key,,}_web" ;;
    esac
    # shellcheck disable=SC2016
    if [ "${mount_source}" != '${VDM_PROJECT_PATH}/'"${new_key}/${mount_folder}" ] &&
      [ "${mount_source}" != "${mount_volume}" ]; then
      return 2
    fi
  done < <(printf '%s\n' "${active}" | grep -E ':/var/(lib/mysql|lib/postgresql(/data)?|www/html)/?(:[a-z,]+)?"?[[:space:]]*$')
  return 0
}

# get a value from a Joomla configuration.php file
# $1: path to configuration.php   $2: setting name (host, db, sitename, ...)
function getJoomlaConfigValue() {
  local file="${1:-}"
  local name="${2:-}"
  [ -f "${file}" ] || return 1
  sed -nE "s/^[[:space:]]*public[[:space:]]+[\$]${name}[[:space:]]*=[[:space:]]*'(.*)';[[:space:]]*\$/\\1/p" "${file}" | head -n 1
}

# point a cloned Joomla configuration.php at the clone's own containers
# $1: path to the cloned configuration.php
# $2: old key   $3: new key
# $4 (optional): new site name ('' keeps the current one)
# The file is written in place so it keeps its owner and mode (normally 0444, owned by the container user).
# returns 1 when the file is missing or could not be written, 2 when the database host is not mariadb<old key>
function cloneJoomlaConfiguration() {
  local file="${1:-}"
  local old_key="${2:-}"
  local new_key="${3:-}"
  local site_name="${4:-}"
  local host
  local tmp_file
  local q="'"
  local -a sed_args=()
  [ -f "${file}" ] || return 1
  [[ "${old_key}" =~ ^[A-Za-z]+$ && "${new_key}" =~ ^[A-Za-z]+$ ]] || return 1
  host=$(getJoomlaConfigValue "${file}" 'host')
  # only a site that uses this container's database can be re-pointed safely
  [[ "${host}" =~ ^mariadb${old_key}(:[0-9]+)?$ ]] || return 2
  # database host (the port, if any, is kept)
  sed_args+=(-e 's/^([[:space:]]*public[[:space:]]+[$]host[[:space:]]*=[[:space:]]*'"${q}"')mariadb'"${old_key}"'((:[0-9]+)?'"${q}"';)/\1mariadb'"${new_key}"'\2/')
  # mailcatcher host (only when it pointed at this container's mailcatcher)
  sed_args+=(-e 's/^([[:space:]]*public[[:space:]]+[$]smtphost[[:space:]]*=[[:space:]]*'"${q}"')mailcatcher'"${old_key}"'('"${q}"';)/\1mailcatcher'"${new_key}"'\2/')
  # site name
  if [ -n "${site_name}" ]; then
    # escape for a PHP single quoted string (\ and '), then escape the result for the sed replacement (\ & |)
    site_name=$(printf '%s' "${site_name}" | sed -e 's/[\\]/\\\\/g' -e "s/'/\\\\'/g" -e 's/[\\]/\\\\/g' -e 's/[&|]/\\&/g')
    sed_args+=(-e 's|^([[:space:]]*public[[:space:]]+[$]sitename[[:space:]]*=[[:space:]]*'"${q}"').*('"${q}"';[[:space:]]*)$|\1'"${site_name}"'\2|')
  fi
  tmp_file=$(mktemp) || return 1
  if ! sed -E "${sed_args[@]}" "${file}" > "${tmp_file}"; then
    rm -f "${tmp_file}"
    return 1
  fi
  # write back into the existing file so owner and mode are kept
  if [ -w "${file}" ]; then
    cat "${tmp_file}" > "${file}" || {
      rm -f "${tmp_file}"
      return 1
    }
  elif useSudo; then
    # tee (run with sudo) is what writes the file, the redirects only feed it
    # shellcheck disable=SC2024
    runPrivileged tee "${file}" < "${tmp_file}" > /dev/null || {
      rm -f "${tmp_file}"
      return 1
    }
  else
    # no sudo here (Windows): lift the owner write bit for the write and put it back
    if ! chmod u+w "${file}" || ! cat "${tmp_file}" > "${file}"; then
      chmod u-w "${file}" 2>/dev/null
      rm -f "${tmp_file}"
      return 1
    fi
    chmod u-w "${file}" || {
      rm -f "${tmp_file}"
      return 1
    }
  fi
  rm -f "${tmp_file}"
  return 0
}

# copy the env values of one Joomla env key to another env key
# $1: env file to read   $2: old env key   $3: new env key
# $4 (optional): env file to write (default: the file read)
# A line is only added when the new key does not already have that value.
# Prints the name of every variable it added (one per line), so a rollback can remove exactly those.
function cloneContainerEnvVariables() {
  local src_file="${1:-}"
  local old_env="${2:-}"
  local new_env="${3:-}"
  local dst_file="${4:-$1}"
  local suffixes
  local line
  local suffix
  local value
  local -a lines=()
  [ -f "${src_file}" ] || return 1
  [[ "${old_env}" =~ ^[A-Za-z]+$ && "${new_env}" =~ ^[A-Za-z]+$ ]] || return 1
  [ -n "${dst_file}" ] || return 1
  [ "${old_env}" = "${new_env}" ] && [ "${src_file}" = "${dst_file}" ] && return 0
  suffixes=$(getJoomlaEnvSuffixes)
  # read everything first, so we never read the lines we append (source and target can be the same file)
  mapfile -t lines < "${src_file}" || return 1
  # the target must end with a new line, else the first value is glued onto its last line
  if [ -s "${dst_file}" ] && [ -n "$(tail -c 1 "${dst_file}")" ]; then
    printf '\n' >> "${dst_file}" || return 1
  fi
  for line in "${lines[@]}"; do
    [[ "${line}" =~ ^VDM_${old_env}_(${suffixes})=(.*)$ ]] || continue
    suffix="${BASH_REMATCH[1]}"
    value="${BASH_REMATCH[2]}"
    if [ -f "${dst_file}" ] && grep -qE "^VDM_${new_env}_${suffix}=" "${dst_file}"; then
      continue
    fi
    printf 'VDM_%s_%s=%s\n' "${new_env}" "${suffix}" "${value}" >> "${dst_file}" || return 1
    echo "VDM_${new_env}_${suffix}"
  done
  return 0
}

# check if an env file already has values for a Joomla env key
# $1: env file   $2: env key
function hasContainerEnvVariables() {
  local env_file="${1:-}"
  local env_key="${2:-}"
  [[ "${env_key}" =~ ^[A-Za-z]+$ ]] || return 1
  [ -f "${env_file}" ] && [ -n "${env_key}" ] &&
    grep -qE "^VDM_${env_key}_($(getJoomlaEnvSuffixes))=" "${env_file}"
}

# copy a per-container env file for a cloned container, renaming the env key
# $1: source .env   $2: target .env   $3: old env key   $4: new env key
function cloneContainerEnvFile() {
  local src_file="${1:-}"
  local dst_file="${2:-}"
  local old_env="${3:-}"
  local new_env="${4:-}"
  local suffixes
  [ -f "${src_file}" ] || return 1
  [ -n "${dst_file}" ] && [ "${src_file}" != "${dst_file}" ] &&
    [ ! "${src_file}" -ef "${dst_file}" ] || return 1
  [[ "${old_env}" =~ ^[A-Za-z]+$ && "${new_env}" =~ ^[A-Za-z]+$ ]] || return 1
  suffixes=$(getJoomlaEnvSuffixes)
  if [ "${old_env}" = "${new_env}" ]; then
    cp "${src_file}" "${dst_file}" || return 1
  else
    sed -E 's/^VDM_'"${old_env}"'_('"${suffixes}"')=/VDM_'"${new_env}"'_\1=/' "${src_file}" > "${dst_file}" || return 1
  fi
  chmod 600 "${dst_file}"
}

# remove env variables by name from an env file (used to roll back a failed clone)
# $1: env file   $2...: the variable names to remove (as printed by cloneContainerEnvVariables)
# Only these exact names are removed; the file is replaced in one step, never truncated first.
function removeContainerEnvVariables() {
  local env_file="${1:-}"
  local name
  local names=''
  local tmp_file
  local rc
  [ -f "${env_file}" ] || return 0
  shift
  for name in "$@"; do
    [[ "${name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    names+="${names:+|}${name}"
  done
  [ -n "${names}" ] || return 0
  tmp_file=$(mktemp "${env_file}.XXXXXX") || return 1
  # grep returns 1 when no line is left, which is still a valid result
  grep -vE "^(${names})=" "${env_file}" > "${tmp_file}"
  rc=$?
  if [ "${rc}" -gt 1 ]; then
    rm -f "${tmp_file}"
    return 1
  fi
  if ! chmod 600 "${tmp_file}" || ! mv -f "${tmp_file}" "${env_file}"; then
    rm -f "${tmp_file}"
    return 1
  fi
  return 0
}

# check if a host name is already routed by Traefik for any container ${PROGRAM_NAME} knows
# $1: host (sub.domain.tld), compared without case like DNS and Traefik do
function isJoomlaHostInUse() {
  local host="${1:-}"
  [ -n "${host}" ] || return 0
  # shellcheck disable=SC2016
  grep -qsiF 'Host(`'"${host}"'`)' "${VDM_REPO_PATH}/"*/available/*/docker-compose.yml "${VDM_REPO_PATH}/"*/docker-compose.yml
}

# check if privileged commands should go through sudo
# Linux and macOS use sudo; on Windows (MSYS/Git Bash) the files belong to the user, and a sudo
# found there is the unrelated Windows sudo.exe, so commands run directly.
function useSudo() {
  [ "${OS_NUMBER:-0}" != "3" ] && command -v sudo >/dev/null 2>&1
}

# run a command with sudo where useSudo says so, else directly
function runPrivileged() {
  if useSudo; then
    if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then sudo -n "$@"; else sudo "$@"; fi
  else
    "$@"
  fi
}

# get a whiptail height that fits a message (long lines wrap), capped at the terminal height
# $1: message (with \n new lines)   $2 (optional): rows the dialog needs besides the text (default 8)
function getDialogHeight() {
  local message="${1:-}"
  local extra="${2:-8}"
  local lines
  local rows
  local height
  lines=$(printf '%b\n' "${message}" | awk '{ n += (length($0) > 106) ? int((length($0) + 105) / 106) : 1 } END { print n + 0 }')
  height=$((lines + extra))
  rows=$(tput lines 2>/dev/null)
  if [[ "${rows}" =~ ^[0-9]+$ ]] && [ "${rows}" -gt 10 ] && [ "${height}" -gt "${rows}" ]; then
    height="${rows}"
  fi
  echo "${height}"
}

# check if a key is already used by a Joomla project folder, a compose file or a docker container
# $1: key
# returns 0 when in use, 1 when available, 2 when the inventory cannot be inspected safely
function isJoomlaKeyInUse() {
  local key="${1:-}"
  local yml names scan_status inventory_dir
  [[ "${key}" =~ ^[A-Za-z]+$ ]] || return 2
  for inventory_dir in "${VDM_PROJECT_PATH}" "${VDM_REPO_PATH}"; do
    if [ ! -d "${inventory_dir}" ] || [ ! -r "${inventory_dir}" ] || [ ! -x "${inventory_dir}" ]; then
      printf '%s\n' 'Could not inspect the project or repository directory for key collisions.' >&2
      return 2
    fi
  done
  for inventory_dir in "${VDM_REPO_PATH}/joomla" "${VDM_REPO_PATH}/joomla/available"; do
    if { [ -e "${inventory_dir}" ] || [ -L "${inventory_dir}" ]; } &&
      { [ ! -d "${inventory_dir}" ] || [ ! -r "${inventory_dir}" ] || [ ! -x "${inventory_dir}" ]; }; then
      printf '%s\n' 'Could not inspect the Joomla Compose directory for key collisions.' >&2
      return 2
    fi
  done
  if [ -e "${VDM_PROJECT_PATH}/${key}" ] || [ -L "${VDM_PROJECT_PATH}/${key}" ]; then
    return 0
  fi
  for yml in "${VDM_REPO_PATH}/joomla/available/"*/docker-compose.yml; do
    [ -e "${yml}" ] || [ -L "${yml}" ] || continue
    scan_status=0
    grep -qE "^[[:space:]]*container_name:[[:space:]]*(mariadb|joomla|phpmyadmin|mailcatcher)${key}[[:space:]]*$" \
      "${yml}" 2>/dev/null || scan_status=$?
    case "${scan_status}" in
    0) return 0 ;;
    1) ;;
    *)
      printf '%s\n' 'Could not inspect an existing Joomla Compose file for key collisions.' >&2
      return 2
      ;;
    esac
  done
  if ! command -v docker >/dev/null 2>&1 ||
    ! names=$(docker ps -a --format '{{.Names}}' 2>/dev/null); then
    printf '%s\n' 'Could not inspect Docker containers for key collisions.' >&2
    return 2
  fi
  printf '%s\n' "${names}" | grep -qxE "(mariadb|joomla|phpmyadmin|mailcatcher)${key}" && return 0
  return 1
}

# reset persistent Joomla volume
function resetPersistentJoomlaVolumes() {
  cliPreflightOtherTask || return $?
  # we first check if we have some volumes
  if hasDirectories '' "${VDM_PROJECT_PATH}"; then
    # set some local variables
    local vdm_reset_volumes
    local persistent
    # saved the file
    showNotice "Only reset persistent Joomla volumes of which you have made absolutely sure it's no longer in use!"
    # get containers to enable
    vdm_reset_volumes=$(getSelectedDirectories "Select persistent volume\s to reset." \
      "${VDM_PROJECT_PATH}" "Select Persistent Volume\s to Reset")
    # check that we have something, else return to main menu
    if [ ${#vdm_reset_volumes} -ge 1 ]; then
      # convert the string to and array
      IFS=' ' read -r -a vdm_reset_volumes_array <<<"${vdm_reset_volumes[@]}"
      # loop over the directories to build the
      for volumes in "${vdm_reset_volumes_array[@]}"; do
        # remove the " from the string
        persistent="${volumes//\"/}"
        ensureProjectStopped "${persistent}" || return $?
        # last serious check and then its gone
        if [ -d "${VDM_PROJECT_PATH}/${persistent}/joomla" ] &&
          { { [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ] && [[ "${VDM_VOLUME:-}" == web || "${VDM_VOLUME:-}" == both ]]; } ||
          { [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] && whiptail --yesno "Are you absolutely sure you would like to delete this (${persistent}/joomla) persistent volume? THIS CAN'T BE UNDONE!\n(we need sudo privileges)" \
            --title "Delete Persistent Volume" --backtitle "${BACK_TITLE}" 15 112; }; }; then
          # then remove soft link
          runPrivileged rm -rf "${VDM_PROJECT_PATH}/${persistent}/joomla" || return $?
        fi
        # last serious check and then its gone
        if [ -d "${VDM_PROJECT_PATH}/${persistent}/db" ] &&
          { { [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ] && [[ "${VDM_VOLUME:-}" == database || "${VDM_VOLUME:-}" == both ]]; } ||
          { [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] && whiptail --yesno "Are you absolutely sure you would like to delete this (${persistent}/db) persistent volume? THIS CAN'T BE UNDONE!\n(we need sudo privileges)" \
            --title "Delete Persistent Volume" --backtitle "${BACK_TITLE}" 15 112; }; }; then
          # then remove soft link
          runPrivileged rm -rf "${VDM_PROJECT_PATH}/${persistent}/db" || return $?
        fi
      done
    fi
  else
    showError "There are no persistent volumes found in ${VDM_PROJECT_PATH}."
  fi
}

# make an update
function runUpdate() {
  # we need sudo permissions
  if getInputYesNo "${USER^}, to update ${PROGRAM_NAME} we need sudo privileges." \
      "Give sudo Privileges" 8 112; then
    local branch download staged
    # get the target branch to use in our update
    if [ -n "${VDM_UPDATE_CHANNEL:-}" ]; then
      case "$VDM_UPDATE_CHANNEL" in master|staging) branch="$VDM_UPDATE_CHANNEL";; *) return 17;; esac
    elif isExpert && [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ]; then
      branch=$(getTargetBranch) || return 1
    fi
    download=$(mktemp "${TMPDIR:-/tmp}/octojoom-update.XXXXXX") || return 1
    # Keep the installed executable in place until the complete script is valid.
    if ! curl --fail --silent --show-error -L "https://raw.githubusercontent.com/octoleo/octojoom/refs/heads/${branch:-master}/src/octojoom" -o "$download" ||
        ! [ -s "$download" ] || ! grep -q '^#!/usr/bin/env bash$' "$download" || ! bash -n "$download"; then
      rm -f "$download"
      echo >&2 "ERROR: Update download or validation failed."
      return 1
    fi
    staged=$(cliSudo mktemp /usr/local/bin/.octojoom-update.XXXXXX) || {
      rm -f "$download"
      return 1
    }
    if [ -z "$staged" ] || ! cliSudo install -m 0755 "$download" "$staged" || ! cliSudo mv -f "$staged" /usr/local/bin/octojoom; then
      rm -f "$download"
      [ -z "$staged" ] || cliSudo rm -f "$staged"
      echo >&2 "ERROR: Update installation failed."
      return 1
    fi
    rm -f "$download"
    installShellIntegration || return 1
    echo "SUCCESS: Update was successful."
    [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ] && return 0
    quitProgram
  fi
}

# Remove only a specific application directory, never a home or system root.
function validateOctojoomRemovalPath() {
  local directory="${1:-}" canonical protected
  [[ "$directory" == /* ]] && [ -d "$directory" ] || return 1
  canonical=$(cd "$directory" && pwd -P) || return 1
  case "$canonical" in
    /|/etc|/usr|/usr/local|/var|/home|/root|/opt|/srv|/tmp|/mnt|/media)
      echo >&2 "ERROR: Refusing to delete a system root: $directory"
      return 1
      ;;
  esac
  for protected in "$HOME" "${VDM_HOME_PATH:-}"; do
    [ -d "$protected" ] || continue
    protected=$(cd "$protected" && pwd -P) || return 1
    if [[ "$protected/" == "$canonical/"* ]]; then
      echo >&2 "ERROR: Refusing to delete a home directory or its parent: $directory"
      return 1
    fi
  done
  return 0
}

function removeOctojoomDirectory() {
  validateOctojoomRemovalPath "${1:-}" || return 1
  local directory="$1"
  sudo rm -rf -- "$directory"
}

# make an uninstall
function runUninstall() {
  if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then cliUninstall; return $?; fi
  # little notice
  showNotice "We have three uninstall options: 1) Complete. 2) Just Script. 3) Make your selection."
  # first safety check
  if (whiptail --yesno "We are just trying to be careful here, therefore we have a few questions. Please remember there is an auto update option!\n\
    Are you absolutely sure you want to continue with the uninstalling process?\n(we need sudo privileges)" \
    --defaultno --title "Uninstalling ${PROGRAM_NAME} v${_VERSION} " --backtitle "${BACK_TITLE}" 15 112); then
    # we have four main options
    if (whiptail --yesno "Okay, So do you want to completely remove everything? This is the most dangerous option! IT CAN'T BE UNDONE!\
      We will remove literally everything like this script was never here." \
      --defaultno --title "Complete Uninstall of ${PROGRAM_NAME} v${_VERSION} " --backtitle "${BACK_TITLE}" 12 112); then
      local directory
      for directory in "$VDM_REPO_PATH" "$VDM_SRC_PATH" "$VDM_PROJECT_PATH"; do
        [ ! -d "$directory" ] || validateOctojoomRemovalPath "$directory" || return 1
      done
      if [ -d "${VDM_REPO_PATH}/joomla" ]; then
        # take down all joomla containers
        if hasDirectories 'joomla/enabled'; then
          downContainers 'joomla' || return 1
        fi
        # now completely remove Joomla configurations
        removeOctojoomDirectory "${VDM_REPO_PATH}/joomla" || return 1
      fi
      # Remove all of Openssh Docker stuff
      if [ -d "${VDM_REPO_PATH}/openssh" ]; then
        # take down all joomla containers
        if hasDirectories 'openssh/enabled'; then
          downContainers 'openssh' || return 1
        fi
        # now completely remove Joomla configurations
        removeOctojoomDirectory "${VDM_REPO_PATH}/openssh" || return 1
      fi
      # Remove all of Portainer Docker stuff
      if [ -d "${VDM_REPO_PATH}/portainer" ]; then
        # take down all portainer containers
        if [ -f "${VDM_REPO_PATH}/portainer/docker-compose.yml" ]; then
          disableContainer 'portainer' || return 1
        fi
        # now completely remove Portainer configurations
        removeOctojoomDirectory "${VDM_REPO_PATH}/portainer" || return 1
      fi
      # Remove all of Traefik Docker stuff
      if [ -d "${VDM_REPO_PATH}/traefik" ]; then
        # take down all traefik containers
        if [ -f "${VDM_REPO_PATH}/traefik/docker-compose.yml" ]; then
          disableContainer 'traefik' || return 1
        fi
        # now completely remove Traefik configurations
        removeOctojoomDirectory "${VDM_REPO_PATH}/traefik" || return 1
      fi
      # remove config if found
      if [ -d "${VDM_SRC_PATH}" ]; then
        removeOctojoomDirectory "${VDM_SRC_PATH}" || return 1
      fi
      # remove config if found
      if [ -d "${VDM_REPO_PATH}" ]; then
        removeOctojoomDirectory "${VDM_REPO_PATH}" || return 1
      fi
    elif (whiptail --yesno "Would you like to only remove the actual ${PROGRAM_NAME} v${_V}  script but keep all the Docker stuff?" \
      --title "Keep Docker Stuff" --backtitle "${BACK_TITLE}" 8 112); then
      # now remove the octojoom script
      if [ -f /usr/local/bin/octojoom ]; then
        sudo rm -f /usr/local/bin/octojoom || return 1
        removeShellIntegration || return 1
      fi
      # give the final message
      whiptail --title "${PROGRAM_NAME} v${_VERSION}  is UNINSTALLED" --msgbox "\n\
        ${PROGRAM_NAME}  v${_V} has been uninstalled.\n\n\
        We have not touched any of the Docker stuff.\n\
        To also remove these you will have to manually pull down the Docker containers (if there are any running) and then remove the following directories.\n\n\
        DOCKER:  ${VDM_REPO_PATH} \n\
        VOLUMES: ${VDM_PROJECT_PATH} \n\
        CONFIG:  ${VDM_SRC_PATH}" --backtitle "${BACK_TITLE}" 20 112
      # we exit here... where done!
      quitProgram
    else
      # little notice
      showNotice "This option lets you choose what you keep, so read the questions carefully! IT CAN'T BE UNDONE!"
      local directory
      for directory in "$VDM_REPO_PATH" "$VDM_SRC_PATH" "$VDM_PROJECT_PATH"; do
        [ ! -d "$directory" ] || validateOctojoomRemovalPath "$directory" || return 1
      done
      # shellcheck disable=SC1090
      # ----------------------------------------------------- MULTI CONTAINERS
      # Remove all of Joomla Docker stuff
      if [ -d "${VDM_REPO_PATH}/joomla" ] &&
        (whiptail --yesno "Would you like to completely remove the Joomla Docker yaml configurations in (${VDM_REPO_PATH}/joomla)?" \
          --defaultno --title "Remove Docker Config" --backtitle "${BACK_TITLE}" 12 112); then
        # take down all joomla containers
        if hasDirectories 'joomla/enabled'; then
          downContainers 'joomla' || return 1
        fi
        # now completely remove Joomla configurations
        removeOctojoomDirectory "${VDM_REPO_PATH}/joomla" || return 1
      fi
      # check if we have possible joomla containers (this will only run if they did not remove it above)
      if [ -e "${VDM_REPO_PATH}/joomla/enabled" ] &&
        (whiptail --yesno "Would you like to take down Joomla containers?" \
          --defaultno --title "Take Down Containers" --backtitle "${BACK_TITLE}" 8 112); then
        # take down all joomla containers
        if hasDirectories 'joomla/enabled'; then
          downContainers 'joomla' || return 1
        fi
        # remove all enabled
        removeOctojoomDirectory "${VDM_REPO_PATH}/joomla/enabled" || return 1
      fi
      # Remove all of Openssh Docker stuff
      if [ -d "${VDM_REPO_PATH}/openssh" ] &&
        (whiptail --yesno "Would you like to completely remove the Openssh Docker yaml configurations in (${VDM_REPO_PATH}/openssh)?" \
          --defaultno --title "Remove Docker Config" --backtitle "${BACK_TITLE}" 12 112); then
        # take down all joomla containers
        if hasDirectories 'openssh/enabled'; then
          downContainers 'openssh' || return 1
        fi
        # now completely remove Joomla configurations
        removeOctojoomDirectory "${VDM_REPO_PATH}/openssh" || return 1
      fi
      # check if we have possible openssh containers (this will only run if they did not remove it above)
      if [ -e "${VDM_REPO_PATH}/openssh/enabled" ] &&
        (whiptail --yesno "Would you like to take down Openssh containers?" \
          --defaultno --title "Take Down Containers" --backtitle "${BACK_TITLE}" 8 112); then
        # take down all joomla containers
        if hasDirectories 'openssh/enabled'; then
