#!/usr/bin/env bash

# Migration workers intentionally isolate invocation state in subshells.
# ShellCheck otherwise links identically named function-local variables across
# those independent scopes and reports their isolation as lost assignments.
# shellcheck disable=SC2030,SC2031

# The most recent program version.
_VERSION="3.9.2"
_V="3.9"

# Bash version required
_bash_v=4

# The program full name
PROGRAM_NAME="Octojoom"

# Git Bash on Windows sets USERNAME but not USER
: "${USER:=${USERNAME:-$(id -un 2>/dev/null)}}"

# Set Server Hostname
SERVER_HOSTNAME="$(hostname)"

# Set the back title
BACK_TITLE="    Octoleo | ${USER}@${SERVER_HOSTNAME}"

# The SSH migration protocol must not run installers, initialize host settings,
# or emit interactive startup output. Load this installed script's own function
# definitions, then dispatch only the fixed worker operations below.
if [ "${1:-}" = --migration-worker ]; then
  set +x
  if (( BASH_VERSINFO[0] < 4 )); then
    printf '%s\n' 'Migration requires Bash 4 or newer.' >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  source <(awk '/^(function )?[A-Za-z_][A-Za-z0-9_]*\(\) \{$/ {p=1} p {print} p && /^}$/ {p=0}' "${BASH_SOURCE[0]}")
  shift
  migrationWorker "$@"
  exit $?
fi

# Read-only discovery and explicit automation bypass interactive dependency setup.
# Load this executable's own functions, as the migration worker already does.
# A supplied task with no input terminal is automation even when the caller
# omits --non-interactive. An argument-free invocation retains the normal menu.
octojoom_headless_task=false
if [ ! -t 0 ] && [ "${1:-}" != --complete ]; then
  for octojoom_argument in "$@"; do
    case "$octojoom_argument" in --) break;; --type|--type=*|--task|--task=*|--container|--container=*) octojoom_headless_task=true;; esac
  done
fi
if [ "$octojoom_headless_task" = true ]; then set -- --non-interactive "$@"; fi
unset octojoom_headless_task
for octojoom_argument in "$@"; do
  case "$octojoom_argument" in
    --complete|--non-interactive|--input-json|--input-json=*|--output|--output=*|-h|--help)
      check_cli_bash=${BASH_VERSINFO[0]}
      [ "$check_cli_bash" -ge 4 ] || { echo >&2 'Octojoom requires Bash 4 or newer.'; exit 1; }
      # shellcheck disable=SC1090
      source <(awk '/^(function )?[A-Za-z_][A-Za-z0-9_]*\(\) \{$/ {p=1} p {print} p && /^}$/ {p=0}' "${BASH_SOURCE[0]}")
      cliStart "$@"
      exit $?
      ;;
  esac
done
unset octojoom_argument

