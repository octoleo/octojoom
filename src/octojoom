# Replace only Joomla's ordinary, single-line database properties. Values are
# PHP single-quoted literals; neither credentials nor source text are evaluated.
function joomlaDatabasePatchConfiguration() {
  set +x
  local source="$1" destination="$2" name value escaped index
  shift 2
  local -a field_names=(host dbtype db user password dbprefix) values=("$@")
  [ "${#values[@]}" -eq 6 ] && [ -f "$source" ] && [ ! -L "$source" ] || return 1
  [ "$source" != "$destination" ] && [ ! "$source" -ef "$destination" ] || return 1
  cp -p -- "$source" "$destination" && chmod u+w "$destination" || return 1
  for index in "${!field_names[@]}"; do
    name="${field_names[index]}" value="${values[index]}"
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || return 1
    escaped="${value//\\/\\\\}"; escaped="${escaped//\'/\\\'}"
    if ! OCTOJOOM_PHP_LITERAL="$escaped" awk -v name="$name" '
      $0 ~ ("^[[:space:]]*public[[:space:]]+[$]" name "[[:space:]]*=") {
        count++; if ($0 !~ /=[[:space:]]*["\047].*["\047];[[:space:]]*$/) bad=1
        match($0,/^[[:space:]]*/); indent=substr($0,1,RLENGTH)
        print indent "public $" name " = \047" ENVIRON["OCTOJOOM_PHP_LITERAL"] "\047;"; next
      }
      {print}
      END {if(count!=1 || bad) exit 1}
    ' "$destination" > "$destination.next"; then rm -f -- "$destination.next"; return 1; fi
    cat "$destination.next" > "$destination" && rm -f -- "$destination.next" || return 1
  done
  chmod 600 "$destination"
}

# A one-shot PHP process accesses only the selected website mount. Existing
# named volumes must exist: Docker must never silently create an empty source.
# shellcheck disable=SC2016
function joomlaDatabaseConfigurationFile() {
  local site="$1" operation="$2" file="$3" mount source
  readJoomlaSiteFacts "$site" || return 1
  source="$VDM_SITE_MOUNT_SOURCE"
  if [ "$VDM_SITE_MOUNT_TYPE" = volume ]; then
    source="${VDM_SITE_VOLUME_NAME:-$source}"
    docker volume inspect "$source" >/dev/null || return 1
  elif [ "$VDM_SITE_MOUNT_TYPE" = bind ]; then
    [ -d "$source" ] && ! migrationPathHasSymlink "$source" || return 1
    source=$(joomlaWebHostPath "$source") || return 1
  else return 1; fi
  [[ "$source" != *,* && "$VDM_SITE_MOUNT_TARGET" != *,* ]] || return 1
  mount="type=$VDM_SITE_MOUNT_TYPE,source=$source,target=$VDM_SITE_MOUNT_TARGET"
  if [ "$operation" = read ]; then
    MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' docker run --rm --network none --read-only --user 0 \
      --mount "$mount,readonly" --entrypoint php "$VDM_SITE_IMAGE" -r '
        $file=$argv[1]; if(is_link($file)||!is_file($file)){exit(1);} readfile($file);
      ' -- "$VDM_SITE_DOCROOT/configuration.php" > "$file" || return 1
    chmod 600 "$file"
  elif [ "$operation" = write ]; then
    [ -f "$file" ] && [ ! -L "$file" ] || return 1
    MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' docker run --rm -i --network none --read-only --user 0 \
      --mount "$mount" --entrypoint php "$VDM_SITE_IMAGE" -r '
        $file=$argv[1]; if(is_link($file)||!is_file($file)){exit(1);}
        $data=stream_get_contents(STDIN); if($data===false||$data===""){exit(1);}
        $mode=fileperms($file)&0777; if(!chmod($file,$mode|0200)){exit(1);}
        $ok=file_put_contents($file,$data,LOCK_EX)!==false; $ok=chmod($file,$mode)&&$ok; exit($ok?0:1);
      ' -- "$VDM_SITE_DOCROOT/configuration.php" < "$file"
  else return 1; fi
}

function joomlaDatabaseCopyConfiguration() {
  joomlaDatabaseConfigurationFile "$1" read "$2"
}

function joomlaDatabaseWriteConfiguration() {
  joomlaDatabaseConfigurationFile "$1" write "$2"
}

# Preserve unowned environment entries verbatim, supporting the generated list
# and ordinary block maps. Unknown YAML shapes need an explicit manual edit.
function joomlaDatabaseEnvironment() {
  local source="$1" service="$2" replacement="$3" kind="$4" engine="$5" env_key="$6" host="$7" driver="$8"
  local block style=list prefix port=3306
  block=$(joomlaServiceProperty "$source" "$service" environment) || return 1
  if [ -n "$block" ] && ! printf '%s\n' "$block" | head -1 | grep -qE '^    environment:[[:space:]]*$'; then return 1; fi
  if printf '%s\n' "$block" | grep -qE '^      [A-Za-z_][A-Za-z0-9_]*:'; then style=map; fi
  printf '%s\n' "$block" | awk -v kind="$kind" '
    NR==1 {next}
    {
      line=$0; sub(/^[[:space:]]*(-[[:space:]]*)?["\047]?/,"",line); sub(/[=:].*/,"",line)
      if(kind=="database" && line ~ /^(MYSQL|MARIADB)_(DATABASE|USER|PASSWORD|ROOT_PASSWORD)$/) next
      if(kind=="database" && line ~ /^POSTGRES_(DB|USER|PASSWORD)$/) next
      if(kind=="joomla" && line ~ /^JOOMLA_DB_(HOST|TYPE)$/) next
      if($0 ~ /^      [^ #]/ && $0 !~ /^      (- |[A-Za-z_][A-Za-z0-9_]*:)/) bad=1
      print
    }
    END {if(bad) exit 1}
  ' > "$replacement.entries" || return 1
  printf '    environment:\n' > "$replacement" || return 1
  cat "$replacement.entries" >> "$replacement" || return 1
  rm -f -- "$replacement.entries"
  local -a field_names=() values=()
  if [ "$kind" = database ]; then
    case "$engine" in
      mysql) prefix=MYSQL;; mariadb) prefix=MARIADB;; postgres) prefix=POSTGRES;; *) return 1;;
    esac
    if [ "$engine" = postgres ]; then field_names=(POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD)
    else field_names=("${prefix}_DATABASE" "${prefix}_USER" "${prefix}_PASSWORD" "${prefix}_ROOT_PASSWORD"); fi
    values=("\${VDM_${env_key}_DB}" "\${VDM_${env_key}_DB_USER}" "\${VDM_${env_key}_DB_PASS}" "\${VDM_${env_key}_DB_ROOT}")
  else
    [ "$engine" != postgres ] || port=5432
    field_names=(JOOMLA_DB_HOST JOOMLA_DB_TYPE); values=("$host:$port" "$driver")
  fi
  local index
  for index in "${!field_names[@]}"; do
    if [ "$style" = map ]; then printf '      %s: "%s"\n' "${field_names[index]}" "${values[index]}"
    else printf '      - %s=%s\n' "${field_names[index]}" "${values[index]}"; fi
  done >> "$replacement"
}

# Validate the driver shipped in the installed website too: an administrator
# may have upgraded Joomla independently of the selected image's bundled files.
# shellcheck disable=SC2016
function joomlaDatabaseInstalledCapability() {
  local site="$1" engine="$2" version="$3" source mount
  readJoomlaSiteFacts "$site" || return 1
  source="$VDM_SITE_MOUNT_SOURCE"
  if [ "$VDM_SITE_MOUNT_TYPE" = volume ]; then
    source="${VDM_SITE_VOLUME_NAME:-}"
    [ -n "$source" ] && docker volume inspect "$source" >/dev/null || return 1
  elif [ "$VDM_SITE_MOUNT_TYPE" = bind ]; then
    [ -d "$source" ] && ! migrationPathHasSymlink "$source" || return 1
    source=$(joomlaWebHostPath "$source") || return 1
  else return 1; fi
  [[ "$source" != *,* && "$VDM_SITE_MOUNT_TARGET" != *,* ]] || return 1
  mount="type=$VDM_SITE_MOUNT_TYPE,source=$source,target=$VDM_SITE_MOUNT_TARGET,readonly"
  MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' docker run --rm --network none --read-only --entrypoint php \
    --mount "$mount" "$VDM_SITE_IMAGE" -r '
      $root=$argv[1]; $engine=$argv[2]; $version=$argv[3];
      if(!is_file($root."/configuration.php")){exit(0);}
      if(!is_file($root."/libraries/vendor/autoload.php")){exit(1);}
      define("_JEXEC",1); require $root."/libraries/vendor/autoload.php";
      $class=$engine==="postgres"?"Joomla\\Database\\Pgsql\\PgsqlDriver":"Joomla\\Database\\Mysqli\\MysqliDriver";
      if(!class_exists($class)){exit(1);}
      $properties=(new ReflectionClass($class))->getDefaultProperties();
      $minimum=$properties[$engine==="mariadb"?"dbMinMariadb":"dbMinimum"]??null;
      exit($minimum && version_compare($version,$minimum,">=")?0:1);
    ' -- "$VDM_SITE_DOCROOT" "$engine" "$version" || {
      printf 'The installed Joomla driver cannot verify compatibility with this database version. Source unchanged.\n' >&2; return 1;
    }
}

# Stage a fresh named data volume without touching source storage or runtime.
# Existing custom service fields, other mounts and unrelated services survive.
# shellcheck disable=SC2016,SC2034
function joomlaDatabaseStageStorage() {
  local site="$1" engine="$2" image="$3" stage="$4" model service target old_target volumes current property driver
  local version env_key key directory compose env_file old_engine profiles
  joomlaDatabaseContext "$site" && readJoomlaSiteFacts "$site" || return 1
  service="$VDM_DB_SERVICE" old_engine="$VDM_DB_ENGINE" env_key="$VDM_SITE_ENV_KEY" key="$VDM_SITE_KEY"
  directory="$VDM_SITE_DIR" compose="$VDM_SITE_COMPOSE" env_file="$VDM_SITE_ENV"
  joomlaDatabaseImageFacts "$image" "$engine" || return 1
  target="$VDM_DATABASE_VOLUME_TARGET" version="$VDM_DATABASE_IMAGE_VERSION"
  joomlaDatabaseJoomlaCapability "$VDM_SITE_IMAGE" "$engine" "$version" >/dev/null || return 1
  driver="$VDM_DATABASE_JOOMLA_DRIVER"
  joomlaDatabaseInstalledCapability "$site" "$engine" "$version" || return 1
  (local VDM_DB_ENGINE="$engine"; joomlaSetupDatabaseCredentials "$VDM_DB_NAME" "$VDM_DB_USER" "$VDM_DB_PASSWORD") || return 1
  model=$(migrationRunCompose "$env_file" "$compose" --project-directory "$directory" config --format json) || return 1
  old_target=$(printf '%s' "$model" | joomlaSiteJSON -er --arg service "$service" '
    [.services[$service].volumes[]? | select(.target=="/var/lib/mysql" or .target=="/var/lib/postgresql/data" or .target=="/var/lib/postgresql")] |
    if length==1 then .[0].target else error("ambiguous database data mount") end') || return 1
  # Engine-specific commands/entrypoints/config files cannot be safely translated.
  if [ "$old_engine" != "$engine" ]; then
    for property in command entrypoint; do
      [ -z "$(joomlaServiceProperty "$compose" "$service" "$property")" ] || {
        printf 'Adapt the custom database %s before changing engine families.\n' "$property" >&2; return 1;
      }
    done
    if printf '%s' "$model" | joomlaSiteJSON -e --arg service "$service" '.services[$service].volumes[]? | select(.target|test("^/(etc|docker-entrypoint-initdb.d)(/|$)"))' >/dev/null; then
      printf 'Database configuration/initialization mounts require manual engine adaptation.\n' >&2; return 1
    fi
  fi
  mkdir -p "$stage" && chmod 700 "$stage" || return 1
  VDM_DATABASE_STAGE_STORAGE="octojoom_${key,,}_db_$(date +%s)_${RANDOM}"
  VDM_DATABASE_STAGE_COMPOSE="$stage/docker-compose.yml" VDM_DATABASE_STAGE_ENV="$stage/.env"
  VDM_DATABASE_STAGE_SERVICE="$service" VDM_DATABASE_STAGE_DRIVER="$driver" VDM_DATABASE_STAGE_MOUNT_TARGET="$target"
  siteWriteScopedEnv "$compose" "$env_file" "$env_key" "$VDM_DATABASE_STAGE_ENV" || return 1
  writeEnvVariable "$VDM_DATABASE_STAGE_ENV" "VDM_${env_key}_DB_ENGINE=$engine" true &&
    writeEnvVariable "$VDM_DATABASE_STAGE_ENV" "VDM_${env_key}_DB_IMAGE=$image" true || return 1
  cp -- "$compose" "$stage/current.yml" || return 1
  current="$stage/current.yml"
  siteReplaceServiceScalar "$current" "$stage/next.yml" "$service" image "\${VDM_${env_key}_DB_IMAGE}" && mv "$stage/next.yml" "$current" || return 1
  volumes=$(printf '%s' "$model" | joomlaSiteJSON -c --arg service "$service" --arg old "$old_target" \
    --arg target "$target" --arg volume "$VDM_DATABASE_STAGE_STORAGE" '
    .services[$service].volumes | map(if .target==$old then {type:"volume",source:$volume,target:$target} else . end)') || return 1
  printf '    volumes: %s\n' "$volumes" > "$stage/property"
  joomlaSetServiceProperty "$current" "$stage/next.yml" "$service" volumes "$stage/property" && mv "$stage/next.yml" "$current" || return 1
  joomlaDatabaseEnvironment "$current" "$service" "$stage/property" database "$engine" "$env_key" "$service" "$driver" &&
    joomlaSetServiceProperty "$current" "$stage/next.yml" "$service" environment "$stage/property" && mv "$stage/next.yml" "$current" || return 1
  joomlaDatabaseEnvironment "$current" "$VDM_SITE_SERVICE" "$stage/property" joomla "$engine" "$env_key" "$service" "$driver" &&
    joomlaSetServiceProperty "$current" "$stage/next.yml" "$VDM_SITE_SERVICE" environment "$stage/property" && mv "$stage/next.yml" "$current" || return 1
  case "$engine" in
    postgres) printf '%s\n' '    healthcheck:' '      test: ["CMD-SHELL", "pg_isready -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]';;
    mysql) printf '    healthcheck:\n      test: ["CMD", "mysqladmin", "ping", "--silent"]\n';;
    mariadb) printf '    healthcheck:\n      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]\n';;
  esac > "$stage/property"
  printf '      interval: 2s\n      timeout: 5s\n      retries: 60\n      start_period: 10s\n' >> "$stage/property"
  joomlaSetServiceProperty "$current" "$stage/next.yml" "$service" healthcheck "$stage/property" && mv "$stage/next.yml" "$current" || return 1
  if [ "$engine" = postgres ] && joomlaServiceBlock "$current" "phpmyadmin$key" >/dev/null 2>&1; then
    # Keep all customization for a future MySQL-family return, but never launch
    # a MySQL-only viewer against PostgreSQL by ordinary compose up.
    profiles=$(printf '%s' "$model" | joomlaSiteJSON -c --arg service "phpmyadmin$key" '((.services[$service].profiles // []) + ["octojoom-mysql-viewer-disabled"]) | unique') || return 1
    printf '    profiles: %s\n' "$profiles" > "$stage/property"
    joomlaSetServiceProperty "$current" "$stage/next.yml" "phpmyadmin$key" profiles "$stage/property" && mv "$stage/next.yml" "$current" || return 1
  elif joomlaServiceProperty "$current" "phpmyadmin$key" profiles 2>/dev/null | grep -q 'octojoom-mysql-viewer-disabled'; then
    profiles=$(printf '%s' "$model" | joomlaSiteJSON -c --arg service "phpmyadmin$key" '(.services[$service].profiles // []) | map(select(. != "octojoom-mysql-viewer-disabled"))') || return 1
    : > "$stage/property"
    [ "$profiles" = '[]' ] || printf '    profiles: %s\n' "$profiles" > "$stage/property"
    joomlaSetServiceProperty "$current" "$stage/next.yml" "phpmyadmin$key" profiles "$stage/property" && mv "$stage/next.yml" "$current" || return 1
  fi
  awk -v volume="$VDM_DATABASE_STAGE_STORAGE" '
    /^volumes:[[:space:]]*$/ {found++; print; print "  " volume ":\n    name: " volume; next}
    /^volumes:/ {bad=1}
    {print}
    END {if(!found) print "\nvolumes:\n  " volume ":\n    name: " volume; if(found>1 || bad) exit 1}
  ' "$current" > "$VDM_DATABASE_STAGE_COMPOSE" || return 1
  chmod 600 "$VDM_DATABASE_STAGE_COMPOSE" && siteValidateCompose "$VDM_DATABASE_STAGE_COMPOSE" "$VDM_DATABASE_STAGE_ENV" "$directory"
}

# Repointing a shared configuration.php would silently change another website.
# Compare the actual bind file or named-volume-relative configuration identity.
function joomlaDatabaseRequirePrivateConfiguration() {
  (
    local site="$1" kind source relative file='' candidate other result
    readJoomlaSiteFacts "$site" || exit 1
    kind="$VDM_SITE_MOUNT_TYPE" source="$VDM_SITE_MOUNT_SOURCE"
    relative="${VDM_SITE_DOCROOT#"$VDM_SITE_MOUNT_TARGET"}/configuration.php"
    if [ "$kind" = bind ]; then
      file="$VDM_SITE_HOST_PATH/configuration.php"
      [ -f "$file" ] && ! migrationPathHasSymlink "$file" || exit 1
    elif [ "$kind" = volume ]; then source="${VDM_SITE_VOLUME_NAME:-$source}"
    else exit 1; fi
    for candidate in "$VDM_REPO_PATH/joomla/available/"*/docker-compose.yml; do
      [ -f "$candidate" ] || continue
      other="${candidate%/docker-compose.yml}"; other="${other##*/}"
      [ "$other" != "$site" ] || continue
      result=0
      (
        readJoomlaSiteFacts "$other" || exit 1
        if [ "$kind" = bind ] && [ "$VDM_SITE_MOUNT_TYPE" = bind ]; then
          [ "$file" -ef "$VDM_SITE_HOST_PATH/configuration.php" ]
        elif [ "$kind" = volume ] && [ "$VDM_SITE_MOUNT_TYPE" = volume ]; then
          [ "$source" = "${VDM_SITE_VOLUME_NAME:-$VDM_SITE_MOUNT_SOURCE}" ] &&
            [ "$relative" = "${VDM_SITE_DOCROOT#"$VDM_SITE_MOUNT_TARGET"}/configuration.php" ]
        else exit 1; fi
      ) && result=1
      if [ "$result" -eq 1 ]; then
        printf 'This website shares configuration.php with %s. Separate its website storage before changing its database.\n' "$other" >&2
        exit 1
      fi
    done
  )
}

# This transaction has deliberate downtime. All writers are stopped before the
# final logical export; the old raw data directory/volume is never modified by
# the target engine. Recovery keeps the original config and running-service set.
function joomlaDatabaseChange() {
  (
    local site="$1" engine="$2" image="$3" mode="$4" source_engine directory compose effective_env stage='' lock=''
    local service app key driver port=3306 running='' published=false changed_config=false runtime_changed=false success=false
    local had_env=false status item retry verified=false source_image mirror='' publish_compose='' publish_env='' recovery_failed=false
    local -a active=() writers=() resumed=()
    case "$engine" in mariadb|mysql|postgres) ;; *) printf 'Choose mariadb, mysql or postgres.\n' >&2; exit 2;; esac
    case "$mode" in preserve|fresh) ;; *) printf 'Choose preserve, fresh or the independent clone action.\n' >&2; exit 2;; esac
    [[ "$image" =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ && "$image" == *[:@]* ]] || { printf 'A concrete database image reference is required.\n' >&2; exit 2; }
    joomlaDatabaseContext "$site" && readJoomlaSiteFacts "$site" || exit 1
    source_engine="$VDM_DB_ENGINE" source_image="${VDM_DB_IMAGE:-unknown}"
    joomlaDatabaseRequirePrivateConfiguration "$site" || exit 1
    if [ "$mode" = preserve ] && { [ "$engine" = postgres ] || [ "$source_engine" = postgres ]; } && [ "$engine" != "$source_engine" ]; then
      printf 'PostgreSQL/MySQL-family data conversion is unsupported. Choose an explicitly fresh database or a separate migration tool. Source unchanged.\n' >&2; exit 2
    fi
    directory="$VDM_SITE_DIR" compose="$VDM_SITE_COMPOSE" effective_env="$VDM_SITE_ENV" service="$VDM_DB_SERVICE" app="$VDM_SITE_SERVICE" key="$VDM_SITE_KEY"
    lock="$directory/.octojoom-change.lock"
    if [ -d "$VDM_REPO_PATH/joomla/enabled/$site" ] && [ ! -L "$VDM_REPO_PATH/joomla/enabled/$site" ]; then
      [ "$(getJoomlaSiteEnabledState "$site")" = enabled ] || { printf 'The enabled website copy differs from its available configuration. Reconcile it before changing databases.\n' >&2; exit 1; }
      mirror="$VDM_REPO_PATH/joomla/enabled/$site"
    fi
    mkdir "$lock" 2>/dev/null || { printf 'Another database operation is using %s.\n' "$site" >&2; exit 1; }
    trap 'rmdir "$lock" 2>/dev/null || true' EXIT
    stage=$(mktemp -d "$directory/.database-change.XXXXXX") && chmod 700 "$stage" || exit 1
    joomlaDatabaseStageStorage "$site" "$engine" "$image" "$stage/candidate" || exit 1
    driver="$VDM_DATABASE_STAGE_DRIVER"
    [ "$engine" != postgres ] || port=5432
    joomlaDatabaseCopyConfiguration "$site" "$stage/configuration.original.php" &&
      joomlaDatabasePatchConfiguration "$stage/configuration.original.php" "$stage/configuration.php" \
      "$service:$port" "$driver" "$VDM_DB_NAME" "$VDM_DB_USER" "$VDM_DB_PASSWORD" "$VDM_DB_PREFIX" || exit 1
    cp -p -- "$compose" "$stage/docker-compose.original.yml" || exit 1
    if [ -f "$directory/.env" ]; then had_env=true; cp -p -- "$directory/.env" "$stage/env.original" || exit 1; fi
    running=$(joomlaSiteCompose "$site" ps --status running --services) || exit 1
    while IFS= read -r item; do
      [ -n "$item" ] || continue
      active+=("$item")
      [ "$item" = "$service" ] || writers+=("$item")
    done <<< "$running"
    if [ "${VDM_PRE_BACKUP:-false}" = true ]; then
      joomlaBackupCreate "$site" "$stage/pre-change.tar.gz" full tar.gz false true >/dev/null || exit 1
    fi
    # From here every failure, including interruption, restores original files
    # and services. Candidate data is retained for diagnosis, never auto-pruned.
    trap '
      status=$?
      trap - EXIT INT TERM HUP
      if ! "$success" && "$runtime_changed"; then
        printf "Database change failed; restoring original storage and configuration.\n" >&2
        joomlaSiteCompose "$site" stop >&2 || recovery_failed=true
        if "$published"; then
          cp -p -- "$stage/docker-compose.original.yml" "$compose" || { status=1; recovery_failed=true; }
          [ -z "$mirror" ] || cp -p -- "$stage/docker-compose.original.yml" "$mirror/docker-compose.yml" || { status=1; recovery_failed=true; }
          if "$had_env"; then
            cp -p -- "$stage/env.original" "$directory/.env" || { status=1; recovery_failed=true; }
            [ -z "$mirror" ] || cp -p -- "$stage/env.original" "$mirror/.env" || { status=1; recovery_failed=true; }
          else
            rm -f -- "$directory/.env" || { status=1; recovery_failed=true; }
            [ -z "$mirror" ] || rm -f -- "$mirror/.env" || { status=1; recovery_failed=true; }
          fi
        fi
        if "$changed_config"; then joomlaDatabaseWriteConfiguration "$site" "$stage/configuration.original.php" || { status=1; recovery_failed=true; }; fi
        if [ "${#active[@]}" -gt 0 ]; then joomlaSiteCompose "$site" up -d --no-deps --force-recreate --wait --wait-timeout 120 "${active[@]}" >&2 || { status=1; recovery_failed=true; }; fi
        printf "Recovery files retained in %s; original data storage remains intact.\n" "$stage" >&2
        if "$recovery_failed"; then printf "Automatic recovery is incomplete. Inspect the retained configuration and service status before restarting.\n" >&2; fi
      fi
      [ -z "$publish_compose" ] || rm -f -- "$publish_compose"
      [ -z "$publish_env" ] || rm -f -- "$publish_env"
      rmdir "$lock" 2>/dev/null || true
      exit "$status"
    ' EXIT
    trap 'exit 130' INT TERM HUP
    runtime_changed=true
    if [ "${#writers[@]}" -gt 0 ]; then joomlaSiteCompose "$site" stop "${writers[@]}" >&2 || exit 1; fi
    joomlaSiteCompose "$site" up -d --no-deps --wait --wait-timeout 120 "$service" >&2 || exit 1
    if [ "$mode" = preserve ]; then
      joomlaDatabaseExport "$site" "$stage/database.sql" none false >/dev/null &&
        joomlaDatabaseTablesResolved > "$stage/source-tables" &&
        joomlaDatabaseRowCountsResolved > "$stage/source-counts" || exit 1
    fi
    joomlaSiteCompose "$site" stop "$service" >&2 || exit 1
    changed_config=true
    joomlaDatabaseWriteConfiguration "$site" "$stage/configuration.php" || exit 1
    # Hold the same configuration lock through export, import and verification.
    # Adjacent renames publish complete files; the trap retains rollback state.
    published=true
    publish_compose=$(mktemp "$directory/.database-compose.XXXXXX") &&
      publish_env=$(mktemp "$directory/.database-env.XXXXXX") || exit 1
    cp -p -- "$VDM_DATABASE_STAGE_COMPOSE" "$publish_compose" &&
      cp -p -- "$VDM_DATABASE_STAGE_ENV" "$publish_env" &&
      mv -f -- "$publish_env" "$directory/.env" &&
      mv -f -- "$publish_compose" "$compose" || exit 1
    if [ -n "$mirror" ]; then
      cp -p -- "$directory/.env" "$mirror/.env" && cp -p -- "$compose" "$mirror/docker-compose.yml" || exit 1
    fi
    joomlaSiteCompose "$site" up -d --no-deps --force-recreate --wait --wait-timeout 150 "$service" >&2 || exit 1
    joomlaDatabaseContext "$site" || exit 1
    for ((retry=0; retry<60; retry++)); do
      if printf 'SELECT 1;\n' | joomlaDatabaseClient sql >/dev/null 2>&1; then verified=true; break; fi
      sleep 2
    done
    "$verified" || { printf 'Target database did not accept the site credentials.\n' >&2; exit 1; }
    if [ "$mode" = preserve ]; then
      joomlaDatabaseClient import "$stage/database.sql" || { printf 'The source SQL is not compatible with this target; rolling back.\n' >&2; exit 1; }
      if ! joomlaDatabaseTablesResolved > "$stage/target-tables" || ! cmp -s "$stage/source-tables" "$stage/target-tables" ||
        ! joomlaDatabaseRowCountsResolved > "$stage/target-counts" || ! cmp -s "$stage/source-counts" "$stage/target-counts"; then
        printf 'The target table inventory or row counts differ from the source; rolling back.\n' >&2; exit 1
      fi
    fi
    joomlaDatabaseVerifyConnection "$site" || exit 1
    if [ "$mode" = preserve ]; then
      for item in "${active[@]}"; do
        [ "$engine" != postgres ] || [ "$item" != "phpmyadmin$key" ] || continue
        resumed+=("$item")
      done
      if [ "${#resumed[@]}" -gt 0 ]; then joomlaSiteCompose "$site" up -d --no-deps --wait --wait-timeout 120 "${resumed[@]}" >&2 || exit 1; fi
      printf '%s\n' "$running" | grep -qxF "$app" || joomlaSiteCompose "$site" stop "$app" >&2 || exit 1
      printf '%s\n' "$running" | grep -qxF "$service" || joomlaSiteCompose "$site" stop "$service" >&2 || exit 1
    else
      # An empty database is not an installed Joomla website. Do not expose a
      # broken application or tell the user that existing content was migrated.
      joomlaSiteCompose "$site" stop "$app" >&2 || exit 1
      printf '%s\n' "$running" | grep -qxF "$service" || joomlaSiteCompose "$site" stop "$service" >&2 || exit 1
    fi
    success=true
    printf '%s\t%s\t%s\n' "$site" "$mode" "$image"
    printf 'Original %s database storage and recovery files retained: %s\n' "$source_image" "$stage" >&2
    [ "$mode" != fresh ] || printf 'The target database is empty. Website services remain stopped until installation or restore.\n' >&2
  )
}

function showJoomlaDatabaseChange() {
  local site="$1" mode engine image pre_backup=false
  joomlaDatabaseContext "$site" || return 1
  mode=$(whiptail --title "Database | $site" --backtitle "$BACK_TITLE" --menu \
    "Current engine: $VDM_DB_ENGINE. Current image: ${VDM_DB_IMAGE:-unknown}. Choose the intended data outcome." 0 112 0 \
    keep 'Keep the current database' preserve 'Replace database engine/version and preserve content' \
    clone 'Create an independent clone, then change its database' fresh 'Prepare an empty database; website stops until installation/restore' 3>&1 1>&2 2>&3) || return 0
  [ "$mode" != keep ] || return 0
  engine=$(whiptail --title 'Database engine' --backtitle "$BACK_TITLE" --menu 'The selected Joomla image must support the chosen driver and server version.' 0 112 0 \
    mariadb MariaDB mysql MySQL postgres PostgreSQL 3>&1 1>&2 2>&3) || return 0
  image=$(whiptail --title 'Published database image' --backtitle "$BACK_TITLE" --inputbox 'Enter a published image with an explicit tag. The actual server version will be verified.' 12 112 "${engine}:" 3>&1 1>&2 2>&3) || return 0
  getInputYesNo 'Create a complete backup before changing the database?' 'Database backup' 10 112 defaultyes && pre_backup=true
  getInputYesNo 'Continue? Writes will pause during the change. Original storage will be retained for recovery.' 'Change database' 11 112 defaultno || return 0
  local VDM_CONTAINER="$site" VDM_DATA_MODE="$mode" VDM_DB_IMAGE="$image" VDM_DB_ENGINE="$engine" VDM_PRE_BACKUP="$pre_backup" VDM_CONFIRM=true
  joomlaDatabaseChangeAction
}

function joomlaDatabaseChangeAction() {
  (
    local site="${VDM_CONTAINER:-}" engine="${VDM_DB_ENGINE:-}" image="${VDM_DB_IMAGE:-}" mode="${VDM_DATA_MODE:-}" work destination key
    [ -n "$site" ] || { printf 'Select a website with --container.\n' >&2; exit 2; }
    if [ -z "$mode" ] && [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ]; then showJoomlaDatabaseChange "$site"; exit $?; fi
    [[ -n "$engine" && -n "$image" && -n "$mode" && "${VDM_CONFIRM:-false}" = true ]] || {
      printf 'Database changes require --engine, --database-image, --data-mode and --confirm true.\n' >&2; exit 2;
    }
    case "$mode" in
      preserve|fresh) joomlaDatabaseChange "$site" "$engine" "$image" "$mode";;
      clone)
        key="${VDM_KEY:-}" destination="${VDM_SUBDOMAIN:-}.${VDM_DOMAIN:-}"
        if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] && { [ -z "$key" ] || ! isValidDomain "$destination"; }; then
          key=$(whiptail --title 'Independent clone key' --inputbox 'Unique destination key (letters only)' 10 112 3>&1 1>&2 2>&3) || exit 0
          destination=$(whiptail --title 'Independent clone hostname' --inputbox 'Destination website hostname' 10 112 3>&1 1>&2 2>&3) || exit 0
        fi
        if ! [[ "$key" =~ ^[A-Za-z]+$ ]] || ! isValidDomain "$destination" || [ "$destination" = "$site" ]; then
          printf 'Clone requires a distinct destination --key, --sub-domain and --domain.\n' >&2; exit 2
        fi
        [ ! -e "$VDM_REPO_PATH/joomla/available/$destination" ] || { printf 'Clone destination already exists.\n' >&2; exit 2; }
        joomlaDatabaseContext "$site" && readJoomlaSiteFacts "$site" || exit 1
        if { [ "$engine" = postgres ] || [ "$VDM_DB_ENGINE" = postgres ]; } && [ "$engine" != "$VDM_DB_ENGINE" ]; then
          printf 'Independent preserved-data clones cannot convert PostgreSQL/MySQL-family SQL.\n' >&2; exit 2
        fi
        joomlaDatabaseImageFacts "$image" "$engine" && joomlaDatabaseJoomlaCapability "$VDM_SITE_IMAGE" "$engine" "$VDM_DATABASE_IMAGE_VERSION" >/dev/null || exit 1
        work=$(mktemp -d "$VDM_SITE_DIR/.database-clone.XXXXXX") && chmod 700 "$work" || exit 1
        joomlaBackupCreate "$site" "$work/source.tar.gz" full tar.gz false >/dev/null &&
          joomlaBackupRestoreNew "$work/source.tar.gz" "$destination" "$key" &&
          joomlaDatabaseChange "$destination" "$engine" "$image" preserve || exit 1
        printf 'Independent clone created at %s. Source website retained.\n' "$destination" >&2;;
      *) printf 'Data mode must be preserve, fresh or clone.\n' >&2; exit 2;;
    esac
  )
}

# Choices remain ordinary scoped ENV settings. Read-only operations never create
# files; only a successful user export saves its selected location and options.
function joomlaDatabasePreference() {
  local site="$1" suffix="$2" fallback="$3" value=''
  if [ -n "$site" ]; then
    resolveJoomlaSite "$site" || return 1
    local identity=''
    identity=$(sed -nE 's/.*[$][{]VDM_([A-Za-z]+)_DB[}].*/\1/p' "$VDM_SITE_COMPOSE" | head -n 1)
    [ -z "$identity" ] || migrationReadEnvValue "$VDM_SITE_ENV" "VDM_${identity}_DATABASE_${suffix}" value || value=''
  fi
  if [ -z "$value" ]; then migrationReadEnvValue "$VDM_SRC_PATH/.env" "VDM_DATABASE_${suffix}" value || value=''; fi
  printf '%s\n' "${value:-$fallback}"
}

function joomlaDatabaseStorePreferences() {
  (
    local site="$1" temporary='' suffix value entry
    shift
    local -a preferences=("$@")
    readJoomlaSiteFacts "$site" || exit 1
    # Handwritten sites without a recognizable scope still support every native
    # operation; their preferences can use the distinct host defaults.
    createPrivateDirectory -p "$VDM_SRC_PATH" || exit 1
    [ -f "$VDM_SRC_PATH/.env" ] || (umask 077; : > "$VDM_SRC_PATH/.env") || exit 1
    for entry in "${preferences[@]}"; do
      suffix="${entry%%=*}" value="${entry#*=}"
      case "$suffix" in EXPORT_DIR|IMPORT_DIR|COMPRESSION|TIMESTAMP) ;; *) exit 2;; esac
      writeEnvVariable "$VDM_SRC_PATH/.env" "VDM_DATABASE_${suffix}=$value" false || exit 1
    done
    [ -n "$VDM_SITE_ENV_KEY" ] || exit 0
    temporary=$(mktemp "$VDM_SITE_DIR/.database-env.XXXXXXXX") || exit 1
    trap '[ -z "$temporary" ] || rm -f -- "$temporary"' EXIT
    siteWriteScopedEnv "$VDM_SITE_COMPOSE" "$VDM_SITE_ENV" "$VDM_SITE_ENV_KEY" "$temporary" || exit 1
    for entry in "${preferences[@]}"; do
      suffix="${entry%%=*}" value="${entry#*=}"
      writeEnvVariable "$temporary" "VDM_${VDM_SITE_ENV_KEY}_DATABASE_${suffix}=$value" true || exit 1
    done
    mv -f -- "$temporary" "$VDM_SITE_DIR/.env" || exit 1
    temporary=''
  )
}

function joomlaDatabaseSavePreferences() {
  joomlaDatabaseStorePreferences "$1" "EXPORT_DIR=$2" "COMPRESSION=$3" "TIMESTAMP=$4"
}

function joomlaDatabaseSaveImportPreference() {
  joomlaDatabaseStorePreferences "$1" "IMPORT_DIR=$2"
}

function joomlaDatabaseTimestampPath() {
  local path="$1" suffix='' stem="$1"
  case "$path" in *.sql.gz) suffix=.sql.gz; stem="${path%.sql.gz}";; *.sql) suffix=.sql; stem="${path%.sql}";; *.dump) suffix=.dump; stem="${path%.dump}";; esac
  printf '%s-%s%s\n' "$stem" "$(date -u +%Y%m%dT%H%M%SZ)" "$suffix"
}

function joomlaDatabaseDefaultFilename() {
  case "$2" in gzip) printf '%s.sql.gz\n' "$1";; custom) printf '%s.dump\n' "$1";; *) printf '%s.sql\n' "$1";; esac
}

# Numeric dialog tags keep literal table names (including commas, quotes, spaces
# and wildcard characters) out of whiptail's selection serialization.
function joomlaDatabaseSelectTables() {
  local site="$1" tables table answer index=0
  local -a choices=() database_tables=()
  tables=$(joomlaDatabaseTables "$site") || return 1
  while IFS= read -r table; do
    [ -n "$table" ] || continue
    [[ "$table" != *$'\t'* && "$table" != *$'\r'* ]] || { printf 'Table names containing control characters require the native SQL console.\n' >&2; return 2; }
    database_tables+=("$table"); choices+=("$index" "$table" OFF); index=$((index + 1))
  done <<< "$tables"
  VDM_TABLES=()
  [ "${#choices[@]}" -gt 0 ] || return 3
  answer=$(whiptail --title 'Select database tables' --backtitle "$BACK_TITLE" --separate-output --checklist \
    'Select actual tables from this website. An empty selection cancels the export.' 0 112 0 "${choices[@]}" 3>&1 1>&2 2>&3) || return 3
  while IFS= read -r index; do
    [ -n "$index" ] || continue
    [[ "$index" =~ ^[0-9]+$ && "$index" -lt "${#database_tables[@]}" ]] || return 2
    VDM_TABLES+=("${database_tables[index]}")
  done <<< "$answer"
  [ "${#VDM_TABLES[@]}" -gt 0 ] || return 3
}

function joomlaDatabaseChooseFile() {
  local directory="$1" file answer index=0
  local -a choices=(manual 'Enter a file path') database_files=()
  for file in "$directory/"*; do
    if [ ! -f "$file" ] || [ -L "$file" ]; then continue; fi
    case "$file" in *.sql|*.sql.gz|*.gz|*.dump) database_files+=("$file"); choices+=("$index" "${file##*/}"); index=$((index + 1));; esac
  done
  answer=$(whiptail --title 'Choose SQL input' --backtitle "$BACK_TITLE" --menu \
    "Choose a file from $directory, or enter its literal path." 0 112 0 "${choices[@]}" 3>&1 1>&2 2>&3) || return 3
  if [ "$answer" = manual ]; then getInput 'SQL or gzip SQL file path' "$directory/" 'Database input'
  elif [[ "$answer" =~ ^[0-9]+$ && "$answer" -lt "${#database_files[@]}" ]]; then printf '%s\n' "${database_files[answer]}"
  else return 2; fi
}

function joomlaDatabaseExportQuestions() {
  local site="$1" batch="${2:-false}" defaultno=defaultno
  if [ "$batch" != true ]; then
    if getInputYesNo 'Export the complete Joomla database?' 'Database export' 9 112; then VDM_TABLES=()
    else joomlaDatabaseSelectTables "$site" || return $?; fi
  fi
  VDM_DESTINATION=$(joomlaDatabasePreference "$site" EXPORT_DIR "$VDM_HOME_PATH/Backups") || return 1
  VDM_COMPRESSION=$(joomlaDatabasePreference "$site" COMPRESSION gzip) || return 1
  VDM_TIMESTAMP=$(joomlaDatabasePreference "$site" TIMESTAMP true) || return 1
  VDM_DESTINATION=$(getInput 'Export directory' "$VDM_DESTINATION" 'Database export') || return 3
  [ "$VDM_TIMESTAMP" != true ] || defaultno=''
  if getInputYesNo 'Include a timestamp in export filenames?' 'Database export' 9 112 "$defaultno"; then VDM_TIMESTAMP=true; else VDM_TIMESTAMP=false; fi
  if getInputYesNo "Change the saved compression choice ($VDM_COMPRESSION)?" 'Database export' 9 112 defaultno; then
    VDM_COMPRESSION=$(whiptail --title 'Export compression' --backtitle "$BACK_TITLE" --menu 'Select the native output format.' 0 112 0 \
      none 'Plain SQL' gzip 'Gzip-compressed SQL' custom 'PostgreSQL native archive' 3>&1 1>&2 2>&3) || return 3
  fi
  VDM_FILE='' VDM_OVERWRITE=false VDM_DATABASE_PATH_READY=false
  if [ "$batch" != true ]; then
    VDM_FILE=$(getInput 'Output filename (full path)' "$VDM_DESTINATION/$(joomlaDatabaseDefaultFilename "$site" "$VDM_COMPRESSION")" 'Database export') || return 3
    if [ "$VDM_TIMESTAMP" = true ]; then VDM_FILE=$(joomlaDatabaseTimestampPath "$VDM_FILE"); fi
    VDM_DATABASE_PATH_READY=true
    if [ -e "$VDM_FILE" ]; then
      getInputYesNo "Overwrite the existing file?\n$VDM_FILE" 'Database export' 10 112 defaultno || return 3
      VDM_OVERWRITE=true
    fi
  else
    if getInputYesNo 'Allow overwriting any existing batch output filenames?' 'Database export' 9 112 defaultno; then VDM_OVERWRITE=true; fi
  fi
  VDM_DATABASE_OPTIONS_READY=true
}

function joomlaDatabaseImportQuestions() {
  local site="$1" directory action
  directory=$(joomlaDatabasePreference "$site" IMPORT_DIR "$VDM_HOME_PATH/Backups") || return 1
  VDM_FILE=$(joomlaDatabaseChooseFile "$directory") || return $?
  VDM_IMPORT_MODE=$(whiptail --title 'Import into selected website' --backtitle "$BACK_TITLE" --menu \
    "Website: $site\nFile: $VDM_FILE\nChoose the intended operation. SQL is executed as supplied; unrelated tables are never automatically cleared." 0 112 0 \
    fresh 'Import into an empty prepared database' replace 'Replace the objects described by this native dump' merge 'Apply SQL as supplied without automatic clearing' 3>&1 1>&2 2>&3) || return 3
  if [ "$VDM_IMPORT_MODE" != fresh ] && getInputYesNo 'Create a website backup before this potentially destructive import?' 'Database import' 10 112; then
    if isFunc joomla__TRuST__backup; then
      (local VDM_CONTAINER="$site" VDM_ACTION=create VDM_FILE='' VDM_INPUT_FILE=''; joomla__TRuST__backup) || return 1
    else printf 'The backup action is unavailable. Create a backup before retrying this import.\n' >&2; return 1; fi
  fi
  action='Delete the import file after successful import?'
  if getInputYesNo "$action" 'Database import' 9 112 defaultno; then VDM_DELETE_SOURCE=true; else VDM_DELETE_SOURCE=false; fi
  VDM_TABLES=()
}

function joomlaDatabaseBatchSites() {
  local answer site index=0
  local -a choices=() database_sites=()
  answer=$(whiptail --title 'Batch database export' --backtitle "$BACK_TITLE" --menu 'Choose the export scope.' 0 112 0 \
    selected 'Explicitly select websites' all 'All discovered Joomla websites' 3>&1 1>&2 2>&3) || return 3
  VDM_SITES=() VDM_ALL=false
  if [ "$answer" = all ]; then VDM_ALL=true; return 0; fi
  while IFS= read -r site; do
    [ -n "$site" ] || continue
    database_sites+=("$site"); choices+=("$index" "$site" OFF); index=$((index + 1))
  done < <(listJoomlaSites)
  answer=$(whiptail --title 'Export selected websites' --backtitle "$BACK_TITLE" --separate-output --checklist \
    'Choose the websites to export.' 0 112 0 "${choices[@]}" 3>&1 1>&2 2>&3) || return 3
  while IFS= read -r index; do
    [ -n "$index" ] || continue
    [[ "$index" =~ ^[0-9]+$ && "$index" -lt "${#database_sites[@]}" ]] || return 2
    VDM_SITES+=("${database_sites[index]}")
  done <<< "$answer"
  [ "${#VDM_SITES[@]}" -gt 0 ] || return 3
}

# Menu and CLI share the same operation handler; only question gathering differs.
# shellcheck disable=SC2034
function showJoomlaDatabaseTools() {
  local site="$1" action status
  local VDM_DB_SITE VDM_DB_COMPOSE VDM_DB_ENV VDM_DB_PROJECT_DIR VDM_DB_ENGINE VDM_DB_IMAGE VDM_DB_DRIVER
  local VDM_DB_NAME VDM_DB_USER VDM_DB_PASSWORD VDM_DB_HOST VDM_DB_PORT VDM_DB_PREFIX VDM_DB_SERVICE
  local VDM_DB_INSTALLED VDM_DB_CLIENT VDM_DB_DUMP VDM_DB_RESTORE
  local VDM_CONTAINER="$site" VDM_ACTION VDM_FILE VDM_DESTINATION VDM_COMPRESSION VDM_TIMESTAMP
  local VDM_OVERWRITE=false VDM_DELETE_SOURCE=false VDM_IMPORT_MODE VDM_ALL=false
  local VDM_DATABASE_OPTIONS_READY=false VDM_DATABASE_PATH_READY=false
  local -a VDM_TABLES=() VDM_SITES=()
  while :; do
    joomlaDatabaseContext "$site" || return 1
    action=$(whiptail --title 'Database tools' --backtitle "$BACK_TITLE" --menu \
      "Website: $site\nDatabase: $VDM_DB_NAME\nEngine: $VDM_DB_ENGINE\nService: $VDM_DB_SERVICE" 0 112 0 \
      export 'Export database or selected tables' import 'Import a SQL file' tables 'Select database tables' \
      console 'Open SQL console' execute 'Run SQL file' batch 'Export selected or all websites' change 'Change database engine or image' back 'Back to website information' 3>&1 1>&2 2>&3) || return 0
    VDM_ALL=false VDM_SITES=() VDM_DATABASE_OPTIONS_READY=false VDM_DATABASE_PATH_READY=false VDM_FILE=''
    status=0
    case "$action" in
      back) return 0;;
      tables) joomlaDatabaseSelectTables "$site" || status=$?; [ "$status" -ne 0 ] || showNotice "Selected ${#VDM_TABLES[@]} tables." 8; continue;;
      export) joomlaDatabaseExportQuestions "$site" || status=$?; VDM_ACTION='export';;
      batch) joomlaDatabaseBatchSites && joomlaDatabaseExportQuestions "$site" true || status=$?; VDM_ACTION='export';;
      import) joomlaDatabaseImportQuestions "$site" || status=$?; VDM_ACTION=import;;
      execute) VDM_FILE=$(joomlaDatabaseChooseFile "$(joomlaDatabasePreference "$site" EXPORT_DIR "$VDM_HOME_PATH/Backups")") || status=$?; VDM_ACTION=execute;;
      console) VDM_ACTION=console;;
      change) showJoomlaDatabaseChange "$site"; continue;;
      *) return 17;;
    esac
    [ "$status" -eq 0 ] || continue
    if joomla__TRuST__database; then
      [ "$VDM_ACTION" = console ] || showNotice 'Database operation completed.' 8
    else showError 'The database operation failed. Review the diagnostic above; input files were retained on failure.'; fi
  done
}

# shellcheck disable=SC2034
function joomla__TRuST__database() {
  (
    local site="${VDM_CONTAINER:-}" action="${VDM_ACTION:-}" file="${VDM_FILE:-${VDM_INPUT_FILE:-}}"
    local destination="${VDM_DESTINATION:-}" compression="${VDM_COMPRESSION:-}" timestamp="${VDM_TIMESTAMP:-}"
    local status=0 one_status rows='' entry tables
    local -a database_sites=("${VDM_SITES[@]}")
    command -v jq >/dev/null || { printf 'Database tools require jq.\n' >&2; exit 1; }
    if [ -z "$action" ]; then
      [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] || { printf 'Select a database action.\n' >&2; exit 2; }
      showJoomlaDatabaseTools "$site"; exit $?
    fi
    if [ "$action" != export ]; then
      [ -n "$site" ] || { printf 'Select one website.\n' >&2; exit 2; }
      case "$action" in
        tables)
          tables=$(joomlaDatabaseTables "$site") || exit 1
          if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then printf '%s' "$tables" | jq -Rs 'split("\n") | map(select(length>0))'; else printf '%s\n' "$tables"; fi;;
        console) joomlaDatabaseConsole "$site" || exit $?;;
        change) joomlaDatabaseChangeAction || exit $?;;
        execute) joomlaDatabaseExecute "$site" "$file" || exit $?;;
        import)
          if [ -z "${VDM_IMPORT_MODE:-}" ]; then printf 'Specify --import-mode fresh, replace or merge before any import.\n' >&2; exit 2; fi
          if [ "${VDM_PRE_BACKUP:-false}" = true ]; then
            (local VDM_ACTION=create VDM_FILE='' VDM_INPUT_FILE=''; joomla__TRuST__backup) >&2 || exit 1
          fi
          joomlaDatabaseImport "$site" "$file" "$VDM_IMPORT_MODE" "${VDM_DELETE_SOURCE:-false}" || exit $?
          joomlaDatabaseSaveImportPreference "$site" "$(dirname -- "$file")" || printf 'Import succeeded, but saving its directory preference failed.\n' >&2
          if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then jq -n --arg site "$site" '{site:$site,imported:true}';
          elif [ "${VDM_QUIET:-false}" != true ]; then printf 'Imported database for %s.\n' "$site"; fi;;
        *) printf 'Unknown database action.\n' >&2; exit 2;;
      esac
      exit 0
    fi
    if [ "${VDM_ALL:-false}" = true ]; then
      database_sites=()
      while IFS= read -r entry; do [ -z "$entry" ] || database_sites+=("$entry"); done < <(listJoomlaSites)
    elif [ "${#database_sites[@]}" -eq 0 ] && [ -n "$site" ]; then database_sites=("$site"); fi
    [ "${#database_sites[@]}" -gt 0 ] || { printf 'Select at least one website to export.\n' >&2; exit 2; }
    if [ "${VDM_DATABASE_OPTIONS_READY:-false}" != true ]; then
      cliHasValue VDM_DESTINATION || destination=$(joomlaDatabasePreference "$site" EXPORT_DIR "$VDM_HOME_PATH/Backups") || exit 1
      cliHasValue VDM_COMPRESSION || compression=$(joomlaDatabasePreference "$site" COMPRESSION gzip) || exit 1
      cliHasValue VDM_TIMESTAMP || timestamp=$(joomlaDatabasePreference "$site" TIMESTAMP true) || exit 1
      # An explicit output path remains literal unless timestamping was itself
      # requested. Its standard extension also supplies an unambiguous format.
      if [ -n "$file" ]; then
        cliHasValue VDM_TIMESTAMP || timestamp=false
        if ! cliHasValue VDM_COMPRESSION; then
          case "$file" in *.gz) compression=gzip;; *.dump) compression=custom;; *.sql) compression=none;; esac
        fi
      fi
    fi
    case "$compression" in none|gzip|custom) ;; *) printf 'Select compression none, gzip or custom.\n' >&2; exit 2;; esac
    [[ "$timestamp" = true || "$timestamp" = false ]] || exit 2
    if cliHasValue VDM_TABLES && [ "${#VDM_TABLES[@]}" -eq 0 ]; then printf 'No tables were selected; no export was created.\n' >&2; exit 2; fi
    [ "${#database_sites[@]}" -eq 1 ] || [ -z "$file" ] || { printf 'Batch export uses --destination, not one --file.\n' >&2; exit 2; }
    if [ -n "$file" ]; then destination=$(dirname -- "$file"); fi
    createPrivateDirectory -p -- "$destination" || exit 1
    for site in "${database_sites[@]}"; do
      one_status=0
      entry="$file"
      [ -n "$entry" ] || entry="$destination/$(joomlaDatabaseDefaultFilename "$site" "$compression")"
      if [ "$timestamp" = true ] && [ "${VDM_DATABASE_PATH_READY:-false}" != true ]; then entry=$(joomlaDatabaseTimestampPath "$entry"); fi
      if joomlaDatabaseExport "$site" "$entry" "$compression" "${VDM_OVERWRITE:-false}" "${VDM_TABLES[@]}"; then
        joomlaDatabaseSavePreferences "$site" "$destination" "$compression" "$timestamp" || { printf 'Export succeeded, but saving its preferences failed.\n' >&2; one_status=1; }
      else one_status=$?; fi
      [ "$one_status" -eq 0 ] || status=1
      if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then
        rows+=$(jq -cn --arg site "$site" --arg file "$entry" --argjson status "$one_status" '{site:$site,file:$file,success:($status==0),exit_status:$status}')$'\n'
      elif [ "${VDM_QUIET:-false}" != true ]; then
        if [ "$one_status" -eq 0 ]; then printf '%s: exported %s\n' "$site" "$entry"; else printf '%s: export failed\n' "$site"; fi
      fi
    done
    if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then printf '%s' "$rows" | jq -s '{sites:.}'; fi
    exit "$status"
  )
}

######################################## EXISTING SITE CONFIGURATION

# Copy the complete effective configuration needed by one site. Shared files are
# never copied wholesale: unrelated sites and host-only secrets stay behind.
function siteWriteScopedEnv() {
  local compose_file="$1" effective_env="$2" env_key="$3" destination="$4"
  local references name value line suffixes temporary
  [[ "$env_key" =~ ^[A-Za-z]+$ ]] || return 1
  [ -f "$effective_env" ] && [ ! -L "$effective_env" ] || return 1
  [ "$effective_env" != "$destination" ] && [ ! "$effective_env" -ef "$destination" ] || return 1
  (loadEnvFile "$effective_env") || return 1
  references=$(migrationComposeReferences "$compose_file") || return 1
  suffixes=$(getJoomlaEnvSuffixes)
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?(VDM_[A-Za-z0-9_]+)[[:space:]]*= ]]; then
      name="${BASH_REMATCH[2]}"
      if [[ "$name" =~ ^VDM_${env_key}_(${suffixes})$ ]] && ! printf '%s\n' "$references" | grep -qxF "$name"; then
        references+=$'\n'"$name"
      fi
    fi
  done < "$effective_env"
  temporary=$(mktemp "${destination}.tmp.XXXXXX") || return 1
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if ! migrationReadEnvValue "$effective_env" "$name" value || ! formatEnvAssignment "$name=\"$value\"" >> "$temporary"; then
      rm -f -- "$temporary"
      return 1
    fi
  done <<< "$references"
  if ! chmod 600 "$temporary" || ! mv -f -- "$temporary" "$destination"; then
    rm -f -- "$temporary"
    return 1
  fi
}

# These two helpers intentionally support the original, block-style service
# mapping only. They are not a general YAML parser. A service/property must
# occur exactly once at the original indentation; custom structures are refused.
function siteReadServiceScalar() {
  local source="$1" service="$2" property="$3" scalar
  [[ "$service" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ && "$property" =~ ^[a-z_]+$ ]] || return 1
  scalar=$(awk -v service="$service" -v property="$property" '
    /^services:[[:space:]]*(#.*)?$/ { services=1; next }
    services && /^[^[:space:]#]/ { services=0; selected=0 }
    services && /^  [^[:space:]#]/ {
      selected=(index($0, "  " service ":") == 1 && substr($0, length(service)+4) ~ /^[[:space:]]*(#.*)?$/); if (selected) blocks++
    }
    selected && $0 ~ ("^    " property ":[[:space:]]*") {
      count++; line=$0; sub("^    " property ":[[:space:]]*", "", line); value=line
    }
    END { if (blocks != 1 || count != 1) exit 1; print value }
  ' "$source") || return 1
  decodeEnvValue "$scalar" scalar || return 1
  [ -n "$scalar" ] && [[ "$scalar" != *$'\n'* && "$scalar" != *$'\r'* ]] || return 1
  printf '%s\n' "$scalar"
}

function siteReplaceServiceScalar() {
  local source="$1" destination="$2" service="$3" property="$4" value="$5" escaped
  [ "$source" != "$destination" ] && [ ! "$source" -ef "$destination" ] || return 1
  siteReadServiceScalar "$source" "$service" "$property" >/dev/null || return 1
  [[ -n "$value" && "$value" != *$'\n'* && "$value" != *$'\r'* ]] || return 1
  # Environment variables remain Compose placeholders; the YAML value is quoted.
  escaped="${value//\\/\\\\}"
  escaped="${escaped//\"/\\\"}"
  OCTOJOOM_SCALAR_VALUE="$escaped" awk -v service="$service" -v property="$property" '
    /^services:[[:space:]]*(#.*)?$/ { services=1 }
    services && /^[^[:space:]#]/ && $0 !~ /^services:/ { services=0; selected=0 }
    services && /^  [^[:space:]#]/ { selected=(index($0, "  " service ":") == 1 && substr($0, length(service)+4) ~ /^[[:space:]]*(#.*)?$/) }
    selected && $0 ~ ("^    " property ":[[:space:]]*") { $0="    " property ": \"" ENVIRON["OCTOJOOM_SCALAR_VALUE"] "\"" }
    { print }
  ' "$source" > "$destination"
}

# Keep the original Compose project directory while validating adjacent staged
# files. This preserves relative mounts and the normal inferred project name.
function siteValidateCompose() {
  local compose_file="$1" env_file="$2" project_directory="$3"
  [ -f "$compose_file" ] && [ -f "$env_file" ] && [ -d "$project_directory" ] || return 1
  migrationRunCompose "$env_file" "$compose_file" --project-directory "$project_directory" config --quiet
}

# Publish Compose, ENV and optional companion files as a recoverable sequence.
# Companion pairs come from caller-local OCTOJOOM_SITE_FILE_TARGETS/_SOURCES
# arrays. Optional START/STOP_SERVICES arrays cover a changed HTTP service role.
# Only already-running affected services are recreated; disabled/stopped sites
# stay stopped. The caller verifies intended semantic changes before this call.
function sitePublishConfiguration() {
  (
    local site="$1" staged_compose="$2" staged_env="$3"
    shift 3
    local directory="${VDM_REPO_PATH}/joomla/available/$site" compose_file effective_env
    local recovery='' lock='' running='' service target source index changed=0 failed=false runtime_changed=false
    local callback="${OCTOJOOM_SITE_VALIDATE_FUNCTION:-}" rollback_failed=false
    local -a targets=("${OCTOJOOM_SITE_FILE_TARGETS[@]}") sources=("${OCTOJOOM_SITE_FILE_SOURCES[@]}")
    local -a active=() stopped=() start_services=("${OCTOJOOM_SITE_START_SERVICES[@]}")
    local -a stop_services=("${OCTOJOOM_SITE_STOP_SERVICES[@]}") existed=()
    isValidDomain "$site" && [ -d "$directory" ] && ! migrationPathHasSymlink "$directory" || exit 1
    compose_file="$directory/docker-compose.yml"
    effective_env=$(getContainerEnvFile joomla "$site" available)
    [ "${#targets[@]}" -eq "${#sources[@]}" ] || exit 1
    targets+=("$directory/.env" "$compose_file")
    sources+=("$staged_env" "$staged_compose")
    for index in "${!targets[@]}"; do
      target="${targets[index]}" source="${sources[index]}"
      [[ "$target" == "$directory/"* && "$target" != *'/../'* && "$target" != *'/./'* && "$target" != *$'\n'* ]] || exit 1
      [ -f "$source" ] && [ ! -L "$source" ] && ! migrationPathHasSymlink "$target" || exit 1
      [ "$target" != "$source" ] && [ ! "$target" -ef "$source" ] || exit 1
      [ -d "${target%/*}" ] || exit 1
      # Duplicate destinations make rollback ambiguous.
      for ((changed=0; changed<index; changed++)); do [ "$target" != "${targets[changed]}" ] || exit 1; done
    done
    changed=0
    lock="$directory/.octojoom-change.lock"
    mkdir "$lock" 2>/dev/null || { printf 'Another configuration change is using %s.\n' "$site" >&2; exit 1; }
    trap 'rmdir "$lock" 2>/dev/null || true' EXIT
    siteValidateCompose "$staged_compose" "$staged_env" "$directory" || exit 1
    if [ "$#" -gt 0 ] || [ "${#stop_services[@]}" -gt 0 ]; then
      running=$(migrationRunCompose "$effective_env" "$compose_file" --project-directory "$directory" ps --status running --services) || {
        printf 'Cannot determine running services for %s; configuration unchanged.\n' "$site" >&2; exit 1;
      }
      for service in "$@"; do
        [[ "$service" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || exit 1
        if printf '%s\n' "$running" | grep -qxF "$service"; then active+=("$service"); fi
      done
      for service in "${stop_services[@]}"; do
        [[ "$service" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || exit 1
        if printf '%s\n' "$running" | grep -qxF "$service"; then stopped+=("$service"); fi
      done
      if [ "${#active[@]}" -gt 0 ] || [ "${#stopped[@]}" -gt 0 ]; then
        for service in "${start_services[@]}"; do
          [[ "$service" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || exit 1
          active+=("$service")
        done
      fi
    fi
    recovery=$(mktemp -d "$directory/.octojoom-recovery.XXXXXX") || exit 1
    chmod 700 "$recovery" || exit 1
    for index in "${!targets[@]}"; do
      target="${targets[index]}"
      if [ -e "$target" ]; then
        [ -f "$target" ] && cp -p -- "$target" "$recovery/$index" || exit 1
        existed+=(true)
      else
        existed+=(false)
      fi
      printf '%s\t%s\n' "$index" "$target" >> "$recovery/paths" || exit 1
    done
    # Interrupted writes flow through the same recovery path as command failures.
    trap 'failed=true' INT TERM HUP
    if [ "${#stopped[@]}" -gt 0 ]; then
      runtime_changed=true
      migrationRunCompose "$effective_env" "$compose_file" --project-directory "$directory" stop "${stopped[@]}" >&2 || failed=true
    fi
    if ! "$failed"; then
      for index in "${!targets[@]}"; do
        "$failed" && break
        # Write an adjacent copy so publication remains a rename on one filesystem.
        # Companions retain their explicitly prepared mode (PHP/Nginx read 0644
        # configuration as an unprivileged container user); ENV/Compose stay private.
        target="${targets[index]}"
        source=$(mktemp "${target}.publish.XXXXXX") || { failed=true; break; }
        if ! cp -p -- "${sources[index]}" "$source"; then
          rm -f -- "$source"; failed=true; break
        fi
        if [ "$target" = "$directory/.env" ] || [ "$target" = "$compose_file" ]; then
          chmod 600 "$source" || { rm -f -- "$source"; failed=true; break; }
        fi
        if ! mv -f -- "$source" "$target"; then
          rm -f -- "$source"; failed=true; break
        fi
        changed=$((index+1))
      done
    fi
    if ! "$failed" && [ "${#active[@]}" -gt 0 ]; then
      runtime_changed=true
      # Companion contents can change without changing the Compose model. A
      # renamed bind file also leaves an existing container on the old inode.
      migrationRunCompose "$directory/.env" "$compose_file" --project-directory "$directory" up -d --no-deps --force-recreate --wait --wait-timeout 90 "${active[@]}" >&2 || failed=true
      if ! "$failed" && [ -n "$callback" ]; then
        if ! isFunc "$callback" || ! "$callback" "$site"; then failed=true; fi
      fi
    fi
    if "$failed"; then
      for ((index=changed-1; index>=0; index--)); do
        target="${targets[index]}"
        if "${existed[index]}"; then
          cp -p -- "$recovery/$index" "$target" || rollback_failed=true
        else
          rm -f -- "$target" || rollback_failed=true
        fi
      done
      if "$runtime_changed"; then
        # Stop newly introduced services using the candidate before returning to
        # the original project. Do not remove containers or their data volumes.
        if [ "${#start_services[@]}" -gt 0 ]; then
          migrationRunCompose "$staged_env" "$staged_compose" --project-directory "$directory" stop "${start_services[@]}" >&2 || rollback_failed=true
        fi
        local -a restore=()
        for service in "$@" "${stopped[@]}"; do
          if printf '%s\n' "$running" | grep -qxF "$service"; then restore+=("$service"); fi
        done
        if [ "${#restore[@]}" -gt 0 ]; then
          migrationRunCompose "$effective_env" "$compose_file" --project-directory "$directory" up -d --no-deps --force-recreate --wait --wait-timeout 90 "${restore[@]}" >&2 || rollback_failed=true
        fi
      fi
      printf 'Configuration change failed for %s. Originals retained in %s.\n' "$site" "$recovery" >&2
      if "$rollback_failed"; then printf 'Automatic recovery is incomplete; inspect the retained files and services before retrying.\n' >&2; fi
      exit 1
    fi
    printf 'Previous configuration retained in %s.\n' "$recovery" >&2
  )
}

# Alignment's one concrete transformation exposes the *current* web image as a
# scoped editable setting. It deliberately does not enable optional services,
# upgrade an image, regenerate YAML, or change Traefik before such a change exists.
function siteAlignmentPlan() {
  local site="$1" directory compose_file effective_env raw image env_key service references name value problem
  isValidDomain "$site" || return 1
  directory="${VDM_REPO_PATH}/joomla/available/$site"
  compose_file="$directory/docker-compose.yml"
  [ -f "$compose_file" ] && ! migrationPathHasSymlink "$compose_file" || return 1
  if ! getJoomlaComposeIdentity "$compose_file"; then
    printf 'action-needed\tThe web service/environment identity is not in the supported generated layout.\n'; return 0
  fi
  env_key="$VDM_SRC_ENV_KEY" service="joomla$VDM_SRC_KEY"
  effective_env=$(getContainerEnvFile joomla "$site" available)
  if [ ! -f "$effective_env" ] || ! references=$(migrationComposeReferences "$compose_file"); then
    printf 'action-needed\tThe effective environment is missing or interpolation needs a manual edit.\n'; return 0
  fi
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if ! migrationReadEnvValue "$effective_env" "$name" value problem; then
      printf 'action-needed\t%s\n' "$problem"; return 0
    fi
  done <<< "$references"
  if ! raw=$(siteReadServiceScalar "$compose_file" "$service" image); then
    printf 'action-needed\tThe web image is not a unique block-style service scalar.\n'; return 0
  fi
  if [ "$raw" = "\${VDM_${env_key}_IMAGE}" ]; then
    if migrationReadEnvValue "$effective_env" "VDM_${env_key}_IMAGE" image; then
      printf 'unchanged\tCurrent image already has a saved site setting.\n'
    else
      printf 'action-needed\tThe saved web image setting is missing.\n'
    fi
  elif [[ "$raw" =~ ^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*$ ]]; then
    printf 'pending\tSave the current web image and scoped environment; no service recreation.\n'
  else
    printf 'action-needed\tThe existing image interpolation is customized; keep its current setting.\n'
  fi
}

function siteAlignConfiguration() {
  (
    local site="$1" action="${2:-apply}" plan state directory compose_file effective_env env_key service image
    local staged_compose='' staged_env='' before='' after='' reported=false status temporary
    trap '
      status=$?
      for temporary in "$staged_compose" "$staged_env" "$before" "$after"; do
        [ -z "$temporary" ] || rm -f -- "$temporary"
      done
      if [ "$status" -ne 0 ] && ! "$reported"; then
        printf "%s\taction-needed\tAlignment failed; original configuration or reported recovery files retained.\n" "$site"
      fi
      exit "$status"
    ' EXIT
    plan=$(siteAlignmentPlan "$site") || exit 1
    state="${plan%%$'\t'*}"
    if [ "$action" = inspect ] || [ "$state" != pending ]; then
      printf '%s\t%s\n' "$site" "$plan"
      reported=true
      [ "$state" != action-needed ]
      exit $?
    fi
    directory="${VDM_REPO_PATH}/joomla/available/$site"
    compose_file="$directory/docker-compose.yml"
    effective_env=$(getContainerEnvFile joomla "$site" available)
    getJoomlaComposeIdentity "$compose_file" || exit 1
    env_key="$VDM_SRC_ENV_KEY" service="joomla$VDM_SRC_KEY"
    image=$(siteReadServiceScalar "$compose_file" "$service" image) || exit 1
    staged_compose=$(mktemp "$directory/.align-compose.XXXXXX") || exit 1
    staged_env=$(mktemp "$directory/.align-env.XXXXXX") || { rm -f "$staged_compose"; exit 1; }
    before=$(mktemp "$directory/.align-before.XXXXXX") || exit 1
    after=$(mktemp "$directory/.align-after.XXXXXX") || exit 1
    siteWriteScopedEnv "$compose_file" "$effective_env" "$env_key" "$staged_env" &&
      writeEnvVariable "$staged_env" "VDM_${env_key}_IMAGE=\"$image\"" true &&
      siteReplaceServiceScalar "$compose_file" "$staged_compose" "$service" image "\${VDM_${env_key}_IMAGE}" || exit 1
    siteValidateCompose "$staged_compose" "$staged_env" "$directory" || exit 1
    migrationRunCompose "$effective_env" "$compose_file" --project-directory "$directory" config > "$before" &&
      migrationRunCompose "$staged_env" "$staged_compose" --project-directory "$directory" config > "$after" || exit 1
    if ! cmp -s "$before" "$after"; then
      printf '%s\taction-needed\tEffective Compose configuration changed unexpectedly; original retained.\n' "$site"
      reported=true
      exit 1
    fi
    # No service arguments: effective configuration is identical, including when
    # the daemon cannot be inspected. No stop/start/pull is needed for this edit.
    sitePublishConfiguration "$site" "$staged_compose" "$staged_env" || exit 1
    printf '%s\tupdated\tSaved current image and complete site environment; services unchanged.\n' "$site"
  )
}

function joomla__TRuST__align() {
  local action="${VDM_ACTION:-apply}" site result=0 found=false
  case "$action" in inspect|apply) ;; *) printf 'Alignment action must be inspect or apply.\n' >&2; return 17 ;; esac
  if [ "${VDM_ALL:-false}" = true ] && [ -n "${VDM_CONTAINER:-}" ]; then
    printf 'Choose --all or --container for alignment.\n' >&2; return 17
  fi
  if [ "${VDM_ALL:-false}" = true ]; then
    for site in "${VDM_REPO_PATH}/joomla/available/"*; do
      [ -f "$site/docker-compose.yml" ] || continue
      found=true
      siteAlignConfiguration "${site##*/}" "$action" || result=1
    done
    "$found" || printf 'No Joomla websites found.\n'
  elif [ -n "${VDM_CONTAINER:-}" ]; then
    siteAlignConfiguration "$VDM_CONTAINER" "$action" || result=$?
  else
    printf 'Alignment requires --container HOSTNAME or --all.\n' >&2; return 17
  fi
  return "$result"
}

function showConfigurationAlignment() {
  local VDM_ALL=true VDM_CONTAINER='' VDM_ACTION=inspect report
  report=$(joomla__TRuST__align)
  if getInputYesNo "$report\n\nApply the supported configuration changes? Current images, data and service state are preserved." 'Update existing configurations' 22 112; then
    VDM_ACTION=apply
    report=$(joomla__TRuST__align 2>&1)
    showNotice "$report" 22
  fi
}

# Read-only menu hint, no Docker, cache, settings writes or implicit apply.
function configurationAlignmentCount() {
  local site plan count=0
  for site in "${VDM_REPO_PATH}/joomla/available/"*; do
    [ -f "$site/docker-compose.yml" ] || continue
    plan=$(siteAlignmentPlan "${site##*/}") || continue
    [[ "$plan" == pending$'\t'* ]] && count=$((count+1))
  done
  printf '%s\n' "$count"
}

