#####################################################################################################################VDM
######################################## ENABLE JOOMLA
# Save a generated Compose file atomically, leaving an existing setup intact
# when rendering, permission changes or the final rename fail.
function saveContainerCompose() {
  local generator="${1:-}"
  local compose_file="${2:-}"
  local compose_dir="${compose_file%/*}"
  local compose_tmp
  createPrivateDirectory -p "${compose_dir}" || return 1
  compose_tmp=$(mktemp "${compose_dir}/.docker-compose.XXXXXX") || return 1
  if ! "${generator}" >"${compose_tmp}" || ! chmod 600 "${compose_tmp}" ||
    ! mv -f "${compose_tmp}" "${compose_file}"; then
    rm -f "${compose_tmp}"
    showError "The Compose file (${compose_file}) could not be saved."
    return 1
  fi
}

# Run Compose exactly once with the selected environment. A failed operation must
# never be retried without its credentials or hidden by later filesystem changes.
function runContainerCompose() {
  local env_file="${1:-}"
  local compose_file="${2:-}"
  local compose_status=0
  shift 2
  if [ ! -f "${compose_file}" ]; then
    showError "The Compose file (${compose_file}) does not exist."
    return 1
  fi
  if [ -n "${env_file}" ]; then
    docker compose --env-file "${env_file}" --file "${compose_file}" "$@" || compose_status=$?
  else
    docker compose --file "${compose_file}" "$@" || compose_status=$?
  fi
  if [ "${compose_status}" -ne 0 ]; then
    showError "Docker Compose failed for (${compose_file}), exit status ${compose_status}.\n\nCheck the Docker output before trying again."
  fi
  return "${compose_status}"
}

function joomla__TRuST__enable() {
  if [ -n "${VDM_CONTAINER:-}" ] && ! isValidDomain "${VDM_CONTAINER}"; then
    showError "The container identifier (${VDM_CONTAINER}) is invalid."
    unset VDM_CONTAINER
    return 1
  fi
  # some local values
  local evn_file
  # check if this type have available containers
  if ! hasDirectories "${VDM_CONTAINER_TYPE}/available/"; then
    showError "The path ${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available/ does not exist or is empty, first run a ${VDM_CONTAINER_TYPE^} setup."
    return 1
  elif [ ! -d "${VDM_PROJECT_PATH}" ]; then
    # this should never happen, but in case
    showError "The path ${VDM_PROJECT_PATH} does not exist, so we can't mount the persistent volumes. This error should never show, \
      please open an issue and report octojoom-error-1234 with the steps of how you got here?"
    return 1
  elif [ ${#VDM_CONTAINER} -ge 1 ]; then
    # this means we have a single already selected container to enable if it exists
    if [ -d "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available/${VDM_CONTAINER}" ]; then
      # create the folder as needed
      mkdir -p "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/" || return $?
      # create the soft link
      [ -e "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/${VDM_CONTAINER}" ] || {
        ln -s "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available/${VDM_CONTAINER}" "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/${VDM_CONTAINER}" || return $?
      }
      # set some local variables
      local evn_file
      # check if image has its own env file also
      evn_file=''
      # shellcheck disable=SC2015
      [ -f "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/${VDM_CONTAINER}/.env" ] && evn_file="${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/${VDM_CONTAINER}/.env" || {
        [ -f "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" ] && evn_file="${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env"
      }
      # make sure the docker image is started
      runContainerCompose "${evn_file}" "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/${VDM_CONTAINER}/docker-compose.yml" up -d || {
        local compose_status=$?
        unset VDM_CONTAINER
        return "${compose_status}"
      }
    else
      showError "The (${VDM_CONTAINER}) container does not exist."
      unset VDM_CONTAINER
      return 1
    fi
    # always unset after
    VDM_CONTAINER=''
    unset VDM_CONTAINER
  else
    # set some local variables
    local vdm_enable_me
    local container
    local evn_file
    # create the folder as needed
    mkdir -p "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/" || return $?
    # get containers to enable
    vdm_enable_me=$(getSelectedDirectories "Select container/s to enable." \
      "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available/" "Enable ${VDM_CONTAINER_TYPE^} Containers")
    # check that we have something, else return to main menu
    if [ ${#vdm_enable_me} -ge 1 ]; then
      # convert the string to and array
      IFS=' ' read -r -a vdm_enable_me_array <<<"${vdm_enable_me[@]}"
      # loop over the directories to build the
      for containered in "${vdm_enable_me_array[@]}"; do
        # remove the " from the string
        container="${containered//\"/}"
        # create the soft link
        [ -e "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/${container}" ] || {
          ln -s "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available/${container}" "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/${container}" || return $?
        }
        # check if image has its own env file also
        evn_file=''
        # shellcheck disable=SC2015
        [ -f "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/${container}/.env" ] && evn_file="${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/${container}/.env" || {
          [ -f "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" ] && evn_file="${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env"
        }
        # make sure the docker image is started
        runContainerCompose "${evn_file}" "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled/${container}/docker-compose.yml" up -d || return $?
      done
    fi
  fi
}

