  # provides the Compose plugin as a package.
  if command -v apt-get &>/dev/null; then
    sudo apt-get update || return 1
    sudo apt-get install -y docker-compose-plugin || return 1
  elif command -v dnf &>/dev/null; then
    sudo dnf install -y docker-compose-plugin || return 1
  elif command -v yum &>/dev/null; then
    sudo yum install -y docker-compose-plugin || return 1
  else
    echo >&2 "ERROR: Could not detect a supported package manager (apt, dnf, yum)."
    echo >&2 "Please install docker-compose-plugin manually."
    exit 1
  fi
  docker compose version || return 1
  echo "Docker Compose plugin is installed."
}
# Install Docker Compose V2 plugin on macOS
function install_docker_compose_macos() {
  echo "Installing Docker Compose plugin on macOS..."
  # Docker Desktop for macOS includes Compose V2 by default.
  # If Docker Desktop is installed, the plugin should already be available.
  if docker compose version &>/dev/null; then
    echo "Docker Compose plugin is already available via Docker Desktop."
    docker compose version
    return 0
  fi
  # If not available (e.g., Docker installed via Homebrew without Desktop), install manually.
  local plugin_dir="$HOME/.docker/cli-plugins" release COMPOSE_VERSION download
  release=$(curl -fsSL https://api.github.com/repos/docker/compose/releases/latest) || return 1
  COMPOSE_VERSION=$(printf '%s\n' "$release" | sed -nE 's/.*"tag_name"[[:space:]]*:[[:space:]]*"(v[0-9]+\.[0-9]+\.[0-9]+)".*/\1/p' | head -n 1)
  if [ -z "$COMPOSE_VERSION" ]; then
    echo >&2 "ERROR: Could not determine the Docker Compose release version."
    return 1
  fi
  mkdir -p "$plugin_dir" || return 1
  download=$(mktemp "$plugin_dir/.docker-compose.XXXXXX") || return 1
  if ! curl -fsSL "https://github.com/docker/compose/releases/download/${COMPOSE_VERSION}/docker-compose-$(uname -s)-$(uname -m)" \
      -o "$download" || ! [ -s "$download" ] || ! chmod +x "$download" || ! "$download" version; then
    rm -f "$download"
    echo >&2 "ERROR: Docker Compose download or validation failed."
    return 1
  fi
  if ! mv -f "$download" "$plugin_dir/docker-compose"; then
    rm -f "$download"
    return 1
  fi
  echo "Docker Compose plugin ${COMPOSE_VERSION} is installed."
}
