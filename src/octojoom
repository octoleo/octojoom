# Check and install Docker on Linux
function install_docker_linux() {
  echo "Installing Docker on Linux..."
  local ID='' ID_LIKE='' VERSION_CODENAME='' UBUNTU_CODENAME=''
  local DISTRO DISTRO_FAMILY REPO_DISTRO CODENAME architecture
  local -a conflicting_packages

  # Detect the distribution.
  if [ -f /etc/os-release ]; then
    # shellcheck source=/dev/null
    . /etc/os-release
    DISTRO="${ID}"
    # For derivatives (e.g., Linux Mint, Pop!_OS, Zorin), use the parent distro.
    if [ "${ID}" = fedora ]; then
      DISTRO_FAMILY="fedora"
    elif [ -n "${ID_LIKE}" ]; then
      case "${ID_LIKE}" in
        *debian*|*ubuntu*) DISTRO_FAMILY="debian" ;;
        *fedora*|*rhel*)   DISTRO_FAMILY="rhel" ;;
        *suse*)            DISTRO_FAMILY="suse" ;;
        *)                 DISTRO_FAMILY="${ID_LIKE}" ;;
      esac
    else
      case "${DISTRO}" in
        ubuntu|debian)          DISTRO_FAMILY="debian" ;;
        fedora)                 DISTRO_FAMILY="fedora" ;;
        centos|rhel|rocky|alma|almalinux) DISTRO_FAMILY="rhel" ;;
        opensuse*|sles)         DISTRO_FAMILY="suse" ;;
        *)                      DISTRO_FAMILY="" ;;
      esac
    fi
  else
    echo >&2 "ERROR: Cannot detect Linux distribution. /etc/os-release not found."
    exit 1
  fi

  # Resolve derivative repositories before making any system changes.
  if [ "$DISTRO_FAMILY" = debian ]; then
    REPO_DISTRO=debian
    if [ "$DISTRO" = ubuntu ] || [[ " $ID_LIKE " == *" ubuntu "* ]] || [ -n "$UBUNTU_CODENAME" ]; then
      REPO_DISTRO=ubuntu
    fi
    CODENAME="${UBUNTU_CODENAME:-$VERSION_CODENAME}"
    if [[ ! "$CODENAME" =~ ^[a-z][a-z0-9]*$ ]]; then
      echo >&2 "ERROR: Cannot determine the parent distribution codename. Please install Docker manually."
      return 1
    fi
    architecture=$(dpkg --print-architecture) || return 1
    [ -n "$architecture" ] || return 1
  elif [[ "$DISTRO_FAMILY" != fedora && "$DISTRO_FAMILY" != rhel ]]; then
    echo >&2 "ERROR: Unsupported Linux distribution '${DISTRO}' (family: '${DISTRO_FAMILY}')."
    echo >&2 "Please install Docker manually: https://docs.docker.com/engine/install/"
    return 1
  fi

  # Remove any conflicting/unofficial Docker packages.
  echo "Removing any conflicting Docker packages..."
  case "${DISTRO_FAMILY}" in
    debian)
      # shellcheck disable=SC2086
      for pkg in docker.io docker-doc docker-compose docker-compose-v2 docker-buildx podman-docker containerd runc; do
        sudo apt-get remove -y "$pkg" 2>/dev/null || true
      done
      ;;
    fedora|rhel)
      conflicting_packages=(docker docker-client docker-client-latest docker-common
        docker-latest docker-latest-logrotate docker-logrotate docker-engine podman-docker)
      if [ "$DISTRO_FAMILY" = fedora ]; then
        conflicting_packages+=(docker-selinux docker-engine-selinux)
      else
        conflicting_packages+=(podman runc)
      fi
      for pkg in "${conflicting_packages[@]}"; do
        sudo dnf remove -y "$pkg" 2>/dev/null || sudo yum remove -y "$pkg" 2>/dev/null || true
      done
      ;;
  esac

  # Install Docker based on the distribution family.
  case "${DISTRO_FAMILY}" in
    debian)
      # Install prerequisites.
      sudo apt-get update || return 1
      sudo apt-get install -y ca-certificates curl gnupg || return 1

      # Set up the official Docker GPG key.
      sudo install -m 0755 -d /etc/apt/keyrings || return 1
      (set -o pipefail
        curl -fsSL "https://download.docker.com/linux/${REPO_DISTRO}/gpg" | \
          sudo gpg --batch --yes --dearmor -o /etc/apt/keyrings/docker.gpg
      ) || return 1
      sudo chmod a+r /etc/apt/keyrings/docker.gpg || return 1

      echo "deb [arch=${architecture} signed-by=/etc/apt/keyrings/docker.gpg] \
        https://download.docker.com/linux/${REPO_DISTRO} ${CODENAME} stable" | \
        sudo tee /etc/apt/sources.list.d/docker.list > /dev/null || return 1

      # Install Docker Engine, CLI, containerd, and Compose plugin.
      sudo apt-get update || return 1
      sudo apt-get install -y docker-ce docker-ce-cli containerd.io \
        docker-buildx-plugin docker-compose-plugin || return 1
      ;;

    fedora)
      # Install prerequisites.
      sudo dnf install -y dnf-plugins-core || return 1

      # Add the Docker repository.
      sudo dnf config-manager addrepo --from-repofile \
        https://download.docker.com/linux/fedora/docker-ce.repo || \
        sudo dnf config-manager --add-repo https://download.docker.com/linux/fedora/docker-ce.repo || return 1

      # Install Docker Engine, CLI, containerd, and Compose plugin.
      sudo dnf install -y docker-ce docker-ce-cli containerd.io \
        docker-buildx-plugin docker-compose-plugin || return 1
      ;;

    rhel)
      # Works for CentOS, RHEL, Rocky Linux, AlmaLinux.
      REPO_DISTRO=centos
      [ "$DISTRO" != rhel ] || REPO_DISTRO=rhel
      if command -v dnf &>/dev/null; then
        sudo dnf install -y dnf-plugins-core || return 1
        sudo dnf config-manager --add-repo \
          "https://download.docker.com/linux/${REPO_DISTRO}/docker-ce.repo" || return 1
        sudo dnf install -y docker-ce docker-ce-cli containerd.io \
          docker-buildx-plugin docker-compose-plugin || return 1
      else
        sudo yum install -y yum-utils || return 1
        sudo yum-config-manager --add-repo \
          https://download.docker.com/linux/centos/docker-ce.repo || return 1
        sudo yum install -y docker-ce docker-ce-cli containerd.io \
          docker-buildx-plugin docker-compose-plugin || return 1
      fi
      ;;

    *)
      echo >&2 "ERROR: Unsupported Linux distribution '${DISTRO}' (family: '${DISTRO_FAMILY}')."
      echo >&2 "Please install Docker manually: https://docs.docker.com/engine/install/"
      exit 1
      ;;
  esac

  # Create the docker group (may already exist).
  getent group docker >/dev/null 2>&1 || sudo groupadd docker || return 1

  # Add the current user to the docker group.
  sudo usermod -aG docker "$USER" || return 1

  # Enable and start the Docker service.
  sudo systemctl enable docker.service || return 1
  sudo systemctl start docker.service || return 1
  sudo systemctl enable containerd.service || return 1
  sudo systemctl start containerd.service || return 1

  docker --version || return 1
  docker compose version || return 1

  DOCKER_INSTALLED_THIS_SESSION=true
  echo "Docker is installed."
}
# Check and install Docker on macOS
function install_docker_macos() {
  echo "Installing Docker on macOS..."
  # Check if Homebrew is installed.
  if ! command -v brew &>/dev/null; then
    echo "Homebrew is not installed. Installing Homebrew first..."
    local brew_installer
    brew_installer=$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh) || return 1
    [ -n "$brew_installer" ] || return 1
    /bin/bash -c "$brew_installer" || return 1
    # Add Homebrew to PATH for Apple Silicon Macs (default install location changed).
    if [[ -f /opt/homebrew/bin/brew ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [[ -f /usr/local/bin/brew ]]; then
      eval "$(/usr/local/bin/brew shellenv)"
    fi
    if ! command -v brew &>/dev/null; then
      echo >&2 "ERROR: Homebrew installation failed. Please install it manually:"
      echo >&2 "https://brew.sh"
      exit 1
    fi
  fi
  # Check if Docker Desktop is already installed but just not in PATH.
  if [[ -d "/Applications/Docker.app" ]]; then
    echo "Docker Desktop is already installed but Docker CLI is not available."
    echo "Starting Docker Desktop..."
    open /Applications/Docker.app || return 1
    echo "Please wait for Docker Desktop to finish starting, then re-run this script."
    exit 0
  fi
  # Install Docker Desktop via Homebrew.
  brew install --cask docker || return 1
  # Start Docker Desktop.
  open /Applications/Docker.app || return 1
  # Wait for Docker daemon to become available.
  echo "Waiting for Docker Desktop to start..."
  local TIMEOUT=120 ELAPSED=0
  while ! docker info &>/dev/null; do
    if [[ ${ELAPSED} -ge ${TIMEOUT} ]]; then
      echo >&2 "WARNING: Docker Desktop did not start within ${TIMEOUT} seconds."
      echo >&2 "Please finish setup manually, then re-run this script."
      exit 1
    fi
    sleep 2
    ELAPSED=$((ELAPSED + 2))
    printf "."
  done
  echo ""
  docker --version || return 1
  docker compose version || return 1
  # macOS does not require a Docker group login refresh.
  echo "Docker is installed and running."
}
