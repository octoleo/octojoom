function v4SiteConfigure() {
  local meta name value changed=false
  v4Require site || return $?
  v4Confirm || return $?
  v4LoadSite "$(v4Get site)" || return $?
  if [ "${V4_LEGACY:-false}" = true ]; then v4HydrateLegacyMetadata || return $?; fi
  meta="$V4_META"
  for name in memory_limit upload_max_filesize post_max_size max_execution_time; do
    if v4Has "$name"; then
      value=$(v4Get "$name")
      if [ "$name" = max_execution_time ]; then
        [[ "$value" =~ ^[0-9]+$ ]] || { v4Error 'max_execution_time must be a nonnegative integer.' 2; return 2; }
      else [[ "$value" =~ ^([1-9][0-9]*[KMG]?|-1)$ ]] || { v4Error "Invalid PHP setting: $name." 2; return 2; }; fi
      meta=$(jq --arg name "$name" --arg value "$value" '.php_settings[$name]=$value' <<< "$meta") || return 1
      changed=true
    fi
  done
  if v4Has http_port; then
    value=$(v4Get http_port)
    if ! { [[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -le 65535 ]; }; then v4Error 'http_port must be between 0 and 65535.' 2; return 2; fi
    meta=$(jq --argjson value "$value" '.http_port=$value' <<< "$meta") || return 1
    changed=true
  fi
  [ "$changed" = true ] || { v4Error 'Supply at least one supported PHP setting or http_port.' 2; return 2; }
  v4ApplyConfig "$meta" || return $?
  v4Result "$(jq -n --arg site "$V4_HOST" '{site:$site,configured:true}')"
}

# Uses PHP inside the selected image, never host PHP. The existing configuration
# is tokenized as text; expressions are refused and never evaluated.
function v4RealignConfiguration() {
  local name user password env_prefix settings code
  env_prefix="VDM_${V4_ENV_KEY}"
  if [ "$(jq -r '.services.mail' <<< "$V4_META")" = true ] && declare -F v4MailPreserve >/dev/null; then
    v4MailPreserve || return $?
  fi
  if ! migrationReadEnvValue "$V4_ENV_FILE" "${env_prefix}_DB" name ||
    ! migrationReadEnvValue "$V4_ENV_FILE" "${env_prefix}_DB_USER" user ||
    ! migrationReadEnvValue "$V4_ENV_FILE" "${env_prefix}_DB_PASS" password; then
      v4Error 'The scoped database environment is incomplete.' 2; return 2
  fi
  settings=$(jq -n --arg host "$V4_DB_SERVICE" --arg db "$name" --arg user "$user" --arg password "$password" \
    --arg engine "$V4_DB_ENGINE" --argjson meta "$V4_META" --arg clear "$(v4Get clear_url true)" --arg label "$(v4Get dev_label false)" '
    {host:$host,db:$db,user:$user,password:$password,dbtype:(if $engine=="postgres" then "pgsql" else "mysqli" end),
      log_path:"/var/www/html/administrator/logs",tmp_path:"/var/www/html/tmp"} +
    (if $clear=="true" then {live_site:"",cookie_domain:""} else {} end) +
    (if $meta.profile=="local" then {force_ssl:0} else {} end) +
    (if $meta.profile=="local" or $meta.tls.mode!="none" then {behind_loadbalancer:true} else {} end) +
    (if $meta.services.mail then {mailer:"smtp",smtphost:("mailpit"+$meta.key),smtpport:1025,smtpauth:false,smtpsecure:"",smtpuser:"",smtppass:""} else {} end) +
    {_development_label:($label=="true")}') || return 1
  code=$(cat <<'PHP'
$path="/var/www/html/configuration.php";
try {
    $changes=json_decode(stream_get_contents(STDIN),true,512,JSON_THROW_ON_ERROR);
    $label=$changes["_development_label"]??false; unset($changes["_development_label"]);
    $original=file_get_contents($path); if ($original===false) throw new RuntimeException("Cannot read Joomla configuration.");
    $tokens=token_get_all($original); $out=""; $seen=[];
    for($i=0,$n=count($tokens);$i<$n;$i++) {
        $t=$tokens[$i]; $text=is_array($t)?$t[1]:$t;
        if(is_array($t)&&$t[0]===T_VARIABLE) {
            $key=substr($text,1); $wanted=array_key_exists($key,$changes)||($label&&$key==="sitename");
            if($wanted) {
                if(isset($seen[$key])) throw new RuntimeException("Duplicate Joomla configuration property.");
                $seen[$key]=true; $j=$i+1; $prefix=$text;
                while($j<$n&&is_array($tokens[$j])&&$tokens[$j][0]===T_WHITESPACE) {$prefix.=$tokens[$j][1];$j++;}
                if(($tokens[$j]??null)!=="=") throw new RuntimeException("Unsupported Joomla property declaration.");
                $prefix.="=";$j++;$value="";$literal=[];
                while($j<$n&&$tokens[$j]!==";") {
                    $q=$tokens[$j];$value.=is_array($q)?$q[1]:$q;
                    if(!(is_array($q)&&$q[0]===T_WHITESPACE)) $literal[]=$q;
                    $j++;
                }
                if($j===$n||count($literal)!==1||!is_array($literal[0])||
                   !in_array($literal[0][0],[T_CONSTANT_ENCAPSED_STRING,T_LNUMBER,T_DNUMBER,T_STRING],true))
                    throw new RuntimeException("Only literal Joomla configuration properties can be realigned.");
                if($literal[0][0]===T_STRING&&!in_array(strtolower($literal[0][1]),["true","false","null"],true))
                    throw new RuntimeException("Configuration expressions are not modified.");
                if($key==="sitename"&&!array_key_exists($key,$changes)) {
                    $raw=trim($value);
                    if(substr($raw,0,1)!=="\x27") throw new RuntimeException("Development label requires a literal single-quoted site name.");
                    $current=str_replace(["\\\x27","\\\\"],["\x27","\\"],substr($raw,1,-1));
                    $changes[$key]=str_starts_with($current,"[DEV] - ")?$current:"[DEV] - ".$current;
                }
                $out.=$prefix." ".var_export($changes[$key],true).";";$i=$j;continue;
            }
        }
        $out.=$text;
    }
    foreach(["host","db","user","password","dbtype","log_path","tmp_path"] as $key)
        if(!isset($seen[$key])) throw new RuntimeException("Required Joomla configuration property is missing.");
    $info=stat($path);$tmp=tempnam(dirname($path),".octojoom-config-");
    if($tmp===false||file_put_contents($tmp,$out)===false) throw new RuntimeException("Cannot stage Joomla configuration.");
    if(!chmod($tmp,$info["mode"]&0777)||(fileowner($tmp)!==$info["uid"]&&!chown($tmp,$info["uid"]))||(filegroup($tmp)!==$info["gid"]&&!chgrp($tmp,$info["gid"]))||!rename($tmp,$path)) {
        @unlink($tmp);throw new RuntimeException("Cannot publish Joomla configuration.");
    }
} catch(Throwable $e) {fwrite(STDERR,$e->getMessage()."\n");exit(1);}
PHP
  ) || return 1
  printf '%s' "$settings" | v4Compose run --rm -T --no-deps --entrypoint php "$V4_WEB_SERVICE" -r "$code" >&2
}

function v4SiteRealign() {
  local status=0 lock
  v4Require site || return $?
  v4Confirm || return $?
  v4LoadSite "$(v4Get site)" || return $?
  lock="$V4_DIR/.operation.lock"
  v4Lock "$lock" || return $?
  v4RealignConfiguration || status=$?
  v4Unlock "$lock" || status=1
  [ "$status" -eq 0 ] || return "$status"
  v4Result "$(jq -n --arg site "$V4_HOST" '{site:$site,realigned:true}')"
}

# Resolve installable release assets, never repository source snapshots or update
# packages. GitHub's asset digest is SHA-256; older releases may publish the same
# checksum in the official release body's installation table.
function v4RuntimeOfficialPackage() {
  local requested="${1:-latest}" endpoint release version asset url digest
  case "$requested" in
    latest) endpoint=latest ;;
    *) [[ "$requested" =~ ^[3-9][0-9]*\.[0-9]+\.[0-9]+$ ]] || { v4Error 'Choose latest or an exact Joomla release version.' 2; return 2; }; endpoint="tags/$requested" ;;
  esac
  release=$(curl --silent --show-error --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 --connect-timeout 15 --max-time 60 \
    --header 'Accept: application/vnd.github+json' "https://api.github.com/repos/joomla/joomla-cms/releases/$endpoint") || {
    v4Error 'The official Joomla release could not be resolved. Check the version and network/API availability.' 3; return 3;
  }
  jq -e '.draft==false and .prerelease==false' <<< "$release" >/dev/null || { v4Error 'Only published stable Joomla packages are selected automatically.' 2; return 2; }
  version=$(jq -er '.tag_name' <<< "$release") || return 2
  [[ "$version" =~ ^[3-9][0-9]*\.[0-9]+\.[0-9]+$ ]] || return 2
  if [ "$requested" != latest ] && [ "$requested" != "$version" ]; then v4Error 'The release response did not match the requested version.' 2; return 2; fi
  asset=$(jq -ec --arg name "Joomla_${version}-Stable-Full_Package.tar.gz" '[.assets[] | select(.name==$name)] | if length==1 then .[0] else error("No unique full package") end' <<< "$release") || {
    v4Error 'The official release does not contain a unique full installation package.' 3; return 3;
  }
  url=$(jq -er '.browser_download_url' <<< "$asset") || return 2
  [[ "$url" = "https://github.com/joomla/joomla-cms/releases/download/$version/"* ]] || return 2
  digest=$(jq -r '.digest // empty' <<< "$asset")
  if [[ "$digest" =~ ^sha256:([a-fA-F0-9]{64})$ ]]; then digest="${BASH_REMATCH[1]}"
  else
    digest=$(jq -r --arg url "$url" '[((.body // "") | split("\n")[] | select(contains($url)) | scan("[a-fA-F0-9]{64}"))] | unique | if length==1 then .[0] else empty end' <<< "$release") || return 2
  fi
  [[ "$digest" =~ ^[[:xdigit:]]{64}$ ]] || { v4Error 'This official release has no verifiable SHA-256 checksum. Use an explicit package URL and trusted source-sha256.' 3; return 3; }
  jq -cn --arg version "$version" --arg url "$url" --arg checksum "${digest,,}" '{version:$version,url:$url,sha256:$checksum}'
}

function v4SiteDownload() {
  (
    local output parent basename requested resolved url checksum supplied stage='' version lock status=0 existed=false published=false
    v4Require output || exit $?
    output=$(v4Get output)
    v4ValidAbsolutePath "$output" || { v4Error 'The download output must be an absolute non-root directory.' 2; exit 2; }
    [ ! -L "$output" ] || { v4Error 'The download output must not be a symbolic link.' 2; exit 2; }
    basename=$(basename "$output"); parent=$(dirname "$output")
    if [ "$parent" != / ]; then parent=$(v4CanonicalRoot "$parent") || exit $?; fi
    output="${parent%/}/$basename"
    if [ -e "$output" ]; then
      if [ ! -d "$output" ] || [ -n "$(find "$output" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
        v4Error 'The download output must be empty; existing Joomla sites are never overwritten.' 2; exit 2
      fi
      existed=true
    fi
    requested=$(v4Get joomla_version latest)
    [[ "$requested" = latest || "$requested" =~ ^[3-9][0-9]*\.[0-9]+\.[0-9]+$ ]] || { v4Error 'Choose latest or an exact Joomla release version.' 2; exit 2; }
    if v4Has package_url; then
      v4Require source_sha256 || exit $?
      url=$(v4Get package_url); checksum=$(v4Get source_sha256)
      if [[ "$url" != https://* || ! "$checksum" =~ ^[[:xdigit:]]{64}$ ]]; then
        v4Error 'A custom package requires an HTTPS URL and a SHA-256 checksum.' 2; exit 2
      fi
    else
      resolved=$(v4RuntimeOfficialPackage "$requested") || exit $?
      requested=$(jq -r '.version' <<< "$resolved"); url=$(jq -r '.url' <<< "$resolved"); checksum=$(jq -r '.sha256' <<< "$resolved")
      if v4Has source_sha256; then
        supplied=$(v4Get source_sha256)
        if [ "${supplied,,}" != "$checksum" ]; then v4Error 'The supplied checksum disagrees with the official release checksum.' 2; exit 2; fi
      fi
    fi
    mkdir -p "$parent" || exit 1
    lock="${output}.download.lock"
    v4Lock "$lock" || exit $?
    trap 'status=$?; [ -z "$stage" ] || rm -rf -- "$stage"; if [ "$existed" = true ] && [ "$published" = false ] && [ ! -e "$output" ]; then mkdir "$output" || status=1; fi; v4Unlock "$lock" || status=1; exit "$status"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    stage=$(mktemp -d "$parent/.octojoom-download.XXXXXX") || exit 1
    mkdir "$stage/site" || exit 1
    v4RuntimeDownloadSource "$url" "$stage/site" "$checksum" || exit $?
    version=$(V4_DOCROOT="$stage/site" v4RuntimeInstalledVersion) || { v4Error 'The downloaded Joomla version cannot be verified.' 2; exit 2; }
    if [ "$requested" != latest ] && [ "$version" != "$requested" ]; then v4Error 'The package does not contain the requested Joomla version.' 2; exit 2; fi
    find "$stage/site" -type d -exec chmod 755 {} + || exit 1
    find "$stage/site" -type f -exec chmod 644 {} + || exit 1
    if [ -e "$output" ]; then rmdir "$output" || { v4Error 'The output directory changed during the download; it was not overwritten.' 2; exit 2; }; fi
    mv "$stage/site" "$output" || exit 1
    published=true
    v4Result "$(jq -cn --arg output "$output" --arg version "$version" --arg sha256 "${checksum,,}" '{output:$output,joomla_version:$version,sha256:$sha256,downloaded:true,installed:false}')"
  )
}

#####################################################################################################################VDM
# OCTOJOOM V4: database
# Joomla database, recovery, clone and portable migration operations.
# Every mutation is invoked through the same request API used by the TUI.

function v4BackupRoot() {
  local root
  root=$(v4Get backup_path "${VDM_BACKUP_PATH:-${VDM_HOME_PATH:-${HOME}}/OctojoomBackups}")
  [[ "$root" == /* && "$root" != / && "$root" != *$'\n'* ]] || { v4Error 'An absolute backup directory is required.' 2; return 2; }
  case "/${root#/}/" in *'/../'*|*'/./'*|*'//'*) v4Error 'The backup directory must be a normalized absolute path.' 2; return 2 ;; esac
  migrationPathHasSymlink "$root" && { v4Error 'Backup directories must not contain symbolic links.' 2; return 2; }
  if [ -n "${V4_DOCROOT:-}" ]; then
    case "$root/" in "$V4_DOCROOT/"*) v4Error 'Backups must be stored outside the public Joomla directory.' 2; return 2 ;; esac
  fi
  (umask 077; mkdir -p "$root") || return 1
  printf '%s\n' "$root"
}

function v4Digest() {
  local digest
  if command -v sha256sum >/dev/null 2>&1; then digest=$(sha256sum -- "$1") || return 1
  else digest=$(shasum -a 256 -- "$1") || return 1; fi
  printf '%s\n' "${digest%% *}"
}

function v4DatabaseTables() {
  local value table
  V4_DB_TABLES=()
  value=$(v4Get tables '')
  [ -n "$value" ] || return 0
  if [[ "$value" == \[* ]]; then
    jq -e 'type == "array" and all(.[]; type == "string")' <<< "$value" >/dev/null || return 2
    while IFS= read -r table; do V4_DB_TABLES+=("$table"); done < <(jq -r '.[]' <<< "$value")
  else IFS=',' read -r -a V4_DB_TABLES <<< "$value"; fi
  for table in "${V4_DB_TABLES[@]}"; do
    [[ "$table" =~ ^[A-Za-z0-9_]+$ ]] || { v4Error 'Table names may contain letters, numbers and underscores only.' 2; return 2; }
  done
}

# Credentials are expanded only inside the database container, never into the
# host command line, JSON result, or Docker invocation log.
# shellcheck disable=SC2016
function v4DatabaseDump() {
  local engine="${V4_DB_ENGINE}" table
  local options=()
  case "$engine" in
    mariadb)
      v4Exec "$V4_DB_SERVICE" sh -c 'set -eu; export MYSQL_PWD="$MARIADB_PASSWORD"; exec mariadb-dump --single-transaction --quick --routines --events --triggers --hex-blob --no-tablespaces --user="$MARIADB_USER" "$MARIADB_DATABASE" "$@"' octojoom "${V4_DB_TABLES[@]}"
      ;;
    mysql)
      v4Exec "$V4_DB_SERVICE" sh -c 'set -eu; export MYSQL_PWD="$MYSQL_ROOT_PASSWORD"; exec mysqldump --single-transaction --quick --routines --events --triggers --hex-blob --no-tablespaces --set-gtid-purged=OFF --user=root "$MYSQL_DATABASE" "$@"' octojoom "${V4_DB_TABLES[@]}"
      ;;
    postgres)
      for table in "${V4_DB_TABLES[@]}"; do options+=(--table "$table"); done
      v4Exec "$V4_DB_SERVICE" sh -c 'set -eu; export PGPASSWORD="$POSTGRES_PASSWORD"; exec pg_dump --host=127.0.0.1 --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --no-owner --no-privileges --format=plain "$@"' octojoom "${options[@]}"
      ;;
    *) v4Error 'Unsupported database engine.' 2; return 2 ;;
  esac
}

function v4DatabaseReadSql() {
  local file="$1"
  case "$file" in
    *.sql.gz|*.mysql.gz) gzip -dc -- "$file" ;;
    *.sql|*.mysql) cat -- "$file" ;;
    *) v4Error 'Select a SQL file or gzip-compressed SQL file.' 2; return 2 ;;
  esac
}

# The web services must be stopped before resetting/importing a live database.
# Reset uses only the validated configured database name; SQL import then runs
# as its scoped application user, not as a database-server administrator.
# shellcheck disable=SC2016
function v4DatabaseReset() {
  local name
  name=$(jq -r '.database.name' <<< "$V4_META")
  [[ "$name" =~ ^[A-Za-z0-9_]+$ ]] || { v4Error 'Invalid configured database name.' 2; return 2; }
  case "$V4_DB_ENGINE" in
    mariadb)
      v4Exec "$V4_DB_SERVICE" sh -c 'set -eu; export MYSQL_PWD="$MARIADB_ROOT_PASSWORD"; printf "DROP DATABASE IF EXISTS \`%s\`; CREATE DATABASE \`%s\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\n" "$1" "$1" | mariadb --user=root' octojoom "$name"
      ;;
    mysql)
      v4Exec "$V4_DB_SERVICE" sh -c 'set -eu; export MYSQL_PWD="$MYSQL_ROOT_PASSWORD"; printf "DROP DATABASE IF EXISTS \`%s\`; CREATE DATABASE \`%s\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;\n" "$1" "$1" | mysql --user=root' octojoom "$name"
      ;;
    postgres)
      v4Exec "$V4_DB_SERVICE" sh -c 'set -eu; export PGPASSWORD="$POSTGRES_PASSWORD"; dropdb --host=127.0.0.1 --username="$POSTGRES_USER" --if-exists --force "$POSTGRES_DB"; createdb --host=127.0.0.1 --username="$POSTGRES_USER" --owner="$POSTGRES_USER" "$POSTGRES_DB"'
      ;;
    *) return 2 ;;
  esac
}

# shellcheck disable=SC2016
function v4DatabaseImportSql() {
  case "$V4_DB_ENGINE" in
    mariadb) v4Exec "$V4_DB_SERVICE" sh -c 'set -eu; export MYSQL_PWD="$MARIADB_PASSWORD"; exec mariadb --user="$MARIADB_USER" "$MARIADB_DATABASE"' ;;
    mysql)
      # Recent MariaDB dumps start with a client-only sandbox directive which
      # the MySQL client cannot parse. Remove exactly that directive, no SQL.
      (set -o pipefail; sed '/^\/\*M!999999\\- enable the sandbox mode \*\/$/d' |
        v4Exec "$V4_DB_SERVICE" sh -c 'set -eu; export MYSQL_PWD="$MYSQL_PASSWORD"; exec mysql --user="$MYSQL_USER" "$MYSQL_DATABASE"')
      ;;
    postgres) v4Exec "$V4_DB_SERVICE" sh -c 'set -eu; export PGPASSWORD="$POSTGRES_PASSWORD"; exec psql --host=127.0.0.1 --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --set=ON_ERROR_STOP=on' ;;
    *) return 2 ;;
  esac
}

# shellcheck disable=SC2016
function v4DatabaseProbe() {
  case "$V4_DB_ENGINE" in
    mariadb) v4Exec "$V4_DB_SERVICE" sh -c 'export MYSQL_PWD="$MARIADB_PASSWORD"; exec mariadb --user="$MARIADB_USER" "$MARIADB_DATABASE" --batch --skip-column-names --execute="SELECT 1"' >/dev/null ;;
    mysql) v4Exec "$V4_DB_SERVICE" sh -c 'export MYSQL_PWD="$MYSQL_PASSWORD"; exec mysql --user="$MYSQL_USER" "$MYSQL_DATABASE" --batch --skip-column-names --execute="SELECT 1"' >/dev/null ;;
    postgres) v4Exec "$V4_DB_SERVICE" sh -c 'export PGPASSWORD="$POSTGRES_PASSWORD"; exec psql --host=127.0.0.1 --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --tuples-only --command="SELECT 1"' >/dev/null ;;
    *) return 2 ;;
  esac
}

function v4DatabaseWait() {
  local timeout="${1:-120}" start=$SECONDS
  [[ "$timeout" =~ ^[0-9]+$ ]] || return 2
  while [ "$((SECONDS - start))" -lt "$timeout" ]; do
    if v4DatabaseProbe >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  v4Error 'The database did not become ready before the timeout.' 1
  return 1
}

# Legacy projects can be backed up and adopted without guessing the installed
# Joomla/PHP/database versions. These read-only probes never run installers.
# shellcheck disable=SC2016
function v4HydrateLegacyMetadata() {
  local runtime version binary user
  [ "${V4_LEGACY:-false}" = true ] || return 0
  [ "${V4_NAMED_VOLUMES:-false}" = false ] || { v4Error 'Adoption requires a supported bind-mounted Joomla project.' 2; return 2; }
  if ! jq -e '(.joomla_version|test("^[4-9][0-9]*\\.[0-9]+")) and (.php_version|test("^[0-9]+\\.[0-9]+$"))' <<< "$V4_META" >/dev/null; then
    runtime=$(v4Compose run --rm -T --no-deps --entrypoint php "$V4_WEB_SERVICE" -r '$f="/var/www/html/administrator/manifests/files/joomla.xml"; if (!is_file($f)) exit(1); $x=simplexml_load_file($f); echo json_encode(["joomla"=>(string)$x->version,"php"=>PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION]);') || { v4Error 'Could not determine the installed legacy Joomla/PHP versions.' 2; return 2; }
    V4_META=$(jq -c --argjson runtime "$runtime" '.joomla_version=$runtime.joomla | .php_version=$runtime.php' <<< "$V4_META") || return 2
  fi
  if ! jq -e '.database.version|test("^[0-9]+(\\.[0-9]+){0,2}(-[A-Za-z0-9._-]+)?$")' <<< "$V4_META" >/dev/null; then
    case "$V4_DB_ENGINE" in mariadb) binary=mariadbd ;; mysql) binary=mysqld ;; postgres) binary=postgres ;; *) return 2 ;; esac
    version=$(v4Compose run --rm -T --no-deps --entrypoint "$binary" "$V4_DB_SERVICE" --version) || return 1
    version=$(sed -nE 's/.*[[:space:]]([0-9]+\.[0-9]+(\.[0-9]+)?)([-[:space:]].*|$)/\1/p' <<< "$version" | head -n 1)
    [ -n "$version" ] || { v4Error 'Could not determine the legacy database version.' 2; return 2; }
    V4_META=$(jq -c --arg version "$version" '.database.version=$version' <<< "$V4_META") || return 2
  fi
  if [ -z "$(jq -r '.database.user // empty' <<< "$V4_META")" ]; then
    migrationReadEnvValue "$V4_ENV_FILE" "VDM_${V4_ENV_KEY}_DB_USER" user || return 2
    V4_META=$(jq -c --arg user "$user" '.database.user=$user' <<< "$V4_META") || return 2
  fi
  V4_META=$(jq -c 'del(.legacy,.named_volumes) | .services={mail:(.services.mail // false),redis:(.services.redis // false),node:(.services.node // false)} | .hooks=(.hooks // {})' <<< "$V4_META") || return 2
  v4RuntimeValidateMeta "$V4_META"
}

# Temporarily start only the database for operations on stopped projects.
# The enclosing handler restores its previous stopped state in its EXIT trap.
function v4DatabaseEnsureRunning() {
  local running
  V4_DATABASE_STARTED=false
  running=$(v4Compose ps --services --status running) || return 1
  if ! printf '%s\n' "$running" | grep -qxF "$V4_DB_SERVICE"; then
    V4_DATABASE_STARTED=true
    v4Compose up -d "$V4_DB_SERVICE" >/dev/null || return 1
  fi
  v4DatabaseWait "$(v4Get timeout 120)"
}

function v4DatabaseWriteDump() {
  local output="$1" temporary
  case "/${output#/}/" in *'/../'*|*'/./'*|*'//'*) v4Error 'The export path must be normalized.' 2; return 2 ;; esac
  [[ "$output" != *[![:print:]]* ]] || return 2
  if ! { [ ! -e "$output" ] && [ ! -L "$output" ]; }; then v4Error 'The export destination already exists.' 2; return 2; fi
  migrationPathHasSymlink "$(dirname "$output")" && return 2
  temporary=$(umask 077; mktemp "${output}.tmp.XXXXXX") || return 1
  if [[ "$output" == *.gz ]]; then
    if ! (set -o pipefail; v4DatabaseDump | gzip -c > "$temporary"); then rm -f "$temporary"; return 1; fi
    gzip -t "$temporary" || { rm -f "$temporary"; return 1; }
  else
    v4DatabaseDump > "$temporary" || { rm -f "$temporary"; return 1; }
  fi
  [ -s "$temporary" ] || { rm -f "$temporary"; v4Error 'The database export was empty.'; return 1; }
  chmod 600 "$temporary" && ln "$temporary" "$output" && rm -f "$temporary"
}

function v4DbExport() {
  (
    set +x
    local root output host results='[]' status=0 item sub_request sites V4_DATABASE_STARTED=false export_lock=''
    if [ "$(v4Get all false)" = true ] || v4Has sites; then
      sites=$(v4DatabaseBatchSites) || exit $?
      while IFS= read -r host; do
        [ -n "$host" ] || continue
        sub_request=$(jq -c --arg site "$host" 'del(.output,.sites) | .all=false | .site=$site' <<< "$V4_REQUEST")
        if item=$(V4_RESULT_FILE='' V4_REQUEST="$sub_request" v4DbExport </dev/null); then
          results=$(jq -c --argjson item "$item" '. + [$item]' <<< "$results") || exit 1
        else
          status=1
          results=$(jq -c --arg site "$host" '. + [{site:$site,ok:false}]' <<< "$results") || exit 1
        fi
      done <<< "$sites"
      v4Result "$(jq -cn --argjson results "$results" '{results:$results}')"
      exit "$status"
    fi
    v4Require site || exit $?
    v4LoadSite "$(v4Get site)" || exit $?
    v4DatabaseTables || exit $?
    root=$(v4BackupRoot) || exit $?
    output=$(v4Get output "$root/${V4_HOST}-$(date -u +%Y%m%dT%H%M%SZ)-${RANDOM}.sql.gz")
    [[ "$output" == /* ]] || { v4Error 'An absolute output path is required.' 2; exit 2; }
    case "$output/" in "$V4_DOCROOT/"*) v4Error 'Database dumps must be outside the public Joomla directory.' 2; exit 2 ;; esac
    [ -d "$(dirname "$output")" ] || { v4Error 'The output directory does not exist.' 2; exit 2; }
    export_lock="$V4_DIR/.operation.lock"
    v4Lock "$export_lock" || exit $?
    trap 'status=$?; if "$V4_DATABASE_STARTED"; then v4Compose stop "$V4_DB_SERVICE" >/dev/null || status=1; fi; v4Unlock "$export_lock" || status=1; exit "$status"' EXIT
    v4DatabaseEnsureRunning || exit $?
    v4RunHook pre-export-db || exit $?
    v4DatabaseWriteDump "$output" || exit $?
    if ! v4RunHook post-export-db; then
      v4Result "$(jq -cn --arg site "$V4_HOST" --arg file "$output" '{site:$site,file:$file,exported:true,ok:false}')"
      v4Error "The SQL export was retained at $output, but its post-export-db hook failed."
      exit 1
    fi
    v4Result "$(jq -cn --arg site "$V4_HOST" --arg file "$output" --arg sha256 "$(v4Digest "$output")" '{site:$site,file:$file,sha256:$sha256,ok:true}')"
  )
}

# Save the exact set of running application services before quiescing them.
# Database containers stay up for logical export. Redis and optional workers
# are stopped as well so a full backup has a stable filesystem boundary.
function v4Quiesce() {
  local service running
  V4_RESUME_SERVICES=()
  running=$(v4Compose ps --services --status running) || return 1
  while IFS= read -r service; do
    if ! { [ -n "$service" ] && [ "$service" != "$V4_DB_SERVICE" ]; }; then continue; fi
    V4_RESUME_SERVICES+=("$service")
  done <<< "$running"
  if [ "${#V4_RESUME_SERVICES[@]}" -gt 0 ]; then
    v4Compose stop "${V4_RESUME_SERVICES[@]}" >/dev/null || return 1
    running=$(v4Compose ps --services --status running) || return 1
    for service in "${V4_RESUME_SERVICES[@]}"; do
      if printf '%s\n' "$running" | grep -qxF "$service"; then v4Error 'An application service did not stop.'; return 1; fi
    done
  fi
}

function v4Resume() {
  [ "${#V4_RESUME_SERVICES[@]}" -eq 0 ] || v4Compose start "${V4_RESUME_SERVICES[@]}" >/dev/null
}

function v4DbImport() {
  (
    set +x
    set -o pipefail
    local file root recovery lock status=0 resume=false imported=false V4_DATABASE_STARTED=false
    local -a V4_RESUME_SERVICES=() V4_DB_TABLES=()
    v4Require site input || exit $?
    v4Confirm || exit $?
    v4LoadSite "$(v4Get site)" || exit $?
    file=$(v4Get input)
    if ! { [ -f "$file" ] && [ ! -L "$file" ]; }; then v4Error 'The SQL input is not a regular file.' 2; exit 2; fi
    case "$file" in *.sql|*.mysql) ;; *.sql.gz|*.mysql.gz) gzip -t "$file" || exit 2 ;; *) v4Error 'Use an extracted SQL or SQL.gz file for import.' 2; exit 2 ;; esac
    root=$(v4BackupRoot) || exit $?
    recovery="$root/${V4_HOST}-before-import-$(date -u +%Y%m%dT%H%M%SZ)-${RANDOM}.sql.gz"
    lock="$V4_DIR/.operation.lock"
    v4Lock "$lock" || exit $?
    trap 'status=$?; if "$resume"; then v4Resume || status=1; fi; if "$V4_DATABASE_STARTED"; then v4Compose stop "$V4_DB_SERVICE" >/dev/null || status=1; fi; v4Unlock "$lock" || status=1; exit "$status"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    v4RunHook pre-import-db || exit $?
    resume=true
    v4Quiesce || exit $?
    v4DatabaseEnsureRunning || exit $?
    v4DatabaseWriteDump "$recovery" || exit $?
    if { [ "$(v4Get replace true)" != true ] || v4DatabaseReset; } &&
      (v4DatabaseReadSql "$file" | v4DatabaseImportSql) && v4DatabaseProbe; then imported=true; fi
    if ! "$imported"; then
      if v4DatabaseReset && v4DatabaseReadSql "$recovery" | v4DatabaseImportSql && v4DatabaseProbe; then
        v4Error "Import failed; the previous database was restored. Recovery dump: $recovery"
      else
        resume=false
        v4Error "Import and rollback failed. Application services remain stopped. Recovery dump: $recovery"
      fi
      exit 1
    fi
    v4Resume || exit $?
    resume=false
    v4RunHook post-import-db || exit $?
    v4Result "$(jq -cn --arg site "$V4_HOST" --arg recovery "$recovery" '{site:$site,imported:true,recovery:$recovery}')"
  )
}

# shellcheck disable=SC2016
function v4DbConsole() {
  local statement result
  v4Require site || return $?
  v4LoadSite "$(v4Get site)" || return $?
  if v4Has command; then
    jq -e '.command|type=="string" and length>0' <<< "$V4_REQUEST" >/dev/null || { v4Error 'The SQL command must be a nonempty string.' 2; return 2; }
    statement=$(v4Get command)
    case "$V4_DB_ENGINE" in
      mariadb) result=$(printf '%s\n' "$statement" | v4Exec "$V4_DB_SERVICE" sh -c 'export MYSQL_PWD="$MARIADB_PASSWORD"; exec mariadb --batch --raw --user="$MARIADB_USER" "$MARIADB_DATABASE"') || return $? ;;
      mysql) result=$(printf '%s\n' "$statement" | v4Exec "$V4_DB_SERVICE" sh -c 'export MYSQL_PWD="$MYSQL_PASSWORD"; exec mysql --batch --raw --user="$MYSQL_USER" "$MYSQL_DATABASE"') || return $? ;;
      postgres) result=$(printf '%s\n' "$statement" | v4Exec "$V4_DB_SERVICE" sh -c 'export PGPASSWORD="$POSTGRES_PASSWORD"; exec psql --host=127.0.0.1 --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --csv --set=ON_ERROR_STOP=on') || return $? ;;
      *) return 2 ;;
    esac
    v4Result "$(jq -cn --arg site "$V4_HOST" --arg output "$result" '{site:$site,output:$output}')"
    return $?
  fi
  if [ "$(v4Get json false)" = true ]; then v4Error 'The interactive SQL console cannot use JSON output.' 2; return 2; fi
  if ! { [ -t 0 ] && [ -t 1 ]; }; then v4Error 'The SQL console requires a terminal.' 2; return 2; fi
  case "$V4_DB_ENGINE" in
    mariadb) v4Compose exec "$V4_DB_SERVICE" sh -c 'export MYSQL_PWD="$MARIADB_PASSWORD"; exec mariadb --user="$MARIADB_USER" "$MARIADB_DATABASE"' ;;
    mysql) v4Compose exec "$V4_DB_SERVICE" sh -c 'export MYSQL_PWD="$MYSQL_PASSWORD"; exec mysql --user="$MYSQL_USER" "$MYSQL_DATABASE"' ;;
    postgres) v4Compose exec "$V4_DB_SERVICE" sh -c 'export PGPASSWORD="$POSTGRES_PASSWORD"; exec psql --host=127.0.0.1 --username="$POSTGRES_USER" --dbname="$POSTGRES_DB"' ;;
  esac
}

function v4ArchiveValidate() {
  local archive="$1" member normalized types type names
  local -A seen=()
  [ -f "$archive" ] && [ ! -L "$archive" ] || return 1
  case "$archive" in
    *.tar.gz|*.tgz) migrationValidateTar "$archive" folder ;;
    *.zip)
      command -v unzip >/dev/null 2>&1 && command -v zipinfo >/dev/null 2>&1 || return 1
      names=$(unzip -Z -1 "$archive") || return 1
      types=$(zipinfo -l "$archive") || return 1
      while IFS= read -r type; do
        case "$type" in Archive:*|Zip\ file\ size:*|*[0-9]\ files,*|*[0-9]\ file,*) continue ;; esac
        [[ "$type" == -* || "$type" == d* ]] || return 1
        [[ "${type:0:10}" != *[sS]* ]] || return 1
      done <<< "$types"
      while IFS= read -r member; do
        [[ -n "$member" && "$member" != /* && "$member" != *\\* && "$member" != *[![:print:]]* ]] || return 1
        normalized="${member#./}"; normalized="${normalized%/}"
        case "/$normalized/" in *'/../'*|*'/./'*|*'//'*) return 1 ;; esac
        [ -n "$normalized" ] && [ -z "${seen[$normalized]+set}" ] || return 1
        seen["$normalized"]=1
      done <<< "$names"
      ;;
    *) return 1 ;;
  esac
}

function v4ArchiveExtract() {
  local archive="$1" target="$2"
  v4ArchiveValidate "$archive" || { v4Error 'The archive has invalid paths, links, duplicate members or unsupported file types.' 2; return 2; }
  [ -d "$target" ] && [ -z "$(find "$target" -mindepth 1 -print -quit)" ] || return 2
  migrationPathHasSymlink "$target" && return 2
  case "$archive" in
    *.zip) unzip -q "$archive" -d "$target" ;;
    *) TAR_OPTIONS='' tar --no-same-owner -xzf "$archive" -C "$target" ;;
  esac || return 1
  chmod 700 "$target" || return 1
  migrationValidateTree "$target" || return 2
}

function v4PackageHashMap() {
  (
    set -o pipefail
    local directory="$1" file list='' hashes='' digest_status
    list=$(umask 077; mktemp "${TMPDIR:-/tmp}/octojoom-hash-list.XXXXXX") || exit 1
    hashes=$(umask 077; mktemp "${TMPDIR:-/tmp}/octojoom-hashes.XXXXXX") || { rm -f "$list"; exit 1; }
    trap 'digest_status=$?; rm -f -- "$list" "$hashes"; exit "$digest_status"' EXIT
    cd "$directory" || exit 1
    find . -type f ! -path ./checksums.json -print0 > "$list" || exit 1
    while IFS= read -r -d '' file; do
      [[ "$file" != *[![:print:]]* && "$file" != *\\* ]] || exit 2
    done < "$list"
    [ -s "$list" ] || exit 2
    if command -v sha256sum >/dev/null 2>&1; then xargs -0 sha256sum -- < "$list" > "$hashes" || exit 1
    else xargs -0 shasum -a 256 -- < "$list" > "$hashes" || exit 1; fi
    jq -Rsc 'split("\n") | map(select(length>0) | capture("^(?<value>[a-f0-9]{64})  \\./(?<key>.*)$")) | from_entries' "$hashes"
  )
}

function v4PackageChecksums() {
  local directory="$1" entries
  entries=$(v4PackageHashMap "$directory") || return $?
  printf '%s\n' "$entries" > "$directory/checksums.json"
}

function v4PackageVerify() {
  local directory="$1" actual result=0
  jq -e 'type == "object" and length > 0 and all(to_entries[]; (.key|type)=="string" and (.value|test("^[a-f0-9]{64}$")))' "$directory/checksums.json" >/dev/null || return 2
  actual=$(umask 077; mktemp "${TMPDIR:-/tmp}/octojoom-verify.XXXXXX") || return 1
  v4PackageHashMap "$directory" > "$actual" || result=$?
  if [ "$result" -eq 0 ]; then jq -e --slurpfile actual "$actual" '.==$actual[0]' "$directory/checksums.json" >/dev/null || result=2; fi
  rm -f "$actual"
  [ "$result" -eq 0 ] || { v4Error 'Archive checksums or file inventory did not match.' 2; return "$result"; }
  jq -e '.schema_version==1 and .format=="octojoom-logical" and (.scope=="full" or .scope=="site" or .scope=="database") and (.site|type)=="object"' "$directory/manifest.json" >/dev/null || return 2
  [ -s "$directory/database.sql.gz" ] && gzip -t "$directory/database.sql.gz" || return 2
}

# Package the project's identity, credentials and effective Compose references.
# Absolute bind mounts need no Compose interpolation, but restore still needs a
# destination root. Unrelated shared environment secrets are never included.
function v4PackageEnvironment() {
  local output="$1" name value refs file all_refs=''
  all_refs=$(printf '%s\n' VDM_PROJECT_PATH "VDM_${V4_ENV_KEY}_DB" "VDM_${V4_ENV_KEY}_DB_USER" "VDM_${V4_ENV_KEY}_DB_PASS")$'\n'
  [ "$V4_DB_ENGINE" = postgres ] || all_refs+="VDM_${V4_ENV_KEY}_DB_ROOT"$'\n'
  for file in "$V4_COMPOSE" "$V4_DIR/docker-compose.override.yml"; do
    [ -f "$file" ] || continue
    refs=$(migrationComposeReferences "$file") || { v4Error 'Compose uses unsupported environment expressions.' 2; return 2; }
    all_refs+="$refs"$'\n'
  done
  : > "$output" || return 1
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if [ "$name" = VDM_PROJECT_PATH ]; then value="$VDM_PROJECT_PATH"
    else migrationReadEnvValue "$V4_ENV_FILE" "$name" value || return 2; fi
    formatEnvAssignment "$name=\"$value\"" >> "$output" || return 1
  done < <(printf '%s' "$all_refs" | LC_ALL=C sort -u)
  chmod 600 "$output"
}

function v4PackageProject() {
  local target="$1" scope="$2" file relative invalid
  mkdir -p "$target/project" "$target/compose" || return 1
  [ -d "$V4_PROJECT" ] && [ ! -L "$V4_PROJECT" ] || return 2
  invalid=$(runPrivileged find "$V4_PROJECT" -path "$V4_PROJECT/db" -prune -o -path "$V4_PROJECT/.octojoom-recovery" -prune -o \( \( ! -type d ! -type f \) -o \( -type f -links +1 \) \) -print) || return 1
  [ -z "$invalid" ] || { v4Error 'Portable backups require regular files and directories without hard links.' 2; return 2; }
  # Symlink/special-file refusal happens before copying; no external file is
  # followed. Raw database files are excluded from this logical archive.
  while IFS= read -r -d '' file; do
    relative="${file#"$V4_PROJECT"/}"
    case "$relative" in db|db/*|.octojoom-recovery|.octojoom-recovery/*) continue ;; esac
    case "$relative" in *.key|*/rootCA.pem|*/rootCA-key.pem) v4Error 'Move private TLS keys outside the project before creating a portable backup.' 2; return 2 ;; esac
    if [ -L "$file" ] || { [ ! -f "$file" ] && [ ! -d "$file" ]; }; then v4Error 'Portable backups currently require regular files and directories.' 2; return 2; fi
  done < <(find "$V4_PROJECT" -mindepth 1 -path "$V4_PROJECT/db" -prune -o -print0)
  if [ "$scope" = site ]; then
    mkdir -p "$target/project/$(jq -r '.docroot' <<< "$V4_META")" || return 1
    runPrivileged cp -a "$V4_DOCROOT/." "$target/project/$(jq -r '.docroot' <<< "$V4_META")/" || return 1
  else
    while IFS= read -r -d '' file; do
      relative="${file#"$V4_PROJECT"/}"
      if ! { [ "$relative" != db ] && [ "$relative" != .octojoom-recovery ]; }; then continue; fi
      runPrivileged cp -a "$file" "$target/project/" || return 1
    done < <(find "$V4_PROJECT" -mindepth 1 -maxdepth 1 -print0)
  fi
  # Generated project metadata is rewritten at restore. Companion PHP/server
  # config, custom commands and hooks are copied; machine-local trust is not.
  while IFS= read -r -d '' file; do
    relative="${file#"$V4_DIR"/}"
    case "$relative" in .env|project.json|.operation.lock|tls|certs|.share*|*.key|*rootCA*) continue ;; esac
    if [ -d "$file" ]; then migrationValidateTree "$file" || return 2
    else [ -f "$file" ] && [ ! -L "$file" ] || return 2; fi
    runPrivileged cp -a "$file" "$target/compose/" || return 1
  done < <(find "$V4_DIR" -mindepth 1 -maxdepth 1 -print0)
  v4PackageEnvironment "$target/compose/.env" || return $?
  # The archive is readable only by the owner; copied container ownership must
  # not prevent hashing or compression on macOS/Linux.
  runPrivileged chown -R "$(id -u):$(id -g)" "$target" || return 1
  chmod 700 "$target/compose"
}

# shellcheck disable=SC2030,SC2031
function v4BackupBuild() {
  (
    set +x
    local output="$1" scope="${2:-full}" label="${3:-}" package='' temporary='' lock="$V4_DIR/.operation.lock" status=0 resume=false created V4_DATABASE_STARTED=false
    local -a V4_RESUME_SERVICES=() V4_DB_TABLES=()
    case "/${output#/}/" in *'/../'*|*'/./'*|*'//'*) v4Error 'The backup path must be normalized.' 2; exit 2 ;; esac
    [[ "$output" != *[![:print:]]* ]] || exit 2
    case "$scope" in full|site|database) ;; *) v4Error 'Backup scope must be full, site or database.' 2; exit 2 ;; esac
    if ! { [ ! -e "$output" ] && [ ! -L "$output" ]; }; then v4Error 'The backup destination already exists.' 2; exit 2; fi
    migrationPathHasSymlink "$(dirname "$output")" && exit 2
    [ -d "$(dirname "$output")" ] || exit 2
    case "$output" in *.zip) command -v zip >/dev/null 2>&1 || { v4Error 'ZIP output requires zip and unzip.' 2; exit 2; } ;; *.tar.gz|*.tgz) ;; *) v4Error 'Use a .tar.gz, .tgz or .zip archive filename.' 2; exit 2 ;; esac
    v4Lock "$lock" || exit $?
    trap 'status=$?; if "$resume"; then v4Resume || status=1; fi; if "$V4_DATABASE_STARTED"; then v4Compose stop "$V4_DB_SERVICE" >/dev/null || status=1; fi; [ -z "$package" ] || runPrivileged rm -rf -- "$package"; [ -z "$temporary" ] || rm -f -- "$temporary"; v4Unlock "$lock" || status=1; exit "$status"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    package=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/octojoom-backup.XXXXXX") || exit 1
    temporary=$(umask 077; mktemp "${output}.tmp.XXXXXX") || exit 1
    v4HydrateLegacyMetadata || exit $?
    v4RunHook pre-backup || exit $?
    resume=true
    v4Quiesce || exit $?
    v4DatabaseEnsureRunning || exit $?
    v4DatabaseWriteDump "$package/database.sql.gz" || exit $?
    if [ "$scope" != database ]; then v4PackageProject "$package" "$scope" || exit $?; fi
    created=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    jq -cn --arg created "$created" --arg label "$label" --arg scope "$scope" --argjson site "$V4_META" \
      '{schema_version:1,format:"octojoom-logical",created:$created,label:$label,scope:$scope,site:$site}' > "$package/manifest.json" || exit 1
    v4PackageChecksums "$package" && v4PackageVerify "$package" || exit $?
    v4Resume || exit $?
    resume=false
    case "$output" in
      *.zip) rm -f "$temporary"; (cd "$package" && zip -q -r "$temporary" .) || exit 1 ;;
      *) (cd "$package" && TAR_OPTIONS='' tar -czf "$temporary" .) || exit 1 ;;
    esac
    # Zip appends .zip unless the temporary filename already has an extension.
    [ -f "$temporary" ] || { v4Error 'The archive writer did not produce its expected output.'; exit 1; }
    chmod 600 "$temporary" || exit 1
    # Validate using its final extension in a private directory before publish.
    mkdir "$package/verify" || exit 1
    ln "$temporary" "$package/verify/$(basename "$output")" || exit 1
    v4ArchiveValidate "$package/verify/$(basename "$output")" || exit 2
    ln "$temporary" "$output" || exit 1
    v4RunHook post-backup || { v4Error "The backup archive was retained at $output, but its post-backup hook failed."; exit 1; }
  )
}

function v4BackupCreate() {
  (
    set +x
    local root output scope format label host results='[]' item status=0 request sites
    if [ "$(v4Get all false)" = true ] || v4Has sites; then
      sites=$(v4DatabaseBatchSites) || exit $?
      while IFS= read -r host; do
        [ -n "$host" ] || continue
        request=$(jq -c --arg site "$host" 'del(.output,.sites) | .all=false | .site=$site' <<< "$V4_REQUEST")
        if item=$(V4_RESULT_FILE='' V4_REQUEST="$request" v4BackupCreate </dev/null); then results=$(jq -c --argjson item "$item" '.+[$item]' <<< "$results")
        else status=1; results=$(jq -c --arg site "$host" '.+[{site:$site,ok:false}]' <<< "$results"); fi
      done <<< "$sites"
      v4Result "$(jq -cn --argjson results "$results" '{results:$results}')"
      exit "$status"
    fi
    v4Require site || exit $?
    v4LoadSite "$(v4Get site)" || exit $?
    [ "${V4_NAMED_VOLUMES:-false}" = false ] || { v4Error 'Portable backups require a supported bind-mounted Joomla project.' 2; exit 2; }
    root=$(v4BackupRoot) || exit $?
    scope=$(v4Get scope full); format=$(v4Get format tar.gz); label=$(v4Get label '')
    case "$format" in tar.gz|tgz|zip) ;; *) v4Error 'Archive format must be tar.gz, tgz or zip.' 2; exit 2 ;; esac
    output=$(v4Get output "$root/${V4_HOST}-$(date -u +%Y%m%dT%H%M%SZ)-${RANDOM}.$format")
    [[ "$output" == /* ]] || { v4Error 'An absolute output path is required.' 2; exit 2; }
    case "$output/" in "$V4_PROJECT/"*) v4Error 'A backup archive must be outside the project being archived.' 2; exit 2 ;; esac
    if v4BackupBuild "$output" "$scope" "$label"; then :
    else
      status=$?
      if [ -f "$output" ]; then v4Result "$(jq -cn --arg site "$V4_HOST" --arg file "$output" --arg scope "$scope" '{site:$site,file:$file,scope:$scope,created:true,ok:false}')"; fi
      exit "$status"
    fi
    v4Result "$(jq -cn --arg site "$V4_HOST" --arg file "$output" --arg scope "$scope" --arg sha256 "$(v4Digest "$output")" '{site:$site,file:$file,scope:$scope,sha256:$sha256,ok:true}')"
  )
}

function v4BackupList() {
  local root file result='[]' name
  root=$(v4BackupRoot) || return $?
  while IFS= read -r -d '' file; do
    name=$(basename "$file")
    if v4Has site; then [[ "$name" == "$(v4Get site)"-* ]] || continue; fi
    result=$(jq -c --arg file "$file" --arg name "$name" '.+[{name:$name,file:$file}]' <<< "$result") || return 1
  done < <(find "$root" -maxdepth 1 -type f \( -name '*.tar.gz' -o -name '*.tgz' -o -name '*.zip' -o -name '*.sql' -o -name '*.sql.gz' \) -print0)
  v4Result "$(jq -cn --argjson backups "$result" '{backups:($backups|sort_by(.name))}')"
}

function v4BackupDelete() {
  local root file parent
  v4Require input || return $?
  v4Confirm || return $?
  root=$(v4BackupRoot) || return $?
  file=$(v4Get input)
  if ! { [ -f "$file" ] && [ ! -L "$file" ]; }; then v4Error 'Select a regular backup file.' 2; return 2; fi
  parent=$(cd "$(dirname "$file")" && pwd -P) || return 2
  [ "$parent" = "$(cd "$root" && pwd -P)" ] || { v4Error 'Only files in the configured backup directory can be deleted.' 2; return 2; }
  case "$file" in *.tar.gz|*.tgz|*.zip|*.sql|*.sql.gz) ;; *) return 2 ;; esac
  rm -- "$file" || return 1
  v4Result "$(jq -cn --arg file "$file" '{deleted:$file}')"
}

function v4RestoreEnvironment() {
  local input="$1" output="$2" old="$3" new="$4" line name value
  : > "$output" || return 1
  # Write this independently of archive contents for older v4 archives whose
  # absolute Compose bind mounts caused the source root to be omitted.
  formatEnvAssignment "VDM_PROJECT_PATH=\"$VDM_PROJECT_PATH\"" >> "$output" || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    [[ "$line" =~ ^(VDM_[A-Za-z0-9_]+)=(.*)$ ]] || return 2
    name="${BASH_REMATCH[1]}"
    decodeEnvValue "${BASH_REMATCH[2]}" value || return 2
    case "$name" in
      VDM_PROJECT_PATH) continue ;;
      "VDM_${old}_"*) name="VDM_${new}_${name#"VDM_${old}_"}" ;;
    esac
    formatEnvAssignment "$name=\"$value\"" >> "$output" || return 1
  done < "$input"
  chmod 600 "$output"
}

function v4RestoreTargetMetadata() {
  local original="$1" host key env_key profile engine version tls docroot port=0
  host=$(v4Get target_site "$(v4Get site '')")
  key=$(v4Get target_key '')
  env_key="${key^^}"; env_key=$(v4Get target_env_key "${env_key//-/_}")
  if [ -z "$host" ] || ! isValidDomain "$host"; then v4Error 'A valid target-site is required.' 2; return 2; fi
  [[ "$key" =~ ^[A-Za-z][A-Za-z0-9_-]{0,49}$ && "$env_key" =~ ^[A-Z][A-Z0-9_]*$ ]] || { v4Error 'Use a target key of letters, numbers, underscores or hyphens and an uppercase environment key.' 2; return 2; }
  profile=$(v4Get profile "$(jq -r '.profile // "local"' <<< "$original")")
  engine=$(v4Get database_engine "$(jq -r '.database.engine' <<< "$original")")
  if [ "$engine" = "$(jq -r '.database.engine' <<< "$original")" ]; then version=$(jq -r '.database.version' <<< "$original")
  else version=$(v4RuntimeDefaultDbVersion "$engine") || return $?; fi
  version=$(v4Get database_version "$version")
  tls=$(v4Get tls_mode "$(jq -r 'if .tls.mode=="local" then "none" else .tls.mode // "none" end' <<< "$original")")
  docroot=$(v4Get docroot "$(jq -r '.docroot' <<< "$original")")
  [ "$host" != "$(jq -r '.host' <<< "$original")" ] || port=$(jq -r '.http_port // 0' <<< "$original")
  port=$(v4Get http_port "$port")
  if ! { [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -le 65535 ]; }; then v4Error 'Invalid target HTTP port.' 2; return 2; fi
  # Certificates are destination-local; provisioning starts without local TLS
  # then the explicitly requested TLS operation creates a new leaf certificate.
  [ "$tls" != local ] || tls=none
  jq -c --arg host "$host" --arg key "$key" --arg env "$env_key" --arg root "$VDM_PROJECT_PATH/$key" \
    --arg profile "$profile" --arg engine "$engine" --arg version "$version" --arg tls "$tls" --arg docroot "$docroot" --argjson port "$port" \
    '.host=$host | .key=$key | .env_key=$env | .project_dir=$root | .profile=$profile | .docroot=$docroot | .http_port=$port |
     .database.engine=$engine | .database.version=$version | .tls.mode=$tls | del(.tls.cert,.tls.key,.tls.certificate,.tls.private_key)' <<< "$original"
}

function v4RestoreCompanions() {
  local source="$1" file base source_key source_env source_root source_host source_engine line role
  [ -d "$source" ] || return 0
  source_key=$(jq -r '.site.key' "$source/../manifest.json")
  source_env=$(jq -r '.site.env_key' "$source/../manifest.json")
  source_root=$(jq -r '.site.project_dir' "$source/../manifest.json")
  source_host=$(jq -r '.site.host' "$source/../manifest.json")
  source_engine=$(jq -r '.site.database.engine' "$source/../manifest.json")
  while IFS= read -r -d '' file; do
    base=$(basename "$file")
    case "$base" in .env|project.json|docker-compose.yml|nginx.conf|.operation.lock|tls|certs|*.key|*rootCA*) continue ;; esac
    # Rewrite only known managed identities and the managed project root.
    # The regenerated base Compose is never copied from the source machine.
    if [ "$base" = docker-compose.override.yml ]; then
      : > "$V4_DIR/$base" || return 1
      while IFS= read -r line || [ -n "$line" ]; do
        line=${line//"$source_root"/"$V4_PROJECT"}
        line=${line//"VDM_${source_env}_"/"VDM_${V4_ENV_KEY}_"}
        line=${line//"${source_engine}${source_key}"/"${V4_DB_ENGINE}${V4_KEY}"}
        for role in joomla nginx phpmyadmin adminer mailpit mailcatcher redis node; do line=${line//"${role}${source_key}"/"${role}${V4_KEY}"}; done
        line=${line//"$source_host"/"$V4_HOST"}
        printf '%s\n' "$line" >> "$V4_DIR/$base" || return 1
      done < "$file"
      continue
    fi
    runPrivileged cp -a "$file" "$V4_DIR/" || return 1
  done < <(find "$source" -mindepth 1 -maxdepth 1 -print0)
}

# Restore is transactional at the directory boundary. Existing data is moved
# aside only after the package is validated and a fresh recovery archive exists.
# Failure removes only this operation's target, then puts the original back.
# shellcheck disable=SC2016,SC2030,SC2031
function v4RestoreArchive() {
  (
    set +x
    set -o pipefail
    local archive="$1" staging='' status=0 original metadata scope old_env new_env source_engine target_engine host key
    local target_dir target_project source_docroot target_docroot environment='' backup_root recovery='' old_dir='' old_project=''
    local destination_created=false original_moved=false original_running=false published=false locked=false lock
    local requested_tls local_tls_required=false old_request="$V4_REQUEST" temp_request status_json old_running='' operation_lock='' operation_locked=false service original_stopped=false imported_hooks target_hooks='{}' hook_status=0 tls_item tls_snapshot='' previous_tls='none'
    local -a original_services=()
    v4Confirm || exit $?
    staging=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/octojoom-restore.XXXXXX") || exit 1
    trap '
      status=$?
      if [ "$published" = false ] && [ "$destination_created" = true ]; then
        if [ "$original_moved" = false ]; then v4LocalRemoveSite >/dev/null 2>&1 || status=1
        elif [ -n "$tls_snapshot" ]; then
          if [ ! -f "$tls_snapshot/hosts/${host}.json" ] && [ -f "$VDM_SRC_PATH/local-tls/hosts/${host}.json" ]; then v4HostsEntry remove "$host" || status=1; fi
          for tls_item in "routes/${host}.json" "certs/${host}.pem" "certs/${host}-key.pem" "hosts/${host}.json"; do
            if [ -f "$tls_snapshot/$tls_item" ]; then cp -p "$tls_snapshot/$tls_item" "$VDM_SRC_PATH/local-tls/$tls_item" || status=1
            else rm -f "$VDM_SRC_PATH/local-tls/$tls_item" || status=1; fi
          done
          v4LocalProxyStopIfIdle "$VDM_SRC_PATH/local-tls" >/dev/null 2>&1 || status=1
        fi
        v4Compose down --remove-orphans >/dev/null 2>&1 || status=1
        runPrivileged rm -rf -- "$target_dir" "$target_project" || status=1
      fi
      if [ "$published" = false ] && [ "$original_moved" = true ]; then
        runPrivileged mv -- "$old_dir" "$target_dir" && runPrivileged mv -- "$old_project" "$target_project" || status=1
        if v4LoadSite "$host"; then
          v4NetworkSyncRoute || status=1
          if "$original_running"; then v4Compose up -d "${original_services[@]}" >/dev/null 2>&1 || status=1; fi
        else status=1; fi
      elif [ "$published" = false ] && [ "$original_stopped" = true ] && [ "$original_running" = true ]; then
        v4LoadSite "$host" && v4Compose up -d "${original_services[@]}" >/dev/null 2>&1 || status=1
      fi
      if "$operation_locked"; then
        if "$published"; then v4Unlock "$old_dir/.operation.lock" || status=1
        else v4Unlock "$operation_lock" || status=1; fi
      fi
      [ "$locked" = false ] || v4Unlock "$lock" || status=1
      [ -z "$staging" ] || runPrivileged rm -rf -- "$staging"
      exit "$status"
    ' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    v4ArchiveExtract "$archive" "$staging" && v4PackageVerify "$staging" || exit $?
    scope=$(jq -r '.scope' "$staging/manifest.json")
    [ "$scope" != database ] || { v4Error 'Use snapshot restore for a database-only archive.' 2; exit 2; }
    original=$(jq -c '.site' "$staging/manifest.json") || exit 2
    imported_hooks=$(jq -c '.hooks // {}' <<< "$original")
    metadata=$(v4RestoreTargetMetadata "$original") || exit $?
    if [ "$(v4Get trust_hooks false)" != true ]; then metadata=$(jq -c '.hooks={}' <<< "$metadata") || exit 2; fi
    v4RuntimeValidateMeta "$metadata" || exit $?
    host=$(jq -r '.host' <<< "$metadata"); key=$(jq -r '.key' <<< "$metadata")
    source_engine=$(jq -r '.database.engine' <<< "$original"); target_engine=$(jq -r '.database.engine' <<< "$metadata")
    case "$source_engine:$target_engine" in mariadb:mariadb|mariadb:mysql|mysql:mysql|mysql:mariadb|postgres:postgres) ;;
      *) v4Error 'SQL data cannot be converted automatically across database families. Use database switch --mode fresh with a new target.' 2; exit 2 ;;
    esac
    source_docroot=$(jq -r '.docroot' <<< "$original"); target_docroot=$(jq -r '.docroot' <<< "$metadata")
    case "/$source_docroot/" in *'/../'*|*'/./'*|*'//'*) exit 2 ;; esac
    [ -f "$staging/project/$source_docroot/configuration.php" ] || { v4Error 'The archive does not contain an installed Joomla configuration.' 2; exit 2; }
    target_dir="$VDM_REPO_PATH/joomla/available/$host"; target_project="$VDM_PROJECT_PATH/$key"
    lock="$VDM_REPO_PATH/joomla/.restore.lock"
    mkdir -p "$VDM_REPO_PATH/joomla" || exit 1
    v4Lock "$lock" || exit $?
    locked=true
    if [ -e "$target_dir" ] || [ -e "$target_project" ]; then
      [ "$(v4Get replace false)" = true ] || { v4Error 'The destination exists. Choose a new target or explicitly request --replace --yes.' 2; exit 2; }
      v4LoadSite "$host" || exit $?
      [ "$V4_PROJECT" = "$target_project" ] || { v4Error 'The target key does not match the existing destination.' 2; exit 2; }
      target_hooks=$(jq -c '.hooks // {}' <<< "$V4_META")
      previous_tls=$(jq -r '.tls.mode // "none"' <<< "$V4_META")
      if ! v4Has profile; then metadata=$(jq -c --arg profile "$(jq -r '.profile' <<< "$V4_META")" '.profile=$profile' <<< "$metadata") || exit 2; fi
      if ! v4Has http_port; then metadata=$(jq -c --argjson port "$(jq '.http_port // 0' <<< "$V4_META")" '.http_port=$port' <<< "$metadata") || exit 2; fi
      if ! v4Has tls_mode; then
        metadata=$(jq -c --argjson tls "$(jq -c '.tls' <<< "$V4_META")" '.tls=$tls' <<< "$metadata") || exit 2
      fi
      tls_snapshot="$staging/previous-local-tls"
      (umask 077; mkdir -p "$tls_snapshot") || exit 1
      for tls_item in "routes/${host}.json" "certs/${host}.pem" "certs/${host}-key.pem" "hosts/${host}.json"; do
        if [ -f "$VDM_SRC_PATH/local-tls/$tls_item" ]; then
          mkdir -p "$tls_snapshot/$(dirname "$tls_item")" && cp -p "$VDM_SRC_PATH/local-tls/$tls_item" "$tls_snapshot/$tls_item" || exit 1
        fi
      done
      if [ "$(v4Get trust_hooks false)" != true ]; then metadata=$(jq -c --argjson hooks "$target_hooks" '.hooks=$hooks' <<< "$metadata") || exit 2; fi
      v4RunHook pre-restore || exit $?
      backup_root=$(v4BackupRoot) || exit $?
      recovery="$backup_root/$host-before-restore-$(date -u +%Y%m%dT%H%M%SZ)-${RANDOM}.tar.gz"
      v4BackupBuild "$recovery" full 'Automatic recovery before restore' || exit $?
      operation_lock="$V4_DIR/.operation.lock"
      v4Lock "$operation_lock" || exit $?
      operation_locked=true
      old_running=$(v4Compose ps --services --status running) || exit 1
      if [ -n "$old_running" ]; then
        original_running=true
        while IFS= read -r service; do original_services+=("$service"); done <<< "$old_running"
      fi
      original_stopped=true
      v4Compose down --remove-orphans >/dev/null || exit 1
      (umask 077; mkdir -p "$VDM_REPO_PATH/joomla/recovery") || exit 1
      old_dir="$VDM_REPO_PATH/joomla/recovery/${host}-$(date -u +%Y%m%dT%H%M%SZ)-${RANDOM}"
      old_project="${target_project}.recovery-$(date -u +%Y%m%dT%H%M%SZ)-${RANDOM}"
      runPrivileged mv -- "$target_dir" "$old_dir" || exit 1
      if ! runPrivileged mv -- "$target_project" "$old_project"; then
        runPrivileged mv -- "$old_dir" "$target_dir"
        if "$original_running"; then v4Compose up -d "${original_services[@]}" >/dev/null 2>&1 || true; fi
        exit 1
      fi
      original_moved=true
    fi
    old_env=$(jq -r '.env_key' <<< "$original"); new_env=$(jq -r '.env_key' <<< "$metadata")
    environment="$staging/restore.env"
    v4RestoreEnvironment "$staging/compose/.env" "$environment" "$old_env" "$new_env" || exit $?
    v4ProvisionMetadata "$metadata" "$environment" || exit $?
    destination_created=true
    # Provisioning created only empty target paths. Copy all project companions;
    # a configured alternate docroot is renamed inside this new destination.
    runPrivileged cp -a "$staging/project/." "$target_project/" || exit 1
    if [ "$source_docroot" != "$target_docroot" ]; then
      [ ! -e "$target_project/$target_docroot/configuration.php" ] || { v4Error 'The requested document root collides with archived files.' 2; exit 2; }
      runPrivileged mkdir -p "$(dirname "$target_project/$target_docroot")" || exit 1
      # Runtime creates the docroot; remove only that still-empty directory.
      [ ! -d "$target_project/$target_docroot" ] || runPrivileged rmdir "$target_project/$target_docroot" || exit 1
      runPrivileged mv "$target_project/$source_docroot" "$target_project/$target_docroot" || exit 1
    fi
    v4RestoreCompanions "$staging/compose" || exit $?
    if [ "$(v4Get trust_hooks false)" != true ] && [ "$imported_hooks" != '{}' ]; then
      (umask 077; printf '%s\n' "$imported_hooks" > "$V4_DIR/imported-hooks.json") || exit 1
      chmod 600 "$V4_DIR/imported-hooks.json" || exit 1
    fi
    v4LoadSite "$host" || exit $?
    if ! "$original_moved"; then v4RunHook pre-restore || exit $?; fi
    v4GenerateCompose || exit $?
    v4Compose config -q >/dev/null || exit 2
    # Restored files were staged as the invoking host user for verification.
    # Joomla writes uploads/cache/config as www-data in its official runtime.
    v4Compose run --rm -T --no-deps --user root --entrypoint chown "$V4_WEB_SERVICE" -R www-data:www-data /var/www/html >/dev/null || exit 1
    v4RealignConfiguration || exit $?
    v4Compose up -d "$V4_DB_SERVICE" >/dev/null || exit 1
    v4DatabaseWait "$(v4Get timeout 120)" || exit $?
    v4DatabaseReset || exit $?
    v4DatabaseReadSql "$staging/database.sql.gz" | v4DatabaseImportSql || exit 1
    v4DatabaseProbe || exit $?
    requested_tls=$(v4Get tls_mode '')
    if [ "$requested_tls" = local ]; then
      temp_request=$(jq -c --arg site "$host" '.site=$site' <<< "$old_request")
      V4_REQUEST="$temp_request" v4TlsSetup >/dev/null || exit $?
      v4LoadSite "$host" || exit $?
    elif [ "$(jq -r '.tls.mode // "none"' <<< "$original")" = local ] && [ "$(jq -r '.tls.mode' <<< "$V4_META")" != local ]; then
      local_tls_required=true
    fi
    # Start and verify even if the caller wants the restored project left off.
    v4Compose up -d >/dev/null || exit 1
    v4WaitReady "$(v4Get timeout 120)" || exit $?
    v4DatabaseWait "$(v4Get timeout 120)" || exit $?
    v4Exec "$V4_WEB_SERVICE" php -r 'require "/var/www/html/configuration.php"; $c=new JConfig; if ($c->dbtype==="pgsql" || $c->dbtype==="postgresql") { $pdo=new PDO("pgsql:host=".$c->host.";dbname=".$c->db,$c->user,$c->password); $pdo->query("SELECT 1"); } else { mysqli_report(MYSQLI_REPORT_ERROR|MYSQLI_REPORT_STRICT); $db=new mysqli($c->host,$c->user,$c->password,$c->db); $db->query("SELECT 1"); }' >/dev/null || exit 1
    if [ "$previous_tls" = local ] && [ "$(jq -r '.tls.mode' <<< "$V4_META")" != local ]; then v4LocalRemoveSite || exit $?; fi
    published=true
    v4RunHook post-restore || hook_status=$?
    if [ "$(v4Get activate true)" = false ]; then v4Compose stop >/dev/null || exit 1; fi
    mkdir -p "$VDM_REPO_PATH/joomla/enabled" || exit 1
    if [ "$(v4Get activate true)" = true ]; then
      [ -e "$VDM_REPO_PATH/joomla/enabled/$host" ] || ln -s "$target_dir" "$VDM_REPO_PATH/joomla/enabled/$host" || exit 1
    else
      [ ! -L "$VDM_REPO_PATH/joomla/enabled/$host" ] || rm "$VDM_REPO_PATH/joomla/enabled/$host" || exit 1
    fi
    status_json=$(jq -cn --arg site "$host" --arg archive "$archive" --arg recovery "$recovery" \
      --arg old_compose "$old_dir" --arg old_project "$old_project" --argjson tls_required "$local_tls_required" \
      '{site:$site,archive:$archive,restored:true,recovery_archive:(if $recovery=="" then null else $recovery end),retained_previous_compose:(if $old_compose=="" then null else $old_compose end),retained_previous_project:(if $old_project=="" then null else $old_project end),local_tls_required:$tls_required}')
    v4Result "$status_json"
    [ "$hook_status" -eq 0 ] || { v4Error 'The site was restored and retained, but its post-restore hook failed.'; exit "$hook_status"; }
  )
}

function v4BackupRestore() {
  v4Require input || return $?
  v4RestoreArchive "$(v4Get input)"
}

function v4SiteClone() {
  (
    set +x
    local archive root source request
    v4Require site target_site target_key || exit $?
    v4Confirm || exit $?
    source=$(v4Get site)
    [ "$source" != "$(v4Get target_site)" ] || { v4Error 'A clone requires a different target site.' 2; exit 2; }
    v4LoadSite "$source" || exit $?
    root=$(v4BackupRoot) || exit $?
    archive="$root/$source-clone-$(date -u +%Y%m%dT%H%M%SZ)-${RANDOM}.tar.gz"
    v4BackupBuild "$archive" full 'Clone source' || exit $?
    request=$(jq -c '.replace=false' <<< "$V4_REQUEST")
    V4_REQUEST="$request" v4RestoreArchive "$archive"
  )
}

function v4SnapshotCreate() {
  local request
  request=$(jq -c '.scope="database" | .format="tar.gz"' <<< "$V4_REQUEST") || return 2
  V4_REQUEST="$request" v4BackupCreate
}

function v4SnapshotList() {
  local root file stage manifest result='[]'
  root=$(v4BackupRoot) || return $?
  while IFS= read -r -d '' file; do
    if v4Has site; then [[ "$(basename "$file")" == "$(v4Get site)"-* ]] || continue; fi
    v4ArchiveValidate "$file" || continue
    case "$file" in *.zip) manifest=$(unzip -p "$file" manifest.json 2>/dev/null || unzip -p "$file" ./manifest.json 2>/dev/null) ;;
      *) manifest=$(tar -xOzf "$file" ./manifest.json 2>/dev/null || tar -xOzf "$file" manifest.json 2>/dev/null) ;; esac
    jq -e '.scope=="database" and .format=="octojoom-logical"' <<< "$manifest" >/dev/null 2>&1 || continue
    result=$(jq -c --arg file "$file" --argjson metadata "$manifest" '.+[{file:$file,label:$metadata.label,created:$metadata.created,site:$metadata.site.host,engine:$metadata.site.database.engine}]' <<< "$result") || return 1
  done < <(find "$root" -maxdepth 1 -type f \( -name '*.tar.gz' -o -name '*.tgz' -o -name '*.zip' \) -print0)
  v4Result "$(jq -cn --argjson snapshots "$result" '{snapshots:($snapshots|sort_by(.created))}')"
}

# shellcheck disable=SC2030,SC2031
function v4SnapshotRestore() {
  (
    local staging='' status source_engine request
    v4Require site input || exit $?
    v4Confirm || exit $?
    v4LoadSite "$(v4Get site)" || exit $?
    staging=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/octojoom-snapshot.XXXXXX") || exit 1
    trap 'status=$?; [ -z "$staging" ] || rm -rf -- "$staging"; exit "$status"' EXIT
    v4ArchiveExtract "$(v4Get input)" "$staging" && v4PackageVerify "$staging" || exit $?
    [ "$(jq -r '.scope' "$staging/manifest.json")" = database ] || { v4Error 'Select a database snapshot archive.' 2; exit 2; }
    source_engine=$(jq -r '.site.database.engine' "$staging/manifest.json")
    case "$source_engine:$V4_DB_ENGINE" in mariadb:mariadb|mariadb:mysql|mysql:mysql|mysql:mariadb|postgres:postgres) ;; *) v4Error 'Snapshot database families are incompatible.' 2; exit 2 ;; esac
    request=$(jq -c --arg input "$staging/database.sql.gz" '.input=$input | .replace=true' <<< "$V4_REQUEST")
    V4_REQUEST="$request" v4DbImport
  )
}

function v4SnapshotDelete() {
  v4BackupDelete
}

function v4DbSwitch() {
  (
    set +x
    local mode engine version source target request original metadata result
    v4Require site database_engine database_version || exit $?
    v4Confirm || exit $?
    v4LoadSite "$(v4Get site)" || exit $?
    original="$V4_META"; source="$V4_HOST"
    mode=$(v4Get mode clone); engine=$(v4Get database_engine); version=$(v4Get database_version)
    case "$engine" in mariadb|mysql|postgres) ;; *) v4Error 'Select mariadb, mysql or postgres.' 2; exit 2 ;; esac
    case "$mode" in
      fresh)
        v4Require target_site target_key || exit $?
        [ "$(v4Get target_site)" != "$source" ] || { v4Error 'A fresh database family requires a separate new Joomla site.' 2; exit 2; }
        request=$(jq -c --argjson original "$original" '.site=.target_site | .key=.target_key | .env_key=(.target_env_key // (.target_key|ascii_upcase|gsub("-";"_"))) | .image=($original.image) | .joomla_version=$original.joomla_version | .php_version=$original.php_version | .webserver=$original.webserver | .docroot=$original.docroot | .profile=$original.profile | .tls_mode="none" | del(.target_site,.target_key,.target_env_key)' <<< "$V4_REQUEST")
        V4_REQUEST="$request" v4SiteCreate
        ;;
      clone)
        v4Require target_site target_key || exit $?
        case "$V4_DB_ENGINE:$engine" in mariadb:mariadb|mariadb:mysql|mysql:mysql|mysql:mariadb|postgres:postgres) ;;
          *) v4Error 'Cross-family SQL conversion is unsupported. Use --mode fresh for a separate initialized Joomla site.' 2; exit 2 ;;
        esac
        v4SiteClone
        ;;
      replace)
        case "$V4_DB_ENGINE:$engine" in mariadb:mariadb|mariadb:mysql|mysql:mysql|mysql:mariadb|postgres:postgres) ;; *) v4Error 'Cross-family SQL conversion is unsupported. Use --mode fresh for a separate initialized Joomla site.' 2; exit 2 ;; esac
        request=$(jq -c --arg site "$V4_HOST" --arg key "$V4_KEY" --arg env "$V4_ENV_KEY" '.target_site=$site | .target_key=$key | .target_env_key=$env | .replace=true' <<< "$V4_REQUEST")
        local root archive
        root=$(v4BackupRoot) || exit $?
        archive="$root/$source-database-switch-$(date -u +%Y%m%dT%H%M%SZ)-${RANDOM}.tar.gz"
        v4BackupBuild "$archive" full 'Before database engine/version replacement' || exit $?
        V4_REQUEST="$request" v4RestoreArchive "$archive"
        ;;
      *) v4Error 'Database switch mode must be clone, replace or fresh.' 2; exit 2 ;;
    esac
  )
}

# shellcheck disable=SC2030,SC2031
function v4SiteImport() {
  (
    set +x
    local input sql stage='' status request target created=false published=false directory='' project='' target_tls hook_status=0
    v4Require input database_input target_site target_key || exit $?
    v4Confirm || exit $?
    input=$(v4Get input); sql=$(v4Get database_input)
    if ! { [ -f "$sql" ] && [ ! -L "$sql" ]; }; then v4Error 'A regular SQL dump is required.' 2; exit 2; fi
    case "$sql" in *.sql|*.mysql) ;; *.sql.gz|*.mysql.gz) gzip -t "$sql" || exit 2 ;; *) v4Error 'The database input must be SQL or SQL.gz.' 2; exit 2 ;; esac
    stage=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/octojoom-import.XXXXXX") || exit 1
    trap 'status=$?; if "$created" && ! "$published"; then v4LocalRemoveSite >/dev/null 2>&1 || status=1; v4Compose down --remove-orphans >/dev/null 2>&1 || status=1; runPrivileged rm -rf -- "$directory" "$project" || status=1; fi; [ -z "$stage" ] || runPrivileged rm -rf -- "$stage"; exit "$status"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    mkdir "$stage/files" || exit 1
    if [ -d "$input" ]; then
      migrationValidateTree "$input" || { v4Error 'Website import requires regular files and directories.' 2; exit 2; }
      runPrivileged cp -a "$input/." "$stage/files/" || exit 1
    else v4ArchiveExtract "$input" "$stage/files" || exit $?; fi
    [ -f "$stage/files/configuration.php" ] || { v4Error 'Select the Joomla website root containing configuration.php.' 2; exit 2; }
    # Create the selected runtime using the standard request validation. It is
    # deliberately left stopped until the existing files/database are present.
    target_tls=$(v4Get tls_mode none)
    request=$(jq -c '.site=.target_site | .key=.target_key | .env_key=(.target_env_key // (.target_key|ascii_upcase|gsub("-";"_"))) | .activate=false | .install=false | (if .tls_mode=="local" then .tls_mode="none" else . end) | del(.target_site,.target_key,.target_env_key)' <<< "$V4_REQUEST")
    V4_RESULT_FILE='' V4_REQUEST="$request" v4SiteCreate >/dev/null || exit $?
    target=$(jq -r '.site' <<< "$request")
    v4LoadSite "$target" || exit $?
    created=true; directory="$V4_DIR"; project="$V4_PROJECT"
    v4RunHook pre-import || exit $?
    # The source is copied before any runtime is started; Joomla therefore sees
    # its existing configuration and does not run a fresh installation.
    runPrivileged cp -a "$stage/files/." "$V4_DOCROOT/" || exit 1
    v4Compose run --rm -T --no-deps --user root --entrypoint chown "$V4_WEB_SERVICE" -R www-data:www-data /var/www/html >/dev/null || exit 1
    v4RealignConfiguration || exit $?
    v4Compose up -d "$V4_DB_SERVICE" >/dev/null || exit 1
    v4DatabaseWait "$(v4Get timeout 120)" || exit $?
    if ! (set -o pipefail; v4DatabaseReadSql "$sql" | v4DatabaseImportSql); then
      v4Error "Import failed. The new destination $target will be removed; the source is unchanged."
      exit 1
    fi
    v4DatabaseProbe || exit $?
    if [ "$target_tls" = local ]; then
      V4_RESULT_FILE='' V4_REQUEST="$(jq -c --arg site "$target" '.site=$site' <<< "$V4_REQUEST")" v4TlsSetup >/dev/null || exit $?
      v4LoadSite "$target" || exit $?
    fi
    v4Compose up -d >/dev/null || exit 1
    v4WaitReady "$(v4Get timeout 120)" || exit $?
    published=true
    v4RunHook post-import || hook_status=$?
    if [ "$(v4Get activate true)" = false ]; then v4Compose stop >/dev/null || exit 1
    else mkdir -p "$VDM_REPO_PATH/joomla/enabled" && ln -s "$V4_DIR" "$VDM_REPO_PATH/joomla/enabled/$target" || exit 1; fi
    v4Result "$(jq -cn --arg site "$target" '{site:$site,imported:true,source_preserved:true}')"
    [ "$hook_status" -eq 0 ] || { v4Error 'The site was imported and retained, but its post-import hook failed.'; exit "$hook_status"; }
  )
}

function v4RemoteCommand() {
  local remote="$1" argument command='octojoom'
  shift
  [[ "$remote" =~ ^[A-Za-z0-9_.@:-]+$ && "$remote" != -* ]] || { v4Error 'Invalid SSH destination.' 2; return 2; }
  for argument in "$@"; do command+=" $(quoteRemoteArgument "$argument")"; done
  ssh -o BatchMode=yes -- "$remote" "$command"
}

function v4SiteMigrate() {
  (
    set +x
    local direction remote site root archive remote_json remote_archive digest actual target key result remote_dir command value
    local -a restore_args=() create_args=()
    v4Require site remote target_site target_key || exit $?
    v4Confirm || exit $?
    direction=$(v4Get direction push); remote=$(v4Get remote); site=$(v4Get site)
    target=$(v4Get target_site); key=$(v4Get target_key)
    [[ "$remote" =~ ^[A-Za-z0-9_.@:-]+$ && "$remote" != -* ]] || { v4Error 'Invalid SSH destination.' 2; exit 2; }
    if ! command -v ssh >/dev/null 2>&1 || ! command -v rsync >/dev/null 2>&1; then v4Error 'SSH and rsync are required for single-archive migration.' 2; exit 2; fi
    root=$(v4BackupRoot) || exit $?
    archive="$root/$site-migrate-$(date -u +%Y%m%dT%H%M%SZ)-${RANDOM}.tar.gz"
    restore_args=(backup restore --target-site "$target" --target-key "$key" --json --yes --no-interaction)
    for value in target_env_key profile tls_mode database_engine database_version docroot activate trust_hooks http_port https_port install_trust; do
      if v4Has "$value"; then restore_args+=("--${value//_/-}" "$(v4Get "$value")"); fi
    done
    if v4Has destination_repo; then restore_args+=(--repo-path "$(v4Get destination_repo)"); fi
    if v4Has destination_projects; then restore_args+=(--project-path "$(v4Get destination_projects)"); fi
    case "$direction" in
      push)
        v4LoadSite "$site" || exit $?
        v4BackupBuild "$archive" full 'Migration source' || exit $?
        digest=$(v4Digest "$archive") || exit 1
        remote_dir=$(ssh -o BatchMode=yes -- "$remote" 'umask 077; mktemp -d "${TMPDIR:-/tmp}/octojoom-transfer.XXXXXX"') || exit 1
        [[ "$remote_dir" == /* && "$remote_dir" != *$'\n'* && "$remote_dir" != *$'\r'* ]] || exit 2
        remote_archive="$remote_dir/project.tar.gz"
        if ! rsync --protect-args -e 'ssh -o BatchMode=yes' -- "$archive" "$remote:$remote_archive"; then
          v4Error "Archive transfer failed. Local recovery archive: $archive"
          exit 1
        fi
        command="if command -v sha256sum >/dev/null 2>&1; then sha256sum -- $(quoteRemoteArgument "$remote_archive"); else shasum -a 256 -- $(quoteRemoteArgument "$remote_archive"); fi"
        actual=$(ssh -o BatchMode=yes -- "$remote" "$command") || exit 1
        actual="${actual%% *}"
        [ "$digest" = "$actual" ] || { v4Error 'The received archive checksum differs; destination import was not started.'; exit 1; }
        result=$(v4RemoteCommand "$remote" "${restore_args[@]}" --input "$remote_archive") || {
          v4Error "Destination import failed. Recovery archives: $archive and $remote:$remote_archive"
          exit 1
        }
        jq -e '.ok==true' <<< "$result" >/dev/null || { v4Error 'The destination did not report a successful import.'; exit 1; }
        v4Result "$(jq -cn --arg remote "$remote" --arg file "$archive" --arg remote_file "$remote_archive" --argjson destination "$result" '{direction:"push",remote:$remote,archive:$file,remote_archive:$remote_file,destination:$destination.data,source_preserved:true}')"
        ;;
      pull)
        create_args=(backup create --site "$site" --scope full --format tar.gz --json --no-interaction)
        if v4Has source_repo; then create_args+=(--repo-path "$(v4Get source_repo)"); fi
        if v4Has source_projects; then create_args+=(--project-path "$(v4Get source_projects)"); fi
        remote_json=$(v4RemoteCommand "$remote" "${create_args[@]}") || exit $?
        jq -e '.ok==true and (.data.file|type)=="string" and (.data.sha256|test("^[a-f0-9]{64}$"))' <<< "$remote_json" >/dev/null || { v4Error 'The remote exporter did not return a valid archive.'; exit 1; }
        remote_archive=$(jq -r '.data.file' <<< "$remote_json"); digest=$(jq -r '.data.sha256' <<< "$remote_json")
        [[ "$remote_archive" == /* && "$remote_archive" != *$'\n'* && "$remote_archive" != *$'\r'* ]] || exit 2
        (umask 077; rsync --protect-args -e 'ssh -o BatchMode=yes' -- "$remote:$remote_archive" "$archive") || exit 1
        [ "$(v4Digest "$archive")" = "$digest" ] || { v4Error 'The downloaded archive checksum differs.'; exit 1; }
        v4RestoreArchive "$archive"
        ;;
      *) v4Error 'Migration direction must be push or pull.' 2; exit 2 ;;
    esac
  )
}

function v4BackupCleanup() {
  local root keep site file result='[]' dry_run manifest records='[]' files
  v4Require site keep || return $?
  site=$(v4Get site); keep=$(v4Get keep); dry_run=$(v4Get dry_run true)
  if ! { isValidDomain "$site" && [[ "$keep" =~ ^[0-9]+$ ]] && [ "$keep" -ge 1 ]; }; then v4Error 'Retention requires a valid site and keep of at least one backup.' 2; return 2; fi
  [ "$dry_run" = true ] || v4Confirm || return $?
  root=$(v4BackupRoot) || return $?
  while IFS= read -r -d '' file; do
    [[ "$file" != *[![:print:]]* ]] || continue
    v4ArchiveValidate "$file" || continue
    case "$file" in *.zip) manifest=$(unzip -p "$file" manifest.json 2>/dev/null || unzip -p "$file" ./manifest.json 2>/dev/null) ;;
      *) manifest=$(tar -xOzf "$file" ./manifest.json 2>/dev/null || tar -xOzf "$file" manifest.json 2>/dev/null) ;; esac
    jq -e --arg site "$site" '.format=="octojoom-logical" and .site.host==$site and (.created|test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))' <<< "$manifest" >/dev/null 2>&1 || continue
    records=$(jq -c --arg file "$file" --argjson manifest "$manifest" '.+[{file:$file,created:$manifest.created}]' <<< "$records") || return 1
  done < <(find "$root" -maxdepth 1 -type f -name "$site-*" \( -name '*.tar.gz' -o -name '*.tgz' -o -name '*.zip' \) -print0)
  files=$(jq -r --argjson keep "$keep" 'sort_by(.created,.file)|reverse|.[$keep:]|.[].file' <<< "$records") || return 1
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    if [ "$dry_run" != true ]; then rm -- "$file" || return 1; fi
    result=$(jq -c --arg file "$file" '.+[$file]' <<< "$result") || return 1
  done <<< "$files"
  v4Result "$(jq -cn --arg site "$site" --argjson dry_run "$dry_run" --argjson files "$result" '{site:$site,dry_run:$dry_run,files:$files}')"
}

function v4DatabaseBatchSites() {
  local site
  if v4Has sites; then
    jq -e '.sites|type=="array" and length>0 and all(.[];type=="string")' <<< "$V4_REQUEST" >/dev/null || return 2
    while IFS= read -r site; do
      isValidDomain "$site" || { v4Error 'A batch contains an invalid site hostname.' 2; return 2; }
      printf '%s\n' "$site"
    done < <(jq -r '.sites|unique[]' <<< "$V4_REQUEST")
  else
    [ -d "$VDM_REPO_PATH/joomla/available" ] || return 0
    find "$VDM_REPO_PATH/joomla/available" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | LC_ALL=C sort
  fi
}

#####################################################################################################################VDM
# OCTOJOOM V4: network
# Local development networking. Host trust and certificates never enter project archives.

function v4NetworkDockerScalar() {
  local value
  value=$(v4Docker "$@") || return $?
  printf '%s\n' "${value%$'\r'}"
}

function v4NetworkCompose() {
  local compose="$1" key host frontend tls mail redis node mail_port node_image host_docroot
  key=$(jq -r '.key' <<<"$V4_META")
  host=$(jq -r '.host' <<<"$V4_META")
  frontend="joomla${key}"
  [ "$(jq -r '.webserver' <<<"$V4_META")" != nginx ] || frontend="nginx${key}"
  tls=$(jq -r '.tls.mode // "none"' <<<"$V4_META")
  mail=$(jq -r '.services.mail // false' <<<"$V4_META")
  redis=$(jq -r '.services.redis // false' <<<"$V4_META")
  node=$(jq -r '.services.node // false' <<<"$V4_META")
  mail_port=$(jq -r '.services.mail_port // 0' <<<"$V4_META")
  node_image=$(jq -r '.services.node_image // "node:22-bookworm-slim"' <<<"$V4_META")
  host_docroot=$(v4DockerHostPath "$V4_DOCROOT") || return $?
  if ! { [[ "$mail_port" =~ ^[0-9]+$ ]] && [ "$mail_port" -le 65535 ]; }; then v4Error 'Invalid mail UI port.' 2; return 2; fi
  [[ "$node_image" =~ ^[A-Za-z0-9][A-Za-z0-9._:/@-]+$ ]] || { v4Error 'Invalid Node image.' 2; return 2; }
  jq --arg key "$key" --arg host "$host" --arg frontend "$frontend" --arg tls "$tls" \
    --argjson mail "$mail" --argjson redis "$redis" --argjson node "$node" \
    --arg port "$mail_port" --arg image "$node_image" --arg root "$host_docroot" '
    def network_object: if type=="array" then map({key:.,value:{}})|from_entries elif type=="object" then . else {default:{}} end;
    if $tls=="local" then
      .networks.octojoom_local={external:true,name:"octojoom_local"} |
      .services[$frontend].networks=((.services[$frontend].networks|network_object)+{octojoom_local:{}})
    else . end |
    if $mail then .services["mailpit"+$key]={
      image:"axllent/mailpit:v1.31.5",container_name:("mailpit"+$key),restart:"unless-stopped",
      labels:{"io.octojoom.site":$host,"traefik.enable":"false"},
      ports:[("127.0.0.1:"+$port+":8025")],networks:{default:{}},
      environment:{MP_MAX_MESSAGES:"1000",MP_DISABLE_VERSION_CHECK:"true"},
      healthcheck:{test:["CMD","/mailpit","readyz"],interval:"5s",timeout:"3s",retries:12}
    } else . end |
    if $redis then .services["redis"+$key]={
      image:"redis:7.4-alpine",container_name:("redis"+$key),restart:"unless-stopped",
      labels:{"io.octojoom.site":$host,"traefik.enable":"false"},networks:{default:{}},
      command:["redis-server","--save","","--appendonly","no"],
      healthcheck:{test:["CMD","redis-cli","ping"],interval:"5s",timeout:"3s",retries:12}
    } else . end |
    if $node then .services["node"+$key]={
      image:$image,profiles:["tools"],working_dir:"/var/www/html",init:true,
      labels:{"io.octojoom.site":$host,"traefik.enable":"false"},
      volumes:[{type:"bind",source:$root,target:"/var/www/html"}],networks:{default:{}}
    } else . end' <<<"$compose"
}

function v4NetworkPrivilege() {
  if [ "$(id -u)" -eq 0 ]; then "$@"; return $?; fi
  command -v sudo >/dev/null 2>&1 || { v4Error 'Run this action from an elevated terminal; sudo is unavailable.' 3; return 3; }
  sudo -n "$@" || { v4Error 'Administrative access is required. Authorize sudo in your terminal, then repeat this command.' 3; return 3; }
}

function v4HostsFile() {
  local file record="$VDM_SRC_PATH/local-tls/hosts/${V4_HOST}.json"
  file=$(v4Get hosts_file '')
  if [ -n "$file" ]; then printf '%s\n' "$file"; return 0; fi
  if [ -f "$record" ] && [ ! -L "$record" ]; then jq -er '.file | select(type=="string" and startswith("/"))' "$record"; return $?; fi
  case "${OSTYPE:-}" in
    msys*|cygwin*)
      if command -v cygpath >/dev/null 2>&1; then cygpath -u "${SYSTEMROOT:-${SystemRoot:-C:\\Windows}}/System32/drivers/etc/hosts";
      else printf '%s\n' '/c/Windows/System32/drivers/etc/hosts'; fi ;;
    *) printf '%s\n' '/etc/hosts' ;;
  esac
}

# Only the marked entry belonging to this site is changed. Existing user entries remain.
function v4HostsEntry() {
  local action="$1" host="$2" file marker tmp existing
  file=$(v4HostsFile) || return $?
  isValidDomain "$host" || { v4Error 'Invalid local hostname.' 2; return 2; }
  if ! { [ -f "$file" ] && [ ! -L "$file" ]; }; then v4Error 'The hosts file must be a regular, non-symlink file.' 3; return 3; fi
  marker="# octojoom-v4:${host}"
  tmp=$(mktemp "${TMPDIR:-/tmp}/octojoom-hosts.XXXXXX") || return 1
  if ! awk -v marker="$marker" '{line=$0; sub(/\r$/,"",line); if(substr(line,length(line)-length(marker)+1)!=marker) print $0}' "$file" >"$tmp"; then rm -f "$tmp"; return 1; fi
  if [ "$action" = add ]; then
    existing=$(awk -v host="$host" '{sub(/\r$/,""); sub(/#.*/,""); for(i=2;i<=NF;i++) if(tolower($i)==tolower(host)) print $1}' "$tmp")
    if [ -n "$existing" ]; then
      if printf '%s\n' "$existing" | grep -qvxE '127\.0\.0\.1|::1'; then
        rm -f "$tmp"; v4Error 'This hostname already resolves elsewhere in the hosts file. Choose a development hostname or edit that entry.' 3; return 3
      fi
    fi
    if ! printf '%s\n' "$existing" | grep -qx '127\.0\.0\.1'; then
      printf '127.0.0.1\t%s\t%s\n' "$host" "$marker" >>"$tmp"
    fi
  elif [ "$action" != remove ]; then rm -f "$tmp"; return 2; fi
  if cmp -s "$file" "$tmp"; then rm -f "$tmp"; return 0; fi
  if [ -w "$file" ]; then
    cat "$tmp" >"$file" || { rm -f "$tmp"; return 1; }
  else
    v4NetworkPrivilege tee "$file" <"$tmp" >/dev/null || { rm -f "$tmp"; return 3; }
  fi
  rm -f "$tmp"
}

function v4LocalProxyEnsure() {
  local root="$1" http="$2" https="$3" file previous owner scope mounts host_root host_file
  file="$root/proxy.json"
  host_root=$(v4DockerHostPath "$root") || return $?
  host_file=$(v4DockerHostPath "$file") || return $?
  mkdir -p "$root/routes" "$root/certs" || return 1
  chmod 700 "$root" "$root/routes" "$root/certs" || return 1
  if [ -f "$file" ]; then
    previous=$(jq -r '[.services.proxy.ports[]]|join(" ")' "$file") || return 1
    [ "$previous" = "127.0.0.1:${http}:80 127.0.0.1:${https}:443" ] || {
      v4Error 'The shared local proxy already uses different ports. Use its existing ports for all local sites.' 3; return 3;
    }
  fi
  if v4Docker inspect octojoom-local-proxy >/dev/null 2>&1; then
    owner=$(v4NetworkDockerScalar inspect --format '{{index .Config.Labels "io.octojoom.local-proxy"}}' octojoom-local-proxy) || return 1
    [ "$owner" = v4 ] || { v4Error 'An unrelated container owns the local-proxy name.' 3; return 3; }
    scope=$(v4NetworkDockerScalar inspect --format '{{index .Config.Labels "io.octojoom.local-root"}}' octojoom-local-proxy) || return 1
    if [ "$scope" != "$root" ]; then
      mounts=$(v4NetworkDockerScalar inspect --format '{{json .Mounts}}' octojoom-local-proxy) || return 1
      jq -e --arg source "$host_root/routes" 'any(.[]; .Destination=="/routes" and .Source==$source)' <<<"$mounts" >/dev/null || {
        v4Error 'The local proxy belongs to another OctoJoom configuration directory. Use that directory instead.' 3; return 3;
      }
    fi
  fi
  if ! v4Docker network inspect octojoom_local >/dev/null 2>&1; then
    v4Docker network create --label io.octojoom.local-network=v4 octojoom_local >/dev/null || return 1
  else
    owner=$(v4NetworkDockerScalar network inspect --format '{{index .Labels "io.octojoom.local-network"}}' octojoom_local) || return 1
    [ "$owner" = v4 ] || { v4Error 'An unrelated Docker network owns the local TLS network name.' 3; return 3; }
  fi
  jq -n --arg root "$root" --arg host_root "$host_root" --arg http "$http" --arg https "$https" '{
    name:"octojoom-local",services:{proxy:{image:"traefik:v3.6",container_name:"octojoom-local-proxy",
      restart:"unless-stopped",labels:{"io.octojoom.local-proxy":"v4","io.octojoom.local-root":$root},
      command:["--entrypoints.web.address=:80","--entrypoints.websecure.address=:443","--providers.file.directory=/routes","--providers.file.watch=true","--log.level=WARN"],
      ports:[("127.0.0.1:"+$http+":80"),("127.0.0.1:"+$https+":443")],
      volumes:[{type:"bind",source:($host_root+"/routes"),target:"/routes",read_only:true},{type:"bind",source:($host_root+"/certs"),target:"/certs",read_only:true}],
      networks:{local:{}}
    }},networks:{local:{external:true,name:"octojoom_local"}}}' >"$file.tmp" || return 1
  chmod 600 "$file.tmp" && mv -f "$file.tmp" "$file" || return 1
  v4Docker compose -f "$host_file" config -q >/dev/null && v4Docker compose -f "$host_file" up -d >&2
}

# Stop only this installation's proxy when its final route has been removed.
function v4LocalProxyStopIfIdle() {
  local root="$1" owner scope mounts route host_root
  for route in "$root"/routes/*.json; do [ ! -e "$route" ] || return 0; done
  if ! v4Docker inspect octojoom-local-proxy >/dev/null 2>&1; then return 0; fi
  owner=$(v4NetworkDockerScalar inspect --format '{{index .Config.Labels "io.octojoom.local-proxy"}}' octojoom-local-proxy) || return 1
  [ "$owner" = v4 ] || { v4Error 'Refusing to stop an unrelated local-proxy container.' 3; return 3; }
  scope=$(v4NetworkDockerScalar inspect --format '{{index .Config.Labels "io.octojoom.local-root"}}' octojoom-local-proxy) || return 1
  if [ "$scope" != "$root" ]; then
    host_root=$(v4DockerHostPath "$root") || return $?
    mounts=$(v4NetworkDockerScalar inspect --format '{{json .Mounts}}' octojoom-local-proxy) || return 1
    jq -e --arg source "$host_root/routes" 'any(.[]; .Destination=="/routes" and .Source==$source)' <<<"$mounts" >/dev/null || {
      v4Error 'Refusing to stop a local proxy owned by another configuration directory.' 3; return 3;
    }
  fi
  v4Docker stop octojoom-local-proxy >/dev/null
}

function v4LocalRoute() {
  local root="$1" key="$2" host="$3" frontend="$4" port="${5:-443}"
  jq -n --arg key "$key" --arg host "$host" --arg target "http://${frontend}:80" --arg port "$port" '{
    tls:{certificates:[{certFile:("/certs/"+$host+".pem"),keyFile:("/certs/"+$host+"-key.pem")}]},
    http:{routers:{
      ("octojoom-"+$key):{rule:("Host(`"+$host+"`)") ,entryPoints:["websecure"],service:("octojoom-"+$key),tls:{}},
      ("octojoom-"+$key+"-http"):{rule:("Host(`"+$host+"`)"),entryPoints:["web"],service:("octojoom-"+$key),middlewares:[("octojoom-"+$key+"-https")]}
    },services:{("octojoom-"+$key):{loadBalancer:{servers:[{url:$target}]}}},middlewares:{("octojoom-"+$key+"-https"):{redirectScheme:{scheme:"https",port:$port,permanent:false}}}}
  }' >"$root/routes/${host}.json.tmp" || return 1
  chmod 600 "$root/routes/${host}.json.tmp" && mv -f "$root/routes/${host}.json.tmp" "$root/routes/${host}.json"
}

function v4NetworkSyncRoute() {
  local root="$VDM_SRC_PATH/local-tls" frontend="joomla${V4_KEY}" port
  [ "$(jq -r '.tls.mode' <<<"$V4_META")" = local ] || return 0
  [ -f "$root/routes/${V4_HOST}.json" ] || return 0
  [ "$(jq -r '.webserver' <<<"$V4_META")" != nginx ] || frontend="nginx${V4_KEY}"
  port=$(jq -r '.tls.https_port // 443' <<<"$V4_META") || return 1
  v4LocalRoute "$root" "$V4_KEY" "$V4_HOST" "$frontend" "$port"
}

function v4ShareRunning() {
  local name="octojoom-share-${V4_KEY,,}" owner running
  v4Docker inspect "$name" >/dev/null 2>&1 || return 1
  owner=$(v4NetworkDockerScalar inspect --format '{{index .Config.Labels "io.octojoom.share.site"}}' "$name") || return 1
  [ "$owner" = "$V4_HOST" ] || return 1
  running=$(v4NetworkDockerScalar inspect --format '{{.State.Running}}' "$name") || return 1
  [ "$running" = true ]
}

function v4TlsSetup() {
  (
  local host root http https install_trust update_hosts old_meta metadata frontend caroot hosts_file
  local recovery='' applied=false hosts_added=false proxy_prepared=false status=0 item
  v4Require site || return $?
  v4Confirm || return $?
  host=$(v4Get site)
  v4LoadSite "$host" || return $?
  [ "$(jq -r '.profile // "server"' <<<"$V4_META")" = local ] || { v4Error 'Local certificates require a local-development site profile.' 2; return 2; }
  command -v mkcert >/dev/null 2>&1 || { v4Error 'Install mkcert first (macOS: brew install mkcert nss; Windows: choco install mkcert; Linux: mkcert plus your distribution NSS tools), then repeat TLS setup.' 3; return 3; }
  http=$(v4Get http_port "$(jq -r '.tls.http_port // 80' <<<"$V4_META")")
  https=$(v4Get https_port "$(jq -r '.tls.https_port // 443' <<<"$V4_META")")
  if ! { [[ "$http" =~ ^[0-9]+$ && "$https" =~ ^[0-9]+$ ]] && [ "$http" -ge 1 ] && [ "$http" -le 65535 ] && [ "$https" -ge 1 ] && [ "$https" -le 65535 ] && [ "$http" != "$https" ]; }; then v4Error 'TLS ports must be distinct integers from 1 through 65535.' 2; return 2; fi
  install_trust=$(v4Get install_trust true)
  case "$install_trust" in true|false) ;; *) v4Error 'install_trust must be boolean.' 2; return 2;; esac
  update_hosts=$(v4Get update_hosts true)
  case "$update_hosts" in true|false) ;; *) v4Error 'update_hosts must be boolean.' 2; return 2;; esac
  # mkcert invokes administrative tools itself. Check elevation before it can prompt.
  if [ "$install_trust" = true ]; then
    case "${OSTYPE:-}" in
      msys*|cygwin*) powershell.exe -NoProfile -NonInteractive -Command 'if (([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { exit 0 } else { exit 1 }' >/dev/null 2>&1 || { v4Error 'Install local certificate trust from an Administrator terminal, or use --install-trust=false after trust is already installed.' 3; return 3; } ;;
      *) [ "$(id -u)" -eq 0 ] || sudo -n true 2>/dev/null || { v4Error 'Authorize sudo in your terminal before installing certificate trust; this command does not prompt.' 3; return 3; } ;;
    esac
    mkcert -install </dev/null >&2 || return 1
  fi
  caroot=$(mkcert -CAROOT) || return 1
  caroot=${caroot%$'\r'}
  case "${OSTYPE:-}" in msys*|cygwin*) caroot=$(cygpath -au -- "$caroot") || return 1;; esac
  [ -f "$caroot/rootCA.pem" ] || { v4Error 'mkcert has no local CA. Run TLS setup with trust installation enabled.' 3; return 3; }
  root="$VDM_SRC_PATH/local-tls"
  mkdir -p "$root/routes" "$root/certs" "$root/hosts" || return 1
  chmod 700 "$root" "$root/routes" "$root/certs" "$root/hosts" || return 1
  v4Lock "$root/.lock" || return $?
  recovery=$(mktemp -d "$root/.recovery.XXXXXX") || { v4Unlock "$root/.lock"; return 1; }
  old_meta="$V4_META"
  for item in "routes/${host}.json" "certs/${host}.pem" "certs/${host}-key.pem" "hosts/${host}.json"; do
    if [ -f "$root/$item" ]; then
      if ! mkdir -p "$recovery/$(dirname "$item")" || ! cp -p "$root/$item" "$recovery/$item"; then
        rm -rf "$recovery"; v4Unlock "$root/.lock"; return 1;
      fi
    fi
  done
  trap '
    status=$?
    trap - EXIT
    if [ "$status" -ne 0 ]; then
      for item in "routes/${host}.json" "certs/${host}.pem" "certs/${host}-key.pem" "hosts/${host}.json"; do
        if [ -f "$recovery/$item" ]; then cp -p "$recovery/$item" "$root/$item" || status=1; else rm -f "$root/$item" || status=1; fi
      done
      if [ "$hosts_added" = true ]; then v4HostsEntry remove "$host" || status=1; fi
      if [ "$applied" = true ]; then v4ApplyConfig "$old_meta" >&2 || { v4Error "TLS setup rollback failed; inspect the site configuration before continuing."; status=1; }; fi
      if [ "$proxy_prepared" = true ]; then v4LocalProxyStopIfIdle "$root" >&2 || status=1; fi
    fi
    rm -f "$root/certs/${host}.pem.tmp" "$root/certs/${host}-key.pem.tmp" "$root/routes/${host}.json.tmp"
    rm -rf "$recovery"
    v4Unlock "$root/.lock" || status=1
    exit "$status"
  ' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
  mkcert -cert-file "$root/certs/${host}.pem.tmp" -key-file "$root/certs/${host}-key.pem.tmp" "$host" </dev/null >&2 || return 1
  chmod 600 "$root/certs/${host}.pem.tmp" "$root/certs/${host}-key.pem.tmp" || return 1
  mv -f "$root/certs/${host}.pem.tmp" "$root/certs/${host}.pem" && mv -f "$root/certs/${host}-key.pem.tmp" "$root/certs/${host}-key.pem" || return 1
  v4LocalProxyEnsure "$root" "$http" "$https" || return $?
  proxy_prepared=true
  metadata=$(jq --argjson http "$http" --argjson https "$https" --argjson hosts "$update_hosts" '.tls.mode="local" | .tls.http_port=$http | .tls.https_port=$https | .tls.update_hosts=$hosts' <<<"$V4_META") || return 1
  v4ApplyConfig "$metadata" >&2 || return $?
  applied=true
  if [ -f "$V4_DOCROOT/configuration.php" ]; then v4RealignConfiguration || return $?; fi
  frontend="joomla${V4_KEY}"
  [ "$(jq -r '.webserver' <<<"$metadata")" != nginx ] || frontend="nginx${V4_KEY}"
  if [ "$update_hosts" = true ]; then
    hosts_file=$(v4HostsFile) || return $?
    if ! hostFileHasHost "$host" "$hosts_file"; then hosts_added=true; fi
    v4HostsEntry add "$host" || return $?
    jq -n --arg file "$hosts_file" '{file:$file}' >"$root/hosts/${host}.json" && chmod 600 "$root/hosts/${host}.json" || return 1
  fi
  v4LocalRoute "$root" "$V4_KEY" "$host" "$frontend" "$https" || return $?
  v4Result "$(jq -n --arg host "$host" --arg port "$https" --argjson trusted "$install_trust" '{site:$host,url:("https://"+$host+(if $port=="443" then "" else ":"+$port end)),trust_installed:$trusted,certificate_scope:"this workstation"}')"
  )
}

function v4LocalRemoveSite() {
  (
  local root="$VDM_SRC_PATH/local-tls" status=0
  if [ ! -f "$root/routes/${V4_HOST}.json" ] && [ ! -f "$root/hosts/${V4_HOST}.json" ] && [ "$(jq -r '.tls.mode' <<<"$V4_META")" != local ]; then return 0; fi
  v4Lock "$root/.lock" || return $?
  trap 'status=$?; trap - EXIT; v4Unlock "$root/.lock" || status=1; exit "$status"' EXIT
  if [ -f "$root/hosts/${V4_HOST}.json" ] || [ "$(jq -r '.tls.update_hosts != false' <<<"$V4_META")" = true ]; then
    v4HostsEntry remove "$V4_HOST" || return $?
  fi
  rm -f -- "$root/routes/${V4_HOST}.json" "$root/certs/${V4_HOST}.pem" "$root/certs/${V4_HOST}-key.pem" "$root/hosts/${V4_HOST}.json" || return 1
  v4LocalProxyStopIfIdle "$root"
  )
}

function v4TlsDisable() {
  (
  local old_meta metadata root="$VDM_SRC_PATH/local-tls" status=0
  v4Require site || return $?
  v4Confirm || return $?
  v4LoadSite "$(v4Get site)" || return $?
  [ "$(jq -r '.tls.mode // "none"' <<<"$V4_META")" = local ] || { v4Error 'This site does not use local TLS.' 2; return 2; }
  v4Lock "$root/.lock" || return $?
  trap 'status=$?; trap - EXIT; v4Unlock "$root/.lock" || status=1; exit "$status"' EXIT
  old_meta="$V4_META"
  metadata=$(jq '.tls.mode="none"' <<<"$V4_META") || return 1
  v4ApplyConfig "$metadata" >&2 || return $?
  if [ -f "$V4_DOCROOT/configuration.php" ] && ! v4RealignConfiguration; then
    v4ApplyConfig "$old_meta" >&2 || v4Error 'TLS configuration rollback failed.'
    return 1
  fi
  # Keep the local hostname for plain HTTP. Only the HTTPS route and leaf keys go away.
  if ! rm -f -- "$VDM_SRC_PATH/local-tls/routes/${V4_HOST}.json" "$VDM_SRC_PATH/local-tls/certs/${V4_HOST}.pem" "$VDM_SRC_PATH/local-tls/certs/${V4_HOST}-key.pem"; then
    v4ApplyConfig "$old_meta" >&2 || true
    return 1
  fi
  v4LocalProxyStopIfIdle "$VDM_SRC_PATH/local-tls" || return $?
  v4Result '{"local_tls":false,"host_trust_retained":true}'
  )
}

function v4ShareRemove() {
  local name="octojoom-share-${V4_KEY,,}" owner
  if v4Docker inspect "$name" >/dev/null 2>&1; then
    owner=$(v4NetworkDockerScalar inspect --format '{{index .Config.Labels "io.octojoom.share.site"}}' "$name") || return 1
    [ "$owner" = "$V4_HOST" ] || { v4Error 'Refusing to remove a sharing container owned by another site.' 3; return 3; }
    v4Docker rm -f "$name" >/dev/null || return 1
  fi
  rm -f -- "$V4_DIR/.share.json"
}

function v4ShareStart() {
  local image timeout service id networks network name owner url started state
  v4Require site || return $?
  v4Confirm || return $?
  v4LoadSite "$(v4Get site)" || return $?
  [ "$(jq -r '.profile // "server"' <<<"$V4_META")" = local ] || { v4Error 'Temporary sharing is restricted to local-development sites.' 2; return 2; }
  image=$(v4Get provider_image cloudflare/cloudflared:2026.10.0)
  [[ "$image" =~ ^[A-Za-z0-9][A-Za-z0-9._:/@-]+$ ]] || { v4Error 'Invalid tunnel-provider image.' 2; return 2; }
  timeout=$(v4Get timeout 30)
  if ! { [[ "$timeout" =~ ^[0-9]+$ ]] && [ "$timeout" -ge 1 ] && [ "$timeout" -le 120 ]; }; then v4Error 'Sharing timeout must be between 1 and 120 seconds.' 2; return 2; fi
  service="joomla${V4_KEY}"
  [ "$(jq -r '.webserver' <<<"$V4_META")" != nginx ] || service="nginx${V4_KEY}"
  id=$(v4Compose ps -q "$service") || return 1
  id=${id%$'\r'}
  [ -n "$id" ] || { v4Error 'Start this site before sharing it.' 3; return 3; }
  if [ -f "$V4_DOCROOT/configuration.php" ]; then v4RealignConfiguration || return $?; fi
  networks=$(v4NetworkDockerScalar inspect --format '{{json .NetworkSettings.Networks}}' "$id") || return 1
  network=$(jq -er 'keys | (map(select(endswith("_default"))) + map(select(.!="octojoom_local"))) | .[0]' <<<"$networks") || { v4Error 'The site has no available private Docker network.' 3; return 3; }
  name="octojoom-share-${V4_KEY,,}"
  if v4Docker inspect "$name" >/dev/null 2>&1; then
    owner=$(v4NetworkDockerScalar inspect --format '{{index .Config.Labels "io.octojoom.share.site"}}' "$name") || return 1
    [ "$owner" = "$V4_HOST" ] || { v4Error 'Another container already uses this sharing name.' 3; return 3; }
    state=$(v4NetworkDockerScalar inspect --format '{{.State.Running}}' "$name") || return 1
    if [ "$state" = true ]; then v4ShareStatus; return $?; fi
    v4ShareRemove || return $?
  fi
  # Tunnel HTTPS terminates at Cloudflare; the origin is the selected private HTTP service.
  # Database UIs, mail UIs and the local proxy are never tunnel targets.
  v4Docker run -d --name "$name" --network "$network" --label "io.octojoom.share.site=$V4_HOST" \
    --label io.octojoom.share=v4 --restart no "$image" tunnel --no-autoupdate --url "http://${service}:80" >/dev/null || return 1
  started=$SECONDS
  url=''
  while [ "$((SECONDS-started))" -lt "$timeout" ]; do
    url=$(v4Docker logs "$name" 2>&1 | grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' | head -n 1)
    [ -z "$url" ] || break
    state=$(v4NetworkDockerScalar inspect --format '{{.State.Running}}' "$name" 2>/dev/null) || break
    [ "$state" = true ] || break
    sleep 1
  done
  if [ -z "$url" ]; then
    v4ShareRemove || true
    v4Error 'The temporary tunnel did not become ready; its container was removed. Check outbound network access and provider availability.' 1
    return 1
  fi
  jq -n --arg url "$url" --arg site "$V4_HOST" --arg container "$name" '{url:$url,site:$site,container:$container}' >"$V4_DIR/.share.json.tmp" || { v4ShareRemove; return 1; }
  if ! chmod 600 "$V4_DIR/.share.json.tmp" || ! mv -f "$V4_DIR/.share.json.tmp" "$V4_DIR/.share.json"; then v4ShareRemove; return 1; fi
  v4Result "$(jq -c '. + {running:true,temporary:true}' "$V4_DIR/.share.json")"
}

function v4ShareStop() {
  v4Require site || return $?
  v4LoadSite "$(v4Get site)" || return $?
  v4ShareRemove || return $?
  v4Result '{"running":false}'
}

function v4ShareStatus() {
  local name running owner url=''
  v4Require site || return $?
  v4LoadSite "$(v4Get site)" || return $?
  name="octojoom-share-${V4_KEY,,}"
  running=false
  if v4Docker inspect "$name" >/dev/null 2>&1; then
    owner=$(v4NetworkDockerScalar inspect --format '{{index .Config.Labels "io.octojoom.share.site"}}' "$name") || return 1
    [ "$owner" = "$V4_HOST" ] || { v4Error 'The sharing container belongs to another site.' 3; return 3; }
    running=$(v4NetworkDockerScalar inspect --format '{{.State.Running}}' "$name") || return 1
    if [ "$running" = true ]; then url=$(v4Docker logs "$name" 2>&1 | grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' | head -n 1); fi
  fi
  v4Result "$(jq -n --arg site "$V4_HOST" --arg url "$url" --argjson running "$running" '{site:$site,running:$running,url:(if $url=="" then null else $url end),temporary:true}')"
}

# Mail configuration is transported over stdin; previous SMTP credentials are never argv.
function v4MailSettings() {
  local operation="$1"
  # shellcheck disable=SC2016
  v4Compose run --rm --no-deps -T -u root --entrypoint php "$V4_WEB_SERVICE" -r '
    $path="/var/www/html/configuration.php";
    if (!is_file($path)) {fwrite(STDERR,"Joomla configuration.php is missing.\n");exit(3);}
    $names=["mailer","smtphost","smtpport","smtpauth","smtpsecure","smtpuser","smtppass","mailonline"];
    if ($argv[1]==="read") {require $path;$config=new JConfig;$out=[];foreach($names as $name){if(property_exists($config,$name)){$out[$name]=$config->$name;}}echo json_encode($out,JSON_THROW_ON_ERROR);exit;}
    $values=json_decode(stream_get_contents(STDIN),true,32,JSON_THROW_ON_ERROR);
    if(!is_array($values) || array_diff(array_keys($values),$names)){fwrite(STDERR,"Invalid mail settings.\n");exit(2);}
    $source=file_get_contents($path);$replacement=$source;
    foreach($values as $name=>$value){
      if(!is_scalar($value) && $value!==null){exit(2);}
      $pattern="~^(\\s*public\\s+\\$".preg_quote($name,"~")."\\s*=\\s*)(?:\x27(?:[^\x27\\\\]|\\\\.)*\x27|\x22(?:[^\x22\\\\]|\\\\.)*\x22|[0-9]+|true|false|null)(;[^\\r\\n]*)$~mi";
      $replacement=preg_replace_callback($pattern,static function($m)use($value){return $m[1].var_export($value,true).$m[2];},$replacement,-1,$count);
      if($count!==1){fwrite(STDERR,"Unsupported or missing literal mail property: ".$name."\n");exit(2);}
    }
    $mode=fileperms($path)&0777;$uid=fileowner($path);$gid=filegroup($path);$tmp=tempnam(dirname($path),".mail-");
    if($tmp===false || file_put_contents($tmp,$replacement)===false || !chmod($tmp,$mode) || (fileowner($tmp)!==$uid && !chown($tmp,$uid)) || (filegroup($tmp)!==$gid && !chgrp($tmp,$gid)) || !rename($tmp,$path)){if($tmp!==false){@unlink($tmp);}exit(1);}
  ' "$operation"
}

# Called before runtime realignment so imports can restore their original mail transport.
function v4MailPreserve() {
  local backup="$V4_DIR/.mail-settings.json" settings
  [ ! -L "$backup" ] || { v4Error 'The saved mail-settings path must not be a symbolic link.' 3; return 3; }
  if [ -f "$backup" ]; then
    jq -e 'type=="object" and has("mailer") and has("smtphost")' "$backup" >/dev/null || { v4Error 'Saved original mail settings are invalid.' 3; return 3; }
    return 0
  fi
  settings=$(v4MailSettings read) || return $?
  jq -e 'type=="object" and has("mailer") and has("smtphost")' <<<"$settings" >/dev/null || { v4Error 'Could not read original Joomla mail settings.' 3; return 3; }
  (umask 077; printf '%s\n' "$settings" >"$backup")
}

function v4MailConfigure() {
  local enabled metadata previous current backup
  v4Require site || return $?
  v4Confirm || return $?
  v4LoadSite "$(v4Get site)" || return $?
  [ "$(jq -r '.profile // "server"' <<<"$V4_META")" = local ] || { v4Error 'Mail capture is limited to local-development profiles.' 2; return 2; }
  enabled=$(v4Get enabled true)
  case "$enabled" in true|false) ;; *) v4Error 'enabled must be boolean.' 2; return 2;; esac
  backup="$V4_DIR/.mail-settings.json"
  [ ! -L "$backup" ] || { v4Error 'The saved mail-settings path must not be a symbolic link.' 3; return 3; }
  current=$(v4MailSettings read) || return $?
  jq -e 'type=="object" and has("mailer") and has("smtphost")' >/dev/null <<<"$current" || { v4Error 'Could not read the Joomla mail configuration.' 3; return 3; }
  previous="$V4_META"
  metadata=$(jq --argjson enabled "$enabled" --argjson port "$(v4Get mail_port 0)" '.services.mail=$enabled | .services.mail_port=$port' <<<"$V4_META") || return 2
  if [ "$enabled" = true ]; then
    v4MailPreserve || return $?
    v4ApplyConfig "$metadata" >&2 || return $?
    if ! jq --arg host "mailpit${V4_KEY}" '.mailer="smtp" | .smtphost=$host | .smtpport=1025 | .smtpauth=false | .smtpsecure="" | .smtpuser="" | .smtppass="" | if has("mailonline") then .mailonline=true else . end' <<<"$current" | v4MailSettings write; then
      v4ApplyConfig "$previous" >&2 || v4Error 'Mail service rollback failed.'
      return 1
    fi
  else
    if ! { [ -f "$backup" ] && [ ! -L "$backup" ]; }; then v4Error 'Original mail settings are unavailable; restore them explicitly before disabling capture.' 3; return 3; fi
    v4MailSettings write <"$backup" || return $?
    if ! v4ApplyConfig "$metadata" >&2; then printf '%s\n' "$current" | v4MailSettings write || v4Error 'Mail configuration rollback failed.'; return 1; fi
    rm -f "$backup" || return 1
  fi
  v4Result "$(jq -n --argjson enabled "$enabled" '{capture_enabled:$enabled,original_settings_preserved:true}')"
}

function v4MailStatus() {
  local enabled port=''
  v4Require site || return $?
  v4LoadSite "$(v4Get site)" || return $?
  enabled=$(jq -r '.services.mail // false' <<<"$V4_META")
  if [ "$enabled" = true ]; then port=$(v4Compose port "mailpit${V4_KEY}" 8025 2>/dev/null) || port=''; fi
  port=${port%$'\r'}
  v4Result "$(jq -n --argjson enabled "$enabled" --arg port "$port" '{capture_enabled:$enabled,inbox:(if $port=="" then null else "http://"+$port end)}')"
}

function v4MailTest() {
  v4Require site || return $?
  v4LoadSite "$(v4Get site)" || return $?
  [ "$(jq -r '.services.mail // false' <<<"$V4_META")" = true ] || { v4Error 'Enable mail capture before sending its test message.' 3; return 3; }
  # Boot Joomla mailer so this tests the real site mail configuration, not just SMTP reachability.
  # shellcheck disable=SC2016
  v4Compose exec -T "$V4_WEB_SERVICE" php -r '
    define("_JEXEC",1);define("JPATH_BASE","/var/www/html");require JPATH_BASE."/includes/defines.php";require JPATH_BASE."/includes/framework.php";
    require_once JPATH_CONFIGURATION."/configuration.php";$config=new Joomla\Registry\Registry(new JConfig);
    if($config->get("mailer")!=="smtp" || $config->get("smtphost")!==$argv[1] || (int)$config->get("smtpport")!==1025){fwrite(STDERR,"Joomla mail configuration no longer points at this sites capture service. Re-enable mail capture first.\n");exit(3);}
    $mailer=interface_exists(Joomla\CMS\Mail\MailerFactoryInterface::class)?Joomla\CMS\Factory::getContainer()->get(Joomla\CMS\Mail\MailerFactoryInterface::class)->createMailer($config):Joomla\CMS\Factory::getMailer();
    $mailer->setSender("octojoom@example.test","OctoJoom");$mailer->addRecipient("capture@example.test");$mailer->setSubject("OctoJoom mail capture test");$mailer->setBody("This message verifies this Joomla sites configured mail transport.");
    try {if($mailer->send()===false){throw new RuntimeException("Mailer returned failure");}}catch(Throwable $error){fwrite(STDERR,"Joomla mailer rejected the test message: ".$error->getMessage()."\n");exit(1);}
  ' "mailpit${V4_KEY}" >&2 || return $?
  v4Result '{"test_message_sent":true,"recipient":"capture@example.test"}'
}

function v4ServiceConfigure() {
  local service enabled metadata image
  v4Require site service || return $?
  v4Confirm || return $?
  service=$(v4Get service)
  [ "$service" != mail ] || { v4MailConfigure; return $?; }
  case "$service" in redis|node) ;; *) v4Error 'Supported optional services are mail, redis, and node.' 2; return 2;; esac
  enabled=$(v4Get enabled true)
  case "$enabled" in true|false) ;; *) v4Error 'enabled must be boolean.' 2; return 2;; esac
  v4LoadSite "$(v4Get site)" || return $?
  metadata=$(jq --arg service "$service" --argjson enabled "$enabled" '.services[$service]=$enabled' <<<"$V4_META") || return 1
  if [ "$service" = node ]; then
    image=$(v4Get node_image node:22-bookworm-slim)
    [[ "$image" =~ ^[A-Za-z0-9][A-Za-z0-9._:/@-]+$ ]] || { v4Error 'Invalid Node image.' 2; return 2; }
    metadata=$(jq --arg image "$image" '.services.node_image=$image' <<<"$metadata") || return 1
  fi
  v4ApplyConfig "$metadata" >&2 || return $?
  v4Result "$(jq -n --arg service "$service" --argjson enabled "$enabled" '{service:$service,enabled:$enabled}')"
}

# Validate the downloaded program as text. Never source or execute an update.
function v4UpdateValidate() {
  local file="$1" version
  if ! { [ -s "$file" ] && [ "$(head -n 1 "$file")" = '#!/usr/bin/env bash' ]; }; then v4Error 'The update is not a Bash executable.' 1; return 1;fi
  grep -qx 'PROGRAM_NAME="Octojoom"' "$file" || { v4Error 'The download is not an OctoJoom program.' 1; return 1; }
  version=$(sed -nE 's/^_VERSION="([0-9]+\.[0-9]+\.[0-9]+)"$/\1/p' "$file")
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { v4Error 'The update must declare exactly one semantic version.' 1; return 1; }
  bash -n "$file" || { v4Error 'The downloaded update failed Bash syntax validation.' 1; return 1; }
  printf '%s\n' "$version"
}

function v4UpdateApply() {
  (
  local channel target candidate directory old_version version download='' staged='' backup='' rollback=''
  local lock='' locked=false published=false status=0 owner force index
  local -a privilege=() installed_parts=() available_parts=()
  v4Confirm || return $?
  channel=$(v4Get channel master)
  case "$channel" in master|staging) ;; *) v4Error 'Update channel must be master or staging.' 2; return 2;; esac
  force=$(v4Get force false)
  case "$force" in true|false) ;; *) v4Error 'force must be boolean.' 2; return 2;; esac
  candidate="$0"
  if [ ! -f "$candidate" ] || ! grep -qx 'PROGRAM_NAME="Octojoom"' "$candidate" 2>/dev/null; then candidate=$(command -v octojoom 2>/dev/null) || candidate=/usr/local/bin/octojoom; fi
  if [ -f "$candidate" ]; then candidate="$(cd -- "$(dirname -- "$candidate")" && pwd -P)/$(basename -- "$candidate")"; fi
  target=$(v4Get install_path "$candidate")
  [[ "$target" == /* ]] || { v4Error 'The update install path must be absolute. Supply --install-path for this installation.' 2; return 2; }
  [[ "$target" != *$'\n'* && "$target" != *$'\r'* ]] || { v4Error 'Invalid update install path.' 2; return 2; }
  if ! { [ -f "$target" ] && [ ! -L "$target" ]; }; then v4Error 'The update target must be an existing regular executable, not a symbolic link.' 3; return 3;fi
  [ -x "$target" ] || { v4Error 'The installed program is not executable.' 3; return 3; }
  directory=$(cd -- "$(dirname -- "$target")" && pwd -P) || return 1
  target="$directory/$(basename -- "$target")"
  old_version=$(v4UpdateValidate "$target") || return $?
  if ! command -v curl >/dev/null 2>&1 || ! command -v install >/dev/null 2>&1; then v4Error 'curl and install are required to update OctoJoom.' 3; return 3; fi
  if [ ! -w "$directory" ]; then
    if ! command -v sudo >/dev/null 2>&1 || ! sudo -n true 2>/dev/null; then v4Error 'Authorize sudo separately, then repeat the update; OctoJoom does not prompt for a password.' 3; return 3; fi
    privilege=(sudo -n)
  fi
  lock="${target}.update.lock"
  if ! "${privilege[@]}" mkdir -- "$lock" 2>/dev/null; then v4Error 'Another updater owns the installation lock. If an earlier process was killed, inspect the lock before removing it.' 4; return 4; fi
  locked=true
  trap '
    status=$?
    trap - EXIT
    if [ "$status" -ne 0 ] && [ "$published" = true ]; then
      rollback=$("${privilege[@]}" mktemp "$directory/.octojoom-rollback.XXXXXX") || rollback=""
      if [ -n "$rollback" ] && "${privilege[@]}" cp -p -- "$backup" "$rollback" && "${privilege[@]}" mv -f -- "$rollback" "$target"; then
        published=false
      else
        v4Error "Update recovery failed. Restore the retained executable from: $backup" 1
        status=1
      fi
    fi
    [ -z "$download" ] || rm -f -- "$download"
    [ -z "$staged" ] || "${privilege[@]}" rm -f -- "$staged"
    [ -z "$rollback" ] || "${privilege[@]}" rm -f -- "$rollback"
    if [ "$locked" = true ]; then "${privilege[@]}" rm -f -- "$lock/owner"; "${privilege[@]}" rmdir -- "$lock" || status=1; fi
    exit "$status"
  ' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
  printf 'pid=%s\nhost=%s\n' "${BASHPID:-$$}" "$(hostname)" | "${privilege[@]}" tee "$lock/owner" >/dev/null || return 1
  download=$(umask 077; mktemp "${TMPDIR:-/tmp}/octojoom-update.XXXXXX") || return 1
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
    --connect-timeout 10 --max-time 120 "https://raw.githubusercontent.com/octoleo/octojoom/refs/heads/${channel}/src/octojoom" -o "$download" || {
      v4Error 'The update download failed; the installed program was preserved.' 1; return 1;
    }
  version=$(v4UpdateValidate "$download") || return $?
  IFS=. read -r -a installed_parts <<<"$old_version"
  IFS=. read -r -a available_parts <<<"$version"
  if [ "$force" != true ]; then
    for index in 0 1 2; do
      if ((10#${available_parts[index]} < 10#${installed_parts[index]})); then
        v4Error 'The selected channel is older than this installation. Use --force only for an intentional downgrade.' 2; return 2
      fi
      if ((10#${available_parts[index]} > 10#${installed_parts[index]})); then break; fi
    done
  fi
  # Every replacement and recovery rename stays in the target filesystem.
  staged=$("${privilege[@]}" mktemp "$directory/.octojoom-update.XXXXXX") || return 1
  "${privilege[@]}" install -m 0755 "$download" "$staged" || return 1
  owner=$(stat -c '%u:%g' "$target" 2>/dev/null) || owner=$(stat -f '%u:%g' "$target") || return 1
  "${privilege[@]}" chown "$owner" "$staged" || return 1
  backup=$("${privilege[@]}" mktemp "${target}.previous-${old_version}.XXXXXX") || return 1
  "${privilege[@]}" cp -p -- "$target" "$backup" || return 1
  # Treat interruption between rename and verification as a failed publication.
  published=true
  "${privilege[@]}" mv -f -- "$staged" "$target" || return 1
  if ! { cmp -s "$download" "$target" && [ -x "$target" ]; }; then v4Error 'Installed update verification failed; restoring the previous executable.' 1; return 1;fi
  v4Result "$(jq -n --arg channel "$channel" --arg previous "$old_version" --arg version "$version" --arg path "$target" --arg recovery "$backup" '{channel:$channel,previous:$previous,version:$version,install_path:$path,recovery_path:$recovery,updated:true,restart_required:true}')" || return 1
  published=false
  )
}

#####################################################################################################################VDM
# OCTOJOOM V4: tools
# Joomla v4 site information, lifecycle and development tools.
# Requests are validated by the shared CLI; these handlers never open dialogs.

function v4ToolsLoad() {
  v4Require site || return $?
  v4LoadSite "$(v4Get site)"
}

function v4ServiceName() {
  local role="${1:-web}"
  case "$role" in
    web|php) printf '%s\n' "$V4_WEB_SERVICE" ;;
    frontend)
      if [ "$(jq -r '.webserver // "apache"' <<< "$V4_META")" = nginx ]; then
        printf 'nginx%s\n' "$V4_KEY"
      else
        printf '%s\n' "$V4_WEB_SERVICE"
      fi
      ;;
    db|database) printf '%s\n' "$V4_DB_SERVICE" ;;
    mail)
      if [ ! -f "$V4_DIR/project.json" ] && grep -q "mailcatcher${V4_KEY}" "$V4_COMPOSE"; then
        printf 'mailcatcher%s\n' "$V4_KEY"
      elif jq -e '.services.mail == true' <<< "$V4_META" >/dev/null; then
        printf 'mailpit%s\n' "$V4_KEY"
      else
        v4Error 'Mail capture is not enabled for this site.' 2
      fi
      ;;
    database-ui)
      if [ "$V4_DB_ENGINE" = postgres ]; then printf 'adminer%s\n' "$V4_KEY"; else printf 'phpmyadmin%s\n' "$V4_KEY"; fi
      ;;
    redis|node)
      jq -e --arg role "$role" '.services[$role] == true' <<< "$V4_META" >/dev/null || {
        v4Error "The ${role} service is not enabled for this site." 2; return $?;
      }
      printf '%s%s\n' "$role" "$V4_KEY"
      ;;
    *)
      local service
      while IFS= read -r service; do
        if [ "$role" = "$service" ]; then printf '%s\n' "$service"; return 0; fi
      done < <(v4Compose config --services 2>/dev/null)
      v4Error 'The requested service does not belong to this site.' 2
      ;;
  esac
}

# Return only public container state; inspect never exposes Config.Env.
function v4ContainerState() {
  local service="$1" state
  state=$(v4Docker inspect --type container --format '{{json .State}}' "$service" 2>/dev/null) || {
    printf '{"status":"missing","running":false,"health":null}\n'; return 0;
  }
  jq -ce '{status:(.Status // "unknown"),running:(.Running == true),health:(.Health.Status // null)}' <<< "$state" 2>/dev/null || {
    v4Error 'Docker returned invalid container state.' 1; return $?;
  }
}

function v4WaitReady() {
  local timeout="${1:-120}" service
  local -a required=("$V4_DB_SERVICE" "$V4_WEB_SERVICE")
  [ "$(jq -r '.webserver // "apache"' <<< "$V4_META")" != nginx ] || required+=("nginx${V4_KEY}")
  if jq -e '.services.mail == true' <<< "$V4_META" >/dev/null; then
    service=$(v4ServiceName mail) || return $?
    required+=("$service")
  fi
  if jq -e '.services.redis == true' <<< "$V4_META" >/dev/null; then required+=("redis${V4_KEY}"); fi
  v4WaitServices "$timeout" "${required[@]}"
}

function v4WaitServices() {
  local timeout="$1" started=$SECONDS service state complete
  shift
  if ! { [[ "$timeout" =~ ^[0-9]+$ ]] && [ "$timeout" -gt 0 ] && [ "$timeout" -le 3600 ]; }; then
    v4Error 'Timeout must be between 1 and 3600 seconds.' 2; return $?;
  fi
  [ "$#" -gt 0 ] || return 0
  while [ "$((SECONDS-started))" -lt "$timeout" ]; do
    complete=true
    for service in "$@"; do
      state=$(v4ContainerState "$service") || return $?
      if ! jq -e '.running == true and (.health == "healthy" or .health == null)' <<< "$state" >/dev/null; then
        complete=false
      fi
      if jq -e '.status == "dead" or .status == "exited" or .health == "unhealthy"' <<< "$state" >/dev/null; then
        v4Error "The ${service} service failed its readiness check; inspect its logs." 1
        return $?
      fi
    done
    "$complete" && return 0
    sleep 1
  done
  v4Error 'The site did not become ready within the requested timeout.' 1
}

# The URL uses the actual allocated local port, rather than a guessed binding.
function v4SiteUrls() {
  local scheme=http profile port binding service site_url db_url='' mail_url='' mode db_port=80
  [ "$V4_DB_ENGINE" != postgres ] || db_port=8080
  profile=$(jq -r '.profile // "server"' <<< "$V4_META")
  [ -f "$V4_DIR/project.json" ] || profile=server
  mode=$(jq -r '.tls.mode // "none"' <<< "$V4_META")
  [ "$mode" = none ] || scheme=https
  if [ "$profile" = local ]; then
    if [ "$mode" = local ]; then
      port=$(jq -r '.tls.https_port // 443' <<< "$V4_META")
    else
      service=$(v4ServiceName frontend) || return $?
      binding=$(v4Compose port "$service" 80 2>/dev/null | head -n 1)
      port="${binding##*:}"
      [[ "$port" =~ ^[0-9]+$ ]] || port=$(jq -r '.http_port // 0' <<< "$V4_META")
    fi
    if [ "$port" = 0 ]; then
      site_url=''
    elif { [ "$scheme" = http ] && [ "$port" = 80 ]; } || { [ "$scheme" = https ] && [ "$port" = 443 ]; }; then
      site_url="${scheme}://${V4_HOST}"
    else
      site_url="${scheme}://${V4_HOST}:${port}"
    fi
    service=$(v4ServiceName database-ui) || return $?
    binding=$(v4Compose port "$service" "$db_port" 2>/dev/null | head -n 1)
    port="${binding##*:}"
    [[ "$port" =~ ^[0-9]+$ ]] && db_url="http://127.0.0.1:${port}"
    if service=$(v4ServiceName mail 2>/dev/null); then
      port=8025; [[ "$service" != mailcatcher* ]] || port=1080
      binding=$(v4Compose port "$service" "$port" 2>/dev/null | head -n 1)
      port="${binding##*:}"
      [[ "$port" =~ ^[0-9]+$ ]] && mail_url="http://127.0.0.1:${port}"
    fi
  else
    site_url="${scheme}://${V4_HOST}"
    # Only expose known legacy routes; v4 tools are loopback-only by default.
    if [ ! -f "$V4_DIR/project.json" ]; then
      db_url="${scheme}://${V4_HOST%%.*}db.${V4_HOST#*.}"
      if v4ServiceName mail >/dev/null 2>&1; then mail_url="${scheme}://${V4_HOST%%.*}mail.${V4_HOST#*.}"; fi
    else
      service=$(v4ServiceName database-ui) || return $?
      binding=$(v4Compose port "$service" "$db_port" 2>/dev/null | head -n 1)
      port="${binding##*:}"
      [[ "$port" =~ ^[0-9]+$ ]] && db_url="http://127.0.0.1:${port}"
    fi
  fi
  jq -nc --arg site "$site_url" --arg db "$db_url" --arg mail "$mail_url" \
    '{site:$site,admin:(if $site=="" then "" else $site+"/administrator" end),database:$db,mail:$mail}'
}

function v4InstalledJoomlaVersion() {
  local file="$V4_DOCROOT/administrator/manifests/files/joomla.xml" version=''
  if [ -r "$file" ]; then
    version=$(sed -nE 's/.*<version>([0-9]+\.[0-9]+[^<]*)<\/version>.*/\1/p' "$file" | head -n 1)
  fi
  printf '%s\n' "$version"
}

# Container environment variables below are expanded inside the selected container.
# shellcheck disable=SC2016
function v4SiteFacts() {
  local web db frontend php='' database='' version enabled=false urls site_name=''
  web=$(v4ContainerState "$V4_WEB_SERVICE") || return $?
  db=$(v4ContainerState "$V4_DB_SERVICE") || return $?
  frontend=$(v4ContainerState "$(v4ServiceName frontend)") || return $?
  version=$(v4InstalledJoomlaVersion)
  [ ! -L "$VDM_REPO_PATH/joomla/enabled/$V4_HOST" ] || enabled=true
  if jq -e '.running' <<< "$web" >/dev/null; then
    php=$(v4Exec "$V4_WEB_SERVICE" php -r 'echo PHP_VERSION;' 2>/dev/null) || php=''
    [[ "$php" =~ ^[0-9]+\.[0-9]+\.[0-9]+[A-Za-z0-9.+_-]*$ ]] || php=''
  fi
  if jq -e '.running' <<< "$db" >/dev/null; then
    case "$V4_DB_ENGINE" in
      postgres)
        database=$(v4Exec "$V4_DB_SERVICE" sh -c 'PGPASSWORD="$POSTGRES_PASSWORD" psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atqc "SHOW server_version"' 2>/dev/null) || database=''
        ;;
      mysql)
        database=$(v4Exec "$V4_DB_SERVICE" sh -c 'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" mysql -uroot -Nse "SELECT VERSION()"' 2>/dev/null) || database=''
        ;;
      *)
        database=$(v4Exec "$V4_DB_SERVICE" sh -c 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" mariadb -uroot -Nse "SELECT VERSION()"' 2>/dev/null) || database=''
        ;;
    esac
    [[ "$database" =~ ^[0-9][A-Za-z0-9.+_~:-]*$ ]] || database=''
  fi
  if [ -r "$V4_DOCROOT/configuration.php" ]; then
    site_name=$(getJoomlaConfigValue "$V4_DOCROOT/configuration.php" sitename 2>/dev/null) || site_name=''
  fi
  urls=$(v4SiteUrls) || return $?
  jq -nc --arg host "$V4_HOST" --arg key "$V4_KEY" --arg title "$site_name" --arg joomla "$version" \
    --arg php "$php" --arg database "$database" --arg engine "$V4_DB_ENGINE" --arg project "$V4_PROJECT" \
    --arg docroot "$V4_DOCROOT" --arg compose "$V4_COMPOSE" --arg webserver "$(jq -r '.webserver // "apache"' <<< "$V4_META")" --argjson enabled "$enabled" --argjson web "$web" \
    --argjson db "$db" --argjson frontend "$frontend" --argjson urls "$urls" \
    '{host:$host,key:$key,title:$title,joomla_version:$joomla,php_version:$php,status:$web.status,webserver:$webserver,project_dir:$project,docroot:$docroot,database:{engine:$engine,version:$database,state:$db},web:$web,frontend:$frontend,enabled:$enabled,paths:{project:$project,docroot:$docroot,compose:$compose},urls:$urls}'
}

function v4SiteInfo() {
  v4ToolsLoad || return $?
  local facts
  facts=$(v4SiteFacts) || return $?
  v4Result "$facts"
}

function v4SiteList() {
  local directory host facts filter state sites='[]' errors='[]' rc=0
  filter=$(v4Get filter '')
  state=$(v4Get state all)
  case "$state" in all|running|stopped) ;; *) v4Error 'State must be all, running or stopped.' 2; return $? ;; esac
  [[ "$filter" =~ ^[0-9.]*$ ]] || { v4Error 'The Joomla version filter must be a numeric version prefix.' 2; return $?; }
  for directory in "$VDM_REPO_PATH"/joomla/available/*; do
    if ! { [ -d "$directory" ] && [ ! -L "$directory" ]; }; then continue; fi
    [ -f "$directory/docker-compose.yml" ] || continue
    host="${directory##*/}"
    if v4LoadSite "$host" && facts=$(v4SiteFacts); then
      if [ -n "$filter" ] && ! jq -e --arg prefix "$filter" '.joomla_version | startswith($prefix)' <<< "$facts" >/dev/null; then continue; fi
      if [ "$state" = running ] && ! jq -e '.web.running' <<< "$facts" >/dev/null; then continue; fi
      if [ "$state" = stopped ] && jq -e '.web.running' <<< "$facts" >/dev/null; then continue; fi
      sites=$(jq -c --argjson site "$facts" '. + [$site]' <<< "$sites") || return 1
    else
      rc=1
      errors=$(jq -c --arg site "$host" '. + [{site:$site,error:"Unable to inspect project"}]' <<< "$errors") || return 1
    fi
  done
  v4Result "$(jq -nc --argjson sites "$sites" --argjson errors "$errors" '{sites:$sites,errors:$errors}')"
  return "$rc"
}

function v4Lifecycle() {
  (
    local action="$1" lock marker timeout
    v4ToolsLoad || exit $?
    timeout=$(v4Get timeout 120)
    if ! { [[ "$timeout" =~ ^[0-9]+$ ]] && [ "$timeout" -gt 0 ] && [ "$timeout" -le 3600 ]; }; then v4Error 'Timeout must be between 1 and 3600 seconds.' 2; exit $?; fi
    lock="$V4_DIR/.operation.lock"
    v4Lock "$lock" || exit $?
    trap 'v4Unlock "$lock"' EXIT
    marker="$VDM_REPO_PATH/joomla/enabled/$V4_HOST"
    case "$action" in
      start)
        v4RunHook pre-start || exit $?
        v4Compose up -d || exit $?
        v4WaitReady "$timeout" || exit $?
        v4RunHook post-start || exit $?
        if [ "$(v4Get enable true)" = true ]; then
          mkdir -p "${marker%/*}" || exit 1
          if [ ! -e "$marker" ] && [ ! -L "$marker" ]; then ln -s "$V4_DIR" "$marker" || exit 1; fi
        fi
        ;;
      stop)
        v4RunHook pre-stop || exit $?
        v4Compose stop --timeout "$timeout" || exit $?
        v4RunHook post-stop || exit $?
        if [ "$(v4Get disable false)" = true ]; then
          if [ -L "$marker" ]; then rm -- "$marker" || exit 1
          elif [ -e "$marker" ]; then v4Error 'The enabled-site path is not a managed link.' 1; exit $?; fi
        fi
        ;;
      restart)
        v4RunHook pre-stop || exit $?
        v4Compose stop --timeout "$timeout" || exit $?
        v4RunHook post-stop || exit $?
        v4RunHook pre-start || exit $?
        v4Compose up -d || exit $?
        v4WaitReady "$timeout" || exit $?
        v4RunHook post-start || exit $?
        ;;
    esac
    v4Result "$(jq -nc --arg site "$V4_HOST" --arg action "$action" '{site:$site,action:$action}')"
  )
}

function v4SiteStart() {
  if [ "$(v4Get all false)" = true ]; then v4ToolsBatch v4Lifecycle start; else v4Lifecycle start; fi
}

function v4SiteStop() {
  if [ "$(v4Get all false)" = true ]; then v4ToolsBatch v4Lifecycle stop; else v4Lifecycle stop; fi
}

function v4SiteRestart() {
  if [ "$(v4Get all false)" = true ]; then v4ToolsBatch v4Lifecycle restart; else v4Lifecycle restart; fi
}

function v4SiteDelete() {
  (
    local lock marker recovery data trash
    v4ToolsLoad || exit $?
    v4Confirm || exit $?
    data=$(v4Get delete_data false)
    case "$data" in true|false) ;; *) v4Error 'delete_data must be a boolean.' 2; exit $? ;; esac
    if [ "$data" = true ]; then
      if ! { [ ! -L "$V4_PROJECT" ] && [[ "$V4_PROJECT" == "$VDM_PROJECT_PATH/"* ]] && [ "$V4_PROJECT" != "$VDM_PROJECT_PATH/" ]; }; then
        v4Error 'Project data must be a managed, non-symlink directory before deletion. Supply its project_path if the configured root has changed.' 2; exit $?;
      fi
    fi
    lock="$V4_DIR/.operation.lock"
    v4Lock "$lock" || exit $?
    trap 'v4Unlock "$lock"' EXIT
    # Preserve scoped credentials with retained data, outside the web document root.
    if [ "$data" = false ]; then
      recovery="$VDM_SRC_PATH/recovery/$V4_HOST-$(date -u +%Y%m%dT%H%M%SZ)-${BASHPID}"
      (umask 077; mkdir -p "$VDM_SRC_PATH/recovery") || exit 1
      (umask 077; mkdir "$recovery" && cp -R "$V4_DIR/." "$recovery/") || exit 1
      rm -rf -- "$recovery/.operation.lock" || exit 1
      if [ "$V4_ENV_FILE" != "$V4_DIR/.env" ]; then
        v4PackageEnvironment "$recovery/.env" || exit $?
      fi
    fi
    v4RunHook pre-delete || exit $?
    if declare -F v4ShareRemove >/dev/null; then v4ShareRemove || exit $?; fi
    if declare -F v4LocalRemoveSite >/dev/null; then v4LocalRemoveSite || exit $?; fi
    v4Compose down --remove-orphans || exit $?
    marker="$VDM_REPO_PATH/joomla/enabled/$V4_HOST"
    if [ -e "$marker" ] || [ -L "$marker" ]; then
      if [ -L "$marker" ]; then rm -- "$marker" || exit 1
      else v4Error 'The enabled-site path is not a managed link.' 1; exit $?; fi
    fi
    if [ "$data" = true ] && [ -e "$V4_PROJECT" ]; then
      trash="${V4_PROJECT}.deleted-${BASHPID}"
      [ ! -e "$trash" ] && mv -- "$V4_PROJECT" "$trash" || exit 1
      if ! v4ToolsRemoveTree "$trash"; then
        v4Error "Containers are stopped; project data could not be removed and is retained at ${trash}." 1
        exit $?
      fi
    fi
    v4Unlock "$lock" || exit 1
    trap - EXIT
    rm -rf -- "$V4_DIR" || exit 1
    v4Result "$(jq -nc --arg site "$V4_HOST" --arg recovery "${recovery:-}" --argjson deleted "$data" '{site:$site,deleted:true,data_deleted:$deleted,recovery_directory:$recovery}')"
  )
}

# Docker-created bind mount contents may require privilege; never prompt in CLI mode.
function v4ToolsRemoveTree() {
  local directory="$1"
  [ -d "$directory" ] && [ ! -L "$directory" ] && [[ "$directory" == "$VDM_PROJECT_PATH/"* ]] || return 2
  if rm -rf -- "$directory" 2>/dev/null; then return 0; fi
  command -v sudo >/dev/null 2>&1 || return 1
  sudo -n rm -rf -- "$directory"
}

function v4SitePermissions() {
  (
    set +x
    local lock timeout script result compose source normalized status=0 resume=false
    local -a V4_RESUME_SERVICES=()
    v4ToolsLoad || exit $?
    v4Confirm || exit $?
    [ "${V4_NAMED_VOLUMES:-false}" = false ] || { v4Error 'Permission repair requires a bind-mounted Joomla document root.' 2; exit $?; }
    if ! { [ -d "$V4_DOCROOT" ] && [[ "$V4_DOCROOT" == "$V4_PROJECT/"* ]]; }; then
      v4Error 'The managed Joomla document root is unavailable.' 2; exit $?
    fi
    if migrationPathHasSymlink "$V4_DOCROOT" || [ -L "$V4_DOCROOT/configuration.php" ]; then
      v4Error 'The managed document root and configuration.php must not resolve through symbolic links.' 2
      exit $?
    fi
    compose=$(v4Compose config --format json) || exit $?
    source=$(jq -er --arg service "$V4_WEB_SERVICE" '.services[$service].volumes[] | select(.type=="bind" and .target=="/var/www/html" and (.read_only // false | not)) | .source' <<< "$compose") || {
      v4Error 'Permission repair requires the managed writable document-root bind mount.' 2; exit $?
    }
    normalized=$(v4DockerHostPath "$V4_DOCROOT") || exit $?
    case "${OSTYPE:-}" in msys*|cygwin*) source="${source//\\//}" ;; esac
    [ "$source" = "$normalized" ] || { v4Error 'The effective web volume differs from the managed document root.' 2; exit $?; }
    timeout=$(v4Get timeout 120)
    if ! { [[ "$timeout" =~ ^[0-9]+$ ]] && [ "$timeout" -gt 0 ] && [ "$timeout" -le 3600 ]; }; then
      v4Error 'Timeout must be between 1 and 3600 seconds.' 2; exit $?
    fi
    lock="$V4_DIR/.operation.lock"
    v4Lock "$lock" || exit $?
    trap 'status=$?; if "$resume"; then v4Resume && v4WaitServices "$timeout" "${V4_RESUME_SERVICES[@]}" || status=1; fi; v4Unlock "$lock" || status=1; exit "$status"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    # Stop the exact running application services before changing writable files.
    resume=true
    v4Quiesce || exit $?
    # The selected image supplies the correct www-data UID/GID. Physical find
    # traversal skips symlinks and does not cross mounted filesystems.
    script=$(cat <<'OCTOJOOM_PERMISSIONS'
set -eu
root=/var/www/html
[ -d "$root" ] && [ ! -L "$root" ] && [ ! -L "$root/configuration.php" ] || exit 2
uid=$(id -u www-data)
gid=$(id -g www-data)
find -P "$root" -xdev -type d -exec chown --no-dereference "$uid:$gid" {} + -exec chmod 755 {} +
find -P "$root" -xdev -type f -exec chown --no-dereference "$uid:$gid" {} + -exec chmod 644 {} +
private=false
if [ -f "$root/configuration.php" ]; then chmod 600 "$root/configuration.php"; private=true; fi
directories=$(find -P "$root" -xdev -type d -printf x)
files=$(find -P "$root" -xdev -type f -printf x)
links=$(find -P "$root" -xdev -type l -printf x)
printf '{"directories":%s,"files":%s,"symlinks_skipped":%s,"configuration_private":%s,"uid":%s,"gid":%s}\n' "${#directories}" "${#files}" "${#links}" "$private" "$uid" "$gid"
OCTOJOOM_PERMISSIONS
    ) || exit 1
    result=$(v4Compose run --rm --no-deps -T --user root --entrypoint sh "$V4_WEB_SERVICE" -c "$script") || {
      v4Error 'Permission repair failed. Some modes may have changed; the original service state will be restored.' 1
      exit $?
    }
    jq -e '.directories|type=="number"' <<< "$result" >/dev/null || { v4Error 'Permission repair did not return valid counts.' 1; exit $?; }
    result=$(jq -c --arg site "$V4_HOST" --arg docroot "$V4_DOCROOT" '. + {site:$site,docroot:$docroot,owner:"www-data",directory_mode:"0755",file_mode:"0644",configuration_mode:"0600"}' <<< "$result") || exit 1
    v4Result "$result" || exit $?
    v4Resume || exit $?
    v4WaitServices "$timeout" "${V4_RESUME_SERVICES[@]}" || exit $?
    resume=false
  )
}

function v4SitePath() {
  v4ToolsLoad || return $?
  local path target
  target=$(v4Get target docroot)
  case "$target" in project) path="$V4_PROJECT" ;; docroot) path="$V4_DOCROOT" ;; *) v4Error 'Path target must be project or docroot.' 2; return $? ;; esac
  v4Result "$(jq -nc --arg path "$path" '{path:$path}')"
}

function v4OpenResource() {
  local resource="$1"
  case "${OSTYPE:-}" in
    darwin*) command -v open >/dev/null || return 127; open "$resource" ;;
    msys*|cygwin*)
      if command -v explorer.exe >/dev/null; then
        if [ -d "$resource" ] && command -v cygpath >/dev/null; then resource=$(cygpath -w "$resource") || return 1; fi
        explorer.exe "$resource"
      else
        v4Error 'Windows Explorer is unavailable; use --print to obtain the address.' 127
      fi
      ;;
    *) command -v xdg-open >/dev/null || { v4Error 'xdg-open is unavailable; use --print to obtain the address.' 127; return $?; }; xdg-open "$resource" ;;
  esac
}

function v4SiteOpen() {
  v4ToolsLoad || return $?
  local target resource urls
  target=$(v4Get target site)
  case "$target" in
    directory) resource="$V4_DOCROOT" ;;
    site|admin|database|mail)
      urls=$(v4SiteUrls) || return $?
      resource=$(jq -r --arg target "$target" '.[$target]' <<< "$urls")
      [ -n "$resource" ] || { v4Error 'This endpoint is unavailable; start or configure the selected service first.' 2; return $?; }
      ;;
    *) v4Error 'Open target must be site, admin, database, mail or directory.' 2; return $? ;;
  esac
  if [ "$(v4Get print false)" != true ]; then v4OpenResource "$resource" >/dev/null 2>&1 || { v4Error 'The operating system could not open the selected resource.' 1; return $?; }; fi
  v4Result "$(jq -nc --arg target "$target" --arg resource "$resource" '{target:$target,resource:$resource}')"
}

# Capture bounded command output in private files; never reconstruct argv as shell code.
function v4ToolRun() {
  (
    local temporary status=0 output_size
    temporary=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/octojoom-command.XXXXXX") || exit 1
    trap 'rm -rf -- "$temporary"' EXIT
    "$@" > "$temporary/stdout" 2> "$temporary/stderr" || status=$?
    # Avoid unbounded JSON construction. Full log streaming is a separate operation.
    output_size=$(wc -c < "$temporary/stdout")
    if [ "$output_size" -gt 16777216 ]; then
      v4Error 'Command output exceeds the 16 MiB structured-result limit. Redirect output inside the container or use an interactive shell.' 1
      exit $?
    fi
    output_size=$(wc -c < "$temporary/stderr")
    if [ "$output_size" -gt 16777216 ]; then
      v4Error 'Command diagnostics exceed the 16 MiB structured-result limit.' 1
      exit $?
    fi
    v4Result "$(jq -nc --rawfile stdout "$temporary/stdout" --rawfile stderr "$temporary/stderr" --argjson code "$status" '{stdout:$stdout,stderr:$stderr,exit_code:$code}')"
    exit "$status"
  )
}

function v4SiteLogs() {
  v4ToolsLoad || return $?
  local service tail follow
  service=$(v4ServiceName "$(v4Get service web)") || return $?
  tail=$(v4Get tail 100)
  if ! { [[ "$tail" =~ ^[0-9]+$ ]] && [ "$tail" -le 100000 ]; }; then v4Error 'tail must be between 0 and 100000.' 2; return $?; fi
  follow=$(v4Get follow false)
  if [ "$follow" = true ]; then
    [ "$(v4Get json false)" != true ] || { v4Error 'Following logs is a stream; omit --json.' 2; return $?; }
    v4Compose logs --no-color --tail "$tail" --follow "$service"
  else
    v4ToolRun v4Compose logs --no-color --tail "$tail" "$service"
  fi
}

function v4SiteShell() {
  v4ToolsLoad || return $?
  [ "$(v4Get json false)" != true ] || { v4Error 'An interactive shell cannot return JSON.' 2; return $?; }
  if ! { [ -t 0 ] && [ -t 1 ]; }; then v4Error 'An interactive shell requires a terminal; use site exec for automation.' 2; return $?; fi
  local service workdir
  service=$(v4ServiceName "$(v4Get service web)") || return $?
  workdir=$(v4Get workdir /var/www/html)
  [[ "$workdir" == /* && "$workdir" != *$'\n'* ]] || { v4Error 'workdir must be an absolute container path.' 2; return $?; }
  if [ "${#V4_ARGS[@]}" -eq 0 ]; then
    v4Compose exec --workdir "$workdir" "$service" sh
  else
    v4Compose exec --workdir "$workdir" "$service" "${V4_ARGS[@]}"
  fi
}

function v4SiteExec() {
  v4ToolsLoad || return $?
  local service workdir
  [ "${#V4_ARGS[@]}" -gt 0 ] || { v4Error 'Supply command arguments after --.' 2; return $?; }
  service=$(v4ServiceName "$(v4Get service web)") || return $?
  workdir=$(v4Get workdir /var/www/html)
  [[ "$workdir" == /* && "$workdir" != *$'\n'* ]] || { v4Error 'workdir must be an absolute container path.' 2; return $?; }
  v4ToolRun v4Compose exec -T --workdir "$workdir" "$service" "${V4_ARGS[@]}"
}

# The positional parameter is deliberately expanded by the container shell.
# shellcheck disable=SC2016
function v4HasContainerTool() {
  local service="$1" tool="$2"
  [[ "$tool" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]] || return 2
  v4Exec "$service" sh -c 'command -v "$1" >/dev/null 2>&1' sh "$tool" >/dev/null 2>&1
}

function v4SiteJoomla() {
  v4ToolsLoad || return $?
  [ "${#V4_ARGS[@]}" -gt 0 ] || V4_ARGS=(list)
  v4Exec "$V4_WEB_SERVICE" test -f /var/www/html/cli/joomla.php || {
    v4Error 'The selected installation does not provide the Joomla CLI.' 2; return $?;
  }
  v4ToolRun v4Compose exec -T --workdir /var/www/html "$V4_WEB_SERVICE" php cli/joomla.php "${V4_ARGS[@]}"
}

function v4SiteComposer() {
  v4ToolsLoad || return $?
  local workdir phar host_phar version status=0
  workdir=$(v4Get workdir /var/www/html)
  [[ "$workdir" == /* && "$workdir" != *$'\n'* ]] || { v4Error 'workdir must be an absolute container path.' 2; return $?; }
  [ "${#V4_ARGS[@]}" -gt 0 ] || V4_ARGS=(--version)
  v4RunHook pre-composer || return $?
  if v4HasContainerTool "$V4_WEB_SERVICE" composer && ! v4Has composer_version; then
    v4ToolRun v4Compose exec -T --workdir "$workdir" "$V4_WEB_SERVICE" composer --no-interaction "${V4_ARGS[@]}" || status=$?
  else
    version=$(v4Get composer_version "$(jq -r '.tools.composer_version // "2.10.3"' <<< "$V4_META")")
    phar=$(v4ComposerPhar "$version") || return $?
    host_phar=$(v4DockerHostPath "$phar") || return $?
    v4ToolRun v4Compose run --rm --no-deps -T --workdir "$workdir" \
      --volume "$host_phar:/opt/octojoom/composer.phar:ro" --entrypoint php \
      "$V4_WEB_SERVICE" /opt/octojoom/composer.phar --no-interaction "${V4_ARGS[@]}" || status=$?
  fi
  [ "$status" -eq 0 ] || return "$status"
  v4RunHook post-composer
}

function v4SiteNpm() {
  v4ToolsLoad || return $?
  local workdir
  workdir=$(v4Get workdir /var/www/html)
  [[ "$workdir" == /* && "$workdir" != *$'\n'* ]] || { v4Error 'workdir must be an absolute container path.' 2; return $?; }
  [ "${#V4_ARGS[@]}" -gt 0 ] || V4_ARGS=(--version)
  if v4HasContainerTool "$V4_WEB_SERVICE" npm; then
    v4ToolRun v4Compose exec -T --workdir "$workdir" "$V4_WEB_SERVICE" npm "${V4_ARGS[@]}"
  elif jq -e '.services.node == true' <<< "$V4_META" >/dev/null; then
    # Node is an on-demand tools profile, so no idle Node container is required.
    v4ToolRun v4Compose run --rm --no-deps -T --workdir "$workdir" "node${V4_KEY}" npm "${V4_ARGS[@]}"
  else
    v4Error 'Enable the optional Node service or use an image with npm before running asset commands.' 127
    return $?
  fi
}

function v4HookEvents() {
  printf '%s\n' '["pre-start","post-start","pre-stop","post-stop","pre-delete","pre-import","post-import","pre-export-db","post-export-db","pre-import-db","post-import-db","pre-backup","post-backup","pre-restore","post-restore","pre-composer","post-composer"]'
}

# One validator governs explicit requests, saved metadata and per-event edits.
function v4ValidateHooks() {
  local hooks="${1:-}" events
  events=$(v4HookEvents) || return 2
  jq -e --argjson events "$events" '
    type=="object" and all(to_entries[];
      . as $entry | ($events|index($entry.key)) != null and
      ($entry.value | type=="array" and length<=32 and all(.[];
        type=="array" and length>0 and length<=128 and
        (.[0]|type=="string" and length>0) and
        all(.[];type=="string" and (test("[[:cntrl:]]")|not))
      ))
    )' <<< "$hooks" >/dev/null 2>&1 || {
    v4Error 'Hooks must map supported events to at most 32 command argument arrays, with a nonempty executable and no control characters.' 2
    return 2
  }
}

function v4HookConfigure() {
  (
    local event commands enabled metadata lock
    v4ToolsLoad || exit $?
    [ -f "$V4_DIR/project.json" ] || { v4Error 'Save a v4 project configuration before adding hooks.' 2; exit $?; }
    lock="$V4_DIR/.operation.lock"
    v4Lock "$lock" || exit $?
    trap 'v4Unlock "$lock"' EXIT
    v4ToolsLoad || exit $?
    event=$(v4Get event)
    jq -e --arg event "$event" 'index($event) != null' <<< "$(v4HookEvents)" >/dev/null || { v4Error 'Unknown hook event.' 2; exit $?; }
    enabled=$(v4Get enabled true)
    if [ "$enabled" = false ]; then
      metadata=$(jq -c --arg event "$event" 'del(.hooks[$event])' <<< "$V4_META") || exit 1
    else
      commands=$(jq -c '.commands // []' <<< "$V4_REQUEST") || exit 2
      # Permit JSON-file arrays and equivalent CLI JSON strings without evaluating either.
      if jq -e 'type == "string"' <<< "$commands" >/dev/null; then commands=$(jq -er 'fromjson' <<< "$commands") || exit 2; fi
      jq -e 'type=="array" and length>0 and length<=32 and all(.[]; type=="array" and length>0 and length<=128 and (.[0]|type=="string" and length>0) and all(.[];type=="string" and (contains("\u0000")|not)))' <<< "$commands" >/dev/null || {
        v4Error 'commands must be a nonempty JSON array of argument arrays.' 2; exit $?;
      }
      metadata=$(jq -c --arg event "$event" --argjson commands "$commands" '.hooks[$event]=$commands' <<< "$V4_META") || exit 1
    fi
    v4ValidateHooks "$(jq -c '.hooks' <<< "$metadata")" || exit $?
    v4SaveMetadata "$metadata" || exit $?
    v4Result "$(jq -nc --arg site "$V4_HOST" --arg event "$event" --argjson enabled "$enabled" '{site:$site,event:$event,enabled:$enabled}')"
  )
}

function v4RunHook() {
  local event="$1" count index encoded argument
  local -a argv=()
  v4ValidateHooks "$(jq -c '.hooks // {}' <<< "$V4_META")" || return $?
  count=$(jq -r --arg event "$event" '(.hooks[$event] // []) | length' <<< "$V4_META") || return 2
  if ! { [[ "$count" =~ ^[0-9]+$ ]] && [ "$count" -le 32 ]; }; then v4Error 'Invalid hook configuration.' 2; return $?; fi
  for ((index=0; index<count; index++)); do
    jq -e --arg event "$event" --argjson index "$index" '.hooks[$event][$index] | type=="array" and length>0 and length<=128 and (.[0]|type=="string" and length>0) and all(.[];type=="string" and (contains("\u0000")|not))' <<< "$V4_META" >/dev/null || {
      v4Error 'Invalid hook argument configuration.' 2; return $?;
    }
    argv=()
    while IFS= read -r encoded; do
      # jq base64 preserves spaces/newlines and avoids shell word splitting.
      argument=$(jq -jrn --arg encoded "$encoded" '$encoded|@base64d' && printf '.') || return 2
      argument="${argument%.}"
      argv+=("$argument")
    done < <(jq -r --arg event "$event" --argjson index "$index" '.hooks[$event][$index][] | @base64' <<< "$V4_META")
    if ! v4HookExec "${argv[@]}" >&2; then
      v4Error "The ${event} hook failed; the operation stopped." 1
      return $?
    fi
  done
}

function v4SiteOffline() {
  if [ "$(v4Get all false)" = true ]; then v4ToolsBatch v4SiteOffline; return $?; fi
  (
    v4ToolsLoad || exit $?
    local local_mode network=false lock timeout hostfile composer=false
    local_mode=$(jq -r '.profile // "server"' <<< "$V4_META")
    [ "$local_mode" = local ] || { v4Error 'Offline preparation applies to local development projects.' 2; exit $?; }
    timeout=$(v4Get timeout 120)
    if ! { [[ "$timeout" =~ ^[0-9]+$ ]] && [ "$timeout" -gt 0 ] && [ "$timeout" -le 3600 ]; }; then v4Error 'Timeout must be between 1 and 3600 seconds.' 2; exit $?; fi
    lock="$V4_DIR/.operation.lock"
    v4Lock "$lock" || exit $?
    trap 'v4Unlock "$lock"' EXIT
    if [ "$(v4Get update_hosts true)" = true ]; then
      v4HostsEntry add "$V4_HOST" || exit $?
      network=true
    else
      hostfile=$(v4HostsFile) || exit $?
      if [ -r "$hostfile" ] && awk -v host="$V4_HOST" '{sub(/#.*/,""); for(i=2;i<=NF;i++) if(tolower($i)==tolower(host) && ($1=="127.0.0.1" || $1=="::1")) found=1} END {exit !found}' "$hostfile"; then network=true; fi
    fi
    # Include the on-demand Node tools profile in the local image cache.
    v4Compose --profile tools pull || exit $?
    v4Compose --profile tools build || exit $?
    if v4Has composer_version || jq -e '.tools.composer_version != null' <<< "$V4_META" >/dev/null; then
      v4ComposerPhar "$(v4Get composer_version "$(jq -r '.tools.composer_version // "2.10.3"' <<< "$V4_META")")" >/dev/null || exit $?
      composer=true
    fi
    # Start once to materialize the database and resolve runtime setup requirements.
    v4RunHook pre-start || exit $?
    v4Compose up -d || exit $?
    v4WaitReady "$timeout" || exit $?
    v4RunHook post-start || exit $?
    v4Result "$(jq -nc --arg site "$V4_HOST" --argjson resolvable "$network" --argjson composer "$composer" '{site:$site,images_prepared:true,started:true,hosts_entry_present:$resolvable,composer_prepared:$composer,note:"Container images and local runtime are prepared. Install application dependencies before disconnecting; external APIs still require a network connection."}')"
  )
}

function v4SiteDiagnose() {
  local checks='[]' name status detail rc=0 daemon=false facts urls url
  for name in bash jq docker tar gzip curl; do
    status=pass; detail='available'
    if ! type -P "$name" >/dev/null 2>&1; then status=fail; detail='not installed'; rc=1; fi
    checks=$(jq -c --arg name "$name" --arg status "$status" --arg detail "$detail" '. + [{check:$name,status:$status,detail:$detail}]' <<< "$checks") || return 1
  done
  if v4Docker info >/dev/null 2>&1; then daemon=true; status=pass; detail='reachable'; else status=fail; detail='Docker daemon is unavailable or permission was denied'; rc=1; fi
  checks=$(jq -c --arg status "$status" --arg detail "$detail" '. + [{check:"docker-daemon",status:$status,detail:$detail}]' <<< "$checks") || return 1
  if v4Docker compose version >/dev/null 2>&1; then status=pass; detail='available'; else status=fail; detail='Docker Compose v2 is required'; rc=1; fi
  checks=$(jq -c --arg status "$status" --arg detail "$detail" '. + [{check:"docker-compose",status:$status,detail:$detail}]' <<< "$checks") || return 1
  if v4Has site; then
    v4ToolsLoad || return $?
    if v4Compose config -q >/dev/null 2>&1; then status=pass; detail='valid'; else status=fail; detail='Compose or its scoped environment is invalid'; rc=1; fi
    checks=$(jq -c --arg status "$status" --arg detail "$detail" '. + [{check:"project-configuration",status:$status,detail:$detail}]' <<< "$checks") || return 1
    if [ -r "$V4_DOCROOT/configuration.php" ]; then status=pass; detail='present'; else status=fail; detail='Joomla is not installed or configuration.php cannot be read'; rc=1; fi
    checks=$(jq -c --arg status "$status" --arg detail "$detail" '. + [{check:"joomla-configuration",status:$status,detail:$detail}]' <<< "$checks") || return 1
    if "$daemon"; then
      facts=$(v4SiteFacts) || return $?
      if jq -e '.web.running and .frontend.running and .database.state.running and (.web.health==null or .web.health=="healthy") and (.frontend.health==null or .frontend.health=="healthy") and (.database.state.health==null or .database.state.health=="healthy")' <<< "$facts" >/dev/null; then status=pass; detail='core services running'; else status=fail; detail='one or more services are stopped or unhealthy'; rc=1; fi
      checks=$(jq -c --arg status "$status" --arg detail "$detail" '. + [{check:"service-health",status:$status,detail:$detail}]' <<< "$checks") || return 1
      urls=$(v4SiteUrls) || return $?
      url=$(jq -r '.site' <<< "$urls")
      if [ -n "$url" ] && curl --fail --silent --show-error --max-time 15 --output /dev/null "$url/" >/dev/null 2>&1; then status=pass; detail='HTTP route and certificate verification succeeded'; else status=fail; detail='HTTP route failed; inspect hostname resolution, published ports, local trust and proxy settings'; rc=1; fi
      checks=$(jq -c --arg status "$status" --arg detail "$detail" '. + [{check:"site-route",status:$status,detail:$detail}]' <<< "$checks") || return 1
    fi
  fi
  v4Result "$(jq -nc --argjson checks "$checks" '{checks:$checks}')"
  return "$rc"
}

function v4UpdateCheck() {
  local channel remote version current temporary
  channel=$(v4Get channel master)
  case "$channel" in master|staging) ;; *) v4Error 'Update channel must be master or staging.' 2; return $? ;; esac
  temporary=$(umask 077; mktemp "${TMPDIR:-/tmp}/octojoom-version.XXXXXX") || return 1
  if ! curl --fail --silent --show-error --connect-timeout 5 --max-time 20 \
    "https://raw.githubusercontent.com/octoleo/octojoom/${channel}/src/octojoom" -o "$temporary"; then
    rm -f -- "$temporary"
    v4Error 'The update channel could not be checked.' 1
    return $?
  fi
  version=$(sed -nE 's/^_VERSION="([0-9]+\.[0-9]+\.[0-9]+)"$/\1/p' "$temporary" | head -n 1)
  rm -f -- "$temporary"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { v4Error 'The update channel did not return a valid version.' 1; return $?; }
  current="${_VERSION:-4.0.0}"
  remote=false
  local -a available_parts current_parts
  IFS=. read -r -a available_parts <<< "$version"
  IFS=. read -r -a current_parts <<< "$current"
  local index
  for index in 0 1 2; do
    if ((10#${available_parts[index]} > 10#${current_parts[index]})); then remote=true; break; fi
    if ((10#${available_parts[index]} < 10#${current_parts[index]})); then break; fi
  done
  v4Result "$(jq -nc --arg channel "$channel" --arg current "$current" --arg available "$version" --argjson update "$remote" '{channel:$channel,current:$current,available:$available,update_available:$update}')"
}

# Batch actions run the same single-site handler, retaining each site's result.
function v4ToolsBatch() {
  (
    local handler="$1" original="$V4_REQUEST" output="${V4_RESULT_FILE:-}" errors="${V4_ERROR_FILE:-}"
    local directory site temporary result status message overall=0 results='[]'
    shift
    v4Has site && { v4Error 'Select either --site or --all, not both.' 2; exit $?; }
    temporary=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/octojoom-batch.XXXXXX") || exit 1
    trap 'rm -rf -- "$temporary"' EXIT
    for directory in "$VDM_REPO_PATH"/joomla/available/*; do
      if ! { [ -d "$directory" ] && [ ! -L "$directory" ] && [ -f "$directory/docker-compose.yml" ]; }; then continue; fi
      site="${directory##*/}"
      V4_REQUEST=$(jq -c --arg site "$site" '.site=$site | .all=false' <<< "$original") || exit 1
      V4_RESULT_FILE="$temporary/result"; V4_ERROR_FILE="$temporary/error"
      rm -f -- "$V4_RESULT_FILE" "$V4_ERROR_FILE"
      status=0
      "$handler" "$@" > "$temporary/stdout" || status=$?
      [ ! -s "$temporary/stdout" ] || cat "$temporary/stdout" >&2
      result=null
      [ ! -s "$V4_RESULT_FILE" ] || result=$(cat "$V4_RESULT_FILE")
      message=''
      if [ "$status" -ne 0 ]; then
        if [ -s "$V4_ERROR_FILE" ]; then message=$(cat "$V4_ERROR_FILE")
        else message="The site operation exited with status ${status}."; fi
      fi
      results=$(jq -c --arg site "$site" --argjson status "$status" --argjson data "$result" --arg error "$message" '. + [{site:$site,ok:($status==0),exit_code:$status,data:$data,error:(if $status==0 then null else $error end)}]' <<< "$results") || exit 1
      [ "$status" -eq 0 ] || overall=1
    done
    V4_REQUEST="$original"; V4_RESULT_FILE="$output"; V4_ERROR_FILE="$errors"
    v4Result "$(jq -nc --argjson results "$results" '{results:$results,succeeded:([$results[]|select(.ok)]|length),failed:([$results[]|select(.ok|not)]|length)}')"
    [ "$overall" -eq 0 ] || v4Error 'One or more site operations failed; inspect the per-site results.' 1
    exit "$overall"
  )
}

# Hooks around a stopped service use a one-shot container with its entrypoint
# explicitly replaced, so a pre-start hook cannot run the Joomla installer.
function v4HookExec() {
  local state
  state=$(v4ContainerState "$V4_WEB_SERVICE") || return $?
  if jq -e '.running' <<< "$state" >/dev/null; then
    v4Compose exec -T --workdir /var/www/html "$V4_WEB_SERVICE" "$@"
  else
    local executable="$1"
    shift
    v4Compose run --rm --no-deps -T --workdir /var/www/html --entrypoint "$executable" "$V4_WEB_SERVICE" "$@"
  fi
}

function v4ComposerPhar() {
  (
    local version="${1:-2.10.3}" directory temporary expected actual destination
    [[ "$version" =~ ^2\.[0-9]+\.[0-9]+$ ]] || { v4Error 'composer_version must be an explicit Composer 2 release.' 2; exit $?; }
    directory="$V4_DIR/tools"
    [ ! -L "$directory" ] || { v4Error 'The private tools directory must not be a symbolic link.' 2; exit $?; }
    (umask 077; mkdir -p "$directory") || exit 1
    destination="$directory/composer-${version}.phar"
    [ ! -L "$destination" ] || { v4Error 'The Composer executable must not be a symbolic link.' 2; exit $?; }
    if [ "$version" = 2.10.3 ]; then
      expected=7a2d379d5b8ffdaa028580ef26494c36d2feef4b178d3dd1473a4dbc5e17c8d6
    else
      expected=$(curl --fail --silent --show-error --connect-timeout 10 --max-time 30 "https://getcomposer.org/download/${version}/composer.phar.sha256sum") || exit 1
      expected="${expected%% *}"
      [[ "$expected" =~ ^[[:xdigit:]]{64}$ ]] || { v4Error 'Composer did not provide a valid SHA-256 digest.' 1; exit $?; }
    fi
    if [ -f "$destination" ]; then
      actual=$(migrationArchiveDigest "$destination") || exit 1
      if [ "${actual,,}" = "${expected,,}" ]; then printf '%s\n' "$destination"; exit 0; fi
      v4Error 'The cached Composer PHAR failed integrity verification; remove it and retry.' 1
      exit $?
    fi
    temporary=$(mktemp "$directory/.composer.XXXXXX") || exit 1
    trap 'rm -f -- "$temporary"' EXIT
    curl --fail --silent --show-error --connect-timeout 10 --max-time 120 \
      "https://getcomposer.org/download/${version}/composer.phar" -o "$temporary" || exit 1
    actual=$(migrationArchiveDigest "$temporary") || exit 1
    [ "${actual,,}" = "${expected,,}" ] || { v4Error 'The downloaded Composer PHAR failed integrity verification.' 1; exit $?; }
    chmod 644 "$temporary" || exit 1
    # Never replace an executable another operation has published concurrently.
    ln "$temporary" "$destination" || exit 1
    printf '%s\n' "$destination"
  )
}

