# Optional customization contract: 0 configured, 1 explicitly declined,
# >=2 failed or cancelled. Once selected, an ordinary command failure (1)
# must never be confused with declining the customization.
function setPHPSettings() {
  local customization_status
  case "${VDM_PHP_SETTINGS:-}" in
    false) return 1;;
    true) configurePHPSettings; customization_status=$?; [ "$customization_status" -ne 1 ] || customization_status=2; return "$customization_status";;
