function main() {
  # we check if we have a type and a task
  # we use the __TRuST__ convention AS "PUBLIC METHODS" to avoid wrong calls, and hide other functions
  if [ ${#VDM_CONTAINER_TYPE} -ge 1 ] && [ ${#VDM_TASK} -ge 1 ] && isFunc "${VDM_CONTAINER_TYPE}__TRuST__${VDM_TASK}"; then
    "${VDM_CONTAINER_TYPE}__TRuST__${VDM_TASK}"
  elif [ -n "${VDM_CONTAINER_TYPE}" ] || [ -n "${VDM_TASK}" ]; then
    echo >&2 "ERROR: Unsupported container type or task: ${VDM_CONTAINER_TYPE:-<missing type>}/${VDM_TASK:-<missing task>}."
    return 17
  else
    mainMenu
  fi
}

#####################################################################################################################VDM
######################################## SETUP TRAEFIK
function traefik__TRuST__setup() {
  # load this container type globals
  # shellcheck disable=SC1090
  if [ -f "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" ]; then
    loadEnvFile "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" || return 1
  fi
  # check if we have secure switch set
  setSecureState
  # removed cloudflare features by default
  VDM_REMOVE_CLOUDFLARE_SERVICE="#"
  # setup letsencrypt stuff
  VDM_REMOVE_SECURE=''
  VDM_HTTP_SCHEME="https"
  if $VDM_SECURE; then
    setSecureCloudflareState "traefik"
    # get the email if not set
    while [ ${#VDM_SECURE_EMAIL} -le 1 ]; do
      # get the value
      VDM_SECURE_EMAIL=$(getInput 'Enter email for the Letsencrypt setup.' '' 'Enter Valid Email') || return $?
      # keep asking
      [ ${#VDM_SECURE_EMAIL} -ge 1 ] || {
        showError "You must enter an email for the Letsencrypt setup."
      }
    done
    setContainerEnvVariable "VDM_SECURE_EMAIL=\"${VDM_SECURE_EMAIL}\"" || return $?
    if $VDM_SECURE_CLOUDFLARE; then
      VDM_REMOVE_CLOUDFLARE_SERVICE=''
      # get the api token if not set
      while [ ${#VDM_CLOUDFLARE_DNS_API_TOKEN} -le 1 ]; do
        # get the value
        VDM_CLOUDFLARE_DNS_API_TOKEN=$(getInput 'Enter your Cloudflare API token that has Zone:DNS:Edit permission used with API DNS lookup for the auto-resolver in the ACME.' '' 'Enter Valid Email') || return $?
        # keep asking
        [ ${#VDM_CLOUDFLARE_DNS_API_TOKEN} -ge 1 ] || {
          showError "You must enter your Cloudflare API token that has Zone:DNS:Edit permission used with API DNS lookup for the auto-resolver in the ACME."
        }
      done
      setContainerEnvVariable "VDM_CLOUDFLARE_DNS_API_TOKEN=\"${VDM_CLOUDFLARE_DNS_API_TOKEN}\"" || return $?
    fi
    # make sure the directory exist
    mkdir -p "${VDM_PROJECT_PATH}/traefik" || return 1
    # Preserve certificates and account keys when setup is run again.
    local acme_file
    for acme_file in acme.json acme-cloudflare.json; do
      if [ ! -e "${VDM_PROJECT_PATH}/traefik/${acme_file}" ]; then
        printf '{}\n' >"${VDM_PROJECT_PATH}/traefik/${acme_file}" || return 1
      elif [ ! -f "${VDM_PROJECT_PATH}/traefik/${acme_file}" ]; then
        showError "The ACME storage (${acme_file}) must be a file."
        return 1
      fi
      sudo chmod 600 "${VDM_PROJECT_PATH}/traefik/${acme_file}" || return 1
    done
    # and is owned by root
    sudo chown -R 0:0 "${VDM_PROJECT_PATH}/traefik" || return 1
  else
    VDM_REMOVE_SECURE="#"
    VDM_HTTP_SCHEME="http"
  fi
  # set the main domain if not set
  setMainDomain || return $?
  ##########################
  ### export all we need
  # global
  export VDM_CONTAINER_TYPE
  export VDM_REPO_PATH
  export VDM_PROJECT_PATH
  # container
  export VDM_REMOVE_SECURE
  export VDM_HTTP_SCHEME
  saveContainerCompose traefikContainer "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/docker-compose.yml" || return 1
  # saved the file
  showNotice "Saved ${VDM_CONTAINER_TYPE}:docker-compose.yml file.\nSetup of this container is complete!"
  # ask if we should continue to enable
  if getInputYesNo "Would you also like to enable this ${VDM_CONTAINER_TYPE^} container" \
    "Enable Container" 8 112 "defaultno"; then
    enableContainer "${VDM_CONTAINER_TYPE}" || return $?
  fi
  ##########################
  ### unset all no longer needed
  # container
  unset VDM_REMOVE_SECURE
  unset VDM_HTTP_SCHEME
  # return a success
  return 0
}

# Return the Traefik Container setup YAML
function traefikContainer() {
  cat <<EOF
services:
  traefik:
    container_name: traefik
    image: "traefik:latest"
${VDM_REMOVE_CLOUDFLARE_SERVICE}    environment:
${VDM_REMOVE_CLOUDFLARE_SERVICE}      - CLOUDFLARE_DNS_API_TOKEN=\${VDM_CLOUDFLARE_DNS_API_TOKEN:-}
    command:
      # Entrypoints
      - --entrypoints.web.address=:80
      - --entrypoints.websecure.address=:443
#      - --api.dashboard=true
#      - --api.insecure=true

      # Forwarded headers are trusted only from explicitly configured proxies.
#      - --entrypoints.web.forwardedheaders.trustedips=192.0.2.0/24
#      - --entrypoints.websecure.forwardedheaders.trustedips=192.0.2.0/24

      # Providers
      - --providers.docker=true
      - --providers.docker.exposedbydefault=false
      - --providers.file.directory=/conf
      - --providers.file.watch=true

      # Logging
      - --log.level=INFO
      - --accesslog=true
      - --accesslog.filepath=/logs/access.log

      # ACME - HTTP resolver for non-Cloudflare domains
${VDM_REMOVE_SECURE}      - --certificatesresolvers.vdmresolver.acme.httpchallenge=true
${VDM_REMOVE_SECURE}      - --certificatesresolvers.vdmresolver.acme.httpchallenge.entrypoint=web
${VDM_REMOVE_SECURE}      - --certificatesresolvers.vdmresolver.acme.email=\${VDM_SECURE_EMAIL:-user@demo.com}
${VDM_REMOVE_SECURE}      - --certificatesresolvers.vdmresolver.acme.storage=/acme.json
${VDM_REMOVE_SECURE}      - --certificatesresolvers.vdmresolver.acme.keytype=RSA4096

      # ACME - DNS resolver for Cloudflare-proxied domains
${VDM_REMOVE_CLOUDFLARE_SERVICE}      - --certificatesresolvers.cfresolver.acme.dnschallenge.provider=cloudflare
${VDM_REMOVE_CLOUDFLARE_SERVICE}      - --certificatesresolvers.cfresolver.acme.email=\${VDM_SECURE_EMAIL:-user@demo.com}
${VDM_REMOVE_CLOUDFLARE_SERVICE}      - --certificatesresolvers.cfresolver.acme.storage=/acme-cloudflare.json
${VDM_REMOVE_CLOUDFLARE_SERVICE}      - --certificatesresolvers.cfresolver.acme.keytype=RSA4096

    restart: unless-stopped

    ports:
      - "80:80"
      - "443:443"

    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - "\${VDM_PROJECT_PATH}/traefik/logs:/logs"
      - "\${VDM_PROJECT_PATH}/traefik/errors:/errors"
      - "\${VDM_PROJECT_PATH}/traefik/conf:/conf"
${VDM_REMOVE_SECURE}      - "\${VDM_PROJECT_PATH}/traefik/acme.json:/acme.json"
${VDM_REMOVE_SECURE}      - "\${VDM_PROJECT_PATH}/traefik/acme-cloudflare.json:/acme-cloudflare.json"

    labels:
      - "traefik.enable=true"

      # Global HTTP -> HTTPS redirect
${VDM_REMOVE_SECURE}      - "traefik.http.routers.http-catchall.rule=HostRegexp(\`.+\`)"
${VDM_REMOVE_SECURE}      - "traefik.http.routers.http-catchall.entrypoints=web"
${VDM_REMOVE_SECURE}      - "traefik.http.routers.http-catchall.middlewares=redirect-https"
${VDM_REMOVE_SECURE}      - "traefik.http.middlewares.redirect-https.redirectscheme.scheme=https"
${VDM_REMOVE_SECURE}      - "traefik.http.middlewares.redirect-https.redirectscheme.permanent=true"

      # Security headers
      - "traefik.http.middlewares.joomla-security.headers.stsSeconds=63072000"
      - "traefik.http.middlewares.joomla-security.headers.stsIncludeSubdomains=true"
      - "traefik.http.middlewares.joomla-security.headers.stsPreload=true"
      - "traefik.http.middlewares.joomla-security.headers.browserXssFilter=true"
      - "traefik.http.middlewares.joomla-security.headers.contentTypeNosniff=true"
#      - "traefik.http.middlewares.joomla-security.headers.referrerPolicy=same-origin"

      # Cloudflare middleware
${VDM_REMOVE_CLOUDFLARE_SERVICE}      - "traefik.http.middlewares.cloudflare.headers.customrequestheaders.X-Forwarded-Proto=https"

    networks:
      - traefik

networks:
  traefik:
    external: true
    name: ${VDM_TRAEFIK_GATEWAY:-traefik_webgateway}
EOF
}

#####################################################################################################################VDM
######################################## SETUP PORTAINER
function portainer__TRuST__setup() {
  # load this container type globals
  # shellcheck disable=SC1090
  if [ -f "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" ]; then
    loadEnvFile "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" || return 1
  fi
  # check if we have secure switch set
  setSecureState
  # setup letsencrypt stuff
  VDM_PORT_SECURE_LABELS=''
  VDM_REMOVE_SECURE=''
  VDM_ENTRY_POINT="websecure"
  VDM_CERT_RESOLVER="vdmresolver"
  if $VDM_SECURE; then
    VDM_PORT_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.routers.portainer.entrypoints=${VDM_ENTRY_POINT}\"")
    setSecureCloudflareState "portainer"
    if $VDM_SECURE_CLOUDFLARE; then
      VDM_CERT_RESOLVER="cfresolver"
    fi
    VDM_PORT_SECURE_LABELS+=$(getYMLine3 "- \"traefik.http.routers.portainer.tls.certresolver=${VDM_CERT_RESOLVER}\"")
  else
    VDM_REMOVE_SECURE="#"
    VDM_ENTRY_POINT="web"
  fi
  # set the domain
  setDomain || return $?
  # get the sub domain if not set
  setSubDomain 'port' '' 'joomla' || return $?
  ##########################
  ### export all we need
  # global
  export VDM_CONTAINER_TYPE
  export VDM_REPO_PATH
  export VDM_PROJECT_PATH
  # container
  export VDM_REMOVE_SECURE
  export VDM_ENTRY_POINT
  export VDM_PORT_SECURE_LABELS
  export VDM_CERT_RESOLVER
  # set host file if needed
  updateHostFile
  saveContainerCompose portainerContainer "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/docker-compose.yml" || return 1
  # saved the file
  showNotice "Saved ${VDM_CONTAINER_TYPE}:docker-compose.yml file.\nSetup of this container is complete!"
  # ask if we should continue to enable
  if getInputYesNo "Would you also like to enable this ${VDM_CONTAINER_TYPE^} container" \
    "Enable Container" 8 112 "defaultno"; then
    enableContainer "${VDM_CONTAINER_TYPE}" || return $?
  fi
  ##########################
  ### unset all no longer needed
  # container
  unset VDM_SUBDOMAIN
  unset VDM_REMOVE_SECURE
  unset VDM_ENTRY_POINT
  unset VDM_PORT_SECURE_LABELS
  unset VDM_CERT_RESOLVER
  # return a success
  return 0
}

# return the Portainer Container setup yml
