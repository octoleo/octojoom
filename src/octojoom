function v4ValidateRequest() {
  local schema unknown key type allowed actual
  schema=$(v4RequestSchema) || return 2
  if ! jq -e 'type == "object" and (.schema_version // 1) == 1 and
    all(.. | strings; test("[[:cntrl:]]") | not)' <<< "$V4_REQUEST" >/dev/null 2>&1; then
    v4Error 'Configuration must be a JSON object with schema_version 1 and without control characters.' 2
    return 2
  fi
  unknown=$(jq -r --argjson schema "$schema" 'keys[] as $key | select($schema.options | has($key) | not) | $key' <<< "$V4_REQUEST") || return 2
  if [ -n "$unknown" ]; then
    v4Error "Unknown configuration option names: ${unknown//$'\n'/, }. Run 'octojoom site schema' for the supported contract." 2
    return 2
  fi
  while IFS= read -r key; do
    type=$(jq -r --arg key "$key" '.[$key] | type' <<< "$V4_REQUEST") || return 2
    allowed=$(jq -r --arg key "$key" '.options[$key]' <<< "$schema") || return 2
    case "$allowed:$type" in
      string:string|boolean:boolean|integer:number|object:object|array:array|string\|array:string|string\|array:array) ;;
      *) v4Error "Invalid value type for ${key//_/-}; expected $allowed." 2; return 2 ;;
    esac
    if [ "$allowed" = integer ]; then
      actual=$(jq -r --arg key "$key" '.[$key]' <<< "$V4_REQUEST")
      [[ "$actual" =~ ^[0-9]+$ ]] || { v4Error "${key//_/-} must be a non-negative integer." 2; return 2; }
    fi
  done < <(jq -r 'keys[]' <<< "$V4_REQUEST")
  if ! jq -e '
    all((.args // [])[]; type=="string") and
    all((.sites // [])[]; type=="string") and
    (if (.tables|type)=="array" then all(.tables[]; type=="string") else true end) and
    (if (.command|type)=="array" then all(.command[]; type=="string") else true end) and
    all((.commands // [])[]; type=="array" and length>0 and all(.[]; type=="string"))
  ' <<< "$V4_REQUEST" >/dev/null; then
    v4Error 'Argument and table arrays may contain only strings.' 2
    return 2
  fi
  if v4Has hooks; then
    declare -F v4ValidateHooks >/dev/null || { v4Error 'Hook request validation is unavailable in this build.' 3; return 3; }
    v4ValidateHooks "$(v4Get hooks)" || return $?
  fi
}


# The action registry also drives the TUI; reject valid global option names that
# this selected action would otherwise silently ignore.
function v4ValidateActionRequest() {
  local registry fields unknown action="${V4_GROUP}.${V4_ACTION}"
  case "$action" in
    site.help|site.schema|site.version) fields='[]' ;;
    *)
      declare -F v4ActionSchemas >/dev/null || { v4Error 'The action registry is unavailable in this build.' 3; return 3; }
      registry=$(v4ActionSchemas) || return 3
      fields=$(jq -ec --arg action "$action" '.[$action].fields | arrays' <<< "$registry") || { v4Error 'The selected action has no request contract.' 3; return 3; }
      ;;
  esac
  unknown=$(jq -r --argjson fields "$fields" '
    ($fields + ["schema_version","json","no_interaction","yes","repo_path","project_path","backup_path"]) as $allowed |
    keys[] as $key | select(($allowed | index($key)) == null) | $key' <<< "$V4_REQUEST") || return 2
  if [ -n "$unknown" ]; then
    v4Error "Unsupported options for $action: ${unknown//$'\n'/, }. Consult site schema for this action's fields." 2
    return 2
  fi
  if ! jq -e '[(if (.site // "")!="" then 1 else 0 end), (if .all==true then 1 else 0 end), (if ((.sites // [])|length)>0 then 1 else 0 end)] | add <= 1' <<< "$V4_REQUEST" >/dev/null; then
    v4Error 'Choose one target selection: --site, --sites, or --all.' 2
    return 2
  fi
  V4_REQUEST=$(jq -c 'if .site=="" then del(.site) else . end | if .sites==[] then del(.sites) else . end' <<< "$V4_REQUEST") || return 2
}

# Published form descriptors are exactly the descriptors consumed by the TUI.
function v4FormSchemas() {
  local schema registry
  schema=$(v4RequestSchema) || return 1
  registry=$(v4ActionSchemas) || return 1
  jq -c --argjson schema "$schema" '
    with_entries(.value |= (
    . as $action | .fields = [.fields[] | . as $name |
      select($schema.options[$name] != null) |
      {name:$name,type:(if $name=="tables" then "array" elif $name=="command" then "string" else $schema.options[$name] end),required:(($action.required // [])|index($name)!=null),
       default:(if (($action.defaults // {})|has($name)) then $action.defaults[$name] else null end),secret:($name|test("password|token")),
       description:($name|gsub("_";" ")),
       enum:(if $name == "webserver" then ["apache","nginx"]
        elif $name == "profile" then ["local","server"]
        elif $name == "database_engine" then ["mariadb","mysql","postgres"]
        elif $name == "tls_mode" then (if $action.title=="Create Joomla site" or $action.title=="Import existing Joomla" then ["none","acme"] else ["none","local","acme"] end)
        elif $name == "direction" then ["push","pull"]
        elif $name == "target" and $action.title=="Project directory" then ["project","docroot"]
        elif $name == "target" then ["site","admin","database","mail","directory"]
        elif $name == "scope" then ["full","site","database"]
        elif $name == "format" then ["tar.gz","zip"]
        elif $name == "state" then ["all","running","stopped"]
        elif $name == "channel" then ["master","staging"]
        elif $name == "mode" then ["clone","replace","fresh"]
        elif $name == "service" and $action.title=="Optional project service" then ["mail","redis","node"]
        else [] end)}]
    ))' <<< "$registry"
}

function v4Parse() {
  local config='' group='' action='' option key value kind schema file_json='{}' flags='{}' legacy_type='' legacy_task='' input_data
  local positionals=() explicit_args=()
  V4_REQUEST='{}'
  V4_ARGS=()
  V4_GROUP=''
  V4_ACTION=''
  V4_JSON=false
  schema=$(v4RequestSchema) || return 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --) shift; explicit_args=("$@"); break ;;
      -h|--help) group=site; action=help; shift; continue ;;
      --version) group=site; action=version; shift; continue ;;
      --type|--type=*)
        if [[ "$1" == *=* ]]; then legacy_type=${1#*=}; else [ "$#" -ge 2 ] || { v4Error '--type requires a value.' 2; return 2; }; shift; legacy_type=$1; fi
        shift; continue ;;
      --task|--task=*)
        if [[ "$1" == *=* ]]; then legacy_task=${1#*=}; else [ "$#" -ge 2 ] || { v4Error '--task requires a value.' 2; return 2; }; shift; legacy_task=$1; fi
        shift; continue ;;
      --config|--config=*)
        [ -z "$config" ] || { v4Error 'Only one --config input is permitted.' 2; return 2; }
        if [[ "$1" == *=* ]]; then config=${1#*=}; else [ "$#" -ge 2 ] || { v4Error '--config requires a filename or -.' 2; return 2; }; shift; config=$1; fi
        [ -n "$config" ] || { v4Error '--config requires a filename or -.' 2; return 2; }
        shift; continue ;;
      --container|--container=*)
        if [[ "$1" == *=* ]]; then value=${1#*=}; else [ "$#" -ge 2 ] || { v4Error '--container requires a site.' 2; return 2; }; shift; value=$1; fi
        flags=$(jq -c --arg value "$value" '.site=$value' <<< "$flags") || return 2
        shift; continue ;;
      --*)
        option=${1%%=*}; key=${option#--}; key=${key//-/_}
        kind=$(jq -r --arg key "$key" '.options[$key] // empty' <<< "$schema") || return 2
        [ -n "$kind" ] || { v4Error "Unknown option name: $option." 2; return 2; }
        if [[ "$1" == *=* ]]; then
          value=${1#*=}
        elif [ "$kind" = boolean ]; then
          value=true
          if [ "$#" -gt 1 ] && [[ "$2" == true || "$2" == false ]]; then shift; value=$1; fi
        else
          if ! { [ "$#" -gt 1 ] && [[ "$2" != --* ]]; }; then v4Error "$option requires a value." 2; return 2; fi
          shift; value=$1
        fi
        case "$kind" in
          boolean)
            [[ "$value" == true || "$value" == false ]] || { v4Error "$option expects true or false." 2; return 2; }
            flags=$(jq -c --arg key "$key" --argjson value "$value" '.[$key]=$value' <<< "$flags") || return 2
            [ "$key" != json ] || V4_JSON="$value"
            ;;
          integer)
            [[ "$value" =~ ^[0-9]+$ ]] || { v4Error "$option expects a non-negative integer." 2; return 2; }
            flags=$(jq -c --arg key "$key" --arg value "$value" '.[$key]=($value|tonumber)' <<< "$flags") || return 2 ;;
          object|array)
            jq -e --arg kind "$kind" 'type==$kind' <<< "$value" >/dev/null 2>&1 || { v4Error "$option expects a JSON $kind." 2; return 2; }
            flags=$(jq -c --arg key "$key" --argjson value "$value" '.[$key]=$value' <<< "$flags") || return 2 ;;
          string\|array)
            if [[ "$value" == \[* ]]; then
              jq -e -s 'length==1 and (.[0]|type=="array" and all(.[]; type=="string"))' <<< "$value" >/dev/null 2>&1 || { v4Error "$option expects text or a JSON array of strings." 2; return 2; }
              flags=$(jq -c --arg key "$key" --argjson value "$value" '.[$key]=$value' <<< "$flags") || return 2
            else
              flags=$(jq -c --arg key "$key" --arg value "$value" '.[$key]=$value' <<< "$flags") || return 2
            fi ;;
          *) flags=$(jq -c --arg key "$key" --arg value "$value" '.[$key]=$value' <<< "$flags") || return 2 ;;
        esac
        shift; continue ;;
      -*) v4Error 'Unknown short option. Use the documented long options.' 2; return 2 ;;
      *) positionals+=("$1"); shift ;;
    esac
  done
  if [ -n "$config" ]; then
    if [ "$config" = - ]; then input_data=$(cat) || return 2;
    else
      if ! { [ -f "$config" ] && [ -r "$config" ]; }; then v4Error 'The JSON configuration file cannot be read.' 2; return 2; fi
      input_data=$(cat -- "$config") || return 2
    fi
    file_json=$(jq -ec -s 'if length==1 and (.[0]|type)=="object" then .[0] else error("object required") end' <<< "$input_data" 2>/dev/null) || {
      v4Error 'The configuration input must contain exactly one JSON object.' 2; return 2;
    }
  fi
  file_json=$(v4NormalizeOptions "$file_json") || { v4Error 'The JSON configuration contains conflicting option aliases.' 2; return 2; }
  flags=$(v4NormalizeOptions "$flags") || { v4Error 'The command flags contain conflicting option aliases.' 2; return 2; }
  V4_REQUEST=$(jq -cn --argjson file "$file_json" --argjson flags "$flags" '$file + $flags | .schema_version //= 1') || return 2
  V4_JSON=$(v4Get json false)
  v4ValidateRequest || return $?
  if [ "${#positionals[@]}" -gt 2 ]; then v4Error 'Expected an action group and action; place tool arguments after --.' 2; return 2; fi
  if [ "${#positionals[@]}" -gt 0 ]; then
    [ -z "$legacy_type$legacy_task$group$action" ] || { v4Error 'Do not combine positional actions with legacy --type/--task or help flags.' 2; return 2; }
    group=${positionals[0]}; action=${positionals[1]:-help}
  elif [ -n "$legacy_type$legacy_task" ]; then
    [[ "$legacy_type" == joomla ]] || { v4Error 'The v4 command API supports --type joomla.' 2; return 2; }
    group=site; action="$legacy_task"
    case "$action" in
      setup) action=create ;;
      enable) action=start; V4_REQUEST=$(jq -c '.enable=true' <<< "$V4_REQUEST") ;;
      disable) action=stop; V4_REQUEST=$(jq -c '.disable=true' <<< "$V4_REQUEST") ;;
      db-export) group=database; action='export' ;; db-import) group=database; action=import ;;
      db-console) group=database; action=console ;; db-switch) group=database; action=switch ;;
      backup|backup-create) group=backup; action=create ;; backup-list) group=backup; action=list ;;
      backup-restore|restore) group=backup; action=restore ;; backup-delete) group=backup; action=delete ;;
      snapshot|snapshot-create) group=snapshot; action=create ;; snapshot-list) group=snapshot; action=list ;;
      snapshot-restore) group=snapshot; action=restore ;; snapshot-delete) group=snapshot; action=delete ;;
      tls|tls-setup) group=tls; action=setup ;; tls-disable) group=tls; action=disable ;;
      share|share-start) group=share; action=start ;; share-stop) group=share; action=stop ;;
      share-status) group=share; action=status ;; mail) group=mail; action=configure ;;
      service) group=service; action=configure ;; hook) group=hook; action=configure ;;
      update-check) group=update; action=check ;; update-apply) group=update; action=apply ;;
    esac
  fi
  V4_GROUP="${group:-site}"; V4_ACTION="${action:-help}"
  if [ "$V4_GROUP:$V4_ACTION" != site:version ] && ! jq -e --arg group "$V4_GROUP" --arg action "$V4_ACTION" '.actions[$group] | arrays | index($action) != null' <<< "$schema" >/dev/null 2>&1; then
    v4Error 'Unknown action. Run octojoom site schema for supported actions.' 2; return 2
  fi
  if [ "${#explicit_args[@]}" -gt 0 ]; then
    V4_ARGS=("${explicit_args[@]}")
  elif v4Has args; then
    while IFS= read -r value; do V4_ARGS+=("$(jq -r . <<< "$value")"); done < <(jq -c '.args[]' <<< "$V4_REQUEST")
  fi
  case "$V4_GROUP:$V4_ACTION" in
    site:exec|site:joomla|site:composer|site:npm|site:shell|database:console) ;;
    *) [ "${#V4_ARGS[@]}" -eq 0 ] || { v4Error 'This action does not accept trailing tool arguments.' 2; return 2; } ;;
  esac
}

function v4Init() {
  local root src repo projects backup
  # Read by legacy filesystem privilege helpers invoked through this API.
  # shellcheck disable=SC2034
  case "${OSTYPE:-}" in
    linux-gnu*) OS_NUMBER=1 ;; darwin*) OS_NUMBER=2 ;; msys*|cygwin*) OS_NUMBER=3 ;; *) OS_NUMBER=0 ;;
  esac
  root="${OCTOJOOM_HOME:-${HOME:-}}"
  [ -n "$root" ] || { v4Error 'HOME or OCTOJOOM_HOME must be configured.' 3; return 3; }
  root=$(v4CanonicalRoot "$root") || return $?
  src="$root/.config/octojoom"
  VDM_HOME_PATH="$root"; VDM_SRC_PATH="$src"
  if [ -f "$src/.env" ]; then
    loadEnvFile "$src/.env" || { v4Error 'The saved OctoJoom configuration is invalid.' 2; return 2; }
  fi
  VDM_HOME_PATH="$root"; VDM_SRC_PATH="$src"
  repo=$(v4Get repo_path "${VDM_REPO_PATH:-$root/Docker}") || return 2
  projects=$(v4Get project_path "${VDM_PROJECT_PATH:-$root/Projects}") || return 2
  backup=$(v4Get backup_path "${VDM_BACKUP_PATH:-$root/Backups/octojoom}") || return 2
  if ! v4ValidAbsolutePath "$repo" || ! v4ValidAbsolutePath "$projects" || ! v4ValidAbsolutePath "$backup"; then
    v4Error 'Repository, project and backup paths must be absolute, non-root paths without parent traversal.' 2; return 2;
  fi
  repo=$(v4CanonicalRoot "$repo") || return $?
  projects=$(v4CanonicalRoot "$projects") || return $?
  backup=$(v4CanonicalRoot "$backup") || return $?
  VDM_REPO_PATH="$repo"; VDM_PROJECT_PATH="$projects"; VDM_BACKUP_PATH="$backup"
  VDM_CONTAINER_TYPE=joomla
  export VDM_HOME_PATH VDM_SRC_PATH VDM_REPO_PATH VDM_PROJECT_PATH VDM_BACKUP_PATH VDM_CONTAINER_TYPE
}

function v4ValidAbsolutePath() {
  local path="$1"
  [[ "$path" == /* && "$path" != / && "$path" != *$'\n'* && "$path" != *$'\r'* && "$path" != *$'\t'* && "$path" != */../* && "$path" != */.. && "$path" != */./* && "$path" != */. && "$path" != *//* ]]
}


# Canonicalize the existing ancestor, retaining any not-yet-created suffix. This
# accepts system aliases such as macOS /var and /tmp without weakening the
# symlink checks on managed project paths below these explicitly chosen roots.
function v4CanonicalRoot() {
  local path="${1%/}" ancestor suffix='' physical part
  v4ValidAbsolutePath "$path" || { v4Error 'Configured roots must be absolute non-root paths without traversal.' 2; return 2; }
  ancestor="$path"
  while [ ! -e "$ancestor" ]; do
    [ ! -L "$ancestor" ] || { v4Error 'A configured root contains a dangling symbolic link.' 2; return 2; }
    part="${ancestor##*/}"; suffix="/$part$suffix"
    ancestor="${ancestor%/*}"
    [ -n "$ancestor" ] || ancestor=/
  done
  [ -d "$ancestor" ] || { v4Error 'The configured root has an ancestor that is not a directory.' 2; return 2; }
  physical=$(cd -P -- "$ancestor" && pwd -P) || { v4Error 'The configured root cannot be resolved.' 2; return 2; }
  path="${physical%/}$suffix"
  v4ValidAbsolutePath "$path" || { v4Error 'The configured root resolves to an invalid filesystem root.' 2; return 2; }
  printf '%s\n' "$path"
}

function v4ValidateMetadata() {
  jq -e -s 'length==1' <<< "$1" >/dev/null 2>&1 || return 1
  if ! jq -e '
    type == "object" and .schema_version == 1 and
    (.host|type=="string") and (.key|type=="string" and test("^[A-Za-z][A-Za-z0-9_-]*$")) and
    (.env_key|type=="string" and test("^[A-Z][A-Z0-9_]*$")) and
    (.project_dir|type=="string") and (.docroot|type=="string" and length>0 and (startswith("/")|not) and (contains("\\")|not) and (test("(^|/)\\.\\.?(/|$)")|not)) and
    (.image|type=="string" and test("^[A-Za-z0-9][A-Za-z0-9._:/@-]*$")) and
    (.webserver == "apache" or .webserver == "nginx") and
    (.profile == "local" or .profile == "server") and
    (.database|type=="object") and
    (.database.engine == "mariadb" or .database.engine == "mysql" or .database.engine == "postgres") and
    (.database.version|type=="string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and
    (.database.name|type=="string" and test("^[A-Za-z0-9_]+$")) and
    (.database.user|type=="string" and test("^[A-Za-z0-9_]+$")) and
    (.tls.mode == "none" or .tls.mode == "local" or .tls.mode == "acme") and
    (.services|type=="object") and (.hooks|type=="object") and
    all(.. | strings; test("[[:cntrl:]]") | not)
  ' <<< "$1" >/dev/null 2>&1; then return 1; fi
  declare -F v4ValidateHooks >/dev/null || return 1
  v4ValidateHooks "$(jq -c '.hooks' <<< "$1")"
}

function v4LoadSite() {
  local host="${1:-}" metadata root key value image webserver=apache database_user='' database_image='' database_version='' joomla_version='' php_version=''
  isValidDomain "$host" || { v4Error 'Select a valid site hostname.' 2; return 2; }
  V4_HOST="$host"; V4_DIR="${VDM_REPO_PATH}/joomla/available/$host"
  V4_COMPOSE="$V4_DIR/docker-compose.yml"
  if ! { [ ! -L "$V4_DIR" ] && [ ! -L "$V4_COMPOSE" ] && [ -f "$V4_COMPOSE" ]; }; then v4Error 'The selected site does not have a regular Compose project.' 3; return 3; fi
  V4_ENV_FILE=$(getContainerEnvFile joomla "$host" available)
  if ! { [ -n "$V4_ENV_FILE" ] && [ ! -L "$V4_ENV_FILE" ]; }; then v4Error 'The selected site has no readable environment file.' 3; return 3; fi
  metadata="$V4_DIR/project.json"
  V4_LEGACY=false; V4_NAMED_VOLUMES=false
  if [ -f "$metadata" ]; then
    [ ! -L "$metadata" ] || { v4Error 'Project metadata must be a regular file.' 2; return 2; }
    V4_META=$(cat "$metadata") || return 2
    v4ValidateMetadata "$V4_META" || { v4Error 'Project metadata is invalid or uses an unsupported schema.' 2; return 2; }
    [ "$(jq -r .host <<< "$V4_META")" = "$host" ] || { v4Error 'Project metadata does not match the selected hostname.' 2; return 2; }
    V4_KEY=$(jq -r .key <<< "$V4_META"); V4_ENV_KEY=$(jq -r .env_key <<< "$V4_META")
    V4_PROJECT=$(jq -r .project_dir <<< "$V4_META")
    V4_DOCROOT="$V4_PROJECT/$(jq -r .docroot <<< "$V4_META")"
    V4_DB_ENGINE=$(jq -r .database.engine <<< "$V4_META")
    v4ValidAbsolutePath "$V4_PROJECT" || { v4Error 'Project metadata contains an invalid project path.' 2; return 2; }
    root="${VDM_PROJECT_PATH%/}"
    migrationReadEnvValue "$V4_ENV_FILE" VDM_PROJECT_PATH root || true
    [ "$V4_PROJECT" = "${root%/}/$V4_KEY" ] || { v4Error 'Project metadata disagrees with the configured project root.' 2; return 2; }
  else
    getJoomlaComposeIdentity "$V4_COMPOSE" || { v4Error 'This legacy Compose layout cannot be identified safely.' 2; return 2; }
    V4_LEGACY=true; V4_KEY="$VDM_SRC_KEY"; V4_ENV_KEY="$VDM_SRC_ENV_KEY"
    V4_NAMED_VOLUMES="$VDM_SRC_NAMED_VOLUMES"; V4_DB_ENGINE=mariadb
    root="$VDM_PROJECT_PATH"
    migrationReadEnvValue "$V4_ENV_FILE" VDM_PROJECT_PATH root || true
    key="${VDM_SRC_PROJECT_FOLDER:-$V4_KEY}"
    if ! isSafeProjectName "$key" || ! v4ValidAbsolutePath "$root"; then v4Error 'The legacy project path is invalid.' 2; return 2; fi
    V4_PROJECT="${root%/}/$key"; V4_DOCROOT="$V4_PROJECT/joomla"
    image=$(awk -v service="joomla$V4_KEY" '
      $0 ~ "^  " service ":" {inside=1;next}
      inside && /^  [^ ]/ {exit}
      inside && /^    image:/ {sub(/^    image:[[:space:]]*/,"");gsub(/[\047\"]/,"");print;exit}' "$V4_COMPOSE")
    [[ "$image" != *fpm* ]] || webserver=nginx
    value=''
    migrationReadEnvValue "$V4_ENV_FILE" "VDM_${V4_ENV_KEY}_DB" value || true
    migrationReadEnvValue "$V4_ENV_FILE" "VDM_${V4_ENV_KEY}_DB_USER" database_user || true
    database_image=$(awk -v service="mariadb$V4_KEY" '
      $0 ~ "^  " service ":" {inside=1;next}
      inside && /^  [^ ]/ {exit}
      inside && /^    image:/ {sub(/^    image:[[:space:]]*/,"");gsub(/[\047\"]/,"");print;exit}' "$V4_COMPOSE")
    case "$database_image" in *:*) database_version=${database_image##*:} ;; *) database_version=latest ;; esac
    if [[ "$image" =~ :([0-9]+(\.[0-9]+){0,2})-php([0-9]+\.[0-9]+)(-|$) ]]; then
      joomla_version=${BASH_REMATCH[1]}; php_version=${BASH_REMATCH[3]}
    fi
    V4_META=$(jq -cn --arg host "$host" --arg key "$V4_KEY" --arg env "$V4_ENV_KEY" --arg project "$V4_PROJECT" \
      --arg image "$image" --arg joomla "$joomla_version" --arg php "$php_version" --arg database "$value" \
      --arg user "$database_user" --arg version "$database_version" --arg webserver "$webserver" \
      --argjson mail "$VDM_SRC_MAILCATCHER" --argjson secure "$VDM_SRC_SECURE" \
      '{schema_version:1,host:$host,key:$key,env_key:$env,project_dir:$project,docroot:"joomla",image:$image,joomla_version:$joomla,php_version:$php,webserver:$webserver,profile:(if $secure then "server" else "local" end),database:{engine:"mariadb",version:$version,name:$database,user:$user},tls:{mode:(if $secure then "acme" else "none" end),resolver:"vdmresolver"},services:{mail:$mail,redis:false,node:false},hooks:{},legacy:true}') || return 2
  fi
  if ! { [ ! -L "$V4_PROJECT" ] && [ ! -L "$V4_DOCROOT" ]; }; then v4Error 'Project and document-root paths must not be symbolic links.' 2; return 2; fi
  V4_DB_SERVICE="${V4_DB_ENGINE}${V4_KEY}"; V4_WEB_SERVICE="joomla${V4_KEY}"
  export V4_HOST V4_KEY V4_ENV_KEY V4_DIR V4_COMPOSE V4_ENV_FILE V4_PROJECT V4_DOCROOT V4_DB_ENGINE V4_DB_SERVICE V4_WEB_SERVICE V4_META V4_LEGACY V4_NAMED_VOLUMES
}


# Keep container paths, programs and argument arrays literal when launching the
# native Windows CLI. Callers convert only the host filesystem operands.
function v4Docker() {
  case "${OSTYPE:-}" in
    msys*|cygwin*) MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' docker "$@" ;;
    *) docker "$@" ;;
  esac
}

# Compose interpolation is scoped to the selected dotenv, including staged
# validation. Only the project-root path is converted for native Windows binds.
function v4ComposeScopedDocker() {
  (
    local variable project_root="${VDM_PROJECT_PATH:-}"
    [ -f "${V4_ENV_FILE:-}" ] || { v4Error 'The selected Compose environment is unavailable.' 3; return 3; }
    migrationReadEnvValue "$V4_ENV_FILE" VDM_PROJECT_PATH project_root || true
    while IFS= read -r variable; do
      [[ "$variable" =~ ^VDM_[A-Za-z0-9_]+$ ]] && unset "$variable"
    done < <(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?(VDM_[A-Za-z0-9_]+)[[:space:]]*=.*$/\2/p' "$V4_ENV_FILE")
    case "${OSTYPE:-}" in
      msys*|cygwin*)
        if [ -n "$project_root" ]; then
          VDM_PROJECT_PATH=$(v4DockerHostPath "$project_root") || return $?
          export VDM_PROJECT_PATH
        fi ;;
    esac
    v4Docker compose "$@"
  )
}

function v4Compose() {
  if ! { [ -f "${V4_COMPOSE:-}" ] && [ -f "${V4_ENV_FILE:-}" ]; }; then v4Error 'Load a site before running Compose.' 3; return 3; fi
  local override="$V4_DIR/docker-compose.override.yml" env_path compose_path override_path
  env_path=$(v4DockerHostPath "$V4_ENV_FILE") || return $?
  compose_path=$(v4DockerHostPath "$V4_COMPOSE") || return $?
  local compose_args=(--env-file "$env_path" --file "$compose_path")
  if [ -f "$override" ]; then
    [ ! -L "$override" ] || { v4Error 'Compose overrides must be regular files.' 2; return 2; }
    override_path=$(v4DockerHostPath "$override") || return $?
    compose_args+=(--file "$override_path")
  fi
  v4ComposeScopedDocker "${compose_args[@]}" "$@"
}

function v4Exec() {
  local service="$1"
  shift
  [[ "$service" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || { v4Error 'Invalid service name.' 2; return 2; }
  v4Compose exec -T "$service" "$@"
}

function v4SaveMetadata() {
  local metadata="$1" temporary
  v4ValidateMetadata "$metadata" || { v4Error 'Refusing to write invalid project metadata.' 2; return 2; }
  if ! { [ -d "${V4_DIR:-}" ] && [ ! -L "$V4_DIR" ] && [ ! -L "$V4_DIR/project.json" ]; }; then v4Error 'The metadata destination is invalid.' 2; return 2; fi
  temporary=$(mktemp "$V4_DIR/.project.XXXXXX") || return 1
  if ! printf '%s\n' "$metadata" > "$temporary" || ! chmod 600 "$temporary" || ! mv -f "$temporary" "$V4_DIR/project.json"; then
    rm -f "$temporary"; return 1
  fi
