# Check if any hosts are set in the SSH config file
function hasRemoteSystemSet() {
  local ssh_config="${VDM_HOME_PATH}/.ssh/config"

  if [ ! -d "${VDM_HOME_PATH}/.ssh" ] || [ ! -f "${ssh_config}" ] ||
    ! grep -qiE '^[[:space:]]*Host[[:space:]]+[^#[:space:]]' "${ssh_config}"; then
