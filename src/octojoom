# Run a permission operation in the background for the gauge, then wait for
# that specific job and preserve its result before another operation starts.
function runPermissionProgress() {
  local message="${1:-}"
  local permission_pid permission_status=0
  shift
  progressSwitchOn || return 1
  {
    "$@" || permission_status=$?
    progressSwitchOff
    exit "${permission_status}"
  } &
  permission_pid=$!
  showProgress "${message}"
  wait "${permission_pid}" || permission_status=$?
  if [ "${permission_status}" -ne 0 ]; then
    showError "The permission update failed (exit status ${permission_status}).\n\nReview the command output and correct the failure before continuing."
  fi
  return "${permission_status}"
}

function fixJoomlaFilePermissions() {
  local project="${1}" file
  sudo find "${project}" -type f -exec chmod 644 {} + || return $?
  for file in configuration.php .htaccess php.ini; do
    [ -f "${project}/${file}" ] || continue
    if [ "${file}" = 'configuration.php' ]; then
      sudo chmod 444 "${project}/${file}" || return $?
    else
      sudo chmod 400 "${project}/${file}" || return $?
    fi
  done
}

function fixJoomlaDirectoryPermissions() {
  local project="${1}" folder rules
  sudo find "${project}" -type d -exec chmod 755 {} + || return $?
  rules=$(lockFolder) || return $?
  for folder in .idea .hidden .git; do
    [ -d "${project}/${folder}" ] || continue
    sudo chmod -R 700 "${project}/${folder}" || return $?
    sudo tee "${project}/${folder}/.htaccess" <<<"${rules}" >/dev/null || return $?
    sudo chmod 400 "${project}/${folder}/.htaccess" || return $?
  done
  if [ -d "${project}/tmp" ]; then
    sudo chmod -R 700 "${project}/tmp" || return $?
  fi
}

# To fix the permissions of Joomla containers
function fixContainersPermissions() {
  if [ ! -d "${VDM_PROJECT_PATH}" ]; then
    showError "The ${VDM_PROJECT_PATH} does not exist."
    return 1
  elif ! hasDirectories '' "${VDM_PROJECT_PATH}"; then
    showError "There are no persistent volumes in ${VDM_PROJECT_PATH} available."
    return 1
  fi
  local vdm_fix_me persistent volume project user_id
  local -a vdm_fix_me_array=()
  vdm_fix_me=$(getSelectedDirectories "Select persistent volume to fix." \
    "${VDM_PROJECT_PATH}" "Fix Joomla Permissions") || return $?
  [ -n "${vdm_fix_me}" ] || return 0
  if ! whiptail --yesno "${USER^}, to fix these permissions we need sudo privileges." \
    --title "Give sudo Privileges" --backtitle "${BACK_TITLE}" 8 112; then
    return 0
  fi
  sudo -v || return $?
  IFS=' ' read -r -a vdm_fix_me_array <<<"${vdm_fix_me}"
  for volume in "${vdm_fix_me_array[@]}"; do
    persistent="${volume//\"/}"
    project="${VDM_PROJECT_PATH}/${persistent}"
    if [ ! -d "${project}/joomla" ]; then
      showError "${project} is not a Joomla persistent volume and was skipped."
      return 1
    fi
    showNotice "Fixing ${persistent}/joomla permissions now."
    setContainerUser "$(id -u)" || return $?
    runPermissionProgress "Setting the ownership of ${persistent} Joomla directory/files." \
      sudo chown -R "${VDM_PUID}:${VDM_PGID}" "${project}/joomla" || return $?
    runPermissionProgress "Setting the file permissions for ${persistent} Joomla." \
      fixJoomlaFilePermissions "${project}/joomla" || return $?
    runPermissionProgress "Setting the directory permissions for ${persistent} Joomla." \
      fixJoomlaDirectoryPermissions "${project}/joomla" || return $?
    user_id=$(id -u)
    if [ "${user_id}" != "${VDM_PUID}" ]; then
      if ! command -v setfacl >/dev/null 2>&1; then
        showError "Install setfacl to allow user:${USER} to access the Joomla files, then run this fix again."
        return 1
      fi
      runPermissionProgress "Setting permissions so user:${USER} can access and edit ${persistent} Joomla." \
        sudo setfacl -R -m "u:${USER}:rwx" "${project}/joomla" || return $?
    elif command -v setfacl >/dev/null 2>&1; then
      sudo setfacl -R -b "${project}/joomla" || return $?
    fi
    if [ -d "${project}/db" ]; then
      runPermissionProgress "Setting the ownership of ${persistent} database directory/files." \
        sudo chown -R 999:999 "${project}/db" || return $?
      runPermissionProgress "Setting the file permissions for ${persistent} database." \
        sudo find "${project}/db" -type f -exec chmod 660 {} + || return $?
      runPermissionProgress "Setting the directory permissions for ${persistent} database." \
        sudo find "${project}/db" -type d -exec chmod 700 {} + || return $?
    fi
    showNotice "Permissions update completed!"
  done
}

# Project operations may only target a direct directory inside the projects path.
function isSafeProjectName() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

# Refuse destructive operations when Docker cannot confirm a project is stopped.
# A manually renamed bind directory can differ from its container key.
function ensureProjectStopped() {
  local persistent="${1:-}" running_names yml key
  local -a keys=("${persistent}")
  if ! isSafeProjectName "${persistent}" || [ -L "${VDM_PROJECT_PATH}/${persistent}" ]; then
    showError "The project name (${persistent}) must identify a direct project directory."
    return 1
  fi
  running_names=$(docker ps --format '{{.Names}}') || {
    showError "Docker could not inspect running containers. The (${persistent}) project was left unchanged."
    return 1
  }
  for yml in "${VDM_REPO_PATH}/joomla/available/"*/docker-compose.yml; do
    [ -f "${yml}" ] || continue
    if key=$(getJoomlaComposeIdentity "${yml}" &&
      [ "${VDM_SRC_PROJECT_FOLDER}" = "${persistent}" ] && printf '%s' "${VDM_SRC_KEY}"); then
      keys+=("${key}")
    fi
  done
  for key in "${keys[@]}"; do
    if printf '%s\n' "${running_names}" | grep -qxF -e "mariadb${key}" -e "joomla${key}" -e "phpmyadmin${key}"; then
      showError "The (${persistent}) project is in use by running containers. Disable them before deleting or resetting its files."
      return 1
    fi
  done
}

# delete persistent volumes
function deletePersistentVolumes() {
  # we first check if we have some volumes
  if hasDirectories '' "${VDM_PROJECT_PATH}"; then
    # set some local variables
    local vdm_delete_volumes
    local persistent
    # saved the file
    showNotice "Only delete persistent volumes of which you have made absolutely sure it's no longer in use!"
    # get containers to enable
    vdm_delete_volumes=$(getSelectedDirectories "Select persistent volume\s to delete." \
      "${VDM_PROJECT_PATH}" "Select Persistent Volume\s to Delete")
    # check that we have something, else return to main menu
    if [ ${#vdm_delete_volumes} -ge 1 ]; then
      # convert the string to and array
      IFS=' ' read -r -a vdm_delete_volumes_array <<<"${vdm_delete_volumes[@]}"
      # loop over the directories to build the
      for volumes in "${vdm_delete_volumes_array[@]}"; do
        # remove the " from the string
        persistent="${volumes//\"/}"
        ensureProjectStopped "${persistent}" || return $?
        # last serious check and then its gone
        if [ -d "${VDM_PROJECT_PATH}/${persistent}" ] &&
          (whiptail --yesno "Are you absolutely sure you would like to delete this (${persistent}) persistent volume? THIS CAN'T BE UNDONE!\n(we need sudo privileges)" \
            --title "Delete Persistent Volume" --backtitle "${BACK_TITLE}" 15 112); then
          # then remove soft link
          sudo rm -rf "${VDM_PROJECT_PATH}/${persistent}" || return $?
        fi
      done
    fi
  else
    showError "There are no persistent volumes found in ${VDM_PROJECT_PATH}."
  fi
}

# clone persistent volume
function clonePersistentVolume() {
  # we first check if we have some volumes
  if hasDirectories '' "${VDM_PROJECT_PATH}"; then
    # set some local variables
    local vdm_clone_volume
    local persistent
    local new_persistent
    local database_state=0
    # get containers to enable
    vdm_clone_volume=$(getSelectedDirectory "Select persistent volume\s to clone." \
      "${VDM_PROJECT_PATH}" "Select Persistent Volume to Clone")
    # check that we have something, else return to main menu
    if [ ${#vdm_clone_volume} -ge 1 ]; then
      # remove the " from the string
      persistent="${vdm_clone_volume//\"/}"
      if ! isSafeProjectName "${persistent}" || [ -L "${VDM_PROJECT_PATH}/${persistent}" ]; then
        showError "Select a direct project directory to clone."
        return 1
      fi
      # last serious check and then its gone
      if [ -d "${VDM_PROJECT_PATH}/${persistent}" ]; then
        # warn when the database of this project is still running (a live copy can be inconsistent)
        isContainerRunning "mariadb${persistent}" || database_state=$?
        if [ "${database_state}" -gt 1 ]; then
          showError "Docker could not inspect the database. The project folder was not copied."
          return 1
        fi
        if [ "${database_state}" -eq 0 ] && ! getInputYesNo "The database container (mariadb${persistent}) is running.\n\
Copying a running database can produce an inconsistent copy. Disable the container first, or continue at your own risk.\n\n\
Would you like to continue anyway?" "Database Is Running" 12 112 "defaultno"; then
          showNotice "The (${persistent}) project folder was not copied, because its database container is running." 8
          return 0
        fi
        # set the new persistent volume name
        new_persistent="${persistent}"
        while ! isSafeProjectName "${new_persistent}" || [ -e "${VDM_PROJECT_PATH}/${new_persistent}" ] ||
          [ -L "${VDM_PROJECT_PATH}/${new_persistent}" ]; do
          # get the value
          new_persistent=$(getInput "Enter a new persistent volume name\n[Use letters, numbers, dots, underscores or hyphens; do not use an existing name]" '' 'Enter Persistent Name') || return $?
          # keep asking
          if ! isSafeProjectName "${new_persistent}"; then
            showError "Enter a direct project folder name using letters, numbers, dots, underscores or hyphens."
          elif [ -e "${VDM_PROJECT_PATH}/${new_persistent}" ] || [ -L "${VDM_PROJECT_PATH}/${new_persistent}" ]; then
            showError "You must enter a persistent volume name that does not already exist.\n\n${new_persistent} already exist."
          fi
        done
        # create this new folder
        mkdir "${VDM_PROJECT_PATH}/${new_persistent}" || return $?
        # clone or (copy) the files to a new directory (including hidden files).
        local copy_status=0
        sudo cp -a "${VDM_PROJECT_PATH}/${persistent}/." "${VDM_PROJECT_PATH}/${new_persistent}/" || copy_status=$?
        if [ "${copy_status}" -ne 0 ]; then
          sudo rm -rf "${VDM_PROJECT_PATH}/${new_persistent}" ||
            showError "The incomplete copy (${new_persistent}) could not be removed."
          showError "The (${persistent}) project could not be copied (exit status ${copy_status})."
          return "${copy_status}"
        fi
      fi
    fi
  else
    showError "There are no persistent volumes found in ${VDM_PROJECT_PATH}."
  fi
}

