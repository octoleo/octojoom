# Run a permission operation in the background for the gauge, then wait for
# that specific job and preserve its result before another operation starts.
function runPermissionProgress() {
  local message="${1:-}"
  local permission_pid permission_status=0
  shift
  if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then
    "$@"
    return $?
  fi
  progressSwitchOn || return 1
  {
    "$@" || permission_status=$?
    progressSwitchOff
    exit "${permission_status}"
  } &
  permission_pid=$!
  showProgress "${message}"
  wait "${permission_pid}" || permission_status=$?
  if [ "${permission_status}" -ne 0 ]; then
    showError "The permission update failed (exit status ${permission_status}).\n\nReview the command output and correct the failure before continuing."
  fi
  return "${permission_status}"
}

function fixJoomlaFilePermissions() {
  local project="${1}" file
  runPrivileged find "${project}" -type f -exec chmod 644 {} + || return $?
  for file in configuration.php .htaccess php.ini; do
    [ -f "${project}/${file}" ] || continue
    if [ "${file}" = 'configuration.php' ]; then
      runPrivileged chmod 444 "${project}/${file}" || return $?
    else
      runPrivileged chmod 400 "${project}/${file}" || return $?
    fi
  done
}

function fixJoomlaDirectoryPermissions() {
  local project="${1}" folder rules
  runPrivileged find "${project}" -type d -exec chmod 755 {} + || return $?
  rules=$(lockFolder) || return $?
  for folder in .idea .hidden .git; do
    [ -d "${project}/${folder}" ] || continue
    runPrivileged chmod -R 700 "${project}/${folder}" || return $?
    runPrivileged tee "${project}/${folder}/.htaccess" <<<"${rules}" >/dev/null || return $?
    runPrivileged chmod 400 "${project}/${folder}/.htaccess" || return $?
  done
  if [ -d "${project}/tmp" ]; then
    runPrivileged chmod -R 700 "${project}/tmp" || return $?
  fi
}

# To fix the permissions of Joomla containers
function joomla__TRuST__fix() {
  fixContainersPermissions
}

function fixContainersPermissions() {
  local headless="${OCTOJOOM_NON_INTERACTIVE:-false}"
  if [ "$headless" = true ]; then
    if ! isSafeProjectName "${VDM_PROJECT:-}" ||
      [[ ! "${VDM_PUID:-}" =~ ^[0-9]+$ || ! "${VDM_PGID:-}" =~ ^[0-9]+$ ]]; then
      printf 'Permission repair requires --project and numeric --uid and --gid.\n' >&2
      return 17
    fi
    if [ -L "${VDM_PROJECT_PATH}/${VDM_PROJECT}" ] ||
      [ ! -d "${VDM_PROJECT_PATH}/${VDM_PROJECT}/joomla" ] ||
      [ -L "${VDM_PROJECT_PATH}/${VDM_PROJECT}/joomla" ] ||
      [ -L "${VDM_PROJECT_PATH}/${VDM_PROJECT}/db" ]; then
      printf 'Permission repair requires a direct Joomla project directory.\n' >&2
      return 17
    fi
    if [ "$(id -u)" != "$VDM_PUID" ] && ! command -v setfacl >/dev/null 2>&1; then
      printf 'Install setfacl before repairing permissions for a different owner.\n' >&2
      return 1
    fi
  fi
  if [ ! -d "${VDM_PROJECT_PATH}" ]; then
    showError "The ${VDM_PROJECT_PATH} does not exist."
    return 1
  elif ! hasDirectories '' "${VDM_PROJECT_PATH}"; then
    showError "There are no persistent volumes in ${VDM_PROJECT_PATH} available."
    return 1
  fi
  local vdm_fix_me persistent volume project user_id
  local -a vdm_fix_me_array=()
  if [ "$headless" = true ]; then
    vdm_fix_me_array=("$VDM_PROJECT")
  else
    vdm_fix_me=$(getSelectedDirectories "Select persistent volume to fix." \
      "${VDM_PROJECT_PATH}" "Fix Joomla Permissions") || return $?
    [ -n "${vdm_fix_me}" ] || return 0
    if useSudo; then
      if ! whiptail --yesno "${USER^}, to fix these permissions we need sudo privileges." \
        --title "Give sudo Privileges" --backtitle "${BACK_TITLE}" 8 112; then
        return 0
      fi
      sudo -v || return $?
    fi
    IFS=' ' read -r -a vdm_fix_me_array <<<"${vdm_fix_me}"
  fi
  for volume in "${vdm_fix_me_array[@]}"; do
    persistent="${volume//\"/}"
    project="${VDM_PROJECT_PATH}/${persistent}"
    if [ ! -d "${project}/joomla" ]; then
      showError "${project} is not a Joomla persistent volume and was skipped."
      return 1
    fi
    if [ "$headless" != true ]; then
      showNotice "Fixing ${persistent}/joomla permissions now."
      setContainerUser "$(id -u)" || return $?
    fi
    runPermissionProgress "Setting the ownership of ${persistent} Joomla directory/files." \
      runPrivileged chown -R "${VDM_PUID}:${VDM_PGID}" "${project}/joomla" || return $?
    runPermissionProgress "Setting the file permissions for ${persistent} Joomla." \
      fixJoomlaFilePermissions "${project}/joomla" || return $?
    runPermissionProgress "Setting the directory permissions for ${persistent} Joomla." \
      fixJoomlaDirectoryPermissions "${project}/joomla" || return $?
    user_id=$(id -u)
    if [ "${user_id}" != "${VDM_PUID}" ]; then
      if ! command -v setfacl >/dev/null 2>&1; then
        showError "Install setfacl to allow user:${USER} to access the Joomla files, then run this fix again."
        return 1
      fi
      runPermissionProgress "Setting permissions so user:${USER} can access and edit ${persistent} Joomla." \
        runPrivileged setfacl -R -m "u:${USER}:rwx" "${project}/joomla" || return $?
    elif command -v setfacl >/dev/null 2>&1; then
      runPrivileged setfacl -R -b "${project}/joomla" || return $?
    fi
    if [ -d "${project}/db" ]; then
      runPermissionProgress "Setting the ownership of ${persistent} database directory/files." \
        runPrivileged chown -R 999:999 "${project}/db" || return $?
      runPermissionProgress "Setting the file permissions for ${persistent} database." \
        runPrivileged find "${project}/db" -type f -exec chmod 660 {} + || return $?
      runPermissionProgress "Setting the directory permissions for ${persistent} database." \
        runPrivileged find "${project}/db" -type d -exec chmod 700 {} + || return $?
    fi
    [ "$headless" = true ] || showNotice "Permissions update completed!"
  done
}

# Project operations may only target a direct directory inside the projects path.
function isSafeProjectName() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

# Refuse destructive operations when Docker cannot confirm a project is stopped.
# A manually renamed bind directory can differ from its container key.
function ensureProjectStopped() {
  local persistent="${1:-}" running_names yml key
  local -a keys=("${persistent}")
  if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then
    local project_path="${VDM_PROJECT_PATH}/${persistent}" ids id mounts mount
    if migrationPathHasSymlink "$project_path"; then
      showError 'Project operations cannot traverse symbolic links.'
      return 1
    fi
    ids=$(docker ps -q) || return 1
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      mounts=$(docker inspect --format '{{range .Mounts}}{{if eq .Type "bind"}}{{println .Source}}{{end}}{{end}}' "$id") || return 1
      while IFS= read -r mount; do
        [ -n "$mount" ] || continue
        if [[ "$mount" == "$project_path" || "$mount" == "$project_path/"* || "$project_path" == "$mount/"* ]]; then
          showError 'A running container uses this project directory. Stop it before changing the files.'
          return 1
        fi
      done <<< "$mounts"
    done <<< "$ids"
  fi
  if ! isSafeProjectName "${persistent}" || [ -L "${VDM_PROJECT_PATH}/${persistent}" ]; then
    showError "The project name (${persistent}) must identify a direct project directory."
    return 1
  fi
  running_names=$(docker ps --format '{{.Names}}') || {
    showError "Docker could not inspect running containers. The (${persistent}) project was left unchanged."
    return 1
  }
  for yml in "${VDM_REPO_PATH}/joomla/available/"*/docker-compose.yml; do
    [ -f "${yml}" ] || continue
    if key=$(getJoomlaComposeIdentity "${yml}" &&
      [ "${VDM_SRC_PROJECT_FOLDER}" = "${persistent}" ] && printf '%s' "${VDM_SRC_KEY}"); then
      keys+=("${key}")
    fi
  done
  for key in "${keys[@]}"; do
    if printf '%s\n' "${running_names}" | grep -qxF -e "mariadb${key}" -e "joomla${key}" -e "phpmyadmin${key}"; then
      showError "The (${persistent}) project is in use by running containers. Disable them before deleting or resetting its files."
      return 1
    fi
  done
}

# delete persistent volumes
function deletePersistentVolumes() {
  # we first check if we have some volumes
  if hasDirectories '' "${VDM_PROJECT_PATH}"; then
    # set some local variables
    local vdm_delete_volumes
    local persistent
    # saved the file
    showNotice "Only delete persistent volumes of which you have made absolutely sure it's no longer in use!"
    # get containers to enable
    vdm_delete_volumes=$(getSelectedDirectories "Select persistent volume\s to delete." \
      "${VDM_PROJECT_PATH}" "Select Persistent Volume\s to Delete")
    # check that we have something, else return to main menu
    if [ ${#vdm_delete_volumes} -ge 1 ]; then
      # convert the string to and array
      IFS=' ' read -r -a vdm_delete_volumes_array <<<"${vdm_delete_volumes[@]}"
      # loop over the directories to build the
      for volumes in "${vdm_delete_volumes_array[@]}"; do
        # remove the " from the string
        persistent="${volumes//\"/}"
        ensureProjectStopped "${persistent}" || return $?
        # last serious check and then its gone
        if [ -d "${VDM_PROJECT_PATH}/${persistent}" ] &&
          (whiptail --yesno "Are you absolutely sure you would like to delete this (${persistent}) persistent volume? THIS CAN'T BE UNDONE!\n(we need sudo privileges)" \
            --title "Delete Persistent Volume" --backtitle "${BACK_TITLE}" 15 112); then
          # then remove soft link
          sudo rm -rf "${VDM_PROJECT_PATH}/${persistent}" || return $?
        fi
      done
    fi
  else
    showError "There are no persistent volumes found in ${VDM_PROJECT_PATH}."
  fi
}

# clone persistent volume
function clonePersistentVolume() {
  # we first check if we have some volumes
  if hasDirectories '' "${VDM_PROJECT_PATH}"; then
    # set some local variables
    local vdm_clone_volume
    local persistent
    local new_persistent
    local database_state=0
    # get containers to enable
    vdm_clone_volume=$(getSelectedDirectory "Select persistent volume\s to clone." \
      "${VDM_PROJECT_PATH}" "Select Persistent Volume to Clone")
    # check that we have something, else return to main menu
    if [ ${#vdm_clone_volume} -ge 1 ]; then
      # remove the " from the string
      persistent="${vdm_clone_volume//\"/}"
      if ! isSafeProjectName "${persistent}" || [ -L "${VDM_PROJECT_PATH}/${persistent}" ]; then
        showError "Select a direct project directory to clone."
        return 1
      fi
      # last serious check and then its gone
      if [ -d "${VDM_PROJECT_PATH}/${persistent}" ]; then
        # warn when the database of this project is still running (a live copy can be inconsistent)
        isContainerRunning "mariadb${persistent}" || database_state=$?
        if [ "${database_state}" -gt 1 ]; then
          showError "Docker could not inspect the database. The project folder was not copied."
          return 1
        fi
        if [ "${database_state}" -eq 0 ] && [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then
          showError 'Stop the source project before copying its raw database files.'
          return 17
        fi
        if [ "${database_state}" -eq 0 ] && ! getInputYesNo "The database container (mariadb${persistent}) is running.\n\
Copying a running database can produce an inconsistent copy. Disable the container first, or continue at your own risk.\n\n\
Would you like to continue anyway?" "Database Is Running" 12 112 "defaultno"; then
          showNotice "The (${persistent}) project folder was not copied, because its database container is running." 8
          return 0
        fi
        # Explicit automation never copies a live database directory.
        if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then
          ensureProjectStopped "$persistent" || return $?
        fi
        # set the new persistent volume name
        new_persistent="${VDM_TARGET_PROJECT:-${persistent}}"
        while ! isSafeProjectName "${new_persistent}" || [ -e "${VDM_PROJECT_PATH}/${new_persistent}" ] ||
          [ -L "${VDM_PROJECT_PATH}/${new_persistent}" ]; do
          # get the value
          new_persistent=$(getInput "Enter a new persistent volume name\n[Use letters, numbers, dots, underscores or hyphens; do not use an existing name]" '' 'Enter Persistent Name') || return $?
          # keep asking
          if ! isSafeProjectName "${new_persistent}"; then
            showError "Enter a direct project folder name using letters, numbers, dots, underscores or hyphens."
          elif [ -e "${VDM_PROJECT_PATH}/${new_persistent}" ] || [ -L "${VDM_PROJECT_PATH}/${new_persistent}" ]; then
            showError "You must enter a persistent volume name that does not already exist.\n\n${new_persistent} already exist."
          fi
        done
        # create this new folder
        mkdir "${VDM_PROJECT_PATH}/${new_persistent}" || return $?
        # clone or (copy) the files to a new directory (including hidden files).
        local copy_status=0
        runPrivileged cp -a "${VDM_PROJECT_PATH}/${persistent}/." "${VDM_PROJECT_PATH}/${new_persistent}/" || copy_status=$?
        if [ "${copy_status}" -ne 0 ]; then
          runPrivileged rm -rf "${VDM_PROJECT_PATH}/${new_persistent}" ||
            showError "The incomplete copy (${new_persistent}) could not be removed."
          showError "The (${persistent}) project could not be copied (exit status ${copy_status})."
          return "${copy_status}"
        fi
      fi
    fi
  else
    showError "There are no persistent volumes found in ${VDM_PROJECT_PATH}."
  fi
}

#####################################################################################################################VDM
######################################## DATABASE TOOLS

# A resolved context is reusable by backup and database-change staging. Its
# credentials remain shell-local; callers should use a subshell for each site.
function joomlaDatabaseCompose() {
  if [ -n "${VDM_DB_COMPOSE:-}" ]; then
    migrationRunCompose "$VDM_DB_ENV" "$VDM_DB_COMPOSE" --project-directory "$VDM_DB_PROJECT_DIR" "$@"
  else
    joomlaSiteCompose "$VDM_DB_SITE" "$@"
  fi
}

# Read the actual installed configuration without starting its entrypoint or
# writing the website. An absent configuration describes a prepared new site.
# shellcheck disable=SC2016
function joomlaDatabaseReadConfiguration() {
  local source="$VDM_SITE_MOUNT_SOURCE" relative mount
  relative="${VDM_SITE_DOCROOT#"$VDM_SITE_MOUNT_TARGET"}"
  [[ "$VDM_SITE_DOCROOT" == "$VDM_SITE_MOUNT_TARGET" || "$VDM_SITE_DOCROOT" == "$VDM_SITE_MOUNT_TARGET/"* ]] || return 1
  if [ "$VDM_SITE_MOUNT_TYPE" = volume ]; then
    source="${VDM_SITE_VOLUME_NAME:-}"
    [ -n "$source" ] && docker volume inspect "$source" >/dev/null 2>&1 || return 1
  elif [ "$VDM_SITE_MOUNT_TYPE" = bind ]; then
    source=$(joomlaWebHostPath "$source") || return 1
  fi
  [[ -n "$source" && "$source" != *,* ]] || return 1
  case "$VDM_SITE_MOUNT_TYPE" in bind|volume) mount="type=$VDM_SITE_MOUNT_TYPE,source=$source,target=/octojoom-site,readonly";; *) return 1;; esac
  MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' docker run --rm --network none --read-only --entrypoint php --mount "$mount" "$VDM_SITE_IMAGE" -r '
    $file=$argv[1]."/configuration.php";
    if (!is_file($file)) { echo "{\"installed\":false}\n"; exit; }
    require $file; $c=new JConfig;
    echo json_encode(["installed"=>true,"host"=>$c->host,"name"=>$c->db,"user"=>$c->user,
      "password"=>$c->password,"driver"=>$c->dbtype,"prefix"=>$c->dbprefix??""], JSON_UNESCAPED_UNICODE),"\n";
  ' -- "/octojoom-site$relative"
}

# Discover tools actually present in the selected service, not historical aliases.
# shellcheck disable=SC2016
function joomlaDatabaseDiscoverClients() {
  local tools version ids
  local -a inspection=()
  ids=$(joomlaDatabaseCompose ps --status running --quiet "$VDM_DB_SERVICE") || return 1
  if [ -n "$ids" ]; then
    inspection=(joomlaDatabaseCompose exec -T --user 0 "$VDM_DB_SERVICE" sh)
  else
    [ -n "${VDM_DB_IMAGE:-}" ] || { printf 'The database service must be running for client discovery.\n' >&2; return 1; }
    inspection=(docker run --rm --network none --read-only --entrypoint sh "$VDM_DB_IMAGE")
  fi
  tools=$("${inspection[@]}" -c '
    for tool in mariadb mariadb-dump mysql mysqldump psql pg_dump pg_restore; do
      command -v "$tool" >/dev/null 2>&1 && printf "%s\n" "$tool"
    done
    exit 0' </dev/null) || return 1
  if [ "$VDM_DB_ENGINE" = postgres ]; then
    for version in psql pg_dump; do printf '%s\n' "$tools" | grep -qxF "$version" || { printf 'Required database client %s is unavailable.\n' "$version" >&2; return 1; }; done
    VDM_DB_CLIENT=psql VDM_DB_DUMP=pg_dump VDM_DB_RESTORE=''
    printf '%s\n' "$tools" | grep -qxF pg_restore && VDM_DB_RESTORE=pg_restore
  elif printf '%s\n' "$tools" | grep -qxF mariadb && printf '%s\n' "$tools" | grep -qxF mariadb-dump; then
    VDM_DB_ENGINE=mariadb VDM_DB_CLIENT=mariadb VDM_DB_DUMP=mariadb-dump VDM_DB_RESTORE=''
  elif printf '%s\n' "$tools" | grep -qxF mysql && printf '%s\n' "$tools" | grep -qxF mysqldump; then
    version=$("${inspection[@]}" -c 'exec mysql --version' </dev/null) || return 1
    if [[ "$version" == *MariaDB* ]]; then VDM_DB_ENGINE=mariadb; else VDM_DB_ENGINE=mysql; fi
    VDM_DB_CLIENT=mysql VDM_DB_DUMP=mysqldump VDM_DB_RESTORE=''
  else
    printf 'The selected service has no matching native database clients.\n' >&2; return 1
  fi
  return 0
}

# Resolve the exact service named by Joomla's connection. Neither name similarity
# nor a database image elsewhere in the project is enough to select a target.
# shellcheck disable=SC2016,SC2034
function joomlaDatabaseContext() {
  set +x
  export -n VDM_DB_PASSWORD
  local site="$1" model installed app field value configured host candidates driver
  command -v jq >/dev/null || { printf 'Database tools require jq.\n' >&2; return 1; }
  # Read-only Compose exec probes must not consume pending console input.
  readJoomlaSiteFacts "$site" </dev/null || return 1
  [ -n "$VDM_SITE_SERVICE" ] || { printf 'The Joomla service is ambiguous.\n' >&2; return 1; }
  VDM_DB_SITE="$site" VDM_DB_COMPOSE="$VDM_SITE_COMPOSE" VDM_DB_ENV="$VDM_SITE_ENV" VDM_DB_PROJECT_DIR="$VDM_SITE_DIR"
  VDM_DB_NAME='' VDM_DB_USER='' VDM_DB_PASSWORD='' VDM_DB_HOST='' VDM_DB_PORT='' VDM_DB_PREFIX='' VDM_DB_SERVICE=''
  model=$(joomlaDatabaseCompose config --format json) || return 1
  app=$(jq -c --arg service "$VDM_SITE_SERVICE" '.services[$service].environment // {}' <<< "$model") || return 1
  installed=$(joomlaDatabaseReadConfiguration) || { printf 'The installed Joomla connection could not be inspected.\n' >&2; return 1; }
  jq -e 'has("installed")' >/dev/null <<< "$installed" || return 1
  driver=$(jq -r '.driver // empty' <<< "$installed")
  [ -n "$driver" ] || driver=$(jq -r '.JOOMLA_DB_TYPE // "mysqli"' <<< "$app")
  case "$driver" in pgsql|postgresql|pdo_pgsql) VDM_DB_ENGINE=postgres; VDM_DB_PORT=5432;; mysqli|mysql|pdomysql|pdo_mysql) VDM_DB_ENGINE=mysql; VDM_DB_PORT=3306;; *) printf 'Unsupported installed database driver.\n' >&2; return 1;; esac
  for field in host name user password; do
    case "$field" in host) configured=JOOMLA_DB_HOST;; name) configured=JOOMLA_DB_NAME;; user) configured=JOOMLA_DB_USER;; password) configured=JOOMLA_DB_PASSWORD;; esac
    value=$(jq -r --arg key "$configured" '.[$key] // empty' <<< "$app") || return 1
    # `compose config` emits reusable Compose data: every literal dollar is
    # escaped as $$. Decode that serialization once, without interpolation or
    # evaluation, before comparing it with the installed application's value.
    value="${value//\$\$/\$}"
    if [ "$(jq -r '.installed' <<< "$installed")" = true ]; then
      host=$(jq -r --arg key "$field" '.[$key] // empty' <<< "$installed") || return 1
      if [ "$field" = host ]; then value="${value%:"$VDM_DB_PORT"}"; host="${host%:"$VDM_DB_PORT"}"; fi
      if [ -n "$value" ] && [ "$value" != "$host" ]; then
        printf 'Database %s differs between %s/configuration.php and the connection in %s (effective ENV: %s). Correct those selected-site settings before retrying.\n' "$field" "$VDM_SITE_DOCROOT" "$VDM_SITE_COMPOSE" "$VDM_SITE_ENV" >&2; return 1
      fi
      value="$host"
    fi
    [[ -n "$value" && "$value" != *$'\n'* && "$value" != *$'\r'* ]] || { printf 'Database %s is missing or contains unsupported line breaks. Check %s/configuration.php and %s.\n' "$field" "$VDM_SITE_DOCROOT" "$VDM_SITE_ENV" >&2; return 1; }
    printf -v "VDM_DB_${field^^}" '%s' "$value"
  done
  VDM_DB_PREFIX=$(jq -r '.prefix // empty' <<< "$installed")
  host="$VDM_DB_HOST"
  if [[ "$host" =~ ^([^:]+):([0-9]+)$ ]]; then host="${BASH_REMATCH[1]}"; VDM_DB_PORT="${BASH_REMATCH[2]}"; fi
  [[ "$host" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ && "$VDM_DB_PORT" =~ ^[0-9]+$ ]] || return 1
  candidates=$(jq -r --arg host "$host" '[.services | to_entries[] | select(.key==$host or .value.container_name==$host or any(.value.networks[]?.aliases[]?; .==$host)) | .key] | unique | .[]' <<< "$model") || return 1
  [[ -n "$candidates" && "$candidates" != *$'\n'* ]] || { printf 'Joomla does not identify one database service in this Compose project.\n' >&2; return 1; }
  VDM_DB_SERVICE="$candidates"
  VDM_DB_IMAGE=$(jq -r --arg service "$VDM_DB_SERVICE" '.services[$service].image // empty' <<< "$model")
  VDM_DB_DRIVER="$driver"
  [ "$VDM_DB_SERVICE" != "$VDM_SITE_SERVICE" ] || return 1
  VDM_DB_INSTALLED=$(jq -r '.installed' <<< "$installed")
  joomlaDatabaseDiscoverClients
}

function joomlaDatabaseFacts() {
  joomlaDatabaseContext "$@"
}

function joomlaDatabaseOptionQuote() {
  local value="$1"
  value="${value//\\/\\\\}"; value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"; value="${value//$'\r'/\\r}"; value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

function joomlaDatabasePasswordContent() {
  local value field index=0
  if [ "$VDM_DB_ENGINE" = postgres ]; then
    for field in 127.0.0.1 "$VDM_DB_PORT" "$VDM_DB_NAME" "$VDM_DB_USER" "$VDM_DB_PASSWORD"; do
      [[ "$field" != *$'\n'* && "$field" != *$'\r'* ]] || return 1
      value="${field//\\/\\\\}"; value="${value//:/\\:}"
      [ "$index" -eq 0 ] || printf ':'
      printf '%s' "$value"
      index=$((index + 1))
    done
    printf '\n'
  else
    printf '[client]\nhost=127.0.0.1\nport=%s\nuser=' "$VDM_DB_PORT"
    joomlaDatabaseOptionQuote "$VDM_DB_USER"
    printf '\npassword='; joomlaDatabaseOptionQuote "$VDM_DB_PASSWORD"; printf '\n'
  fi
}

# Protected credentials travel over stdin, never command arguments or environment
# values. Temporary client files and private diagnostics are removed on all exits.
# shellcheck disable=SC2016
function joomlaDatabaseClient() {
  (
    set +x
    export -n VDM_DB_PASSWORD
    set -o pipefail
    umask 077
    local operation="$1" credential='' errors='' status=0 binary connection value field reason
    shift
    if [ "$operation" = import ] && [ "$#" -gt 0 ]; then
      [ -f "$1" ] && [ ! -L "$1" ] || exit 2
      joomlaDatabaseClient sql < "$1"
      exit $?
    fi
    case "$operation" in dump|export) binary="$VDM_DB_DUMP";; sql|import|query|console) binary="$VDM_DB_CLIENT";; restore) binary="${VDM_DB_RESTORE:-}";; *) exit 2;; esac
    [ -n "$binary" ] || { printf 'Required native database client is unavailable.\n' >&2; exit 1; }
    if [ "${VDM_VERBOSE:-false}" = true ]; then printf 'Running %s with %s in selected service %s.\n' "$operation" "$binary" "$VDM_DB_SERVICE" >&2; fi
    local -a terminal=(-T) arguments=()
    if [ "$operation" = console ]; then
      [[ -t 0 && -t 1 && "${OCTOJOOM_NON_INTERACTIVE:-false}" != true && "${OCTOJOOM_OUTPUT:-text}" != json ]] || { printf 'The SQL console requires an interactive terminal.\n' >&2; exit 2; }
      terminal=()
    fi
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    trap 'status=$?; [ -z "$credential" ] || joomlaDatabaseCompose exec -T --user 0 "$VDM_DB_SERVICE" rm -f -- "$credential" </dev/null >/dev/null 2>&1 || status=1; [ -z "$errors" ] || rm -f -- "$errors"; exit "$status"' EXIT
    # Compose exec attaches stdin even with -T. Control commands must not
    # consume the SQL stream before the actual native client receives it.
    credential=$(joomlaDatabaseCompose exec -T --user 0 "$VDM_DB_SERVICE" sh -c 'umask 077; mktemp /tmp/octojoom-database.XXXXXXXX' </dev/null) || exit 1
    [[ "$credential" =~ ^/tmp/octojoom-database\.[A-Za-z0-9]+$ ]] || exit 1
    if ! joomlaDatabasePasswordContent | joomlaDatabaseCompose exec -T --user 0 "$VDM_DB_SERVICE" sh -c 'umask 077; cat > "$1" && chmod 600 "$1"' sh "$credential"; then exit 1; fi
    if [ "$VDM_DB_ENGINE" = postgres ]; then
      # A literal keyword connection string prevents a database name from being
      # interpreted as a URI or additional connection parameters by libpq.
      connection='host=127.0.0.1'
      for value in port user dbname; do
        case "$value" in port) field="$VDM_DB_PORT";; user) field="$VDM_DB_USER";; dbname) field="$VDM_DB_NAME";; esac
        field="${field//\\/\\\\}"; field="${field//\'/\\\'}"
        connection+=" $value='$field'"
      done
      arguments=(--dbname "$connection" --no-password)
      if [ "$binary" = psql ]; then
        arguments+=(--no-psqlrc --set=ON_ERROR_STOP=1)
        [ "$operation" = console ] || arguments+=(--quiet --tuples-only --no-align --file=-)
      fi
    else
      arguments=("--defaults-file=$credential" --default-character-set=utf8mb4)
      if [ "$binary" = "$VDM_DB_CLIENT" ]; then
        arguments+=("--database=$VDM_DB_NAME")
        [ "$operation" = console ] || arguments+=(--batch --skip-column-names --raw --binary-mode)
      fi
    fi
    errors=$(mktemp "${TMPDIR:-/tmp}/octojoom-database-errors.XXXXXXXX") || exit 1
    if [ "$operation" = console ]; then
      joomlaDatabaseCompose exec "${terminal[@]}" --user 0 -e "PGPASSFILE=$credential" "$VDM_DB_SERVICE" "$binary" "${arguments[@]}" "$@" || status=$?
    else
      joomlaDatabaseCompose exec "${terminal[@]}" --user 0 -e "PGPASSFILE=$credential" "$VDM_DB_SERVICE" "$binary" "${arguments[@]}" "$@" 2> "$errors" || status=$?
    fi
    if [ "$status" -ne 0 ]; then
      reason='Check the selected database service, native client compatibility and SQL input; partial MySQL/MariaDB DDL may require restoring a backup.'
      if grep -qiE 'access denied|authentication failed|no password supplied|ERROR 1045|28P01' "$errors"; then
        reason='Authentication failed. Check that the selected Joomla and database user credentials agree.'
      elif grep -qiE 'connection refused|could not connect|can.t connect|connection timed out|ERROR 200[2356]' "$errors"; then
        reason='Connection failed. Check the selected database service is running and its configured TCP port is reachable.'
      elif grep -qiE 'permission denied|command denied|insufficient privilege|ERROR (1044|1142|1227)' "$errors"; then
        reason='Permission denied. Grant this application user the permissions needed for the selected database operation.'
      elif grep -qiE 'syntax error|ERROR 1064|invalid command|unsupported version|unknown option' "$errors"; then
        reason='The client rejected SQL syntax or an unsupported format/option. Check the dump engine and native client compatibility.'
      fi
      printf '%s database %s failed (status %s). %s\n' "$VDM_DB_ENGINE" "$operation" "$status" "$reason" >&2
    elif [ "${VDM_VERBOSE:-false}" = true ] && [ -s "$errors" ]; then
      printf '%s client completed with diagnostics; inspect the service for details.\n' "$VDM_DB_ENGINE" >&2
    fi
    exit "$status"
  )
}

function joomlaDatabaseTablesResolved() {
  if [ "$VDM_DB_ENGINE" = postgres ]; then
    printf '%s\n' "SELECT quote_ident(n.nspname)||'.'||quote_ident(c.relname) FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE c.relkind IN ('r','p','v','m') AND n.nspname NOT IN ('pg_catalog','information_schema') AND n.nspname NOT LIKE 'pg_toast%%' ORDER BY 1;" | joomlaDatabaseClient query
  else
    printf 'SHOW TABLES;\n' | joomlaDatabaseClient query
  fi
}

function joomlaDatabaseTables() {
  (joomlaDatabaseContext "$1" && joomlaDatabaseTablesResolved)
}

# Database changes compare this with writers quiesced. Counts are not a live
# cross-table snapshot; logical export remains the authoritative native dump.
function joomlaDatabaseRowCountsResolved() {
  local tables table quoted program='' index=0
  local -a arguments=()
  tables=$(joomlaDatabaseTablesResolved) || return 1
  while IFS= read -r table; do
    [ -n "$table" ] || continue
    [[ "$table" != *$'\t'* && "$table" != *$'\r'* ]] || return 2
    if [ "$VDM_DB_ENGINE" = postgres ]; then
      # PostgreSQL's inventory emitted quote_ident(schema).quote_ident(table).
      quoted="$table"
    else
      quoted="${table//\`/\`\`}"
      quoted="\`$quoted\`"
    fi
    program+="SELECT $index, COUNT(*) FROM $quoted;"$'\n'
    index=$((index + 1))
  done <<< "$tables"
  [ "$VDM_DB_ENGINE" != postgres ] || arguments+=(--field-separator=$'\t')
  printf '%s' "$program" | joomlaDatabaseClient query "${arguments[@]}"
}

function joomlaDatabaseCheckTables() {
  local actual="$1" table
  shift
  for table in "$@"; do
    [[ -n "$table" && "$table" != *$'\n'* && "$table" != *$'\r'* && "$table" != *$'\t'* ]] || return 2
    printf '%s\n' "$actual" | grep -qxF -- "$table" || { printf 'A selected table does not exist in this database.\n' >&2; return 2; }
  done
}

# All required flags are checked against this image's actual native client.
function joomlaDatabaseDumpResolved() {
  local table help required actual
  local -a arguments=()
  actual=$(joomlaDatabaseTablesResolved) || return 1
  joomlaDatabaseCheckTables "$actual" "$@" || return $?
  help=$(joomlaDatabaseCompose exec -T --user 0 "$VDM_DB_SERVICE" "$VDM_DB_DUMP" --help </dev/null 2>/dev/null) || return 1
  if [ "$VDM_DB_ENGINE" = postgres ]; then
    arguments=(--no-owner --no-privileges)
    if [ "${VDM_DB_FORMAT:-none}" = custom ]; then arguments+=(--format=custom); else arguments+=(--format=plain --clean --if-exists); fi
    for table in "$@"; do arguments+=(--table "$table"); done
    for required in no-owner no-privileges format; do [[ "$help" == *"$required"* ]] || return 1; done
  else
    [ "${VDM_DB_FORMAT:-none}" != custom ] || { printf 'Native archive format is available only for PostgreSQL.\n' >&2; return 2; }
    arguments=(--single-transaction --quick --skip-lock-tables --hex-blob --routines --events --triggers)
    for required in single-transaction quick hex-blob routines events triggers; do [[ "$help" == *"$required"* ]] || { printf 'The native dump client lacks %s support.\n' "$required" >&2; return 1; }; done
    [[ "$help" != *no-tablespaces* ]] || arguments+=(--no-tablespaces)
    [[ "$help" != *set-gtid-purged* ]] || arguments+=(--set-gtid-purged=OFF)
    arguments+=(-- "$VDM_DB_NAME" "$@")
  fi
  if [ "${VDM_QUIET:-false}" != true ]; then
    printf 'Export uses a transactional database snapshot; nontransactional tables and website files require quiesced writes for a coordinated backup.\n' >&2
  fi
  joomlaDatabaseClient dump "${arguments[@]}"
}

# Publish only a complete, nonempty dump. No-clobber publication uses a hard
# link in the same directory, so a racing export cannot replace an existing file.
function joomlaDatabaseExport() {
  (
    set -o pipefail
    umask 077
    local site="$1" file="$2" compression="${3:-none}" overwrite="${4:-false}" temporary='' status=0
    shift "$(( $# < 4 ? $# : 4 ))"
    case "$compression" in none|gzip|custom) ;; *) exit 2;; esac
    [[ "$overwrite" = true || "$overwrite" = false ]] || exit 2
    [[ -n "$file" && "$file" != *$'\n'* && ! -L "$file" ]] || exit 2
    case "$file" in /*|[A-Za-z]:/*) ;; *) file="$PWD/$file";; esac
    [ ! -e "$file" ] || { [ "$overwrite" = true ] && [ -f "$file" ]; } || { printf 'Output already exists; explicit overwrite is required.\n' >&2; exit 2; }
    [ -d "$(dirname -- "$file")" ] || { printf 'Choose an existing export directory.\n' >&2; exit 2; }
    joomlaDatabaseContext "$site" || exit 1
    local VDM_DB_FORMAT="$compression"
    temporary=$(mktemp "${file}.tmp.XXXXXXXX") || exit 1
    trap 'status=$?; [ -z "$temporary" ] || rm -f -- "$temporary"; exit "$status"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    if [ "$compression" = gzip ]; then
      joomlaDatabaseDumpResolved "$@" | gzip -c > "$temporary" || exit 1
      gzip -t -- "$temporary" || exit 1
      [ "$(gzip -dc -- "$temporary" | wc -c)" -gt 0 ] || { printf 'The native client produced no database export.\n' >&2; exit 1; }
    else
      joomlaDatabaseDumpResolved "$@" > "$temporary" || exit 1
    fi
    [ -s "$temporary" ] || { printf 'The native client produced no database export.\n' >&2; exit 1; }
    chmod 600 "$temporary" || exit 1
    if [ "$overwrite" = true ]; then mv -f -- "$temporary" "$file" || exit 1
    else ln -- "$temporary" "$file" || exit 1; rm -f -- "$temporary" || exit 1; fi
    temporary=''
  )
}

function joomlaDatabaseInput() {
  local file="$1" compression="$2"
  if [ "${VDM_PROGRESS:-false}" = true ]; then
    command -v pv >/dev/null || { printf 'Import progress requires pv; install it or disable progress.\n' >&2; return 2; }
    if [ "$compression" = gzip ]; then pv -f -- "$file" | gzip -dc; else pv -f -- "$file"; fi
  elif [ "$compression" = gzip ]; then gzip -dc -- "$file"
  else cat -- "$file"; fi
}

function joomlaDatabaseImport() {
  (
    set -o pipefail
    local site="$1" file="$2" mode="${3:-fresh}" delete_source="${4:-false}" tables compression=none magic status=0
    [[ "$mode" = fresh || "$mode" = replace || "$mode" = merge ]] || exit 2
    [[ "$delete_source" = true || "$delete_source" = false ]] || exit 2
    if [ ! -f "$file" ] || [ -L "$file" ] || [ ! -s "$file" ]; then printf 'Choose a readable, nonempty SQL file.\n' >&2; exit 2; fi
    [ "$#" -le 4 ] || { printf 'Import selected-table dumps directly; SQL input is never filtered or rewritten.\n' >&2; exit 2; }
    magic=$(od -An -N5 -tx1 -- "$file" | tr -d ' \n') || exit 1
    if [[ "$magic" == 1f8b* ]]; then compression=gzip; gzip -t -- "$file" || { printf 'The compressed input is incomplete or corrupt.\n' >&2; exit 1; }
    elif [ "$magic" = 5047444d50 ]; then compression=custom; fi
    if [ "${VDM_PROGRESS:-false}" = true ]; then command -v pv >/dev/null || { printf 'Import progress requires pv.\n' >&2; exit 2; }; fi
    joomlaDatabaseContext "$site" || exit 1
    tables=$(joomlaDatabaseTablesResolved) || exit 1
    [ "$mode" != fresh ] || [ -z "$tables" ] || { printf 'Fresh import requires an empty selected database.\n' >&2; exit 2; }
    if [ "$compression" = custom ]; then
      if [ "$VDM_DB_ENGINE" != postgres ] || [ -z "$VDM_DB_RESTORE" ]; then printf 'This archive requires PostgreSQL pg_restore.\n' >&2; exit 2; fi
      local -a arguments=(--exit-on-error --single-transaction --no-owner --no-privileges)
      [ "$mode" != replace ] || arguments+=(--clean --if-exists)
      joomlaDatabaseInput "$file" none | joomlaDatabaseClient restore "${arguments[@]}" > /dev/null || status=$?
    elif [ "$VDM_DB_ENGINE" = postgres ]; then
      joomlaDatabaseInput "$file" "$compression" | joomlaDatabaseClient sql --single-transaction > /dev/null || status=$?
    else
      joomlaDatabaseInput "$file" "$compression" | joomlaDatabaseClient sql > /dev/null || status=$?
    fi
    if [ "$status" -ne 0 ]; then
      printf 'Import failed; the source was retained. Nontransactional DDL may have been partially applied.\n' >&2; exit "$status"
    fi
    tables=$(joomlaDatabaseTablesResolved) || exit 1
    [ -n "$tables" ] || { printf 'Import returned no application tables; source retained.\n' >&2; exit 1; }
    printf 'SELECT 1;\n' | joomlaDatabaseClient query >/dev/null || exit 1
    joomlaDatabaseVerifyConnection "$site" || exit 1
    [ "$delete_source" != true ] || rm -f -- "$file" || exit 1
  )
}

# Verify the real installed Joomla driver against its configured target without
# printing connection details. Prepared sites have no application to check yet.
# shellcheck disable=SC2016
function joomlaDatabaseVerifyConnection() {
  local site="$1" source relative
  readJoomlaSiteFacts "$site" || return 1
  source="$VDM_SITE_MOUNT_SOURCE"; relative="${VDM_SITE_DOCROOT#"$VDM_SITE_MOUNT_TARGET"}"
  if [ "$VDM_SITE_MOUNT_TYPE" = volume ]; then source="${VDM_SITE_VOLUME_NAME:-}"; [ -n "$source" ] && docker volume inspect "$source" >/dev/null 2>&1 || return 1; fi
  # Compose run inherits the selected service's network and settings; its normal
  # Joomla entrypoint is bypassed and no published ports are requested.
  [[ -n "$source" && -n "$relative" || "$VDM_SITE_DOCROOT" = "$VDM_SITE_MOUNT_TARGET" ]] || return 1
  joomlaSiteCompose "$site" run --rm --no-deps --entrypoint php "$VDM_SITE_SERVICE" -r '
    $file=$argv[1]."/configuration.php"; if (!is_file($file)) { exit(0); }
    require $file; $c=new JConfig; $host=explode(":",$c->host,2);
    try {
      if ($c->dbtype==="mysqli") { mysqli_report(MYSQLI_REPORT_OFF); $db=@new mysqli($host[0],$c->user,$c->password,$c->db,(int)($host[1]??3306)); exit($db->connect_errno || !$db->query("SELECT 1") ? 1:0); }
      if (in_array($c->dbtype,["pgsql","pdo_pgsql","postgresql"],true)) {
        $quote=static function($v){return "\x27".str_replace(["\\","\x27"],["\\\\","\\\x27"],$v)."\x27";};
        $dsn="host=".$quote($host[0])." port=".(int)($host[1]??5432)." dbname=".$quote($c->db);
        if($c->dbtype!=="postgresql") {
          if(strpos($dsn,";")!==false){exit(1);}
          $db=new PDO("pgsql:".$dsn,$c->user,$c->password); exit($db->query("SELECT 1")?0:1);
        }
        $db=@pg_connect($dsn." user=".$quote($c->user)." password=".$quote($c->password)); exit(!$db || !@pg_query($db,"SELECT 1") ? 1:0);
      }
      if ($c->dbtype==="pdomysql" || $c->dbtype==="pdo_mysql") { if(strpos($host[0].$c->db,";")!==false){exit(1);} $db=new PDO("mysql:host=".$host[0].";port=".(int)($host[1]??3306).";dbname=".$c->db,$c->user,$c->password); exit($db->query("SELECT 1")?0:1); }
    } catch (Throwable $e) { exit(1); }
    exit(1);' -- "$VDM_SITE_DOCROOT" >/dev/null 2>&1 || { printf 'Joomla database connectivity verification failed; source input was retained.\n' >&2; return 1; }
}

function joomlaDatabaseExecute() {
  (
    local site="$1" file="$2"
    [ -f "$file" ] && [ ! -L "$file" ] || return 2
    joomlaDatabaseContext "$site" || return 1
    joomlaDatabaseClient sql < "$file"
  )
}

function joomlaDatabaseConsole() {
  (joomlaDatabaseContext "$1" && joomlaDatabaseClient console)
}

