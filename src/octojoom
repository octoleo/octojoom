    if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ] || [ ! -t 0 ]; then echo >&2 'ERROR: A remote interactive session needs a terminal; pass -- followed by OctoJoom arguments for automation.'; return 17; fi
