    return 1
  elif ! hasDirectories '' "${VDM_PROJECT_PATH}"; then
    showError "There are no project folders (persistent volumes) found in ${VDM_PROJECT_PATH}."
    return 1
  else
    # run the clone
    cloneJoomlaContainer || clone_status=$?
    ##########################
