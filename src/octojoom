# OCTOJOOM V4: runtime
# shellcheck shell=bash
# Globals below are the shared request/site API; the isolated apply subshell is reloaded by its caller.
# shellcheck disable=SC2034,SC2030,SC2031
# Joomla runtime configuration. Compose JSON is YAML-compatible; keep user
# customizations in docker-compose.override.yml so regeneration is lossless.
function v4DockerHostPath() {
  case "${OSTYPE:-}" in
    msys*|cygwin*)
      command -v cygpath >/dev/null 2>&1 || { v4Error 'Windows Docker host paths require cygpath from Git Bash or Cygwin.' 3; return 3; }
      cygpath -am -- "$1"
      ;;
    *) printf '%s\n' "$1" ;;
  esac
}

function v4RuntimeValidateMeta() {
  local meta="$1" path part
  jq -e '
    .schema_version == 1 and
    (.host | type == "string" and length <= 253 and test("^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$")) and
    (.key | type == "string" and test("^[A-Za-z][A-Za-z0-9_-]{0,49}$")) and
    (.env_key | type == "string" and test("^[A-Z][A-Z0-9_]*$")) and
    (.project_dir | type == "string" and startswith("/") and (test("[\\n\\r$]")|not)) and
    (.docroot | type == "string" and length > 0 and (startswith("/")|not) and (test("[\\n\\r$:\\\\]")|not)) and
    (.image | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._/:@-]+$")) and
    (.joomla_version | type == "string" and test("^[4-9][0-9]*\\.[0-9]+(\\.[0-9]+)?$")) and
    (.php_version | type == "string" and test("^[0-9]+\\.[0-9]+$")) and
    (.webserver == "apache" or .webserver == "nginx") and
    (.profile == "local" or .profile == "server") and
    (.database.engine == "mariadb" or .database.engine == "mysql" or .database.engine == "postgres") and
    (.database.version | type == "string" and test("^[0-9]+(\\.[0-9]+){0,2}(-[A-Za-z0-9._-]+)?$")) and
    (.database.name | type == "string" and test("^[A-Za-z][A-Za-z0-9_]{0,62}$")) and
    (.database.user | type == "string" and test("^[A-Za-z][A-Za-z0-9_]{0,30}$")) and
    ((.http_port // 0) | type == "number" and floor == . and . >= 0 and . <= 65535) and
    (.tls.mode == "none" or .tls.mode == "local" or .tls.mode == "acme") and
    (.services | type == "object") and
    ([.services.mail,.services.redis,.services.node] | all(. == true or . == false)) and
    ((.hooks // {}) | type == "object")
  ' <<< "$meta" >/dev/null || { v4Error 'Invalid or incomplete Joomla project metadata.' 2; return 2; }
  isValidDomain "$(jq -r '.host' <<< "$meta")" || { v4Error 'Select a valid dotted site hostname.' 2; return 2; }
  if declare -F v4ValidateHooks >/dev/null; then v4ValidateHooks "$(jq -c '.hooks // {}' <<< "$meta")" || return $?; fi
  path=$(jq -r '.docroot' <<< "$meta")
  case "/$path/" in *'/../'*|*'/./'*|*'//'*) v4Error 'Document root must be a normalized relative directory.' 2; return 2 ;; esac
  case "$path" in db|db/*|.octojoom|.octojoom/*) v4Error 'Document root overlaps database or internal project storage.' 2; return 2 ;; esac
  path=$(jq -r '.project_dir' <<< "$meta")
  case "/${path#/}/" in *'/../'*|*'/./'*|*'//'*) v4Error 'Project directory must be a normalized absolute directory.' 2; return 2 ;; esac
  # A parent symlink would defeat path reservation checks on create/restore.
  part="$path/$(jq -r '.docroot' <<< "$meta")"
  while [ "$part" != / ]; do
    [ ! -L "$part" ] || { v4Error 'Managed project paths may not contain symbolic links.' 2; return 2; }
    part=${part%/*}; [ -n "$part" ] || part=/
  done
  if [ "$(jq -r '.tls.mode' <<< "$meta")" = acme ] && [ "$(jq -r '.profile' <<< "$meta")" != server ]; then
    v4Error 'ACME requires the server profile; use local TLS for local development.' 2; return 2
  fi
}

function v4RuntimeImage() {
  local version="$1" php="$2" webserver="$3" variant=apache
  [ "$webserver" != nginx ] || variant=fpm
  printf 'joomla:%s-php%s-%s\n' "$version" "$php" "$variant"
}

function v4RuntimeValidateImage() {
  local meta="$1" image php version driver expected actual sapi source_version
  image=$(jq -r '.image' <<< "$meta")
  php=$(jq -r '.php_version' <<< "$meta")
  version=$(jq -r '.joomla_version' <<< "$meta")
  driver=mysqli
  [ "$(jq -r '.database.engine' <<< "$meta")" != postgres ] || driver=pgsql
  v4Docker image inspect "$image" >/dev/null 2>&1 || v4Docker pull "$image" >&2 || return 1
  actual=$(v4Docker run --rm --network none --entrypoint php "$image" -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;') || return 1
  [ "$actual" = "$php" ] || { v4Error 'The selected image does not provide the requested PHP version.' 2; return 2; }
  # shellcheck disable=SC2016 # PHP receives literal variable expressions.
  v4Docker run --rm --network none --entrypoint php "$image" -r 'exit(extension_loaded($argv[1]) ? 0 : 1);' "$driver" >/dev/null || {
    v4Error "The selected Joomla image lacks the required $driver extension." 2; return 2;
  }
  # shellcheck disable=SC2016 # PHP receives literal variable expressions.
  source_version=$(v4Docker run --rm --network none --entrypoint php "$image" -r '
    $f="/usr/src/joomla/administrator/manifests/files/joomla.xml";
    if (!is_file($f)) exit(1); $x=simplexml_load_file($f); echo (string)$x->version;') || {
    v4Error 'The selected image does not expose a verifiable Joomla installation.' 2; return 2;
  }
  expected="$version"
  if [[ "$version" =~ ^[0-9]+\.[0-9]+$ ]]; then
    [[ "$source_version" = "$expected".* ]] || { v4Error 'The selected image belongs to a different Joomla release line.' 2; return 2; }
  elif [ "$source_version" != "$expected" ]; then
    v4Error 'The selected image does not contain the requested Joomla version.' 2; return 2
  fi
  sapi=apache2
  [ "$(jq -r '.webserver' <<< "$meta")" != nginx ] || sapi='php-fpm'
  # shellcheck disable=SC2016 # The container shell owns the positional parameter.
  v4Docker run --rm --network none --entrypoint sh "$image" -c 'command -v "$1" >/dev/null' sh "$sapi" || {
    v4Error 'The selected image does not provide the requested webserver runtime.' 2; return 2;
  }
}

function v4RuntimeWritePhp() {
  local destination="$1" settings value name temporary
  settings=$(jq -c '.php_settings // {}' <<< "$V4_META")
  for name in memory_limit upload_max_filesize post_max_size; do
    value=$(jq -r --arg n "$name" '.[$n] // "256M"' <<< "$settings")
    [[ "$value" =~ ^([1-9][0-9]*[KMG]?|-1)$ ]] || { v4Error "Invalid PHP setting: $name." 2; return 2; }
  done
  value=$(jq -r '.max_execution_time // 120' <<< "$settings")
  [[ "$value" =~ ^[0-9]+$ ]] || { v4Error 'Invalid max_execution_time.' 2; return 2; }
  temporary=$(mktemp "${destination}.tmp.XXXXXX") || return 1
  if ! {
    printf 'output_buffering=Off\ndisplay_errors=Off\nlog_errors=On\n'
    for name in memory_limit upload_max_filesize post_max_size; do
      value=$(jq -r --arg n "$name" '.[$n] // "256M"' <<< "$settings")
      printf '%s=%s\n' "$name" "$value"
    done
    printf 'max_execution_time=%s\n' "$(jq -r '.max_execution_time // 120' <<< "$settings")"
  } > "$temporary" || ! chmod 644 "$temporary" || ! mv -f "$temporary" "$destination"; then
    rm -f "$temporary"; return 1
  fi
}

function v4RuntimeWriteNginx() {
  local destination="$1" key temporary
  key=$(jq -r '.key' <<< "$V4_META")
  temporary=$(mktemp "${destination}.tmp.XXXXXX") || return 1
  cat > "$temporary" <<EOF_NGINX
map \$http_x_forwarded_proto \$octojoom_https {
    default off;
    https on;
    }
server {
    listen 80;
    server_name _;
    root /var/www/html;
    index index.php;
    client_max_body_size 256m;
    location = /__octojoom_health { access_log off; return 200 "ok"; }
    location / { try_files \$uri \$uri/ /index.php?\$args; }
    location /api/ { try_files \$uri \$uri/ /api/index.php?\$args; }
    location ~ ^/configuration\.php(/|$) { deny all; }
    location ~ /\. { deny all; }
    location ~* \.(sql|sqlite|bak|ini|log|env)$ { deny all; }
    location ^~ /administrator/logs/ { deny all; }
    location ^~ /tmp/ { deny all; }
    location ~ \.php(/|$) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        set \$octojoom_path_info \$fastcgi_path_info;
        try_files \$fastcgi_script_name =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
        fastcgi_param PATH_INFO \$octojoom_path_info;
        fastcgi_param HTTPS \$octojoom_https;
        fastcgi_pass joomla${key}:9000;
        fastcgi_read_timeout 120s;
    }
    }
EOF_NGINX
  if ! chmod 644 "$temporary" || ! mv -f "$temporary" "$destination"; then rm -f "$temporary"; return 1; fi
}

# Writes generated files into a chosen directory, leaving custom override files alone.
function v4GenerateCompose() {
  local output="${1:-$V4_COMPOSE}" generated_dir json temporary network host_project
  v4RuntimeValidateMeta "$V4_META" || return $?
  generated_dir=$(dirname "$output")
  mkdir -p "$generated_dir" || return 1
  v4RuntimeWritePhp "$generated_dir/php.generated.ini" || return $?
  v4RuntimeWriteNginx "$generated_dir/nginx.generated.conf" || return $?
  network=$(jq -r '.network // empty' <<< "$V4_META")
  network="${network:-${VDM_TRAEFIK_GATEWAY:-traefik_webgateway}}"
  host_project=$(v4DockerHostPath "$(jq -r '.project_dir' <<< "$V4_META")") || return $?
  json=$(jq -n --argjson m "$V4_META" --arg network "$network" --arg host_project "$host_project" '
    def env($suffix): "${VDM_" + $m.env_key + "_" + $suffix + "}";
    ($m.key) as $k | ($m.database.engine+$k) as $db | ("joomla"+$k) as $web |
    (if $m.webserver == "nginx" then "nginx"+$k else $web end) as $http |
    ($host_project+"/"+$m.docroot) as $root |
    (if $m.database.engine == "postgres" then
       {POSTGRES_DB:env("DB"),POSTGRES_USER:env("DB_USER"),POSTGRES_PASSWORD:env("DB_PASS")}
     elif $m.database.engine == "mysql" then
       {MYSQL_DATABASE:env("DB"),MYSQL_USER:env("DB_USER"),MYSQL_PASSWORD:env("DB_PASS"),MYSQL_ROOT_PASSWORD:env("DB_ROOT")}
     else {MARIADB_DATABASE:env("DB"),MARIADB_USER:env("DB_USER"),MARIADB_PASSWORD:env("DB_PASS"),MARIADB_ROOT_PASSWORD:env("DB_ROOT")} end) as $db_env |
    (if $m.database.engine == "postgres" then
       ["CMD-SHELL","pg_isready -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]
     elif $m.database.engine == "mysql" then ["CMD-SHELL","mysqladmin ping --silent"]
     else ["CMD-SHELL","mariadb-admin ping --silent"] end) as $db_health |
    {name:(("octojoom"+$k)|ascii_downcase), services:{
      ($db):{image:($m.database.engine+":"+$m.database.version),container_name:$db,restart:"unless-stopped",
        environment:$db_env,volumes:[{type:"bind",source:($host_project+"/db"),target:(if $m.database.engine=="postgres" then (if ($m.database.version | split(".")[0] | split("-")[0] | tonumber) >= 18 then "/var/lib/postgresql" else "/var/lib/postgresql/data" end) else "/var/lib/mysql" end)}],
        networks:["default"],healthcheck:{test:$db_health,interval:"3s",timeout:"3s",retries:40}},
      ($web):{image:$m.image,container_name:$web,restart:"unless-stopped",working_dir:"/var/www/html",
        environment:({JOOMLA_DB_HOST:($db+(if $m.database.engine=="postgres" then ":5432" else ":3306" end)),JOOMLA_DB_NAME:env("DB"),JOOMLA_DB_USER:env("DB_USER"),JOOMLA_DB_PASSWORD:env("DB_PASS"),JOOMLA_DB_TYPE:(if $m.database.engine=="postgres" then "pgsql" else "mysqli" end),JOOMLA_DB_PREFIX:(($k|ascii_downcase|gsub("[^a-z0-9]";""))[0:10]+"_")} +
          (if ($m.install // false) then {JOOMLA_SITE_NAME:env("SITE_NAME"),JOOMLA_ADMIN_USER:env("ADMIN_NAME"),JOOMLA_ADMIN_USERNAME:env("ADMIN_USERNAME"),JOOMLA_ADMIN_EMAIL:env("ADMIN_EMAIL"),JOOMLA_ADMIN_PASSWORD:env("ADMIN_PASSWORD")} else {} end)),
        volumes:[{type:"bind",source:$root,target:"/var/www/html"},{type:"bind",source:"./php.generated.ini",target:"/usr/local/etc/php/conf.d/zz-octojoom.ini",read_only:true}],
        networks:["default"],depends_on:{($db):{condition:"service_healthy"}},
        healthcheck:{test:(if $m.webserver=="nginx" then ["CMD","php","-r","$$s=@fsockopen(\"127.0.0.1\",9000);exit($$s?0:1);"] else ["CMD","php","-r","$$s=@fsockopen(\"127.0.0.1\",80);exit($$s?0:1);"] end),interval:"3s",timeout:"3s",retries:40}}
    },networks:{default:{}}} |
    if $m.webserver=="nginx" then .services[("nginx"+$k)]={image:"nginx:1.28-alpine",container_name:("nginx"+$k),restart:"unless-stopped",networks:["default"],
       volumes:[{type:"bind",source:$root,target:"/var/www/html",read_only:true},{type:"bind",source:"./nginx.generated.conf",target:"/etc/nginx/conf.d/default.conf",read_only:true}],
       depends_on:{($web):{condition:"service_healthy"}},healthcheck:{test:["CMD","wget","-q","--spider","http://127.0.0.1/__octojoom_health"],interval:"3s",timeout:"3s",retries:40}} else . end |
    if $m.profile=="local" then .services[$http].ports=[{target:80,published:(($m.http_port // 0)|tostring),host_ip:"127.0.0.1",protocol:"tcp"}]
    else .networks.traefik={external:true,name:$network} | .services[$http].networks += ["traefik"] |
      .services[$http].labels={"traefik.enable":"true",("traefik.http.routers."+$web+".rule"):("Host(`"+$m.host+"`)"),
      ("traefik.http.routers."+$web+".service"):$web,("traefik.http.services."+$web+".loadbalancer.server.port"):"80", "traefik.docker.network":$network,
      ("traefik.http.routers."+$web+".entrypoints"):(if $m.tls.mode=="acme" then "websecure" else "web" end)} |
      if $m.tls.mode=="acme" then .services[$http].labels[("traefik.http.routers."+$web+".tls.certresolver")]=($m.tls.resolver // "vdmresolver") else . end
    end |
    if $m.database.engine=="postgres" then .services[("adminer"+$k)]={image:"adminer:5",container_name:("adminer"+$k),restart:"unless-stopped",networks:["default"],environment:{ADMINER_DEFAULT_SERVER:$db},ports:[{target:8080,published:"0",host_ip:"127.0.0.1"}]}
    else .services[("phpmyadmin"+$k)]={image:"phpmyadmin:5",container_name:("phpmyadmin"+$k),restart:"unless-stopped",networks:["default"],environment:{PMA_HOST:$db,PMA_PORT:"3306",UPLOAD_LIMIT:"256M"},ports:[{target:80,published:"0",host_ip:"127.0.0.1"}]} end
  ') || return 1
  if declare -F v4NetworkCompose >/dev/null; then json=$(v4NetworkCompose "$json") || return $?; fi
  temporary=$(mktemp "${output}.tmp.XXXXXX") || return 1
  if ! printf '%s\n' "$json" > "$temporary" || ! chmod 600 "$temporary" || ! mv -f "$temporary" "$output"; then
    rm -f "$temporary"; return 1
  fi
}

# Reserve a new project without starting it. Restore/clone supply a renamed,
# project-scoped environment file; failed reservations never remove old projects.
function v4ProvisionMetadata() {
  local lock="$VDM_REPO_PATH/joomla/.provision.lock" status=0
  v4RuntimeValidateMeta "$1" || return $?
  mkdir -p "$VDM_REPO_PATH/joomla" || return 1
  v4Lock "$lock" || return $?
  v4ProvisionMetadataUnlocked "$@" || status=$?
  v4Unlock "$lock" || status=1
  return "$status"
}

function v4ProvisionMetadataUnlocked() {
  local meta="$1" env_source="$2" host key project directory reserved_project=false status=0 existing other_key source_root prefix value
  v4RuntimeValidateMeta "$meta" || return $?
  host=$(jq -r '.host' <<< "$meta"); key=$(jq -r '.key' <<< "$meta")
  project=$(jq -r '.project_dir' <<< "$meta")
  directory="$VDM_REPO_PATH/joomla/available/$host"
  local enabled="$VDM_REPO_PATH/joomla/enabled/$host"
  if [ -e "$enabled" ] || [ -L "$enabled" ]; then
    if ! { [ -L "$enabled" ] && [ "$(readlink "$enabled")" = "$directory" ]; }; then v4Error 'The enabled-site entry is already owned by another path.' 3; return 3; fi
  fi
  if [ "$(jq -r '.profile' <<< "$meta")" = server ]; then
    local gateway
    gateway=$(jq -r '.network // empty' <<< "$meta"); gateway="${gateway:-${VDM_TRAEFIK_GATEWAY:-traefik_webgateway}}"
    v4Docker network inspect "$gateway" >/dev/null 2>&1 || { v4Error 'The server proxy network is unavailable. Set up the server proxy or use profile=local.' 3; return 3; }
  fi
  if ! { [ -f "$env_source" ] && [ ! -L "$env_source" ]; }; then v4Error 'A regular scoped environment file is required.' 2; return 2; fi
  migrationReadEnvValue "$env_source" VDM_PROJECT_PATH source_root || { v4Error 'The scoped environment is missing its project root.' 2; return 2; }
  if ! v4ValidAbsolutePath "$source_root" || [ "$project" != "${source_root%/}/$key" ]; then
    v4Error 'The scoped environment and project metadata disagree about the destination.' 2; return 2
  fi
  prefix="VDM_$(jq -r '.env_key' <<< "$meta")"
  if ! migrationReadEnvValue "$env_source" "${prefix}_DB" value || [ "$value" != "$(jq -r '.database.name' <<< "$meta")" ]; then
    v4Error 'The scoped database name does not match metadata.' 2; return 2
  fi
  if ! migrationReadEnvValue "$env_source" "${prefix}_DB_USER" value || [ "$value" != "$(jq -r '.database.user' <<< "$meta")" ]; then
    v4Error 'The scoped database user does not match metadata.' 2; return 2
  fi
  if ! migrationReadEnvValue "$env_source" "${prefix}_DB_PASS" value || [ -z "$value" ]; then
    v4Error 'The scoped database password is missing.' 2; return 2
  fi
  if ! { [ ! -e "$directory" ] && [ ! -L "$directory" ] && [ ! -e "$project" ] && [ ! -L "$project" ]; }; then
    v4Error 'The destination site or project directory already exists.' 3; return 3;
  fi
  # Service/container names include the key, so it must be unique across hosts.
  for existing in "$VDM_REPO_PATH"/joomla/available/*/docker-compose.yml; do
    [ -f "$existing" ] || continue
    if [ -f "${existing%/*}/project.json" ]; then
      other_key=$(jq -er '.key' "${existing%/*}/project.json") || { v4Error 'An existing project has unreadable identity metadata.' 2; return 2; }
    else
      other_key=$(getJoomlaComposeIdentity "$existing" && printf '%s' "$VDM_SRC_KEY") || { v4Error 'An existing project has an unrecognized Compose identity.' 2; return 2; }
    fi
    [ "${other_key,,}" != "${key,,}" ] || { v4Error 'The project key is already used by another site.' 3; return 3; }
  done
  mkdir -p "$VDM_REPO_PATH/joomla/available" "$(dirname "$project")" || return 1
  mkdir "$directory" || return 1
  if mkdir "$project"; then reserved_project=true; else status=1; fi
  if [ "$status" -eq 0 ]; then
    V4_META="$meta" V4_DIR="$directory" V4_COMPOSE="$directory/docker-compose.yml" V4_ENV_FILE="$directory/.env"
    V4_PROJECT="$project" V4_DOCROOT="$project/$(jq -r '.docroot' <<< "$meta")"
    mkdir -p "$V4_DOCROOT" "$project/db" && chmod 700 "$directory" &&
      cp "$env_source" "$V4_ENV_FILE" && chmod 600 "$V4_ENV_FILE" &&
      v4SaveMetadata "$meta" && v4GenerateCompose &&
      v4Compose config --quiet >/dev/null 2>&1 || status=1
  fi
  if [ "$status" -ne 0 ]; then
    rm -rf -- "$directory"
    if [ "$reserved_project" = true ]; then rm -rf -- "$project"; fi
    v4Error 'The new project could not be prepared; its reserved paths were removed.'
    return 1
  fi
  if ! v4LoadSite "$host"; then
    rm -rf -- "$directory" "$project"
    v4Error 'The new project could not be loaded; its reserved paths were removed.'
    return 1
  fi
}

function v4RuntimeDefaultDbVersion() {
  case "$1" in mariadb) printf '11.4\n' ;; mysql) printf '8.4\n' ;; postgres) printf '17\n' ;; *) return 2 ;; esac
}

function v4RuntimeNewMetadata() {
  local host key env_key version php webserver engine db_version profile docroot image port install name user
  v4Require site joomla_version php_version || return $?
  host=$(v4Get site); key=$(v4Get key "${host%%.*}"); env_key="${key^^}"; env_key=$(v4Get env_key "${env_key//-/_}")
  version=$(v4Get joomla_version); php=$(v4Get php_version); webserver=$(v4Get webserver apache)
  engine=$(v4Get database_engine mariadb); db_version=$(v4Get database_version "$(v4RuntimeDefaultDbVersion "$engine")")
  profile=$(v4Get profile local); docroot=$(v4Get docroot joomla); port=$(v4Get http_port 0)
  install=$(v4Get install true); name=$(v4Get database_name joomla); user=$(v4Get database_user joomla)
  image=$(v4Get image "$(v4RuntimeImage "$version" "$php" "$webserver")")
  if ! { [[ "$port" =~ ^[0-9]+$ ]] && [[ "$install" = true || "$install" = false ]]; }; then v4Error 'http_port must be numeric and install must be boolean.' 2; return 2; fi
  jq -n --arg host "$host" --arg key "$key" --arg env "$env_key" --arg project "$VDM_PROJECT_PATH/$key" --arg docroot "$docroot" \
    --arg image "$image" --arg version "$version" --arg php "$php" --arg webserver "$webserver" --arg profile "$profile" \
    --arg engine "$engine" --arg db_version "$db_version" --arg name "$name" --arg user "$user" --argjson port "$port" --argjson install "$install" \
    --arg tls "$(v4Get tls_mode none)" --arg resolver "$(v4Get tls_resolver vdmresolver)" \
    --arg network "$(v4Get network "${VDM_TRAEFIK_GATEWAY:-traefik_webgateway}")" \
    --argjson hooks "$(jq -c '.hooks // {}' <<< "$V4_REQUEST")" \
    --argjson services "$(jq -c '{mail:(.mail // false),redis:(.redis // false),node:(.node // false)} + (if has("mail_port") then {mail_port:.mail_port} else {} end) + (if has("node_image") then {node_image:.node_image} else {} end)' <<< "$V4_REQUEST")" \
    '{schema_version:1,host:$host,key:$key,env_key:$env,project_dir:$project,docroot:$docroot,image:$image,joomla_version:$version,php_version:$php,
      webserver:$webserver,profile:$profile,http_port:$port,install:$install,database:{engine:$engine,version:$db_version,name:$name,user:$user},
      tls:{mode:$tls,resolver:$resolver},network:$network,services:$services,hooks:$hooks,php_settings:{}}'
}

function v4RuntimeCreateEnv() {
  local meta="$1" destination="$2" env_key suffix value install password
  env_key=$(jq -r '.env_key' <<< "$meta"); install=$(jq -r '.install' <<< "$meta")
  if [ "$install" = true ]; then
    v4Require admin_email || return $?
    [[ "$(v4Get admin_email)" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || { v4Error 'A valid administrator email is required.' 2; return 2; }
    [[ "$(v4Get admin_username admin)" =~ ^[A-Za-z]+$ ]] || { v4Error 'The image installer requires an alphabetic administrator username.' 2; return 2; }
    value=$(v4Get site_name 'Joomla Site'); [ "${#value}" -gt 2 ] || { v4Error 'Site name must contain at least three characters.' 2; return 2; }
    value=$(v4Get admin_name Administrator); [ "${#value}" -gt 2 ] || { v4Error 'Administrator name must contain at least three characters.' 2; return 2; }
  fi
  : > "$destination" && chmod 600 "$destination" || return 1
  writeEnvVariable "$destination" "VDM_PROJECT_PATH=\"$VDM_PROJECT_PATH\"" true || return 1
  for suffix in DB DB_USER DB_PASS DB_ROOT SITE_NAME ADMIN_NAME ADMIN_USERNAME ADMIN_EMAIL ADMIN_PASSWORD; do
    case "$suffix" in
      DB) value=$(jq -r '.database.name' <<< "$meta") ;;
      DB_USER) value=$(jq -r '.database.user' <<< "$meta") ;;
      DB_PASS) value=$(v4Get database_password "$(getRandomPass 32)") ;;
      DB_ROOT) value=$(v4Get database_root_password "$(getRandomPass 40)") ;;
      SITE_NAME) value=$(v4Get site_name 'Joomla Site') ;;
      ADMIN_NAME) value=$(v4Get admin_name Administrator) ;;
      ADMIN_USERNAME) value=$(v4Get admin_username admin) ;;
      ADMIN_EMAIL) value=$(v4Get admin_email '') ;;
      ADMIN_PASSWORD) value=$(v4Get admin_password "$(getRandomPass 32)"); password="$value" ;;
    esac
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || { v4Error 'Environment settings must be single-line values.' 2; return 2; }
    case "$suffix" in DB_PASS|DB_ROOT) [ -n "$value" ] || { v4Error 'Database passwords must not be empty.' 2; return 2; } ;; esac
    [ "$suffix" != ADMIN_PASSWORD ] || [ "$install" != true ] || [ "${#password}" -ge 13 ] || { v4Error 'Administrator password must contain at least 13 characters.' 2; return 2; }
    writeEnvVariable "$destination" "VDM_${env_key}_${suffix}=\"$value\"" true || return 1
  done
}

function v4SiteCreate() {
  local meta env_source host start status=0 tls
  meta=$(v4RuntimeNewMetadata) || return $?
  v4RuntimeValidateMeta "$meta" || return $?
  host=$(jq -r '.host' <<< "$meta"); start=$(v4Get start true)
  [[ "$start" = true || "$start" = false ]] || { v4Error 'start must be boolean.' 2; return 2; }
  tls=$(jq -r '.tls.mode' <<< "$meta")
  [ "$tls" != local ] || { v4Error 'Create the site with tls_mode=none, then run tls setup to establish workstation trust.' 2; return 2; }
  if v4Has source_url; then
    v4Require source_sha256 || return $?
    if ! { [[ "$(v4Get source_url)" = https://* ]] && [[ "$(v4Get source_sha256)" =~ ^[[:xdigit:]]{64}$ ]]; }; then
      v4Error 'A source package requires an HTTPS URL and its SHA-256 checksum.' 2; return 2;
    fi
  fi
  env_source=$(mktemp "${TMPDIR:-/tmp}/octojoom-env.XXXXXX") || return 1
  if ! v4RuntimeCreateEnv "$meta" "$env_source"; then rm -f "$env_source"; return 2; fi
  if ! v4RuntimeValidateImage "$meta"; then rm -f "$env_source"; return 2; fi
  if v4ProvisionMetadata "$meta" "$env_source"; then :; else status=$?; fi
  rm -f "$env_source"
  [ "$status" -eq 0 ] || return "$status"
  if v4Has source_url; then
    if ! v4RuntimeDownloadSource "$(v4Get source_url)" "$V4_DOCROOT" "$(v4Get source_sha256)"; then
      v4Error 'Source download failed. The prepared project is retained for inspection.'; return 1
    fi
    local source_version expected_version
    source_version=$(v4RuntimeInstalledVersion) || { v4Error 'The downloaded Joomla version cannot be verified.' 2; return 2; }
    expected_version=$(jq -r '.joomla_version' <<< "$meta")
    if [[ "$expected_version" =~ ^[0-9]+\.[0-9]+$ ]]; then
      [[ "$source_version" = "$expected_version".* ]] || { v4Error 'The downloaded package belongs to a different Joomla release line.' 2; return 2; }
    else
      [ "$source_version" = "$expected_version" ] || { v4Error 'The downloaded package is a different Joomla version.' 2; return 2; }
    fi
  fi
  if [ "$start" = true ]; then
    if declare -F v4RunHook >/dev/null; then v4RunHook pre-start || return $?; fi
    if ! v4Compose up -d --wait --wait-timeout "$(v4Get timeout 180)" >&2; then
      v4Compose stop >&2 || true
      v4Error 'Site startup failed. The stopped project is retained for diagnosis.'; return 1
    fi
    if [ "$(jq -r '.install' <<< "$meta")" = true ] && ! v4Exec "$V4_WEB_SERVICE" php -r 'exit(is_file("configuration.php") && !is_dir("installation") ? 0 : 1);' >/dev/null; then
      v4Error 'Containers started, but Joomla installation did not complete. Inspect site logs.'; return 1
    fi
    if [ "$(jq -r '.install' <<< "$meta")" = true ]; then v4RealignConfiguration || return $?; fi
    if declare -F v4RunHook >/dev/null; then v4RunHook post-start || return $?; fi
    mkdir -p "$VDM_REPO_PATH/joomla/enabled" || return 1
    if [ ! -L "$VDM_REPO_PATH/joomla/enabled/$host" ]; then ln -s "$V4_DIR" "$VDM_REPO_PATH/joomla/enabled/$host" || return 1; fi
  fi
  v4Result "$(jq -n --arg site "$host" --arg credentials "$V4_ENV_FILE" --argjson running "$start" '{site:$site,prepared:true,running:$running,credentials_file:$credentials}')"
}

# Only new project directories are eligible for source extraction. Validate every
# archive member before extracting so a package cannot escape the new docroot.
function v4RuntimeDownloadSource() {
  local url="$1" destination="$2" expected="${3:-}" archive stage member mode actual status=0
  [[ "$url" = https://* ]] || { v4Error 'Joomla package URLs must use HTTPS.' 2; return 2; }
  [[ "$expected" =~ ^[[:xdigit:]]{64}$ ]] || { v4Error 'A SHA-256 checksum is required for the Joomla package.' 2; return 2; }
  if ! { [ -d "$destination" ] && [ -z "$(find "$destination" -mindepth 1 -maxdepth 1 -print -quit)" ]; }; then
    v4Error 'Joomla packages may only be extracted into an empty document root.' 2; return 2;
  fi
  stage=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-download.XXXXXX") || return 1
  archive="$stage/package"
  if ! curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 --output "$archive" "$url" >&2; then rm -rf "$stage"; return 1; fi
  if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum < "$archive") || status=1
  else actual=$(shasum -a 256 < "$archive") || status=1; fi
  if [ "$status" -ne 0 ] || [ "${actual%% *}" != "${expected,,}" ]; then
    rm -rf "$stage"; v4Error 'The Joomla package checksum did not match.' 2; return 2
  fi
  if unzip -tqq "$archive" >/dev/null 2>&1; then
    mode=zip
    unzip -Z1 "$archive" > "$stage/members" || status=1
    unzip -Z -l "$archive" | awk '$1 ~ /^[lbcps]/ {bad=1} END {exit bad}' || status=1
  else
    mode=tar
    tar -tf "$archive" > "$stage/members" 2>/dev/null || status=1
    tar -tvf "$archive" 2>/dev/null | awk 'substr($0,1,1)!="-" && substr($0,1,1)!="d" {bad=1} END {exit bad}' || status=1
  fi
  while IFS= read -r member; do
    case "$member" in /*|*\\*|*:*|../*|*/../*|*/..|..|*$'\r'*) status=1 ;; esac
  done < "$stage/members"
  if [ "$status" -eq 0 ]; then
    if [ "$mode" = zip ]; then unzip -q "$archive" -d "$destination" || status=1
    else tar -xf "$archive" -C "$destination" || status=1; fi
  fi
  rm -rf "$stage"
  if [ "$status" -ne 0 ]; then v4Error 'The Joomla package is invalid or contains unsafe members.' 2; return 2; fi
  [ -f "$destination/administrator/manifests/files/joomla.xml" ] || { v4Error 'The package does not contain a Joomla installation at its root.' 2; return 2; }
}

function v4RuntimeValidateComposeFile() {
  local env_file directory file override
  env_file=$(v4DockerHostPath "$V4_ENV_FILE") || return $?
  directory=$(v4DockerHostPath "$V4_DIR") || return $?
  file=$(v4DockerHostPath "$1") || return $?
  local args=(--env-file "$env_file" --project-directory "$directory" --file "$file")
  if [ -f "$V4_DIR/docker-compose.override.yml" ]; then
    override=$(v4DockerHostPath "$V4_DIR/docker-compose.override.yml") || return $?
    args+=(--file "$override")
  fi
  v4ComposeScopedDocker "${args[@]}" config --quiet >/dev/null 2>&1 || {
    v4Error 'The proposed Compose configuration is invalid.' 2; return 2;
  }
}

# Resolve the override as Compose does, but do not refresh already-present tags:
# a PHP/settings action must not silently replace a database image as a side effect.
function v4RuntimePrepareImages() {
  local config image env_file directory file override
  env_file=$(v4DockerHostPath "$V4_ENV_FILE") || return $?
  directory=$(v4DockerHostPath "$V4_DIR") || return $?
  file=$(v4DockerHostPath "$1") || return $?
  local args=(--env-file "$env_file" --project-directory "$directory" --file "$file")
  if [ -f "$V4_DIR/docker-compose.override.yml" ]; then
    override=$(v4DockerHostPath "$V4_DIR/docker-compose.override.yml") || return $?
    args+=(--file "$override")
  fi
  config=$(v4ComposeScopedDocker "${args[@]}" config --format json) || return 1
  jq -e '.services | type=="object"' <<< "$config" >/dev/null || return 2
  while IFS= read -r image; do
    [ -n "$image" ] || continue
    v4Docker image inspect "$image" >/dev/null 2>&1 || v4Docker pull "$image" >&2 || return 1
  done < <(jq -r '.services[] | select(.build == null) | .image // empty' <<< "$config" | LC_ALL=C sort -u)
}

function v4ApplyConfig() {
  local meta="$1" restart="${2:-true}" lock="$V4_DIR/.operation.lock" host="$V4_HOST" status=0
  v4Lock "$lock" || return $?
  v4ApplyConfigUnlocked "$meta" "$restart" || status=$?
  v4Unlock "$lock" || status=1
  if [ "$status" -eq 0 ]; then v4LoadSite "$host" || return $?; fi
  return "$status"
}

# Call only while holding this site's operation lock. Configuration rollback
# never restores database storage: engine/version changes use a fresh instance.
function v4ApplyConfigUnlocked() {
  (
    local next="$1" restart="${2:-true}" previous="$V4_META" staging backup published=false running='' status=0 file
    local -a originally_running=()
    v4RuntimeValidateMeta "$next" || exit $?
    for file in host key env_key project_dir docroot; do
      [ "$(jq -r --arg k "$file" '.[$k]' <<< "$next")" = "$(jq -r --arg k "$file" '.[$k]' <<< "$previous")" ] || {
        v4Error 'Changing identity or document-root layout requires a clone into a new project.' 2; exit 2;
      }
    done
    [ "$(jq -c '.database' <<< "$next")" = "$(jq -c '.database' <<< "$previous")" ] || {
      v4Error 'Database changes require the database switch action and a new database instance.' 2; exit 2;
    }
    staging=$(mktemp -d "$V4_DIR/.runtime.XXXXXX") || exit 1
    backup="$staging/previous"
    mkdir "$backup" || { rm -rf "$staging"; exit 1; }
    trap 'status=$?; trap - EXIT;
      if [ "$published" = true ] && [ "$status" -ne 0 ]; then
        v4Compose stop >&2 || true
        for file in docker-compose.yml project.json php.generated.ini nginx.generated.conf; do
          if [ -f "$backup/$file" ]; then cp -p "$backup/$file" "$V4_DIR/$file" || status=1; else rm -f "$V4_DIR/$file" || status=1; fi
        done
        V4_META="$previous"
        if declare -F v4NetworkSyncRoute >/dev/null; then v4NetworkSyncRoute || status=1; fi
        if [ -n "$running" ]; then
          v4Compose up -d --remove-orphans --wait --wait-timeout 180 "${originally_running[@]}" >&2 || { v4Error "Configuration was restored, but the original services could not be restarted."; status=1; }
        else v4Compose stop >&2 || true; fi
      fi
      rm -rf "$staging"
      exit "$status"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    for file in docker-compose.yml project.json php.generated.ini nginx.generated.conf; do
      [ ! -f "$V4_DIR/$file" ] || cp -p "$V4_DIR/$file" "$backup/$file" || exit 1
    done
    running=$(v4Compose ps --status running --services) || exit 1
    while IFS= read -r file; do [ -z "$file" ] || originally_running+=("$file"); done <<< "$running"
    V4_META="$next"
    v4GenerateCompose "$staging/docker-compose.yml" || exit $?
    v4RuntimeValidateComposeFile "$staging/docker-compose.yml" || exit $?
    printf '%s\n' "$next" > "$staging/project.json" && chmod 600 "$staging/project.json" || exit 1
    v4RuntimePrepareImages "$staging/docker-compose.yml" || exit $?
    published=true
    for file in docker-compose.yml project.json php.generated.ini nginx.generated.conf; do
      mv -f "$staging/$file" "$V4_DIR/$file" || exit 1
    done
    if [ "$restart" = true ] && [ -n "$running" ]; then
      v4Compose up -d --remove-orphans --wait --wait-timeout "$(v4Get timeout 180)" >&2 || exit 1
      if declare -F v4WaitReady >/dev/null; then v4WaitReady "$(v4Get timeout 180)" || exit $?; fi
    fi
    if declare -F v4NetworkSyncRoute >/dev/null; then v4NetworkSyncRoute || exit $?; fi
    published=false
    exit 0
  )
}

function v4RuntimeInstalledVersion() {
  local manifest="$V4_DOCROOT/administrator/manifests/files/joomla.xml" version
  [ -f "$manifest" ] || return 1
  version=$(sed -nE 's/^[[:space:]]*<version>([0-9]+\.[0-9]+\.[0-9]+)<\/version>[[:space:]]*$/\1/p' "$manifest" | head -n 1)
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || return 1
  printf '%s\n' "$version"
}

