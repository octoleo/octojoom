function v4SetEnv() {
  local file="$1" assignment="$2" replace="${3:-true}"
  [ ! -L "$file" ] || { v4Error 'Environment files must not be symbolic links.' 2; return 2; }
  formatEnvAssignment "$assignment" >/dev/null || { v4Error 'Invalid environment assignment.' 2; return 2; }
  if [ ! -f "$file" ]; then
    [ -d "${file%/*}" ] || mkdir -p "${file%/*}" || return 1
    (umask 077; set -C; : > "$file") || return 1
  fi
  writeEnvVariable "$file" "$assignment" "$replace"
}

# The owner record is checked before stale recovery and before release. A live
# owner, an owner on another machine, or an unreadable record is never removed.
function v4Lock() {
  local path="$1" owner host uid pid previous reclaim current_pid="$BASHPID"
  if ! { v4ValidAbsolutePath "$path" && [ ! -L "$path" ]; }; then v4Error 'Invalid operation lock path.' 2; return 2; fi
  host=$(hostname) || return 1; uid=$(id -u) || return 1
  if ! (umask 077; mkdir "$path") 2>/dev/null; then
    if ! { [ -d "$path" ] && [ -f "$path/owner" ] && [ ! -L "$path/owner" ]; }; then v4Error 'Another operation owns this lock; its owner could not be verified.' 4; return 4; fi
    previous=$(cat "$path/owner") || return 4
    IFS=$'\t' read -r pid owner reclaim <<< "$previous"
    if [[ ! "$pid" =~ ^[0-9]+$ || "$pid" -le 1 || "$owner" != "$host" || "$reclaim" != "$uid" ]] || kill -0 "$pid" 2>/dev/null; then
      v4Error 'Another operation is using this project.' 4; return 4
    fi
    reclaim="${path}.reclaim"
    v4Lock "$reclaim" || return $?
    if [ "$(cat "$path/owner" 2>/dev/null)" != "$previous" ] || kill -0 "$pid" 2>/dev/null; then
      v4Unlock "$reclaim"; v4Error 'The operation lock changed during recovery.' 4; return 4
    fi
    if ! rm -- "$path/owner" || ! rmdir "$path" || ! (umask 077; mkdir "$path"); then
      v4Unlock "$reclaim"; v4Error 'The stale operation lock could not be recovered.' 4; return 4
    fi
    v4Unlock "$reclaim" || return 4
  fi
  (umask 077; printf '%s\t%s\t%s\n' "$current_pid" "$host" "$uid" > "$path/owner") || { rmdir "$path" 2>/dev/null; return 1; }
}

function v4Unlock() {
  local path="$1" pid host uid
  [ -d "$path" ] && [ ! -L "$path" ] && [ -f "$path/owner" ] && [ ! -L "$path/owner" ] || return 1
  IFS=$'\t' read -r pid host uid < "$path/owner" || return 1
  [[ "$pid" == "$BASHPID" && "$host" == "$(hostname)" && "$uid" == "$(id -u)" ]] || return 1
  rm -- "$path/owner" && rmdir "$path"
}

