# Check Bash version
function check_bash_version() {
  local bash_version="${1:-}"
  if [[ ! "$bash_version" =~ ^[0-9]+$ ]]; then
    echo >&2 "ERROR: Invalid required Bash version '${bash_version}'."
    return 1
  fi
  if (( BASH_VERSINFO[0] < 10#$bash_version )); then
    echo >&2 "ERROR: ${PROGRAM_NAME} v${_VERSION} script requires Bash version ${bash_version}.0 or above."
    return 1
  fi
}
# Check for the appropriate version of Bash
check_bash_version "$_bash_v" || exit 1

# Restrict new directories on Unix without mkdir's nonportable mode-setting
# behavior on Git Bash. Keep the caller's umask and mkdir's exit status intact.
function createPrivateDirectory() {
  (
    umask 077
    mkdir "$@"
  )
}

# Install whiptail with the host's package manager.
function install_whiptail_linux() {
  if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update || return 1
    sudo apt-get install whiptail -y || return 1
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y newt || return 1
  elif command -v yum >/dev/null 2>&1; then
    sudo yum install -y newt || return 1
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm libnewt || return 1
  elif command -v zypper >/dev/null 2>&1; then
    sudo zypper install -y newt || return 1
  else
    echo >&2 "ERROR: Unsupported package manager. Please install whiptail manually."
    return 1
  fi
  if ! command -v whiptail >/dev/null 2>&1; then
    echo >&2 "ERROR: Installation did not provide whiptail. Please install whiptail manually."
    return 1
  fi
}
# Install whiptail on macOS
