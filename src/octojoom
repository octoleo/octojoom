# One question collector for new-site defaults and selected-site overrides.
function joomlaPHPQuestion() {
  local setting="$1" default="$2" answer variable="VDM_$1"
  if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then
    if cliHasValue "$variable"; then answer="${!variable}"; else answer="$default"; fi
  else
    answer=$(getInputNow "Enter ${setting//_/ }" "$default" "$setting") || return $?
  fi
  joomlaPHPValidateValue "$setting" "$answer" || { printf 'Invalid PHP value for %s.\n' "$setting" >&2; return 2; }
  printf '%s\n' "$answer"
}

function configurePHPSettings() {
    local default_error_reporting edit_status ini_dir ini_file ini_source='' temporary status=0
    # max_execution_time
    VDM_max_execution_time=$(joomlaPHPQuestion max_execution_time "${VDM_max_execution_time:-124}") || return $?
    # remember this for next time
    setUniqueEnvVariable "VDM_max_execution_time=${VDM_max_execution_time}" || return $?

    # max_input_time
    VDM_max_input_time=$(joomlaPHPQuestion max_input_time "${VDM_max_input_time:-1500}") || return $?
    # remember this for next time
    setUniqueEnvVariable "VDM_max_input_time=${VDM_max_input_time}" || return $?

    # max_input_vars
    VDM_max_input_vars=$(joomlaPHPQuestion max_input_vars "${VDM_max_input_vars:-3000}") || return $?
    # remember this for next time
    setUniqueEnvVariable "VDM_max_input_vars=${VDM_max_input_vars}" || return $?

    # error_reporting
    default_error_reporting="E_ALL & ~E_DEPRECATED & ~E_STRICT"
    VDM_error_reporting=$(joomlaPHPQuestion error_reporting "${VDM_error_reporting:-$default_error_reporting}") || return $?
    # remember this for next time
    setUniqueEnvVariable "VDM_error_reporting=\"${VDM_error_reporting}\"" || return $?

    # upload_max_filesize
    VDM_upload_max_filesize=$(joomlaPHPQuestion upload_max_filesize "${VDM_upload_max_filesize:-256M}") || return $?
    # remember this for next time
    setUniqueEnvVariable "VDM_upload_max_filesize=\"${VDM_upload_max_filesize}\"" || return $?

    # post_max_size
    VDM_post_max_size=$(joomlaPHPQuestion post_max_size "${VDM_post_max_size:-256M}") || return $?
    # remember this for next time
    setUniqueEnvVariable "VDM_post_max_size=\"${VDM_post_max_size}\"" || return $?

    # memory_limit
    VDM_memory_limit=$(joomlaPHPQuestion memory_limit "${VDM_memory_limit:-256M}") || return $?
    # remember this for next time
    setUniqueEnvVariable "VDM_memory_limit=\"${VDM_memory_limit}\"" || return $?

    if [ -n "${VDM_J_REPO:-}" ] && [ -n "${VDM_JV:-}" ]; then
      joomlaRuntimeRequireTools || return 2
      VDM_PHP_INI_TARGET=$(joomlaRuntimeIniTarget "${VDM_J_REPO}:${VDM_JV}") || return 2
      export VDM_PHP_INI_TARGET
    fi
    # PHP configuration contains no credentials. Keep it readable by the
    # selected image's own user instead of requiring a host www-data account.
    # An adjacent temporary file permits replacement of an older read-only
    # override without changing its contents before validation succeeds.
    ini_dir="${VDM_PROJECT_PATH}/${VDM_PHP_PROJECT_PATH}"
    ini_file="${ini_dir}/php.ini"
    mkdir -p "$ini_dir" || return $?
    temporary=$(mktemp "${ini_dir}/.php.ini.XXXXXX") || return $?
    [ ! -f "$ini_file" ] || ini_source="$ini_file"
    if ! joomlaPHPPatchIni "$ini_source" "$temporary" \
      max_execution_time "$VDM_max_execution_time" max_input_time "$VDM_max_input_time" \
      max_input_vars "$VDM_max_input_vars" error_reporting "$VDM_error_reporting" \
      upload_max_filesize "$VDM_upload_max_filesize" post_max_size "$VDM_post_max_size" memory_limit "$VDM_memory_limit"; then
      rm -f "$temporary"
      return 1
    fi

    if isExpert; then
      if getInputYesNo "Would you like to set some more custom PHP overrides for this Joomla container" \
        "Edit PHP.ini" 8 112 "defaultno"; then
        showNotice "${USER^}, to save the changes you've made or to just close the file again press:\n\n[ctrl+x] with nano on ubuntu." 13
        "${EDITOR:-nano}" "$temporary" || status=$?
      else
        edit_status=$?
        [ "$edit_status" -eq 1 ] || status="$edit_status"
      fi
    fi
    if [ "$status" -eq 0 ] && [ -n "${VDM_J_REPO:-}" ] && [ -n "${VDM_JV:-}" ]; then
      joomlaPHPValidateIni "${VDM_J_REPO}:${VDM_JV}" "$temporary" "$VDM_PHP_INI_TARGET" || status=$?
    fi
    if [ "$status" -eq 0 ]; then
      chmod 644 "$temporary" && mv -f "$temporary" "$ini_file" || status=$?
    fi
    rm -f "$temporary"
    return "$status"
}

# set the docker entrypoint
function setDockerEntrypoint() {
  local customization_status
  # ask the question
  if getInputYesNo "Would you like to customize the entrypoint script for this Joomla container" \
    "entrypoint.sh values" 8 112 "defaultno"; then
    if configureDockerEntrypoint; then
      return 0
    else
      customization_status=$?
      [ "$customization_status" -gt 1 ] || customization_status=2
      return "$customization_status"
    fi
  else
    return $?
  fi
}

function configureDockerEntrypoint() {
    local entrypoint_dir="${VDM_PROJECT_PATH}/${VDM_ENTRY_PROJECT_PATH}" temporary customization_status
    # make sure the directory exist
    mkdir -p "$entrypoint_dir" || return $?
    temporary=$(mktemp "${entrypoint_dir}/entrypoint.sh.tmp.XXXXXX") || return $?
    # download entrypoint.sh file to the project folder
    if sudo curl --fail -L "${VDM_ENTRY_REPO}" -o "$temporary" 2>/dev/null; then
      # give little heads-up
      showNotice "${USER^}, to save the changes you've made or to just close the file again press:\n\n[ctrl+x] with nano on ubuntu." 13
      # lets open the file with nano for now
      if sudo "${EDITOR:-nano}" "$temporary" &&
        sudo chown 0:0 "$temporary" && sudo chmod 700 "$temporary" &&
        sudo mv -f "$temporary" "${entrypoint_dir}/entrypoint.sh"; then
        return 0
      else
        customization_status=$?
        sudo rm -f "$temporary"
        return "$customization_status"
      fi
    else
      customization_status=$?
      sudo rm -f "$temporary"
      # show the error
      showError "The entrypoint.sh could not be set."
      return "$customization_status"
    fi
}

# Set the secure Cloudflare state
function setSecureCloudflareState() {
  if cliHasValue VDM_SECURE_CLOUDFLARE || [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then
    : "${VDM_SECURE_CLOUDFLARE:=false}"
    export VDM_SECURE_CLOUDFLARE
    return 0
  fi
	# Determine caller
	local caller="${1:-generic}"
	local question=""
	local title="Cloudflare" status

	# Build caller-specific question
	if [[ "$caller" == "traefik" ]]; then
		question="Will any of the domains hosted on this server be proxied through Cloudflare?\n\nCloudflare's proxy layer requires special handling in Traefik."
	elif [[ "$caller" == "joomla" ]]; then
		question="Is the domain for this Joomla instance proxied through Cloudflare?\n\nCloudflare's proxy layer requires special handling for this container."
	else
		# Fallback if future tools call it
		question="Is the domains involved in this setup proxied through Cloudflare?\n\nCloudflare's proxy layer requires special handling."
	fi

	# Ask the user
	if getInputYesNo "$question" "$title" 10 112 "defaultno"; then
		VDM_SECURE_CLOUDFLARE=true
	else
		status=$?
		[ "$status" -eq 1 ] || return "$status"
		VDM_SECURE_CLOUDFLARE=false
	fi

	export VDM_SECURE_CLOUDFLARE
}

