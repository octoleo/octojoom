    3)
      updateHostFile_windows "$@"
      ;;
    *)
      echo >&2 "ERROR: Unsupported operating system."
      exit 1
      ;;
  esac
}

# Manually edit the host file (dynamically calls the correct OS function)
function editHostFile() {
  case "$OS_NUMBER" in
