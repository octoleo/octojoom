function setContainerEnvVariable() {
  [[ "${VDM_CONTAINER_TYPE:-}" =~ ^[a-zA-Z0-9_-]+$ ]] || return 12
  if [ "${OCTOJOOM_SETUP_COLLECT_ENV:-false}" = true ]; then
    if [ ! -f "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" ] && [ "${OCTOJOOM_SETUP_ENV_APPROVED:-false}" != true ]; then
      getInputYesNo "Can we create the ${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env file" "Environment Variable File" 8 112 || return 12
      OCTOJOOM_SETUP_ENV_APPROVED=true
    fi
    formatEnvAssignment "$1" >/dev/null || return 12
    OCTOJOOM_SETUP_ASSIGNMENTS+=("$1")
    return 0
  fi
  writeEnvVariable "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/.env" "$1"
}

# get the env file to use with a container's docker-compose.yml
# $1: container type (joomla, openssh, ...)
# $2: container name (sub.domain.tld)
# $3 (optional): state directory to look in (enabled or available), default enabled
# A per-container .env (available/<container>/.env, also reachable through the
# enabled/<container> symlink) wins over the shared <type>/.env file.
# Prints the path, or nothing when neither file exists.
function getContainerEnvFile() {
  local container_type="${1:-$VDM_CONTAINER_TYPE}"
  local container="${2:-}"
  local state="${3:-enabled}"
  if [ -n "${container}" ] && [ -f "${VDM_REPO_PATH}/${container_type}/${state}/${container}/.env" ]; then
    echo "${VDM_REPO_PATH}/${container_type}/${state}/${container}/.env"
  elif [ -f "${VDM_REPO_PATH}/${container_type}/.env" ]; then
    echo "${VDM_REPO_PATH}/${container_type}/.env"
  else
    echo ''
  fi
}

# check if a Directory exist and if it has sub-directories
function hasDirectories() {
  local path="${2:-$VDM_REPO_PATH}/${1:-}" directory
  [ -d "$path" ] || return 1
  for directory in "${path%/}/"* "${path%/}/".[!.]* "${path%/}/"..?*; do
    [ -d "$directory" ] && return 0
  done
  return 1
}

# lsof returns 1 with no output when nothing is listening. Diagnostics or any
# other nonzero status mean the scan failed, rather than proving ports are free.
function getPortListeners() {
  local listeners scan_status
  if [ "${OS_NUMBER:-0}" -eq 3 ]; then
    # Windows ships netstat; sudo and lsof are not Git Bash prerequisites.
    if ! listeners=$(netstat.exe -ano -p TCP 2>&1); then
      printf 'Unable to inspect ports 80 and 443: %s\n' "$listeners" >&2
      return 1
    fi
    # Emit the same nine columns consumed by ensurePortsFree's lsof parser.
    # Print no header when the selected ports have no listening sockets.
    printf '%s\n' "$listeners" | awk '
      { gsub(/\r/, "") }
      $1 == "TCP" && $4 == "LISTENING" && $2 ~ /:(80|443)$/ {
        if (!header++) print "COMMAND PID USER FD TYPE DEVICE SIZE/OFF NODE NAME"
        print "netstat", $5, "- - TCP - - -", $2
      }'
    return 0
  fi
  if listeners=$(cliSudo lsof -a -nP -iTCP:80 -iTCP:443 -sTCP:LISTEN 2>&1); then
    scan_status=0
  else
    scan_status=$?
  fi
  if [ "$scan_status" -ne 0 ] && { [ "$scan_status" -ne 1 ] || [ -n "$listeners" ]; }; then
    printf 'Unable to inspect ports 80 and 443: %s\n' "$listeners" >&2
    return 1
  fi
  printf '%s' "$listeners"
}

# Ensure that no system service or process is blocking ports 80 or 443 before Traefik starts
function ensurePortsFree() {
	# Known Linux services that may bind to ports 80/443
	local web_services=("apache2" "httpd" "nginx" "lighttpd" "caddy")
	local conflict_services=()
	local port_users=""
	local message=""
	local os_label=""
	local port_output line proc_name ws svc

	# If Traefik container is running → skip everything
	if isContainerRunning 'traefik'; then
		# Traefik already has the ports → do nothing
		return 0
	fi

	# Label OS for messaging
	case "$OS_NUMBER" in
		1) os_label="Linux" ;;
		2) os_label="macOS" ;;
		3) os_label="Windows" ;;
		*) os_label="Unknown OS" ;;
	esac

	# Universal port scan (Linux, macOS, WSL, MSYS)
	port_output=$(getPortListeners) || {
		showError "Ports 80 and 443 could not be inspected. Check the port-query tools and permissions before enabling Traefik."
		return 1
	}
	port_users=$(printf '%s\n' "$port_output" | awk 'NR>1 {print $1 ":" $2 ":" $9}')

	# Nothing using ports → success
	if [ -z "$port_users" ]; then
		return 0
	fi

	# If Linux → detect systemd services we know how to stop
	if [ "$OS_NUMBER" -eq 1 ]; then
		while IFS= read -r line; do
			proc_name=$(echo "$line" | cut -d':' -f1)

			for ws in "${web_services[@]}"; do
				if [[ "$proc_name" == "$ws" ]]; then
					conflict_services+=("$ws")
				fi
			done
		done <<< "$port_users"

		# Remove duplicates
		if [ "${#conflict_services[@]}" -gt 0 ]; then
			readarray -t conflict_services < <(printf "%s\n" "${conflict_services[@]}" | sort -u)
		fi
	fi

	# Build message
	message="Traefik requires exclusive access to ports 80 and 443.\n\n"
	message+="Current port usage detected on ${os_label}:\n\n${port_users}\n\n"

	if [ "$OS_NUMBER" -eq 1 ] && [ ${#conflict_services[@]} -gt 0 ]; then
		message+="Detected known Linux web services:\n"
		for svc in "${conflict_services[@]}"; do
			message+="  • ${svc}\n"
		done
		message+="\nThese can be stopped and disabled automatically.\n"
	else
		message+="An unknown or non-Linux process is blocking these ports.\n"
		message+="Because this process cannot be managed automatically, Traefik cannot be enabled.\n"
		message+="\nPlease stop the process manually and try again.\n"
		showError "$message"
		return 1
	fi

	# Ask user to disable Linux services
	message+="\nWould you like us to stop and disable these services?"

	if [ "${VDM_FREE_PORTS:-false}" = true ] || getInputYesNo "$message" "Free Ports 80 & 443" 20 112 "defaultno"; then

		# Stop/disable Linux services
		for svc in "${conflict_services[@]}"; do
			if systemctl is-active --quiet "$svc"; then
				cliSudo systemctl stop "$svc" || return 1
			fi
			if systemctl is-enabled --quiet "$svc"; then
				cliSudo systemctl disable "$svc" || return 1
			fi
		done

		# Re-check
		sleep 1
		local still_used
		still_used=$(getPortListeners) || return 1

		if [ -n "$still_used" ]; then
			showError "Even after disabling services, something is still occupying ports 80/443:\n\n${still_used}\n\nTraefik cannot start."
			return 1
		fi

		showNotice "All conflicting services were disabled.\nTraefik now has exclusive access to ports 80 and 443."
		return 0

	else
		# User said NO → do not enable Traefik
		showError "Traefik cannot run unless ports 80 and 443 are free.\nOperation cancelled."
		return 1
	fi
}

# Check if the Traefik container is already running
function isContainerRunning() {
  local container="$1" running_names
  local docker_cmd="docker"
  [ "${OS_NUMBER}" -ne 3 ] || docker_cmd="docker.exe"
  command -v "${docker_cmd}" >/dev/null 2>&1 || return 2
  running_names=$("${docker_cmd}" ps --format '{{.Names}}' 2>/dev/null) || return 2
  if printf '%s\n' "${running_names}" | grep -Fxq -- "${container}"; then
    return 0
  fi
  return 1
}

