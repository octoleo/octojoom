function v4ActionSchema() {
  local forms
  forms=$(v4FormSchemas) || return 1
  jq -ec --arg action "$1" '.[$action] // empty' <<< "$forms"
}

function v4TuiEditField() {
  local field="$1" request="$2" name kind current value choice secret
  local choices=()
  name=$(jq -r '.name' <<< "$field")
  kind=$(jq -r '.type' <<< "$field")
  secret=$(jq -r '.secret' <<< "$field")
  current=$(jq -r --arg name "$name" 'if has($name) then .[$name] | if type=="object" or type=="array" then tojson else tostring end else "" end' <<< "$request")
  if [ "$kind" = boolean ]; then
    value=$(whiptail --menu "Choose ${name//_/ }." 12 90 3 --title 'Site setting' --backtitle "$BACK_TITLE" true 'Enabled' false 'Disabled' default 'Use action default' 3>&1 1>&2 2>&3) || return $?
    if [ "$value" = default ]; then jq -c --arg name "$name" 'del(.[$name])' <<< "$request"; return; fi
  elif [ "$(jq '.enum|length' <<< "$field")" -gt 0 ]; then
    while IFS= read -r choice; do choices+=("$choice" "$choice"); done < <(jq -r '.enum[]' <<< "$field")
    value=$(whiptail --menu "Choose ${name//_/ }. Current: ${current:-default}" 16 90 8 --title 'Site setting' --backtitle "$BACK_TITLE" "${choices[@]}" 3>&1 1>&2 2>&3) || return $?
  elif [ "$secret" = true ]; then
    value=$(whiptail --passwordbox "Enter ${name//_/ }. Leave empty to use the action default." 10 90 --title 'Private site setting' --backtitle "$BACK_TITLE" 3>&1 1>&2 2>&3) || return $?
  else
    value=$(whiptail --inputbox "Enter ${name//_/ }. Type: ${kind}. Leave empty to use the action default." 11 100 "$current" --title 'Site setting' --backtitle "$BACK_TITLE" 3>&1 1>&2 2>&3) || return $?
  fi
  if [ -z "$value" ]; then jq -c --arg name "$name" 'del(.[$name])' <<< "$request"; return; fi
  case "$kind" in
    boolean) [[ "$value" == true || "$value" == false ]] || return 2 ;;
    integer) [[ "$value" =~ ^[0-9]+$ ]] || { showError 'Enter a non-negative whole number.'; return 2; } ;;
    object|array)
      jq -e --arg kind "$kind" 'type==$kind' <<< "$value" >/dev/null 2>&1 || { showError "Enter a valid JSON ${kind}."; return 2; }
      ;;
    *) jq -c --arg name "$name" --arg value "$value" '.[$name]=$value' <<< "$request"; return ;;
  esac
  jq -c --arg name "$name" --argjson value "$value" '.[$name]=$value' <<< "$request"
}

# Preserve a real terminal for interactive tools; JSON requests travel in a
# private file so reading request input cannot consume the terminal stream.
function v4TuiRun() {
  local action="$1" request="$2" title="$3" status=0 response request_file stream=false
  local group="${1%%.*}" task="${1#*.}"
  case "$action" in
    site.shell) stream=true ;;
    database.console) [ -n "$(jq -r '.command // empty' <<< "$request")" ] || stream=true ;;
    site.logs) [ "$(jq -r '.follow // false' <<< "$request")" != true ] || stream=true ;;
  esac
  if [ "$stream" = true ]; then
    request_file=$(mktemp "${TMPDIR:-/tmp}/octojoom-menu.XXXXXX") || return 1
    chmod 600 "$request_file" || { rm -f -- "$request_file"; return 1; }
    printf '%s\n' "$request" > "$request_file"
    v4Main "$group" "$task" --config "$request_file" </dev/tty || status=$?
    rm -f -- "$request_file"
  else
    response=$(v4Main "$group" "$task" --config - --json <<< "$request") || status=$?
    if jq -e . >/dev/null 2>&1 <<< "$response"; then
      response=$(jq -r 'if .ok then .data else .error end | if type=="string" then . else tojson end' <<< "$response")
    fi
    whiptail --msgbox "${response:-The operation returned no details. Exit status: $status}" 25 112 --scrolltext --title "$title" --backtitle "$BACK_TITLE"
  fi
  return "$status"
}

function v4TuiAction() {
  local action="$1" site="${2:-}" schema request title field name current label selection changed missing target
  local choices=()
  type -P jq >/dev/null 2>&1 || { showError 'Install jq to use the OctoJoom 4 command interface and site dashboard.'; return 3; }
  schema=$(v4ActionSchema "$action") || { showError 'This action has no request form.'; return 2; }
  if [ -n "$site" ]; then
    schema=$(jq -c '.fields |= map(select(.name!="all" and .name!="sites"))' <<< "$schema") || return 1
  fi
  title=$(jq -r '.title' <<< "$schema")
  request=$(jq -cn --arg site "$site" --argjson schema "$schema" '{schema_version:1} + (reduce $schema.fields[] as $field ({}; if $field.default!=null then .[$field.name]=$field.default else . end)) + (if $site!="" and any($schema.fields[]; .name=="site") then {site:$site} else {} end)') || return 1
  if [ -n "${3:-}" ]; then request=$(jq -cn --argjson request "$request" --argjson preset "$3" '$request+$preset') || return 2; fi
  case "$action" in
    site.info|share.status|mail.status)
      if [ -n "$site" ]; then v4TuiRun "$action" "$request" "$title"; return $?; fi
      ;;
  esac
  while true; do
    choices=(run 'Run this action' back 'Return without changes')
    while IFS= read -r field; do
      name=$(jq -r '.name' <<< "$field")
      current=$(jq -r --arg name "$name" 'if has($name) then .[$name]|tostring else "" end' <<< "$request")
      if [ -n "$current" ] && [ "$(jq -r '.secret' <<< "$field")" = true ]; then current='[set]'; fi
      label="${name//_/ }: ${current:-[default]}"
      [ "$(jq -r '.required' <<< "$field")" != true ] || label="* $label"
      choices+=("$name" "${label:0:90}")
    done < <(jq -c '.fields[]' <<< "$schema")
    selection=$(whiptail --menu 'Review settings, edit any field, then Run. * marks required input.' 25 112 16 --title "$title" --backtitle "$BACK_TITLE" "${choices[@]}" 3>&1 1>&2 2>&3) || return $?
    case "$selection" in
      back) return 0 ;;
      run)
        missing=$(jq -r --argjson request "$request" '([.fields[] | select(.required and (($request[.name] // .default // "") == "")) | .name] + [(.conditions // [])[] | select(all(.when|to_entries[]; $request[.key]==.value)) | .required[] | select(($request[.] // "")=="")]) | unique | join(", ")' <<< "$schema")
        if [ -n "$missing" ]; then showError "Complete these required settings: $missing"; continue; fi
        target=$(jq -r 'if .all==true then "ALL Joomla sites" elif ((.sites // [])|length)>0 then (.sites|join(", ")) else (.site // .target_site // "the configured target") end' <<< "$request")
        if ! whiptail --yesno "Run ${title} for ${target}?\n\nReview the settings above before continuing. Changes use the same command as the terminal interface." 12 100 --title "$title" --backtitle "$BACK_TITLE" --defaultno; then continue; fi
        request=$(jq -c '.yes=true' <<< "$request") || return 1
        v4TuiRun "$action" "$request" "$title"
        return $?
        ;;
      *)
        field=$(jq -c --arg name "$selection" '.fields[]|select(.name==$name)' <<< "$schema")
        [ -n "$field" ] || continue
        changed=$(v4TuiEditField "$field" "$request") || continue
        request="$changed"
        ;;
    esac
  done
}

function v4TuiCategory() {
  local site="$1" category="$2" action title selection
  local choices=(back 'Return to site')
  while IFS=$'\t' read -r action title; do choices+=("$action" "$title"); done < <(
    v4ActionSchemas | jq -r --arg category "$category" 'to_entries[] |
      select(if $category=="database" then (.key|test("^(database|backup|snapshot)\\."))
        elif $category=="environment" then (.key|test("^(site\\.(configure|php|webserver|realign)|tls\\.|mail\\.|service\\.)"))
        else (.key|test("^(site\\.(shell|exec|joomla|composer|npm|offline|permissions)|hook\\.|share\\.)")) end) |
      [.key,.value.title]|@tsv')
  while true; do
    selection=$(whiptail --menu "Actions for $site" 24 112 15 --title "${category^} | $site" --backtitle "$BACK_TITLE" "${choices[@]}" 3>&1 1>&2 2>&3) || return $?
    [ "$selection" != back ] || return 0
    v4TuiAction "$selection" "$site"
  done
}

function v4SiteDashboard() {
  local site="$1" response summary selection
  while true; do
    response=$(v4Main site info --site "$site" --json) || { showError "$response"; return 1; }
    summary=$(jq -r '.data | "Site: \(.host // .site // "unknown")\nJoomla: \(.joomla_version // "unknown") | PHP: \(.php_version // "unknown") | Webserver: \(.webserver // "unknown")\nStatus: \(.status // "See information") | Database: \(.database.engine // "unknown") \(.database.version // "")\nURL: \(.urls.site // "not running")"' <<< "$response")
    selection=$(whiptail --menu "$summary" 26 112 17 --title "Joomla site | $site" --backtitle "$BACK_TITLE" \
      back 'Return to sites' site.info 'Full information' site.open 'Open site / administrator / service' \
      site.start 'Start / enable' site.stop 'Stop temporarily' site.restart 'Restart' site.logs 'Service logs' \
      database 'Database, backups and restore points' environment 'Environment, PHP, HTTPS and services' \
      tools 'Development tools, hooks and external sharing' site.clone 'Clone site' site.migrate 'Migrate site' \
      site.diagnose 'Diagnose environment' site.path 'Project directory' site.delete 'Delete site' \
      3>&1 1>&2 2>&3) || return $?
    case "$selection" in
      back) return 0 ;;
      database|environment|tools) v4TuiCategory "$site" "$selection" ;;
      *) v4TuiAction "$selection" "$site" ;;
    esac
  done
}

function v4SitesMenu() {
  local response host description selection
  local choices=()
  type -P jq >/dev/null 2>&1 || { showError 'Install jq to use the OctoJoom 4 site dashboard.'; return 3; }
  while true; do
    response=$(v4Main site list --json) || { showError "$response"; return 1; }
    choices=(back 'Return to Joomla menu' batch 'Batch actions for multiple sites' create 'Create Joomla site' import 'Import an existing Joomla site' restore 'Restore a backup as a site' download 'Download Joomla source' diagnose 'Check for OctoJoom updates' update 'Install OctoJoom update')
    while IFS=$'\t' read -r host description; do
      [ -n "$host" ] && choices+=("$host" "$description")
    done < <(jq -r '.data | (if type=="array" then . else .sites // [] end)[] | [.host // .site, ((.joomla_version // "Joomla") + " | " + (.status // "configured"))] | @tsv' <<< "$response")
    selection=$(whiptail --menu 'Select a Joomla site to see information and all available actions.' 25 112 16 --title "Joomla sites | ${PROGRAM_NAME} v${_V}" --backtitle "$BACK_TITLE" "${choices[@]}" 3>&1 1>&2 2>&3) || return $?
    case "$selection" in
      back) return 0 ;;
      batch) v4BatchMenu ;;
      create) v4TuiAction site.create ;;
      import) v4TuiAction site.import ;;
      restore) v4TuiAction backup.restore ;;
      download) v4TuiAction site.download ;;
      diagnose) v4TuiAction update.check ;;
      update) v4TuiAction update.apply ;;
      *) v4SiteDashboard "$selection" ;;
    esac
  done
}

function v4BatchMenu() {
  local selection
  while true; do
    selection=$(whiptail --menu 'Choose an action, then review all sites or select a specific list where supported.' 19 112 9 --title 'Batch Joomla actions' --backtitle "$BACK_TITLE" \
      back 'Return to sites' site.start 'Start all sites' site.stop 'Stop all sites' site.restart 'Restart all sites' \
      database.export 'Export databases' backup.create 'Create verified backups' snapshot.create 'Create database restore points' \
      site.offline 'Prepare sites for offline use' 3>&1 1>&2 2>&3) || return $?
    [ "$selection" != back ] || return 0
    v4TuiAction "$selection" '' '{"all":true}'
  done
}
