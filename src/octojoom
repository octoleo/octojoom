# Parse all options before performing an action. Values passed explicitly on the
# command line override the saved global config loaded later.
function parseCLI() {
  local option variable value
  OCTOJOOM_CLI_ACTION=''
  OCTOJOOM_CLI_KEYS=()
  OCTOJOOM_CLI_VALUES=()
  while [ "$#" -gt 0 ]; do
    option="${1%%=*}"
    variable=''
    case "$1" in
      -h|--help) OCTOJOOM_CLI_ACTION=help; shift; continue ;;
      --update|--uninstall)
        if [ -n "${OCTOJOOM_CLI_ACTION}" ]; then
          echo >&2 "ERROR: Only one action may be requested."
          return 17
        fi
        OCTOJOOM_CLI_ACTION="${1#--}"
        shift
        continue
        ;;
      -y|--yes) VDM_FORCE=true; shift; continue ;;
      --sudo)
        VDM_SUDO_ACCESS=true
        OCTOJOOM_CLI_KEYS+=(VDM_SUDO_ACCESS)
        OCTOJOOM_CLI_VALUES+=(true)
        shift
        continue
        ;;
      --)
        shift
        [ "$#" -eq 0 ] && break
        echo >&2 "ERROR: Unexpected positional argument: $1"
        return 17
        ;;
    esac
    case "${option}" in
      --access-token) variable=VDM_ACCESS_TOKEN ;;
      --type) variable=VDM_CONTAINER_TYPE ;;
      --task) variable=VDM_TASK ;;
      --container) variable=VDM_CONTAINER ;;
      -j|--joomla-version) variable=VDM_JV ;;
      -k|--key) variable=VDM_KEY ;;
      -e|--env-key) variable=VDM_ENV_KEY ;;
      -d|--domain) variable=VDM_DOMAIN ;;
      -s|--sub-domain) variable=VDM_SUBDOMAIN ;;
      -u|--username) variable=VDM_USER_NAME ;;
      --uid) variable=VDM_PUID ;;
      --gid) variable=VDM_PGID ;;
      -p|--port) variable=VDM_PORT ;;
      --ssh-dir) variable=VDM_PUBLIC_KEY_DIR ;;
      -t|--time-zone) variable=VDM_TZ ;;
      *)
        echo >&2 "ERROR: Unknown option or argument: $1"
        return 17
        ;;
    esac
    if [[ "$1" == *=* ]]; then
      value="${1#*=}"
    elif [ "$#" -ge 2 ] && [ -n "$2" ] && [[ "$2" != -* ]]; then
      value="$2"
      shift
    else
      echo >&2 "ERROR: ${option} requires a non-empty option argument."
      return 17
    fi
    if [ -z "${value}" ]; then
      echo >&2 "ERROR: ${option} requires a non-empty option argument."
      return 17
    fi
    printf -v "${variable}" '%s' "${value}"
    OCTOJOOM_CLI_KEYS+=("${variable}")
    OCTOJOOM_CLI_VALUES+=("${value}")
    [ "${variable}" != VDM_DOMAIN ] || VDM_ARG_DOMAIN=true
    shift
  done
  # These per-invocation switches must not come from a saved configuration.
  OCTOJOOM_CLI_KEYS+=(VDM_FORCE VDM_ARG_DOMAIN)
  OCTOJOOM_CLI_VALUES+=("${VDM_FORCE}" "${VDM_ARG_DOMAIN}")
  return 0
}

# defaults
VDM_ARG_DOMAIN=false
VDM_FORCE=false
parseCLI "$@" || exit $?
if [ "${OCTOJOOM_CLI_ACTION}" = help ]; then
  showHelp
  quitProgram
fi

