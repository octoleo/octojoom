function v4SiteWebserver() {
  local webserver installed image meta
  v4Require site webserver || return $?
  v4Confirm || return $?
  v4LoadSite "$(v4Get site)" || return $?
  if [ "${V4_LEGACY:-false}" = true ]; then v4HydrateLegacyMetadata || return $?; fi
  webserver=$(v4Get webserver)
