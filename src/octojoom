# Create Docker networks if they do not exist (IPv6 auto-detect)
function setNetworks() {

	# Default network names and subnets
	local traefik_gateway="${VDM_TRAEFIK_GATEWAY:-traefik_webgateway}"
	local traefik_subnet="${VDM_TRAEFIK_SUBNET:-172.22.0.0/24}"
	local traefik_subnet6="${VDM_TRAEFIK_SUBNET6:-fd00:22::/64}"

	local openssh_gateway="${VDM_OPENSSH_GATEWAY:-openssh_gateway}"
	local openssh_subnet="${VDM_OPENSSH_SUBNET:-172.23.0.0/24}"
	local openssh_subnet6="${VDM_OPENSSH_SUBNET6:-fd00:23::/64}"

	# Ensure Docker is reachable
	if ! docker info >/dev/null 2>&1; then
		echo "ERROR: Docker daemon not running or permission denied." >&2
		return 1
	fi

	# Detect IPv6 support
	local ipv6_enabled=false
	if docker info 2>/dev/null | grep -qE '^ *IPv6: *true'; then
		ipv6_enabled=true
	fi

	# -----------------------
	# Traefik network
	# -----------------------
	if ! docker network inspect "${traefik_gateway}" >/dev/null 2>&1; then
		echo "Creating Docker network: ${traefik_gateway}"

		if [[ "$ipv6_enabled" == true ]]; then
			docker network create \
				--driver bridge \
				--ipv6 \
				--subnet "$traefik_subnet" \
				--subnet "$traefik_subnet6" \
				"${traefik_gateway}" || return $?
		else
			docker network create \
				--driver bridge \
				--subnet "$traefik_subnet" \
				"${traefik_gateway}" || return $?
		fi
	fi

	# -----------------------
	# OpenSSH network
	# -----------------------
	if ! docker network inspect "${openssh_gateway}" >/dev/null 2>&1; then
		echo "Creating Docker network: ${openssh_gateway}"

		if [[ "$ipv6_enabled" == true ]]; then
			docker network create \
				--driver bridge \
				--ipv6 \
				--subnet "$openssh_subnet" \
				--subnet "$openssh_subnet6" \
				"${openssh_gateway}" || return $?
		else
			docker network create \
				--driver bridge \
				--subnet "$openssh_subnet" \
				"${openssh_gateway}" || return $?
		fi
	fi
}

# Serialize caller-supplied assignment data for Compose, without interpolation.
# Callers pass KEY="raw value"; those outer quotes are syntax, internal quotes
# and backslashes are user data. Never evaluate the assignment as shell code.
function formatEnvAssignment() {
  local line="$1" key="${1%%=*}" value="${1#*=}" quoted=false
  [[ "$line" == *=* && "$key" =~ ^VDM_[a-zA-Z0-9_]+$ ]] || return 12
  [[ "$line" != *$'\n'* && "$line" != *$'\r'* ]] || return 12
  if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
    value="${value:1:${#value}-2}"
    quoted=true
  fi
  if ! "$quoted" && [[ "$value" =~ ^[a-zA-Z0-9_.:/+-]*$ ]]; then
    printf '%s=%s\n' "$key" "$value"
  else
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//\$/\\\$}"
    value="${value//$'\t'/\\t}"
    printf '%s="%s"\n' "$key" "$value"
  fi
}

# Decode one dotenv value into the named caller variable; no source or eval.
function decodeEnvValue() {
  local decode_text="$1" decode_target="$2" decode_quote decode_char decode_next
  local decode_result='' decode_rest decode_i decode_closed=false
  decode_text="${decode_text#"${decode_text%%[!$' \t']*}"}"
  decode_quote="${decode_text:0:1}"
  if [[ "$decode_quote" != '"' && "$decode_quote" != "'" ]]; then
    decode_result="${decode_text%%' #'*}"
    decode_result="${decode_result%"${decode_result##*[!$' \t']}"}"
  else
    for ((decode_i=1; decode_i<${#decode_text}; decode_i++)); do
      decode_char="${decode_text:decode_i:1}"
      if [[ "$decode_char" == "$decode_quote" ]]; then
        decode_rest="${decode_text:decode_i+1}"
        decode_rest="${decode_rest#"${decode_rest%%[!$' \t']*}"}"
        [[ -z "$decode_rest" || "$decode_rest" == \#* ]] || return 12
        decode_closed=true
        break
      elif [[ "$decode_char" == "\\" ]]; then
        decode_next="${decode_text:decode_i+1:1}"
        if [[ "$decode_next" == "$decode_quote" ]]; then
          decode_char="$decode_next"
          decode_i=$((decode_i+1))
        elif [[ "$decode_quote" == '"' ]]; then
          case "$decode_next" in
            "\\"|'$'|'`') decode_char="$decode_next"; decode_i=$((decode_i+1)) ;;
            n) decode_char=$'\n'; decode_i=$((decode_i+1)) ;;
            r) decode_char=$'\r'; decode_i=$((decode_i+1)) ;;
            t) decode_char=$'\t'; decode_i=$((decode_i+1)) ;;
          esac
        fi
      fi
      decode_result+="$decode_char"
    done
    "$decode_closed" || return 12
  fi
  printf -v "$decode_target" '%s' "$decode_result"
}

# Configuration files contain data, never executable shell. Validate the whole
# file before assigning anything so malformed files cannot partly alter state.
function loadEnvFile() {
  local env_file="$1" env_line env_key env_value env_i
  local env_keys=() env_values=()
  [ -f "$env_file" ] && [ -r "$env_file" ] || return 12
  while IFS= read -r env_line || [ -n "$env_line" ]; do
    env_line="${env_line%$'\r'}"
    [[ "$env_line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if [[ "$env_line" =~ ^[[:space:]]*(export[[:space:]]+)?(VDM_[a-zA-Z0-9_]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      env_key="${BASH_REMATCH[2]}"
      decodeEnvValue "${BASH_REMATCH[3]}" env_value || return 12
      case "$env_key" in
        VDM_FORCE|VDM_SECURE|VDM_SECURE_CLOUDFLARE|VDM_MULTI_DOMAIN|VDM_UPDATE_HOST|VDM_EXPERT_MODE|VDM_ARG_DOMAIN|VDM_FIRST_RUN|VDM_SRC_NAMED_VOLUMES|VDM_SRC_MAILCATCHER)
          [[ "$env_value" == true || "$env_value" == false ]] || return 12 ;;
      esac
      env_keys+=("$env_key")
      env_values+=("$env_value")
    else
      printf 'Invalid configuration in %s. Only VDM_ assignments are supported.\n' "$env_file" >&2
      return 12
    fi
  done < "$env_file"
  for ((env_i=0; env_i<${#env_keys[@]}; env_i++)); do
    printf -v "${env_keys[env_i]}" '%s' "${env_values[env_i]}" || return 12
  done
}

# Keep secrets private from creation, preserve existing keys, and never report
# a failed write as success. Replacement uses an adjacent temporary file.
function writeEnvVariable() {
  local env_file="$1" assignment="$2" replace="${3:-false}" line key temporary
  line=$(formatEnvAssignment "$assignment") || return 12
  key="${line%%=*}"
  if [ ! -f "$env_file" ]; then
    getInputYesNo "Can we create the ${env_file} file" "Environment Variable File" 8 112 || return 12
    mkdir -p "${env_file%/*}" || return 12
    (umask 077; set -C; printf '%s\n' "$line" > "$env_file") || return 12
    chmod 600 "$env_file" || return 12
    return 0
  fi
  chmod 600 "$env_file" || return 12
  if ! "$replace"; then
    grep -Eq "^[[:space:]]*(export[[:space:]]+)?${key}[[:space:]]*=" "$env_file" && return 0
    printf '%s\n' "$line" >> "$env_file" || return 12
  else
    temporary=$(mktemp "${env_file}.tmp.XXXXXX") || return 12
    if ! awk -v key="$key" '$0 !~ ("^[[:space:]]*(export[[:space:]]+)?" key "[[:space:]]*=")' "$env_file" > "$temporary" ||
      ! printf '%s\n' "$line" >> "$temporary" || ! chmod 600 "$temporary" ||
      ! mv -f "$temporary" "$env_file"; then
      rm -f "$temporary"
      return 12
    fi
  fi
  return 0
}

function setUniqueEnvVariable() {
