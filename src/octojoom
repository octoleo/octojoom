  fi
  choco install newt --yes || return 1
  command -v whiptail >/dev/null 2>&1
}
# Main script
if ! command -v whiptail >/dev/null 2>&1; then
  echo "Whiptail is not installed. Do you want to install it now? (y/n)"
  read -r response
  if [[ "$response" =~ ^[Yy]$ ]]; then
    # If the user chooses Yes, install Docker based on the OS
    case "$OS_NUMBER" in
      1)
        install_whiptail_linux || exit 1
        ;;
      2)
        install_whiptail_macos || exit 1
        ;;
      3)
        install_whiptail_windows || exit 1
        ;;
