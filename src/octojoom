      [ "$customization_status" -gt 1 ] || customization_status=2
      return "$customization_status"
    fi
  else
    return $?
  fi
}

function configureDockerEntrypoint() {
    local entrypoint_dir="${VDM_PROJECT_PATH}/${VDM_ENTRY_PROJECT_PATH}" temporary customization_status
    # make sure the directory exist
    mkdir -p "$entrypoint_dir" || return $?
    temporary=$(mktemp "${entrypoint_dir}/entrypoint.sh.tmp.XXXXXX") || return $?
    # download entrypoint.sh file to the project folder
    if sudo curl --fail -L "${VDM_ENTRY_REPO}" -o "$temporary" 2>/dev/null; then
      # give little heads-up
      showNotice "${USER^}, to save the changes you've made or to just close the file again press:\n\n[ctrl+x] with nano on ubuntu." 13
      # lets open the file with nano for now
      if sudo "${EDITOR:-nano}" "$temporary" &&
        sudo chown 0:0 "$temporary" && sudo chmod 700 "$temporary" &&
        sudo mv -f "$temporary" "${entrypoint_dir}/entrypoint.sh"; then
        return 0
      else
        customization_status=$?
        sudo rm -f "$temporary"
        return "$customization_status"
      fi
    else
      customization_status=$?
      sudo rm -f "$temporary"
      # show the error
      showError "The entrypoint.sh could not be set."
      return "$customization_status"
    fi
}

