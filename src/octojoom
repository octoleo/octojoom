  # return the answer
  printf '%s\n' "${answer}"
}

# get a selected directory
function getSelectedDirectory() {
  local requested='' requested_path="${2%/}"
  if [[ "$requested_path" == "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/available" || "$requested_path" == "${VDM_REPO_PATH}/${VDM_CONTAINER_TYPE}/enabled" ]] && [ -n "${VDM_CONTAINER:-}" ]; then
    isValidDomain "$VDM_CONTAINER" || return 17
    requested="$VDM_CONTAINER"
  elif [ "$requested_path" = "$VDM_PROJECT_PATH" ]; then
    requested="${VDM_PROJECT:-}"
    if [ -z "$requested" ] && [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ] && isSafeProjectName "${3:-}" && [ -d "$requested_path/${3}" ]; then requested="$3"; fi
    [ -z "$requested" ] || isSafeProjectName "$requested" || return 17
  fi
  if [ -n "$requested" ]; then
    [ -d "$requested_path/$requested" ] || { echo >&2 "ERROR: Selected directory does not exist: $requested"; return 1; }
    printf '%s\n' "$requested"
    return 0
  fi
  if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then echo >&2 'ERROR: A container or project selection is required.'; return 17; fi
  # the selected folder
  local answer
  #  set the local path
  local path="${2:-}"
  # set local var
  local folder="${3:-}"
  # we start the selection array
  local selected=()
  # our counter
  local i=0
  # whiptail box size details
  local description_lines
  local height
  # now check if this dir has sub dirs
  if hasDirectories '' "$path"; then
    # loop over the directory
    local dir_
    for dir_ in "${path%/}/"* "${path%/}/".[!.]* "${path%/}/"..?*; do
      [ -d "$dir_" ] || continue
      # remove the full path
      dir_="${dir_##*/}"
      # load the selection
      [ "$folder" = "${dir_#/}" ] && selected+=("${dir_#/}" "${dir_#/}" "ON") || selected+=("${dir_#/}" "${dir_#/}" "OFF")
      # increment our pointer
      if [ "$i" -le 10 ]; then
        i=$((i + 1))
      fi
    done

    # Calculate the height based on the description length and directory count
    description_lines=$(echo -e "${1}" | wc -l)
    height=$((description_lines + i + 7))

    # now make the selection
    answer=$(whiptail --title "${4:-Make a Selection}" --radiolist \
      "${1}" $height 112 $i \
      "${selected[@]}" --backtitle "${BACK_TITLE}" --nocancel --notags 3>&1 1>&2 2>&3) || return $?
  fi
  # return the answer
  printf '%s\n' "${answer:-$folder}"
}

