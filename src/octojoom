# This function asks for Joomla extension ZIP URLs using whiptail, validates them,
# and concatenates them into a single environment variable.
function setJoomlaExtensionUrls() {
    if isFunc cliHasValue && cliHasValue VDM_J_EXTENSIONS_URLS; then return 0; fi
    if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then return 0; fi
    local urls=()
    local input=""
    local prompt_message="Enter Joomla Extension ZIP URL (leave empty to for none):"
    local title="Enter Joomla Extension Installation URL"
    unset VDM_J_EXTENSIONS_URLS

    # Loop to collect URLs until an empty string or cancellation
    while true; do
        input=$(getInput "$prompt_message" "" "$title") || return $?

        # Break loop if input is empty
        if [[ -z "$input" ]]; then
            break
        fi

        # Validate URL format
       if [[ "$input" =~ ^http(s)?://[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}(/.*)?$ ]]; then
            urls+=("$input")
        else
            showNotice "Invalid URL. Please enter a valid ZIP URL (must be a .zip file)." 10
        fi
    done

    # Join URLs with semicolons
    if [ ${#urls[@]} -gt 0 ]; then
        VDM_J_EXTENSIONS_URLS=$(IFS=';'; echo "${urls[*]}")
        export VDM_J_EXTENSIONS_URLS
    fi
}

# This function asks for Joomla commands using whiptail, validates them,
# and concatenates them into a single environment variable.
function setJoomlaCommands() {
    if isFunc cliHasValue && cliHasValue VDM_J_CLI_COMMANDS; then return 0; fi
    if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then return 0; fi
    local j_commands=()
    local input=""
    local prompt_message="Enter Joomla cli command passed to cli/joomla.php script (leave empty for none):"
    local title="Enter a Joomla command"
    unset VDM_J_CLI_COMMANDS

    # Loop to collect commands until an empty string or cancellation
    while true; do
        input=$(getInput "$prompt_message" "" "$title") || return $?

        # Break loop if input is empty
        if [[ -z "$input" ]]; then
            break
        fi

        # Validate command format
       if joomlaValidateCliCommand "$input"; then
            j_commands+=("$input")
        else
            showNotice "Invalid Joomla CLI command. Please enter a valid joomla cli command." 10
        fi
    done

    # Join Commands with semicolons
    if [ ${#j_commands[@]} -gt 0 ]; then
        VDM_J_CLI_COMMANDS=$(IFS=';'; echo "${j_commands[*]}")
        export VDM_J_CLI_COMMANDS
    fi
}

# Validate Joomla CLI command (ENV + Docker safe)
function joomlaValidateCliCommand() {

	local cmd="$1"
	local len

	# Must not be empty
	[[ -n "$cmd" ]] || return 1

	# Length check
	len=${#cmd}
	(( len >= 5 && len <= 4096 )) || return 1

	# Must be single-line (no CR/LF)
	[[ "$cmd" != *$'\n'* ]] || return 1
	[[ "$cmd" != *$'\r'* ]] || return 1

	# Only allow printable ASCII (space to tilde)
	# This excludes control chars automatically
	[[ "$cmd" =~ ^[[:print:]]+$ ]] || return 1

	# Block shell command substitution
	[[ "$cmd" != *'`'* && "$cmd" != *';'* ]] || return 1
	# shellcheck disable=SC2016
	[[ "$cmd" != *'$('* ]] || return 1

	return 0
}

# set the number of containers to build
function setNumberContainers() {
  if [ -n "${VDM_NUMBER_CONTAINERS:-}" ]; then
    if [[ "$VDM_NUMBER_CONTAINERS" =~ ^[0-9]{1,2}$ ]] && (( 10#$VDM_NUMBER_CONTAINERS > 1 && 10#$VDM_NUMBER_CONTAINERS < 100 )); then
      VDM_NUMBER_CONTAINERS=$((10#$VDM_NUMBER_CONTAINERS))
      return 0
    elif [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then
      printf 'ERROR: --number must be between 2 and 99.\n' >&2
      return 17
    fi
  fi
  local valid=0
  local count
  while [ "$valid" -eq 0 ]; do
    # get the value
    VDM_NUMBER_CONTAINERS=$(getInput "Enter the number of containers you would like to deploy.\n[Just a number!]" \
      10 'Enter Number') || return $?
    # check that the number is above 1 and below 100
    if ! [[ $VDM_NUMBER_CONTAINERS =~ ^[0-9]{1,2}$ ]]; then
      showError "You must enter a number from 2 to 99!"
    else
      count=$((10#$VDM_NUMBER_CONTAINERS))
      if [ "$count" -le 1 ]; then
        showError "The number (${VDM_NUMBER_CONTAINERS}) must be above 1"
      else
        VDM_NUMBER_CONTAINERS="$count"
        valid=1
      fi
    fi
  done
  # make sure it is available
  export VDM_NUMBER_CONTAINERS
}

