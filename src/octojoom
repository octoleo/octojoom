      isSafeProjectName "${VDM_PROJECT:-}" && isSafeProjectName "${VDM_TARGET_PROJECT:-}" &&
        [ -d "$VDM_PROJECT_PATH/$VDM_PROJECT" ] && [ ! -L "$VDM_PROJECT_PATH/$VDM_PROJECT" ] &&
        [ ! -e "$VDM_PROJECT_PATH/$VDM_TARGET_PROJECT" ] && [ ! -L "$VDM_PROJECT_PATH/$VDM_TARGET_PROJECT" ] || return 17
      ;;
  esac
  return 0
}

