# Resolve existing inventory only. No .env is sourced and no project record is needed.
# These context globals contain paths/facts, never credentials. Callers performing
# multiple operations should use a subshell to keep the selected context local.
function resolveJoomlaSite() {
  local site="${1:-}"
  VDM_SITE_NAME='' VDM_SITE_DIR='' VDM_SITE_COMPOSE='' VDM_SITE_ENV=''
  if ! isValidDomain "$site"; then
    printf 'Invalid website identifier: %s\n' "$site" >&2
    return 1
  fi
  VDM_SITE_NAME="$site"
  VDM_SITE_DIR="${VDM_REPO_PATH}/joomla/available/${site}"
  VDM_SITE_COMPOSE="${VDM_SITE_DIR}/docker-compose.yml"
  if [ ! -f "$VDM_SITE_COMPOSE" ]; then
    printf 'No Compose file exists for website %s.\n' "$site" >&2
    return 1
  fi
  VDM_SITE_ENV=$(getContainerEnvFile joomla "$site" available)
}

# Exported shell values must not override the selected site's effective ENV.
# Match variable names only; defaults and other Compose expressions remain data
# for Compose itself. Unlike migration validation, this accepts custom Compose.
function joomlaUnexportComposeEnvironment() {
  local file="$1" name
  while IFS= read -r name; do
    [ -z "$name" ] || export -n "${name?}" || return 1
  done < <(grep -oE '[$][{]?[A-Za-z_][A-Za-z0-9_]*' "$file" | sed -E 's/^[$][{]?//' | sort -u)
}

function joomlaSiteCompose() {
  (
    local site="${1:-}"
    shift
    resolveJoomlaSite "$site" || exit 1
    joomlaUnexportComposeEnvironment "$VDM_SITE_COMPOSE" || exit 1
    # The available directory stays the project directory, even for enabled sites.
    # Do not hide native failure statuses behind a dialog or a second invocation.
    local -a arguments=(compose)
    [ -z "$VDM_SITE_ENV" ] || arguments+=(--env-file "$VDM_SITE_ENV")
    docker "${arguments[@]}" --file "$VDM_SITE_COMPOSE" "$@"
  )
}

function listJoomlaSites() {
  local compose site
  for compose in "${VDM_REPO_PATH}/joomla/available/"*/docker-compose.yml; do
    [ -f "$compose" ] || continue
    site="${compose%/docker-compose.yml}"
    site="${site##*/}"
    isValidDomain "$site" && printf '%s\n' "$site"
  done
}

# Bounded offline reader for the block layout generated by Octojoom. Structured
# inspection below uses Compose's parser when jq is installed. Unknown/custom
# YAML still appears in inventory; it is never rewritten by these readers.
function joomlaSourceServices() {
  awk '/^services:[[:space:]]*$/ {services=1; next}
    services && /^[^[:space:]#]/ {exit}
    services && /^  [A-Za-z0-9_.-]+:[[:space:]]*$/ {sub(/^  /, ""); sub(/:[[:space:]]*$/, ""); print}' "$1"
}

function joomlaSourceService() {
  local file="$1" service="$2"
  awk -v service="$service" '
    /^services:[[:space:]]*$/ {services=1; next}
    services && /^[^[:space:]#]/ {exit}
    services && /^  [A-Za-z0-9_.-]+:[[:space:]]*$/ {
      name=$0; sub(/^  /, "", name); sub(/:[[:space:]]*$/, "", name)
      selected=(name==service); next
    }
    selected {print}' "$file"
}

# Expand the simple literal VDM assignments used by master without shell eval.
# Arbitrary Compose expressions are deliberately left to Compose's own parser.
function joomlaExpandComposeValue() {
  local value="$1" env_file="$2" match name resolved
  while [[ "$value" =~ (\$\{(VDM_[A-Za-z0-9_]+)\}) ]]; do
    match="${BASH_REMATCH[1]}" name="${BASH_REMATCH[2]}" resolved=''
    migrationReadEnvValue "$env_file" "$name" resolved || return 1
    value="${value//"$match"/"$resolved"}"
  done
  [[ "$value" != *'$'* ]] || return 1
  printf '%s\n' "$value"
}

function joomlaSourceScalar() {
  local property="$1" value
  value=$(sed -nE 's/^    '"$property"':[[:space:]]*(.*)$/\1/p' | head -n 1)
  if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s\n' "$value"
}

# Native Windows jq treats these arguments as filesystem paths unless MSYS
# conversion is disabled. They are JSON filters and data, including container
# paths. Normalize its CRLF output before comparing scalar values in Bash.
function joomlaSiteJSON() {
  (
    set -o pipefail
    MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' jq "$@" | sed $'s/\r$//'
  )
}

# Git Bash may implement ln -s by copying a directory. Such a copy represents
# this site only while its effective configuration still matches the source.
function getJoomlaSiteEnabledState() {
  local available="${VDM_REPO_PATH}/joomla/available/$1" enabled="${VDM_REPO_PATH}/joomla/enabled/$1"
  if [ -L "$enabled" ]; then
    if [ "$enabled" -ef "$available" ]; then printf 'enabled\n'; else printf 'invalid-link\n'; fi
  elif [ -e "$enabled" ]; then
    if [ "${OS_NUMBER:-0}" = 3 ] && [ -d "$enabled" ] &&
      cmp -s "$available/docker-compose.yml" "$enabled/docker-compose.yml" &&
      { { [ ! -e "$available/.env" ] && [ ! -e "$enabled/.env" ]; } ||
        { [ -f "$available/.env" ] && [ -f "$enabled/.env" ] && cmp -s "$available/.env" "$enabled/.env"; }; }; then
      printf 'enabled\n'
    else
      printf 'invalid-link\n'
    fi
  else
    printf 'disabled\n'
  fi
}

# Accept only a literal single-host router; complicated expressions are shown as
# unavailable rather than presenting an invented URL. The published proxy port
# is resolved separately from its internal HTTP/HTTPS target.
# JSON filters below use jq variables, not shell expansion.
# shellcheck disable=SC2016
function joomlaRouteURL() {
  local labels="$1" proxy_json="${2:-}" host scheme=http target=80 port='' entrypoints
  # shellcheck disable=SC2016
  host=$(printf '%s\n' "$labels" | sed -nE 's/.*\.rule=Host\(`([A-Za-z0-9.-]+)`\)["[:space:]]*$/\1/p' | head -n 1)
  [ -n "$host" ] || return 0
  entrypoints=$(printf '%s\n' "$labels" | sed -nE 's/.*\.entrypoints=([^"[:space:]]+).*/\1/p' | head -n 1)
  if printf '%s\n' "$labels" | grep -qE '\.tls(=true|\.certresolver=)|\.entrypoints=websecure'; then
    scheme=https target=443
  fi
  if [ -n "$proxy_json" ]; then
    # A custom entrypoint's container port can be read from Traefik's command.
    if [ -n "$entrypoints" ] && [[ "$entrypoints" != *,* ]]; then
      port=$(printf '%s' "$proxy_json" | joomlaSiteJSON -r --arg entry "$entrypoints" '
        [.services[]?.command[]? | select(type=="string") |
        select(startswith("--entrypoints."+$entry+".address=:")) |
        split(":")[-1] | split("/")[0]][0] // empty' 2>/dev/null)
      [[ "$port" =~ ^[0-9]+$ ]] && target="$port"
    fi
    port=$(printf '%s' "$proxy_json" | joomlaSiteJSON -r --argjson target "$target" '
      [.services[]?.ports[]? | select(.target==$target) | .published | tostring] | unique | if length==1 then .[0] else empty end' 2>/dev/null)
  else
    # Original short-syntax Traefik port mappings, including quoted values.
    port=$(sed -nE "s/^[[:space:]]*-[[:space:]]*[\"']?([0-9]+):${target}([\"']|[[:space:]])*$/\\1/p" \
      "${VDM_REPO_PATH}/traefik/docker-compose.yml" 2>/dev/null | head -n 1)
  fi
  # A configured route without a verifiable proxy port is not a verified URL.
  [ -n "$port" ] || return 0
  if [ "$scheme:$port" = http:80 ] || [ "$scheme:$port" = https:443 ]; then
    printf '%s://%s\n' "$scheme" "$host"
  else
    printf '%s://%s:%s\n' "$scheme" "$host" "$port"
  fi
}

# Resolve direct HTTP ports as well as proxy routes. Dynamic published ports are
# read from the running service; a failed lookup remains unavailable.
# JSON filters below use jq variables, not shell expansion.
# shellcheck disable=SC2016
function joomlaPublishedURL() {
  local site="$1" service="$2" config="$3" target host port mapping
  [ -n "$config" ] || return 0
  for target in 80 443; do
    mapping=$(printf '%s' "$config" | joomlaSiteJSON -r --arg s "$service" --argjson target "$target" '
      [.services[$s].ports[]? | select(.target==$target)][0] // empty |
      [(.host_ip // "127.0.0.1"),(.published // "" | tostring)] | join("|")')
    [ -n "$mapping" ] || continue
    IFS='|' read -r host port <<< "$mapping"
    if [ -z "$port" ]; then
      mapping=$(joomlaSiteCompose "$site" port "$service" "$target" 2>/dev/null) || mapping=''
      [ -n "$mapping" ] || continue
      port="${mapping##*:}" host="${mapping%:*}"
    fi
    [[ "$port" =~ ^[0-9]+$ ]] || continue
    case "$host" in ''|0.0.0.0|::|'[::]') host=127.0.0.1 ;; esac
    [[ "$host" != *:* || "$host" == \[*\] ]] || host="[$host]"
    if [ "$target" = 443 ]; then printf 'https://%s:%s\n' "$host" "$port"
    else printf 'http://%s:%s\n' "$host" "$port"; fi
    return 0
  done
}

# JSON filters below use jq variables, not shell expansion.
# shellcheck disable=SC2016
function readJoomlaSiteFacts() {
  local site="${1:-}" service block image config='' proxy='' candidate mount relative='.' value ids row
  local state health configured=0 expected=0 running=0 stopped_count=0 unavailable=0 unhealthy=0 healthy=0
  resolveJoomlaSite "$site" || return 1
  # Public context also consumed by PHP, webserver and alignment actions.
  # shellcheck disable=SC2034
  VDM_SITE_KEY='' VDM_SITE_ENV_KEY='' VDM_SITE_SERVICE='' VDM_SITE_IMAGE=''
  VDM_SITE_SERVICES='' VDM_SITE_MOUNT_TYPE='' VDM_SITE_MOUNT_SOURCE='' VDM_SITE_MOUNT_TARGET=''
  VDM_SITE_VOLUME_NAME=''
  VDM_SITE_DOCROOT='' VDM_SITE_HOST_PATH='' VDM_SITE_WEBSERVER=unknown
  VDM_SITE_ENABLED=disabled VDM_SITE_RUNNING=unavailable VDM_SITE_HEALTH=unavailable
  VDM_SITE_URL='' VDM_SITE_ADMIN_URL='' VDM_SITE_VIEWER_URL='' VDM_SITE_MAIL_URL=''
  VDM_SITE_JOOMLA_VERSION=unknown VDM_SITE_PHP_VERSION=unavailable VDM_SITE_RUNTIME_IMAGE=''
  VDM_SITE_IMAGE_DIGEST='' VDM_SITE_SERVICE_STATES='' VDM_SITE_SERVICE_IMAGES='' VDM_SITE_ROUTABLE=unchecked
  VDM_SITE_ALIGNMENT=unavailable
  if isFunc siteAlignmentPlan; then
    VDM_SITE_ALIGNMENT=$(siteAlignmentPlan "$site") || VDM_SITE_ALIGNMENT=unavailable
  fi
  VDM_SITE_ENABLED=$(getJoomlaSiteEnabledState "$site")
  # The identity helper has narrow semantics; failure does not hide the site.
  if getJoomlaComposeIdentity "$VDM_SITE_COMPOSE"; then
    # shellcheck disable=SC2034
    VDM_SITE_KEY="$VDM_SRC_KEY" VDM_SITE_ENV_KEY="$VDM_SRC_ENV_KEY"
  fi
  VDM_SITE_ENV_KEY="${VDM_SITE_ENV_KEY:-$(sed -nE 's/.*[$][{]VDM_([A-Za-z0-9_]+)_DB[}].*/\1/p' "$VDM_SITE_COMPOSE" | head -n 1)}"
  if command -v jq >/dev/null 2>&1; then
    config=$(joomlaSiteCompose "$site" config --format json 2>/dev/null) || config=''
    printf '%s' "$config" | joomlaSiteJSON -e '.services | type=="object"' >/dev/null 2>&1 || config=''
    if [ -f "${VDM_REPO_PATH}/traefik/docker-compose.yml" ]; then
      proxy=$(
        local proxy_file="${VDM_REPO_PATH}/traefik/docker-compose.yml" proxy_env
        proxy_env=$(getContainerEnvFile traefik '')
        joomlaUnexportComposeEnvironment "$proxy_file" || exit 1
        local -a proxy_args=(compose)
        [ -z "$proxy_env" ] || proxy_args+=(--env-file "$proxy_env")
        docker "${proxy_args[@]}" --file "$proxy_file" config --format json 2>/dev/null
      ) || proxy=''
      printf '%s' "$proxy" | joomlaSiteJSON -e '.services | type=="object"' >/dev/null 2>&1 || proxy=''
    fi
  fi
  if [ -n "$config" ]; then
    VDM_SITE_SERVICES=$(printf '%s' "$config" | joomlaSiteJSON -r '.services | keys[]')
    # JOOMLA_DB_HOST also identifies images from arbitrary configured registries.
    VDM_SITE_SERVICE=$(printf '%s' "$config" | joomlaSiteJSON -r '
      [.services | to_entries[] | select((.value.environment.JOOMLA_DB_HOST? != null) or
      ((.value.image // "") | test("(^|/)(joomla|joomengine)(:|@|$)"))) | .key] |
      if length==1 then .[0] else empty end')
    if [ -n "$VDM_SITE_SERVICE" ]; then
      VDM_SITE_IMAGE=$(printf '%s' "$config" | joomlaSiteJSON -r --arg s "$VDM_SITE_SERVICE" '.services[$s].image // empty')
      mount=$(printf '%s' "$config" | joomlaSiteJSON -r --arg s "$VDM_SITE_SERVICE" '
        [.services[$s].volumes[]? | select(.target=="/var/www/html")][0] // empty |
        [.type,.source,.target] | @tsv')
      IFS=$'\t' read -r VDM_SITE_MOUNT_TYPE VDM_SITE_MOUNT_SOURCE VDM_SITE_MOUNT_TARGET <<< "$mount"
      if [ "$VDM_SITE_MOUNT_TYPE" = volume ]; then
        VDM_SITE_VOLUME_NAME=$(printf '%s' "$config" | joomlaSiteJSON -r --arg volume "$VDM_SITE_MOUNT_SOURCE" '.volumes[$volume].name // empty')
      fi
    fi
  else
    VDM_SITE_SERVICES=$(joomlaSourceServices "$VDM_SITE_COMPOSE")
    while IFS= read -r service; do
      [ -n "$service" ] || continue
      block=$(joomlaSourceService "$VDM_SITE_COMPOSE" "$service")
      image=$(printf '%s\n' "$block" | joomlaSourceScalar image)
      image=$(joomlaExpandComposeValue "$image" "$VDM_SITE_ENV") || image=''
      if [[ "$image" =~ (^|/)(joomla|joomengine)(:|@|$) ]] || printf '%s\n' "$block" | grep -q 'JOOMLA_DB_HOST'; then
        configured=$((configured + 1))
        VDM_SITE_SERVICE="$service" VDM_SITE_IMAGE="$image"
      fi
    done <<< "$VDM_SITE_SERVICES"
    if [ "$configured" -ne 1 ]; then
      VDM_SITE_SERVICE='' VDM_SITE_IMAGE=''
    else
      block=$(joomlaSourceService "$VDM_SITE_COMPOSE" "$VDM_SITE_SERVICE")
      mount=$(printf '%s\n' "$block" | sed -nE "s#^[[:space:]]*-[[:space:]]*[\"']?([^\"']+):(/var/www/html)(:[a-z,]+)?[\"']?[[:space:]]*\$#\\1"$'\t'"\\2#p" | head -n 1)
      IFS=$'\t' read -r candidate VDM_SITE_MOUNT_TARGET <<< "$mount"
      VDM_SITE_MOUNT_SOURCE=$(joomlaExpandComposeValue "$candidate" "$VDM_SITE_ENV") || VDM_SITE_MOUNT_SOURCE=''
      case "$VDM_SITE_MOUNT_SOURCE" in
        /*|./*|../*|[A-Za-z]:/*) VDM_SITE_MOUNT_TYPE=bind ;;
        '') ;;
        *) VDM_SITE_MOUNT_TYPE=volume ;;
      esac
      if [[ "$VDM_SITE_MOUNT_SOURCE" == ./* || "$VDM_SITE_MOUNT_SOURCE" == ../* ]]; then
        VDM_SITE_MOUNT_SOURCE="${VDM_SITE_DIR}/${VDM_SITE_MOUNT_SOURCE}"
      fi
    fi
  fi
  if [ -n "$VDM_SITE_ENV_KEY" ]; then
    migrationReadEnvValue "$VDM_SITE_ENV" "VDM_${VDM_SITE_ENV_KEY}_DOCROOT" relative || relative='.'
    migrationReadEnvValue "$VDM_SITE_ENV" "VDM_${VDM_SITE_ENV_KEY}_WEBSERVER" value && VDM_SITE_WEBSERVER="$value"
  fi
  case "$relative" in
    ''|.) relative='' ;;
    /*|..|../*|*/../*|*/..|*\\*) relative=invalid ;;
  esac
  if [ "$relative" != invalid ] && [ -n "$VDM_SITE_MOUNT_TARGET" ]; then
    VDM_SITE_DOCROOT="${VDM_SITE_MOUNT_TARGET%/}${relative:+/$relative}"
    if [ "$VDM_SITE_MOUNT_TYPE" = bind ]; then
      VDM_SITE_HOST_PATH="${VDM_SITE_MOUNT_SOURCE%/}${relative:+/$relative}"
    fi
  fi
  if [ "$VDM_SITE_WEBSERVER" = unknown ]; then
    case "$VDM_SITE_IMAGE" in
      *-fpm*|*:fpm*) VDM_SITE_WEBSERVER=fpm ;;
      *-apache*|*:apache*) VDM_SITE_WEBSERVER=apache ;;
    esac
  fi
  while IFS= read -r service; do
    [ -n "$service" ] || continue
    if [ -n "$config" ]; then
      block=$(printf '%s' "$config" | joomlaSiteJSON -r --arg s "$service" '.services[$s].labels // {} | to_entries[] | .key+"="+(.value|tostring)')
      image=$(printf '%s' "$config" | joomlaSiteJSON -r --arg s "$service" '.services[$s].image // empty')
    else
      block=$(joomlaSourceService "$VDM_SITE_COMPOSE" "$service")
      image=$(printf '%s\n' "$block" | joomlaSourceScalar image)
    fi
    VDM_SITE_SERVICE_IMAGES+="${service}: ${image:-unknown}"$'\n'
    candidate=$(joomlaRouteURL "$block" "$proxy")
    [ -n "$candidate" ] || candidate=$(joomlaPublishedURL "$site" "$service" "$config")
    case "$image" in
      *phpmyadmin*|*adminer*) VDM_SITE_VIEWER_URL="$candidate" ;;
      *mailcatcher*|*mailpit*|*mailhog*) VDM_SITE_MAIL_URL="$candidate" ;;
      *nginx*)
        # An unrelated Nginx service must not replace this website's route. The
        # HTTP companion shares its root and depends on the selected PHP service.
        if [ "$service" = "$VDM_SITE_SERVICE" ] ||
          { [ -n "$config" ] && printf '%s' "$config" | joomlaSiteJSON -e --arg s "$service" --arg web "$VDM_SITE_SERVICE" \
            --arg source "$VDM_SITE_MOUNT_SOURCE" --arg target "$VDM_SITE_MOUNT_TARGET" '
            (.services[$s].depends_on[$web] != null) and
            any(.services[$s].volumes[]?; .source==$source and .target==$target)' >/dev/null 2>&1; } ||
          { [ -z "$config" ] && [ -n "$VDM_SITE_KEY" ] && [ "$service" = "nginx${VDM_SITE_KEY}" ]; }; then
          [ -z "$candidate" ] || VDM_SITE_URL="$candidate"
          VDM_SITE_WEBSERVER=nginx
        fi
        ;;
      *) [ "$service" != "$VDM_SITE_SERVICE" ] || [ -z "$candidate" ] || VDM_SITE_URL="$candidate" ;;
    esac
  done <<< "$VDM_SITE_SERVICES"
  [ -z "$VDM_SITE_URL" ] || VDM_SITE_ADMIN_URL="${VDM_SITE_URL}/administrator/"
  if [ -n "$config" ]; then
    expected=$(printf '%s' "$config" | joomlaSiteJSON '[.services[] | select((.profiles // [] | length)==0)] | length')
  else
    while IFS= read -r service; do [ -z "$service" ] || expected=$((expected + 1)); done <<< "$VDM_SITE_SERVICES"
  fi
  if ids=$(joomlaSiteCompose "$site" ps --all --quiet 2>/dev/null); then
    VDM_SITE_RUNNING=stopped VDM_SITE_HEALTH='not-running'
    while IFS= read -r candidate; do
      [ -n "$candidate" ] || continue
      row=$(docker inspect --format '{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}not-defined{{end}}|{{.Config.Image}}|{{.Image}}|{{index .Config.Labels "com.docker.compose.service"}}' "$candidate" 2>/dev/null) || { unavailable=$((unavailable + 1)); continue; }
      IFS='|' read -r state health image value service <<< "$row"
      [ -n "$state" ] || { unavailable=$((unavailable + 1)); continue; }
      if [ "$state" = running ]; then
        running=$((running + 1))
        [ "$health" != unhealthy ] || unhealthy=$((unhealthy + 1))
        [ "$health" != healthy ] || healthy=$((healthy + 1))
      else stopped_count=$((stopped_count + 1)); fi
      VDM_SITE_SERVICE_STATES+="${service}: ${state} (${health})"$'\n'
      if [ "$service" = "$VDM_SITE_SERVICE" ]; then
        VDM_SITE_RUNTIME_IMAGE="$image" VDM_SITE_IMAGE_DIGEST="$value"
      fi
    done <<< "$ids"
    if [ "$unavailable" -gt 0 ]; then VDM_SITE_RUNNING=unavailable VDM_SITE_HEALTH=unavailable
    elif [ "$running" -gt 0 ] && { [ "$stopped_count" -gt 0 ] || [ "$running" -lt "$expected" ]; }; then VDM_SITE_RUNNING=partial
    elif [ "$running" -gt 0 ]; then VDM_SITE_RUNNING=running
    fi
    if [ "$unhealthy" -gt 0 ]; then VDM_SITE_HEALTH=unhealthy
    elif [ "$VDM_SITE_RUNNING" = unavailable ]; then VDM_SITE_HEALTH=unavailable
    elif [ "$healthy" -eq "$running" ] && [ "$running" -ge "$expected" ] && [ "$stopped_count" -eq 0 ] && [ "$running" -gt 0 ]; then VDM_SITE_HEALTH=healthy
    elif [ "$healthy" -gt 0 ]; then VDM_SITE_HEALTH='partially-checked'
    elif [ "$running" -gt 0 ]; then VDM_SITE_HEALTH='not-defined'
    fi
  fi
  if [ -n "$VDM_SITE_HOST_PATH" ] && [ -r "$VDM_SITE_HOST_PATH/administrator/manifests/files/joomla.xml" ]; then
    value=$(sed -nE 's/.*<version>([^<]+)<\/version>.*/\1/p' "$VDM_SITE_HOST_PATH/administrator/manifests/files/joomla.xml" | head -n 1)
    [[ "$value" =~ ^[0-9]+[.][0-9]+ ]] && VDM_SITE_JOOMLA_VERSION="$value"
  fi
  if [ -n "$VDM_SITE_SERVICE" ] && [[ "$VDM_SITE_RUNNING" = running || "$VDM_SITE_RUNNING" = partial ]]; then
    value=$(joomlaSiteCompose "$site" exec -T "$VDM_SITE_SERVICE" php -r 'echo PHP_VERSION;' 2>/dev/null) || value=''
    [[ "$value" =~ ^[0-9]+[.][0-9]+ ]] && VDM_SITE_PHP_VERSION="$value"
    if [ "$VDM_SITE_JOOMLA_VERSION" = unknown ] && [ -n "$VDM_SITE_DOCROOT" ]; then
      # shellcheck disable=SC2016
      value=$(joomlaSiteCompose "$site" exec -T "$VDM_SITE_SERVICE" php -r '$s=@file_get_contents($argv[1]."/administrator/manifests/files/joomla.xml"); if ($s!==false && preg_match("~<version>([^<]+)</version>~",$s,$m)) echo $m[1];' "$VDM_SITE_DOCROOT" 2>/dev/null) || value=''
      [[ "$value" =~ ^[0-9]+[.][0-9]+ ]] && VDM_SITE_JOOMLA_VERSION="$value"
    fi
  fi
  return 0
}

function showJoomlaSiteFacts() {
  printf 'Website: %s\nEnabled: %s\nServices: %s\nHealth: %s\nRoute check: %s\n' "$VDM_SITE_NAME" "$VDM_SITE_ENABLED" "$VDM_SITE_RUNNING" "$VDM_SITE_HEALTH" "$VDM_SITE_ROUTABLE"
  printf 'Website URL: %s\nAdministrator: %s\nJoomla installed: %s\nPHP measured: %s\nWebserver configured: %s\n' "${VDM_SITE_URL:-unavailable}" "${VDM_SITE_ADMIN_URL:-unavailable}" "$VDM_SITE_JOOMLA_VERSION" "$VDM_SITE_PHP_VERSION" "$VDM_SITE_WEBSERVER"
  printf 'Image configured: %s\nImage running: %s\nImage ID: %s\n' "${VDM_SITE_IMAGE:-unknown}" "${VDM_SITE_RUNTIME_IMAGE:-unavailable}" "${VDM_SITE_IMAGE_DIGEST:-unavailable}"
  printf 'Configuration alignment: %s\n' "$VDM_SITE_ALIGNMENT"
  printf 'Document root: %s\nStorage: %s %s\nHost directory: %s\nCompose: %s\nEnvironment: %s\n' "${VDM_SITE_DOCROOT:-unknown}" "${VDM_SITE_MOUNT_TYPE:-unknown}" "$VDM_SITE_MOUNT_SOURCE" "${VDM_SITE_HOST_PATH:-not a known bind mount}" "$VDM_SITE_COMPOSE" "${VDM_SITE_ENV:-none}"
  [ -z "$VDM_SITE_VIEWER_URL" ] || printf 'Database viewer: %s\n' "$VDM_SITE_VIEWER_URL"
  [ -z "$VDM_SITE_MAIL_URL" ] || printf 'Mail viewer: %s\n' "$VDM_SITE_MAIL_URL"
  [ -z "$VDM_SITE_SERVICE_IMAGES" ] || printf 'Configured services:\n%s' "$VDM_SITE_SERVICE_IMAGES"
  [ -z "$VDM_SITE_SERVICE_STATES" ] || printf 'Observed service state:\n%s' "$VDM_SITE_SERVICE_STATES"
  return 0
}

# JSON filters below use jq variables, not shell expansion.
# shellcheck disable=SC2016
function joomlaSiteFactsJSON() {
  command -v jq >/dev/null 2>&1 || { printf 'JSON output requires jq.\n' >&2; return 1; }
  joomlaSiteJSON -n --arg site "$VDM_SITE_NAME" --arg enabled "$VDM_SITE_ENABLED" --arg running "$VDM_SITE_RUNNING" \
    --arg health "$VDM_SITE_HEALTH" --arg url "$VDM_SITE_URL" --arg administrator "$VDM_SITE_ADMIN_URL" \
    --arg image "$VDM_SITE_IMAGE" --arg runtime_image "$VDM_SITE_RUNTIME_IMAGE" --arg image_id "$VDM_SITE_IMAGE_DIGEST" \
    --arg joomla "$VDM_SITE_JOOMLA_VERSION" --arg php "$VDM_SITE_PHP_VERSION" --arg webserver "$VDM_SITE_WEBSERVER" \
    --arg root "$VDM_SITE_DOCROOT" --arg host_path "$VDM_SITE_HOST_PATH" --arg mount_type "$VDM_SITE_MOUNT_TYPE" \
    --arg mount_source "$VDM_SITE_MOUNT_SOURCE" --arg volume_name "$VDM_SITE_VOLUME_NAME" --arg compose "$VDM_SITE_COMPOSE" --arg env "$VDM_SITE_ENV" \
    --arg service "$VDM_SITE_SERVICE" --arg services "$VDM_SITE_SERVICES" --arg states "$VDM_SITE_SERVICE_STATES" --arg service_images "$VDM_SITE_SERVICE_IMAGES" \
    --arg viewer "$VDM_SITE_VIEWER_URL" --arg mail "$VDM_SITE_MAIL_URL" --arg alignment "$VDM_SITE_ALIGNMENT" \
    '{site:$site,enabled:$enabled,running:$running,health:$health,routable:"unchecked",url:$url,administrator:$administrator,
      image:$image,runtime_image:$runtime_image,image_id:$image_id,joomla_version:$joomla,php_version:$php,webserver:$webserver,
      document_root:$root,host_path:$host_path,mount:{type:$mount_type,source:$mount_source,volume_name:$volume_name},compose:$compose,environment:$env,
      web_service:$service,services:($services|split("\n")|map(select(length>0))),service_states:($states|split("\n")|map(select(length>0))),
      service_images:($service_images|split("\n")|map(select(length>0))),database_viewer_url:$viewer,mail_url:$mail,alignment:$alignment}'
}

function joomla__TRuST__info() {
  (
    readJoomlaSiteFacts "${VDM_CONTAINER:-}" || exit 1
    if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then joomlaSiteFactsJSON; else showJoomlaSiteFacts; fi
  )
}

function joomla__TRuST__list() {
  (
    local site first=true
    [ "${OCTOJOOM_OUTPUT:-text}" != json ] || printf '['
    while IFS= read -r site; do
      readJoomlaSiteFacts "$site" || continue
      # Unknown installed versions appear in unfiltered inventory only.
      if [ -n "${VDM_VERSION_PREFIX:-}" ] && [[ "$VDM_SITE_JOOMLA_VERSION" != "$VDM_VERSION_PREFIX"* || "$VDM_SITE_JOOMLA_VERSION" = unknown ]]; then continue; fi
      if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then
        "$first" || printf ','
        first=false
        joomlaSiteFactsJSON || exit 1
      elif [ "${VDM_SHORT:-false}" = true ]; then
        printf '%s\n' "$site"
      else
        printf '%s\t%s\t%s\tJoomla %s\n' "$site" "$VDM_SITE_ENABLED" "$VDM_SITE_RUNNING" "$VDM_SITE_JOOMLA_VERSION"
      fi
    done < <(listJoomlaSites)
    [ "${OCTOJOOM_OUTPUT:-text}" != json ] || printf ']\n'
    return 0
  )
}

function joomla__TRuST__path() {
  (
    readJoomlaSiteFacts "${VDM_CONTAINER:-}" || exit 1
    if [ -z "$VDM_SITE_HOST_PATH" ]; then
      printf 'Website %s has no resolved bind-mounted host directory; use its container at %s.\n' "$VDM_SITE_NAME" "${VDM_SITE_DOCROOT:-the configured document root}" >&2
      exit 1
    fi
    printf '%s\n' "$VDM_SITE_HOST_PATH"
  )
}

function joomlaSiteLifecycle() {
  local site="${VDM_CONTAINER:-}" action="$1"
  resolveJoomlaSite "$site" || return 1
  case "$action" in
    start) joomlaSiteCompose "$site" up -d ;;
    stop) joomlaSiteCompose "$site" stop ;;
    restart) joomlaSiteCompose "$site" restart ;;
    redeploy) joomlaSiteCompose "$site" up -d --force-recreate ;;
    *) return 17 ;;
  esac
}

function joomla__TRuST__start() {
  joomlaSiteLifecycle start
}

function joomla__TRuST__stop() {
  joomlaSiteLifecycle stop
}

function joomla__TRuST__restart() {
  joomlaSiteLifecycle restart
}

function joomla__TRuST__redeploy() {
  joomlaSiteLifecycle redeploy
}

function joomla__TRuST__logs() {
  local site="${VDM_CONTAINER:-}" service="${VDM_SERVICE:-}" tail="${VDM_TAIL:-100}"
  local -a arguments=(logs --tail "$tail")
  [[ "$tail" =~ ^[0-9]+$ ]] || { printf 'Log tail must be a nonnegative number.\n' >&2; return 17; }
  resolveJoomlaSite "$site" || return 1
  if [ -n "$service" ]; then
    local services
    services=$(joomlaSiteCompose "$site" config --services) || return $?
    printf '%s\n' "$services" | grep -qxF -- "$service" || { printf 'Unknown service: %s\n' "$service" >&2; return 1; }
  fi
  [ "${VDM_FOLLOW:-false}" != true ] || arguments+=(--follow)
  [ -z "$service" ] || arguments+=("$service")
  joomlaSiteCompose "$site" "${arguments[@]}"
}

function joomla__TRuST__open() {
  (
    readJoomlaSiteFacts "${VDM_CONTAINER:-}" || exit 1
    local target=''
    case "${VDM_ACTION:-website}" in
      website) target="$VDM_SITE_URL" ;;
      admin) target="$VDM_SITE_ADMIN_URL" ;;
      viewer) target="$VDM_SITE_VIEWER_URL" ;;
      mail) target="$VDM_SITE_MAIL_URL" ;;
      directory) target="$VDM_SITE_HOST_PATH" ;;
      *) printf 'Choose website, admin, viewer, mail or directory.\n' >&2; exit 17 ;;
    esac
    [ -n "$target" ] || { printf 'The requested website location is unavailable.\n' >&2; exit 1; }
    openJoomlaSiteTarget "$target"
  )
}

# Native argv is passed literally, providing the automation equivalent of shell.
function joomla__TRuST__exec() {
  (
    readJoomlaSiteFacts "${VDM_CONTAINER:-}" || exit 1
    local service="${VDM_SERVICE:-$VDM_SITE_SERVICE}"
    local -a arguments=(exec -T)
    [ "${#OCTOJOOM_ARGS[@]}" -gt 0 ] || { printf 'Supply a native command after --.\n' >&2; exit 17; }
    [ -n "$service" ] || { printf 'Cannot resolve the selected service.\n' >&2; exit 1; }
    printf '%s\n' "$VDM_SITE_SERVICES" | grep -qxF -- "$service" || {
      printf 'Unknown service: %s\n' "$service" >&2; exit 1;
    }
    if [ "$service" = "$VDM_SITE_SERVICE" ]; then
      [ -n "$VDM_SITE_DOCROOT" ] || { printf 'Cannot resolve the website document root.\n' >&2; exit 1; }
      arguments+=(--workdir "$VDM_SITE_DOCROOT")
    fi
    # Database and companion services retain their own image's working directory.
    joomlaSiteCompose "$VDM_SITE_NAME" "${arguments[@]}" "$service" "${OCTOJOOM_ARGS[@]}"
  )
}

function joomla__TRuST__shell() {
  (
    [[ -t 0 && -t 1 ]] || { printf 'A website shell requires an interactive terminal.\n' >&2; exit 17; }
    readJoomlaSiteFacts "${VDM_CONTAINER:-}" || exit 1
    [[ -n "$VDM_SITE_SERVICE" && -n "$VDM_SITE_DOCROOT" ]] || {
      printf 'Cannot resolve the website service and document root.\n' >&2; exit 1;
    }
    joomlaSiteCompose "$VDM_SITE_NAME" exec --workdir "$VDM_SITE_DOCROOT" "$VDM_SITE_SERVICE" sh
  )
}

# Permission repair shares the original Joomla file/directory helpers but uses
# the selected actual root. Optional ownership applies only when both IDs exist.
function joomla__TRuST__permissions() {
  (
    readJoomlaSiteFacts "${VDM_CONTAINER:-}" || exit 1
    [[ -n "$VDM_SITE_HOST_PATH" && -d "$VDM_SITE_HOST_PATH" ]] || {
      printf 'Permission repair requires a resolved bind-mounted document root.\n' >&2; exit 1;
    }
    if [ -n "${VDM_PUID:-}${VDM_PGID:-}" ] &&
      { [[ ! "${VDM_PUID:-}" =~ ^[0-9]+$ ]] || [[ ! "${VDM_PGID:-}" =~ ^[0-9]+$ ]]; }; then
      printf 'Supply both numeric --uid and --gid for an ownership change.\n' >&2
      exit 17
    fi
    if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ]; then
      getInputYesNo "Repair file and directory permissions in:\n${VDM_SITE_HOST_PATH}?" 'Repair website permissions' 12 112 || exit 0
    fi
    if [ -n "${VDM_PUID:-}" ]; then
      runPrivileged chown -R "${VDM_PUID}:${VDM_PGID}" "$VDM_SITE_HOST_PATH" || exit $?
    fi
    fixJoomlaFilePermissions "$VDM_SITE_HOST_PATH" || exit $?
    fixJoomlaDirectoryPermissions "$VDM_SITE_HOST_PATH"
  )
}

function openJoomlaSiteTarget() {
  local target="$1"
  [ -n "$target" ] || return 1
  case "${OS_NUMBER:-0}" in
    1) command -v xdg-open >/dev/null 2>&1 && xdg-open "$target" ;;
    2) open "$target" ;;
    3) explorer.exe "$target" ;;
    *) printf '%s\n' "$target" ;;
  esac
}

# All menu actions run with the selected identity in a subshell. Existing
# lifecycle handlers may unset VDM_CONTAINER; they cannot lose the menu's site.
function runJoomlaSiteAction() {
  (
    local site="$1" action="$2" status=0
    local VDM_CONTAINER="$site" VDM_CONTAINER_TYPE=joomla VDM_ACTION=''
    readJoomlaSiteFacts "$site" || exit 1
    # Variables are read by the feature action handlers.
    # shellcheck disable=SC2034
    case "$action" in
      enable|disable|clone|migrate|delete) "joomla__TRuST__${action}" ;;
      start|stop|restart|redeploy) joomlaSiteLifecycle "$action" ;;
      php-switch|php-settings) VDM_ACTION="${action#php-}"; joomla__TRuST__php ;;
      webserver|docroot) VDM_ACTION='set'; "joomla__TRuST__${action}" ;;
      align) VDM_ACTION=apply; local VDM_ALL=false; joomla__TRuST__align ;;
      database) showJoomlaDatabaseTools "$site" ;;
      database-change) showJoomlaDatabaseChange "$site" ;;
      backups) showJoomlaBackups "$site" ;;
      edit) joomla__TRuST__edit ;;
      env)
        [ -n "$VDM_SITE_ENV" ] || { showError 'This website has no environment file.'; exit 1; }
        if [ "$VDM_SITE_ENV" = "${VDM_REPO_PATH}/joomla/.env" ]; then
          showNotice "This is the shared Joomla environment file, used by other websites too:\n${VDM_SITE_ENV}"
        else
          showNotice "This website uses its own environment file:\n${VDM_SITE_ENV}"
        fi
        "${EDITOR:-nano}" "$VDM_SITE_ENV"
        ;;
      logs)
        local choice service options=(all 'All services')
        while IFS= read -r service; do [ -z "$service" ] || options+=("$service" "$service"); done <<< "$VDM_SITE_SERVICES"
        options+=(back '<-- Return to website details')
        choice=$(whiptail --menu 'Read the latest 100 log lines. Close the viewer to return.' 20 112 10 --title "Logs | ${site}" --backtitle "$BACK_TITLE" "${options[@]}" 3>&2 2>&1 1>&3) || exit 0
        [ "$choice" != back ] || exit 0
        local VDM_SERVICE='' VDM_FOLLOW=false log_file
        [ "$choice" = all ] || VDM_SERVICE="$choice"
        log_file=$(mktemp) || exit 1
        chmod 600 "$log_file" || { rm -f "$log_file"; exit 1; }
        joomla__TRuST__logs >"$log_file" 2>&1 || status=$?
        whiptail --textbox "$log_file" 30 112 --scrolltext --title "Logs | ${site}" --backtitle "$BACK_TITLE"
        rm -f "$log_file"
        exit "$status"
        ;;
      website|admin|viewer|mail|directory) VDM_ACTION="$action"; joomla__TRuST__open ;;
      files) joomla__TRuST__shell ;;
      permissions) local VDM_PUID='' VDM_PGID=''; joomla__TRuST__permissions ;;
      *) return 17 ;;
    esac
  )
}

function showJoomlaWebsiteInformation() {
  local site choice details status hint initial_site="${1:-}" details_only="${2:-false}"
  local -a sites=() actions=()
  while true; do
    if [ -n "$initial_site" ]; then
      site="$initial_site"
      initial_site=''
    else
      sites=()
      while IFS= read -r site; do
        hint=$(getJoomlaSiteEnabledState "$site")
        sites+=("$site" "$hint")
      done < <(listJoomlaSites)
      if [ "${#sites[@]}" -eq 0 ]; then showNotice 'There are no websites configured yet.'; return 0; fi
      sites+=(back '<-- Return to Joomla menu')
      site=$(whiptail --menu 'Select a website' 23 112 15 --title "Website Information | ${PROGRAM_NAME}" --backtitle "$BACK_TITLE" "${sites[@]}" 3>&2 2>&1 1>&3) || return 0
      [ "$site" != back ] || return 0
    fi
    while [ -f "${VDM_REPO_PATH}/joomla/available/${site}/docker-compose.yml" ]; do
      # Facts and flags stay inside this menu invocation; site ENV is never loaded.
      readJoomlaSiteFacts "$site" || break
      details=$(showJoomlaSiteFacts)
      actions=(back '<-- Return to website list' start 'Start website services' stop 'Stop website services' restart 'Restart website services' redeploy 'Recreate website services using current configuration')
      if [ "$VDM_SITE_ENABLED" = enabled ]; then actions+=(disable 'Disable website'); else actions+=(enable 'Enable website'); fi
      actions+=(logs 'Read logs')
      [ -z "$VDM_SITE_URL" ] || actions+=(website 'Open website' admin 'Open administrator')
      [ -z "$VDM_SITE_VIEWER_URL" ] || actions+=(viewer 'Open database viewer')
      [ -z "$VDM_SITE_MAIL_URL" ] || actions+=(mail 'Open mail viewer')
      if [ -n "$VDM_SITE_HOST_PATH" ]; then
        actions+=(directory 'Open website directory' permissions 'Repair website file permissions')
      elif [ -n "$VDM_SITE_SERVICE" ]; then actions+=(files 'Open website container shell'); fi
      isFunc joomla__TRuST__php && actions+=(php-switch 'Change PHP version' php-settings 'Change PHP settings')
      isFunc joomla__TRuST__webserver && actions+=(webserver 'Change webserver')
      isFunc joomla__TRuST__docroot && actions+=(docroot 'Change document root')
      isFunc joomla__TRuST__align && actions+=(align 'Update this website configuration')
      isFunc showJoomlaDatabaseTools && actions+=(database 'Database tools')
      isFunc showJoomlaDatabaseChange && actions+=(database-change 'Change database')
      isFunc showJoomlaBackups && actions+=(backups 'Backups and restore points')
      actions+=(clone 'Clone website' migrate 'Migrate website' delete 'Delete website configuration')
      if isExpert; then actions+=(edit 'Edit Compose configuration' env 'View or edit environment and credentials'); fi
      choice=$(whiptail --menu "$details" 0 112 0 --title "Website Information | ${site}" --backtitle "$BACK_TITLE" "${actions[@]}" 3>&2 2>&1 1>&3) || break
      [ "$choice" != back ] || break
      status=0
      runJoomlaSiteAction "$site" "$choice" || status=$?
      if [ "$status" -ne 0 ]; then showError "The ${choice} action returned status ${status}. Current website state will be refreshed."; fi
    done
    [ "$details_only" != true ] || return 0
  done
}

