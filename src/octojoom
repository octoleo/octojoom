# Called early, before legacy dependency installers or whiptail initialization.
function v4Main() {
  # Dynamically scoped for the shared legacy privilege helper.
  # shellcheck disable=SC2034
  local V4_NONINTERACTIVE=true
  local handler status=0 temporary data='null' error='' action='request' raw='' result_file error_file streaming=false
  V4_ERROR=''; V4_ERROR_FILE=''; V4_RESULT_FILE=''
  if ! type -P jq >/dev/null 2>&1; then
    printf '%s\n' 'ERROR: OctoJoom v4 commands require jq. Install jq using your operating system package manager.' >&2
    return 3
  fi
  case "${OSTYPE:-}" in
    msys*|cygwin*)
      if ! MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' command jq -b -n null >/dev/null 2>&1; then
        printf '%s\n' 'ERROR: Native Windows jq 1.7 or newer is required for binary output.' >&2
        return 3
      fi ;;
  esac
  # Recognize --json even if validation fails before that flag is parsed.
  V4_JSON=false
  local previous=''
  for raw in "$@"; do
    [ "$raw" != -- ] || break
    case "$raw" in
      --json|--json=true) V4_JSON=true ;;
      --json=false) V4_JSON=false ;;
      true|false) [ "$previous" != --json ] || V4_JSON="$raw" ;;
    esac
    previous="$raw"
  done
  local requested_json="$V4_JSON"
  v4Parse "$@" || status=$?
  if [ "$status" -eq 0 ]; then v4ValidateActionRequest || status=$?; fi
  if [ "$status" -ne 0 ] && [ "$requested_json" = true ]; then V4_JSON=true; fi
  action="${V4_GROUP:-request}${V4_ACTION:+:${V4_ACTION}}"
  if [ "$status" -eq 0 ]; then
    case "$V4_GROUP:$V4_ACTION" in
      site:schema)
        data=$(v4RequestSchema)
        if declare -F v4ActionSchemas >/dev/null; then
          data=$(jq -cn --argjson schema "$data" --argjson actions "$(v4ActionSchemas)" '$schema + {action_schemas:$actions}') || status=1
          if [ "$status" -eq 0 ] && declare -F v4ActionSchema >/dev/null; then
            local forms
            forms=$(v4FormSchemas) || status=1
            if [ "$status" -eq 0 ]; then data=$(jq -cn --argjson schema "$data" --argjson forms "$forms" '$schema + {form_schemas:$forms}') || status=1; fi
          fi
        fi
        ;;
      site:help)
        if [ "$V4_JSON" = true ]; then data=$(jq -cn --arg help "$(v4Help)" '{help:$help}'); else v4Help; return 0; fi ;;
      site:version) data=$(jq -cn --arg version "${_VERSION:-4.0.0}" '{version:$version,schema_version:1}') ;;
      *)
        v4Init || status=$?
        if [ "$status" -eq 0 ]; then
          handler=$(v4Handler "$V4_GROUP" "$V4_ACTION") || status=$?
          if [ "$status" -eq 0 ] && ! declare -F "$handler" >/dev/null; then
            v4Error 'This action is unavailable in the installed OctoJoom build.' 3; status=3
          fi
        fi
        if [ "$status" -eq 0 ]; then
          case "$V4_GROUP:$V4_ACTION:$(v4Get follow false)" in
            site:shell:*|site:logs:true) streaming=true ;;
            database:console:*) if ! v4Has command; then streaming=true; fi ;;
          esac
          if [ "$streaming" = true ]; then
            if [ "$V4_JSON" = true ]; then v4Error 'Interactive shells cannot use --json; supply a database --command or use site exec for automation.' 2; status=2
            else "$handler"; return $?; fi
          fi
        fi
        if [ "$status" -eq 0 ]; then
          temporary=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-command.XXXXXX") || return 1
          chmod 700 "$temporary" || { rmdir "$temporary"; return 1; }
          result_file="$temporary/result.json"; error_file="$temporary/error"
          V4_RESULT_FILE="$result_file"; V4_ERROR_FILE="$error_file"
          "$handler" > "$temporary/stdout" || status=$?
          [ ! -f "$result_file" ] || data=$(cat "$result_file")
          [ ! -f "$error_file" ] || V4_ERROR=$(cat "$error_file")
          if [ "$V4_JSON" = true ]; then
            if [ "$data" = null ] && [ -s "$temporary/stdout" ]; then
              data=$(jq -Rs '{stdout:.}' < "$temporary/stdout") || status=1
            elif [ -s "$temporary/stdout" ]; then cat "$temporary/stdout" >&2; fi
          else
            cat "$temporary/stdout"
          fi
          rm -rf -- "$temporary"
          V4_RESULT_FILE=''; V4_ERROR_FILE=''
        fi
        ;;
    esac
  fi
  if [ "$status" -ne 0 ]; then error="${V4_ERROR:-The operation failed. Inspect stderr for details.}"; fi
  if [ "$V4_JSON" = true ]; then
    jq -cn --arg action "$action" --argjson status "$status" --argjson data "$data" --arg error "$error" '{schema_version:1,ok:($status==0),action:$action,data:$data,error:(if $status==0 then null else {code:$status,message:$error} end)}'
  elif [ "$data" != null ]; then
    if jq -e 'type=="object" and (has("stdout") or has("stderr"))' <<< "$data" >/dev/null; then
      jq -jr '.stdout // empty' <<< "$data"
      jq -jr '.stderr // empty' <<< "$data" >&2
    else
      jq . <<< "$data"
    fi
  fi
  return "$status"
}

function v4OptionKey() {
  case "$1" in
    db_engine) printf database_engine ;; db_version) printf database_version ;;
    db_name) printf database_name ;; db_user) printf database_user ;;
    db_password) printf database_password ;; db_root_password) printf database_root_password ;;
    start) printf activate ;; source_url) printf package_url ;; tls_resolver) printf resolver ;;
    dev_label) printf development_label ;; install_trust) printf trust ;; tls) printf tls_mode ;;
    *) printf '%s' "$1" ;;
  esac
}

function v4NormalizeOptions() {
  local object="$1" key canonical value
  while IFS= read -r key; do
    canonical=$(v4OptionKey "$key")
    if [ "$canonical" != "$key" ]; then
      if jq -e --arg key "$canonical" 'has($key)' <<< "$object" >/dev/null; then
        jq -e --arg key "$key" --arg canonical "$canonical" '.[$key]==.[$canonical]' <<< "$object" >/dev/null || {
          v4Error "Conflicting aliases for ${canonical//_/-}." 2; return 2;
        }
      fi
      value=$(jq -c --arg key "$key" '.[$key]' <<< "$object") || return 2
      object=$(jq -c --arg key "$key" --arg canonical "$canonical" --argjson value "$value" 'del(.[$key]) | .[$canonical]=$value' <<< "$object") || return 2
    fi
  done < <(jq -r 'keys[]' <<< "$object")
  printf '%s\n' "$object"
}

# Preserve the legacy entry points unless the caller explicitly asks for the
# machine interface or a new task. No Docker or dialog calls are made here.
function v4ShouldHandle() {
  local argument task='' type='' previous=''
  case "${1:-}" in
    site|database|backup|snapshot|tls|share|mail|service|hook|update) return 0 ;;
  esac
  for argument in "$@"; do
    [ "$argument" != -- ] || break
    case "$argument" in
      --config|--config=*|--json|--json=*|--no-interaction|--no-interaction=*|--version) return 0 ;;
      --task=*) task=${argument#*=} ;;
      --type=*) type=${argument#*=} ;;
      *)
        [ "$previous" != --task ] || task=$argument
        [ "$previous" != --type ] || type=$argument
        ;;
    esac
    previous=$argument
  done
  [ "$type" = joomla ] || return 1
  case "$task" in
    list|info|create|download|permissions|configure|php|webserver|realign|import|start|stop|restart|logs|open|path|shell|exec|joomla|composer|npm|diagnose|offline|schema|db-*|backup*|restore|snapshot*|tls*|share*|mail|service|hook|update-check|update-apply) return 0 ;;
    *) return 1 ;;
  esac
}

