# set the image source values
function setImageSource() {
  # some local values
  local vdm_image_source
  local vdm_tag_url
  # get the Joomla version if not set
  while [ -z "${VDM_J_REPO}" ] || [ ${#VDM_J_REPO} -le 3 ]; do
    # get the image source
    vdm_image_source=$(getImageSource) || return $?
    # build the source key (string before the first | )
    VDM_J_REPO="${vdm_image_source%%|*}"
    # set the source entry-point (url after the last ; )
    VDM_ENTRY_REPO="${vdm_image_source##*;}"
    # remove the J_REPO (remove everything before the first | )
    vdm_image_source="${vdm_image_source##*|}"
    # set the source entry-point (string before the first ; )
    vdm_tag_url="${vdm_image_source%%;*}"
    # keep asking
    [ ${#VDM_J_REPO} -le 3 ] && {
      showError "Seems like the source selected is not correctly configured, please select another."
    }
    # make sure the source is set
    [[ "${VDM_ENTRY_REPO}" == *'docker-entrypoint.sh' ]] || {
      VDM_J_REPO=''
      showError "Seems like the source selected is not correctly configured, please select another."
    }
  done
  # get the Joomla version if not set
  while [ ${#VDM_JV} -le 1 ]; do
    # get the value
    VDM_JV=$(getInput "Enter Joomla version tag for this container.\n[See available tags here ${vdm_tag_url}]" "${VDM_DEFAULT_JOOMLA_IMAGE_TAG:-latest}" 'Enter Version Tag') || return $?
    # keep asking
    [ ${#VDM_JV} -ge 1 ] || {
      showError "You must enter a version tag. See available tags here ${vdm_tag_url}"
    }
  done
  joomlaImageEntrypoint || return $?
  # make the value available globally
  export VDM_ENTRY_REPO
  export VDM_J_REPO
  export VDM_JV
}

# Inspect published PHP runtimes without invoking their installation entrypoint
# or giving them access to a live website. JSON is transient inspection data.
function joomlaRuntimeProbeImage() {
  local image="$1"
  docker run --rm --network none --read-only --entrypoint sh "$image" -c '
    if command -v apache2 >/dev/null 2>&1 || command -v httpd >/dev/null 2>&1; then
      OCTOJOOM_FLAVOR=apache
    elif command -v php-fpm >/dev/null 2>&1; then
      OCTOJOOM_FLAVOR=fpm
    else
      OCTOJOOM_FLAVOR=unknown
    fi
    export OCTOJOOM_FLAVOR
    exec php -r '\''$version = null;
      foreach (["/usr/src/joomla/administrator/manifests/files/joomla.xml", "/var/www/html/administrator/manifests/files/joomla.xml"] as $path) {
        if (is_file($path)) { $xml = @simplexml_load_file($path, "SimpleXMLElement", LIBXML_NONET); if ($xml) { $version = (string) $xml->version; break; } }
      }
      $scan = getenv("PHP_INI_SCAN_DIR") !== false ? getenv("PHP_INI_SCAN_DIR") : (defined("PHP_CONFIG_FILE_SCAN_DIR") ? PHP_CONFIG_FILE_SCAN_DIR : "");
      echo json_encode(["joomla" => $version, "php" => PHP_VERSION, "flavor" => getenv("OCTOJOOM_FLAVOR"), "ini_dir" => $scan, "extensions" => get_loaded_extensions()], JSON_UNESCAPED_SLASHES), "\n";'\'''
}

# Full image references retain registry ports. Switching never changes source.
function joomlaRuntimeRepository() {
  local image="${1%%@*}" tail
  tail="${image##*/}"
  [[ "$tail" != *:* ]] || image="${image%:*}"
  printf '%s\n' "$image"
}

function joomlaRuntimeRequireTools() {
  command -v jq >/dev/null 2>&1 || { printf 'PHP runtime changes require jq; install jq and retry.\n' >&2; return 1; }
  command -v docker >/dev/null 2>&1 || { printf 'Docker is required for PHP runtime inspection.\n' >&2; return 1; }
}

function joomlaRuntimeTagCache() {
  local checksum
  checksum=$(printf '%s' "$1" | cksum) || return 1
  printf '%s/cache/php-tags-%s\n' "$VDM_SRC_PATH" "${checksum%% *}"
}

# Docker Hub's catalog can reject otherwise valid anonymous clients. The
# registry fallback uses Docker's documented, repository-scoped pull token and
# tag-list API. Credentials/tokens never enter the discovery cache.
function joomlaRuntimeHubTags() {
  local repository="$1" url response page=0
  url="https://hub.docker.com/v2/repositories/${repository}/tags?page_size=100"
  while [ -n "$url" ] && [ "$page" -lt 100 ]; do
    response=$(curl --fail --silent --connect-timeout 10 --max-time 30 "$url") || return 1
    jq -e '.results | type == "array" and all(.[]; .name | type == "string" and test("^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"))' >/dev/null <<< "$response" || return 1
    jq -r '.results[].name' <<< "$response" || return 1
    url=$(jq -r '.next // empty' <<< "$response") || return 1
    [[ -z "$url" || "$url" == "https://hub.docker.com/v2/repositories/${repository}/tags?"* ]] || return 1
    page=$((page + 1))
  done
  # Do not silently publish a truncated list if a repository exceeds the bound.
  [ -z "$url" ]
}

function joomlaRuntimeRegistryTags() {
  local repository="$1" token response url next headers page=0 result=0
  response=$(curl --fail --silent --show-error --retry 2 --retry-delay 1 --connect-timeout 10 --max-time 30 \
    "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${repository}:pull") || return 1
  token=$(jq -er '(.token // .access_token) | select(type == "string" and test("^[A-Za-z0-9._~+/=-]+$"))' <<< "$response") || return 1
  headers=$(mktemp "${TMPDIR:-/tmp}/octojoom-tag-headers.XXXXXXXX") || return 1
  url="https://registry-1.docker.io/v2/${repository}/tags/list?n=1000"
  while [ -n "$url" ] && [ "$page" -lt 100 ]; do
    response=$(curl --fail --silent --show-error --retry 2 --retry-delay 1 --connect-timeout 10 --max-time 30 \
      --header "Authorization: Bearer $token" --dump-header "$headers" "$url") || { result=1; break; }
    jq -e --arg repository "$repository" '.name == $repository and (.tags | type == "array" and all(.[]; type == "string" and test("^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$")))' >/dev/null <<< "$response" || { result=1; break; }
    jq -r '.tags[]' <<< "$response" || { result=1; break; }
    next=$(sed -nE 's/^[Ll][Ii][Nn][Kk]:[[:space:]]*<([^>]*)>.*rel="?next"?.*/\1/p' "$headers" | tr -d '\r')
    case "$next" in
      '') url='';;
      /v2/*) url="https://registry-1.docker.io$next";;
      *) url="$next";;
    esac
    # Never forward the bearer token to a pagination URL on another origin or
    # repository. Tags themselves contain no URL delimiters.
    if [[ -n "$url" && "$url" != "https://registry-1.docker.io/v2/${repository}/tags/list?"* ]]; then result=1; break; fi
    page=$((page + 1))
  done
  rm -f "$headers"
  [[ "$result" = 0 && -z "$url" ]]
}

# Discovery runs only for an explicit runtime action. Other registries/private
# repositories remain usable through manual tags and Docker's credential store.
function joomlaRuntimeTags() {
  local repository="$1" hub_repository cache temporary
  hub_repository="${repository#docker.io/}"
  hub_repository="${hub_repository#index.docker.io/}"
  [[ "$hub_repository" == */* ]] || hub_repository="library/$hub_repository"
  [[ "$hub_repository" =~ ^[a-z0-9_-]+/[a-z0-9_.-]+$ ]] || {
    printf 'Automatic tag discovery supports Docker Hub. Enter a published tag for %s.\n' "$repository" >&2; return 1;
  }
  cache=$(joomlaRuntimeTagCache "$repository") || return 1
  createPrivateDirectory -p "${cache%/*}" || return 1
  temporary=$(mktemp "${cache}.tmp.XXXXXX") || return 1
  if ! joomlaRuntimeHubTags "$hub_repository" > "$temporary"; then
    printf 'Docker Hub catalog unavailable; checking published registry tags.\n' >&2
    if ! joomlaRuntimeRegistryTags "$hub_repository" > "$temporary"; then
      rm -f "$temporary"
      printf 'Published tags could not be discovered. Enter a known published tag and retry.\n' >&2
      return 1
    fi
  fi
  if ! sort -u "$temporary" -o "$temporary" || ! chmod 600 "$temporary" || ! mv -f "$temporary" "$cache"; then rm -f "$temporary"; return 1; fi
  cat "$cache"
}

# Read only the installed manifest, including on stopped sites and named volumes.
function joomlaRuntimeInstalledVersion() {
  local site="$1" mount source relative
  readJoomlaSiteFacts "$site" || return 1
  relative="${VDM_SITE_DOCROOT#"$VDM_SITE_MOUNT_TARGET"}"
  [[ "$VDM_SITE_DOCROOT" == "$VDM_SITE_MOUNT_TARGET" || "$VDM_SITE_DOCROOT" == "$VDM_SITE_MOUNT_TARGET/"* ]] || return 1
  source="$VDM_SITE_MOUNT_SOURCE"
  if [ "$VDM_SITE_MOUNT_TYPE" = volume ]; then
    source="${VDM_SITE_VOLUME_NAME:-}"
    # Docker run creates missing named volumes, even when mounted read-only.
    # Inspection must never create an empty volume under a logical Compose key.
    if [ -z "$source" ] || ! docker volume inspect "$source" >/dev/null 2>&1; then
      printf 'The actual website volume is unavailable; start the prepared site first.\n' >&2; return 1;
    fi
  fi
  [[ "$source" != *,* && -n "$source" ]] || { printf 'Cannot safely inspect this website mount.\n' >&2; return 1; }
  case "$VDM_SITE_MOUNT_TYPE" in bind|volume) mount="type=${VDM_SITE_MOUNT_TYPE},src=$source,dst=/octojoom-site,readonly";; *) return 1;; esac
  docker run --rm --network none --read-only --entrypoint php --mount "$mount" "$VDM_SITE_IMAGE" -r '
    $path = $argv[1] . "/administrator/manifests/files/joomla.xml";
    $xml = is_file($path) ? @simplexml_load_file($path, "SimpleXMLElement", LIBXML_NONET) : false;
    if (!$xml || !preg_match("/^\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.-]+)?$/", (string) $xml->version)) { fwrite(STDERR, "Installed Joomla manifest is unavailable.\n"); exit(1); }
    echo (string) $xml->version, "\n";' -- "/octojoom-site${relative}"
}

# Candidates are discovered tags, not synthesized names. They are verified by
# running the selected image before any deployment file is touched.
function joomlaRuntimeChooseTag() {
  local repository="$1" version="$2" flavor="$3" tag answer tags
  local choices=(keep 'Keep current selection' manual 'Enter a published tag')
  tags=$(joomlaRuntimeTags "$repository") || tags=''
  while IFS= read -r tag; do
    [[ "$tag" == "$version"-* && "$tag" == *"$flavor"* ]] || continue
    choices+=("$tag" "$repository:$tag")
  done <<< "$tags"
  answer=$(whiptail --title 'Published PHP runtimes' --backtitle "$BACK_TITLE" --menu \
    'Choose a candidate. Its Joomla version, PHP extensions and architecture will be verified.' 22 112 14 \
    "${choices[@]}" 3>&1 1>&2 2>&3) || return $?
  case "$answer" in
    keep) return 3;;
    manual) getInput 'Enter an existing published image tag from the same repository' '' 'Published tag';;
    *) printf '%s\n' "$answer";;
  esac
}

function joomlaRuntimeDatabaseExtensions() {
  local probe="$1" site="${2:-}" configured driver
  if [ -n "$site" ] && [ -n "${VDM_SITE_MOUNT_SOURCE:-}" ]; then
    configured=$(joomlaDatabaseReadConfiguration) || return 1
    driver=$(jq -r '.driver // empty' <<< "$configured") || return 1
    case "$driver" in
      postgresql) printf '["pgsql"]\n'; return 0;;
      pgsql|pdo_pgsql) printf '["pdo_pgsql"]\n'; return 0;;
      mysqli|mysql) printf '["mysqli"]\n'; return 0;;
      pdomysql|pdo_mysql) printf '["pdo_mysql"]\n'; return 0;;
    esac
  fi
  # Before installation, preserve the database capabilities already present in
  # the chosen image rather than assuming that every image is MySQL-only.
  jq -c '[.extensions[]? | select(.=="mysqli" or .=="pdo_mysql" or .=="pgsql" or .=="pdo_pgsql")] | if length==0 then ["mysqli"] else . end' <<< "$probe"
}

function joomlaRuntimeSelectImage() {
  local site="$1" flavor="$2" tag="${3:-}" installed repository candidate old_probe probe old_arch new_arch current_php required_database
  joomlaRuntimeRequireTools || return 1
  readJoomlaSiteFacts "$site" || return 1
  repository=$(joomlaRuntimeRepository "$VDM_SITE_IMAGE") || return 1
  installed=$(joomlaRuntimeInstalledVersion "$site") || return 1
  old_probe=$(joomlaRuntimeProbeImage "$VDM_SITE_IMAGE") || return 1
  jq -e '.php and .extensions' >/dev/null <<< "$old_probe" || return 1
  current_php=$(jq -r '.php | split(".")[0:2] | join(".")' <<< "$old_probe")
  [ -n "$flavor" ] || flavor=$(jq -r '.flavor' <<< "$old_probe")
  case "$flavor" in apache|fpm) ;; *) printf 'The selected image webserver could not be identified.\n' >&2; return 1;; esac
  if [ -z "$tag" ]; then
    if [ "$(jq -r '.flavor' <<< "$old_probe")" != "$flavor" ]; then
      candidate=$(joomlaRuntimeSelectImageForFlavor "$VDM_SITE_IMAGE" "$flavor") || return $?
      tag="${candidate#"$repository:"}"
    else
      [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] || { printf 'Supply --image-tag for this runtime change.\n' >&2; return 2; }
      tag=$(joomlaRuntimeChooseTag "$repository" "$installed" "$flavor") || return $?
    fi
  fi
  if [[ "$tag" == */* || "$tag" == *:* ]]; then
    candidate="$tag"
    [ "$(joomlaRuntimeRepository "$candidate")" = "$repository" ] || { printf 'Runtime changes must retain image repository %s.\n' "$repository" >&2; return 2; }
  else
    [[ "$tag" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] || { printf 'Invalid image tag.\n' >&2; return 2; }
    candidate="$repository:$tag"
  fi
  docker pull "$candidate" >&2 || return 1
  probe=$(joomlaRuntimeProbeImage "$candidate") || return 1
  required_database=$(joomlaRuntimeDatabaseExtensions "$old_probe" "$site") || return 1
  jq -e --arg installed "$installed" --arg flavor "$flavor" --argjson database "$required_database" '
    .joomla == $installed and .flavor == $flavor and
    ((["json", "session", "dom", "SimpleXML", "xml", "mbstring"] + $database) - .extensions | length == 0)
  ' >/dev/null <<< "$probe" || { printf 'Candidate must contain Joomla %s, %s and the required PHP extensions.\n' "$installed" "$flavor" >&2; return 1; }
  if [ "$(jq -r '.flavor' <<< "$old_probe")" != "$flavor" ]; then
    [ "$(jq -r '.php | split(".")[0:2] | join(".")' <<< "$probe")" = "$current_php" ] || {
      printf 'A webserver change must retain PHP %s; choose another published tag.\n' "$current_php" >&2; return 1;
    }
  fi
  old_arch=$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$VDM_SITE_IMAGE") || return 1
  new_arch=$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$candidate") || return 1
  [[ -n "$old_arch" && "$old_arch" = "$new_arch" ]] || { printf 'Candidate architecture does not match the current runtime.\n' >&2; return 1; }
  printf '%s\n' "$candidate"
}

# Select a published flavor for a new site, preserving its probed Joomla/PHP.
# The tag list supplies candidate names; every chosen candidate is pulled and
# inspected. This also handles --webserver nginx without a duplicate tag prompt.
function joomlaRuntimeSelectImageForFlavor() {
  local image="$1" flavor="$2" tag="${3:-}" probe version php repository tags candidate candidate_probe old_arch new_arch required_database
  joomlaRuntimeRequireTools || return 1
  probe=$(joomlaRuntimeProbeImage "$image") || return 1
  if [ -z "$tag" ] && [ "$(jq -r '.flavor // empty' <<< "$probe")" = "$flavor" ]; then
    printf '%s\n' "$image"
    return 0
  fi
  version=$(jq -r '.joomla // empty' <<< "$probe")
  php=$(jq -r '.php // empty' <<< "$probe")
  [[ -n "$version" && -n "$php" ]] || { printf 'The selected image Joomla/PHP release is unavailable.\n' >&2; return 1; }
  repository=$(joomlaRuntimeRepository "$image") || return 1
  if [ -z "$tag" ]; then
    tags=$(joomlaRuntimeTags "$repository") || return 1
    while IFS= read -r candidate; do
      [[ "$candidate" == "$version"-* && "$candidate" == *"php${php%.*}-"* && "$candidate" == *"$flavor"* ]] || continue
      tag="$candidate"; break
    done <<< "$tags"
    [ -n "$tag" ] || {
      if [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then
        printf 'No published matching %s tag was discovered; supply --image-tag.\n' "$flavor" >&2; return 1
      fi
      tag=$(joomlaRuntimeChooseTag "$repository" "$version" "$flavor") || return $?
    }
  fi
  [[ "$tag" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] || return 2
  candidate="$repository:$tag"
  docker pull "$candidate" >&2 || return 1
  candidate_probe=$(joomlaRuntimeProbeImage "$candidate") || return 1
  required_database=$(joomlaRuntimeDatabaseExtensions "$probe") || return 1
  jq -e --arg version "$version" --arg php "$php" --arg flavor "$flavor" --argjson database "$required_database" '
    .joomla == $version and .php == $php and .flavor == $flavor and
    ((["json", "session", "dom", "SimpleXML", "xml", "mbstring"] + $database) - .extensions | length == 0)
  ' >/dev/null <<< "$candidate_probe" || { printf 'The candidate must retain Joomla %s and PHP %s with %s.\n' "$version" "$php" "$flavor" >&2; return 1; }
  old_arch=$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$image") || return 1
  new_arch=$(docker image inspect --format '{{.Os}}/{{.Architecture}}' "$candidate") || return 1
  [[ -n "$old_arch" && "$old_arch" == "$new_arch" ]] || { printf 'Candidate architecture does not match.\n' >&2; return 1; }
  printf '%s\n' "$candidate"
}

function joomlaRuntimeIniTarget() {
  local probe directory
  probe=$(joomlaRuntimeProbeImage "$1") || return 1
  directory=$(jq -r '.ini_dir // empty' <<< "$probe") || return 1
  [[ "$directory" == /* && "$directory" != *:* && "$directory" != *$'\n'* && "$directory" != *'..'* ]] || {
    printf 'This image does not expose one supported PHP configuration scan directory.\n' >&2; return 1;
  }
  printf '%s/zz-octojoom.ini\n' "${directory%/}"
}

function joomlaSetupPHPChoices() {
  local probe version flavor tag candidate
  [ "${OCTOJOOM_NON_INTERACTIVE:-false}" != true ] || return 0
  joomlaRuntimeRequireTools || return 1
  probe=$(joomlaRuntimeProbeImage "${VDM_J_REPO}:${VDM_JV}") || {
    printf 'PHP image details are unavailable; the manually selected image is retained.\n' >&2; return 0;
  }
  version=$(jq -r '.joomla // empty' <<< "$probe")
  flavor=$(jq -r '.flavor // "unknown"' <<< "$probe")
  if getInputYesNo "Selected image: ${VDM_J_REPO}:${VDM_JV}\nPHP $(jq -r '.php' <<< "$probe"), $flavor.\nWould you like a different available PHP version?" 'PHP version' 12 112 defaultno; then
    :
  else
    local answer_status=$?
    [ "$answer_status" -eq 1 ] && return 0
    return "$answer_status"
  fi
  [ -n "$version" ] || { printf 'The image Joomla release could not be inspected. Use manual image tag selection.\n' >&2; return 1; }
  tag=$(joomlaRuntimeChooseTag "$VDM_J_REPO" "$version" "$flavor") || { local choose_status=$?; [ "$choose_status" -eq 3 ] && return 0; return "$choose_status"; }
  candidate="${VDM_J_REPO}:$tag"
  docker pull "$candidate" >&2 || return 1
  probe=$(joomlaRuntimeProbeImage "$candidate") || return 1
  jq -e --arg version "$version" --arg flavor "$flavor" '.joomla == $version and .flavor == $flavor' >/dev/null <<< "$probe" || {
    printf 'Choose a published tag with the same Joomla release and webserver.\n' >&2; return 1;
  }
  VDM_JV="$tag"
}

# Safe edits are deliberately limited to the ordinary block-style service.
# Compose's semantic model is checked separately; arbitrary YAML is never
# regenerated from resolved values (which would expose credentials).
function joomlaPHPReplaceMount() {
  local source="$1" destination="$2" service="$3" old_target="$4" host_file="$5" target="$6"
  [[ "$service" =~ ^[A-Za-z0-9_-]+$ && "$target" == /* && "$host_file" == /* ]] || return 1
  [[ "$host_file" != *$'\n'* && "$host_file" != *'"'* && "$host_file" != *\\* && "$host_file" != *'$'* ]] || return 1
  awk -v service="$service" -v old="$old_target" -v host="$host_file" -v target="$target" '
    /^  [A-Za-z0-9_-]+: *$/ { inside=($0 == "  " service ":"); volumes=0 }
    inside && /^    volumes: *$/ { volumes=1; print; if (old == "") { print "      - \"" host ":" target ":ro\""; changed++ }; next }
    inside && /^    [A-Za-z_]/ && !/^    volumes:/ { volumes=0 }
    inside && volumes && old != "" && index($0, ":" old) {
      if ($0 !~ /^      - /) { bad=1; exit }
      print "      - \"" host ":" target ":ro\""; changed++; next
    }
    { print }
    END { if (bad || changed != 1) exit 1 }
  ' "$source" > "$destination" || { rm -f "$destination"; printf 'PHP mount editing requires one ordinary service volumes block; use the Compose editor for this layout.\n' >&2; return 1; }
}

function joomlaPHPValidateValue() {
  local setting="$1" value="$2"
  case "$setting" in
    max_execution_time|max_input_vars) [[ "$value" =~ ^[0-9]{1,9}$ ]];;
    max_input_time) [[ "$value" == -1 || "$value" =~ ^[0-9]{1,9}$ ]];;
    memory_limit) [[ "$value" == -1 || "$value" =~ ^[0-9]{1,9}[KMGkmg]?$ ]];;
    upload_max_filesize|post_max_size) [[ "$value" =~ ^[0-9]{1,9}[KMGkmg]?$ ]];;
    error_reporting) [[ -n "$value" && "$value" != *[!A-Z0-9_\ \&\|\~\(\)]* ]];;
    *) return 1;;
  esac
}

# Preserve unrelated directives and comments, including shared bulk php.ini.
function joomlaPHPPatchIni() {
  local source="$1" destination="$2" setting value temporary
  shift 2
  if [ -n "$source" ]; then cp "$source" "$destination" || return 1; else : > "$destination" || return 1; fi
  while [ "$#" -gt 0 ]; do
    setting="$1"; value="$2"; shift 2
    joomlaPHPValidateValue "$setting" "$value" || { printf 'Invalid PHP value for %s.\n' "$setting" >&2; return 2; }
    temporary=$(mktemp "${destination}.tmp.XXXXXX") || return 1
    # Ordinary INI headings are grouping comments to PHP, while HOST/PATH
    # sections have their own scope. Keep those intentional overrides intact.
    if ! awk -v key="$setting" -v value="$value" '
      BEGIN { print key " = " value; scoped=0 }
      /^[[:space:]]*\[/ { scoped=($0 ~ /^[[:space:]]*\[(HOST|PATH)[[:space:]]*=/) }
      !scoped && $0 ~ ("^[[:space:]]*" key "[[:space:]]*=") { next }
      { print }
    ' "$destination" > "$temporary" || ! mv -f "$temporary" "$destination"; then rm -f "$temporary"; return 1; fi
  done
  chmod 644 "$destination"
}

# PHP CLI forcibly sets both timeout directives, including get_cfg_var(). Read
# only those configured web values from PHP's actual ordered startup files;
# retain native parsing and ignore per-HOST/PATH settings for this global check.
function joomlaPHPConfigurationReader() {
  cat <<'PHP'
function octojoomConfiguredPHPValue($setting) {
    if (!in_array($setting, ["max_execution_time", "max_input_time"], true)) {
        return get_cfg_var($setting);
    }
    $paths = [];
    if ($loaded = php_ini_loaded_file()) { $paths[] = $loaded; }
    foreach (preg_split('/,\\s*/', trim((string) php_ini_scanned_files()), -1, PREG_SPLIT_NO_EMPTY) as $path) {
        $paths[] = $path;
    }
    // PHP can skip a malformed scanned file, warn, and still exit successfully.
    // Check every configured scan file before trusting the successfully loaded
    // list; use that original list, not this directory enumeration, for order.
    $scan = getenv("PHP_INI_SCAN_DIR");
    $defaultScan = defined("PHP_CONFIG_FILE_SCAN_DIR") ? PHP_CONFIG_FILE_SCAN_DIR : "";
    if ($scan === false) { $scan = $defaultScan; }
    foreach ($scan === "" ? [] : explode(PATH_SEPARATOR, $scan) as $directory) {
        if ($directory === "") { $directory = $defaultScan; }
        if (!is_dir($directory)) { continue; }
        $entries = @scandir($directory);
        if ($entries === false) { throw new RuntimeException("A PHP scan directory could not be read."); }
        foreach ($entries as $entry) {
            $path = $directory . DIRECTORY_SEPARATOR . $entry;
            if (substr($entry, -4) === ".ini" && is_file($path) && @parse_ini_file($path, true) === false) {
                throw new RuntimeException("A loaded PHP configuration file could not be parsed.");
            }
        }
    }
    $value = null;
    foreach ($paths as $path) {
        $config = @parse_ini_file($path, true);
        if ($config === false) { throw new RuntimeException("A loaded PHP configuration file could not be parsed."); }
        foreach ($config as $key => $entry) {
            if (is_array($entry)) {
                if (!preg_match('/^(HOST|PATH)\\s*=/i', $key) && array_key_exists($setting, $entry)) {
                    $value = $entry[$setting];
                }
            } elseif ($key === $setting) {
                $value = $entry;
            }
        }
    }
    return $value;
  }
PHP
}

# Validate proposed startup settings in the selected image before publication.
# This catches invalid INI expressions and unreadable configuration without
# interrupting a running service or changing stopped-site data.
# shellcheck disable=SC2016
function joomlaPHPValidateIni() {
  local image="$1" file="$2" target="$3"
  shift 3
  [[ "$file" != *,* && "$target" != *,* && "$file" != *$'\n'* ]] || return 2
  docker run --rm --network none --read-only --entrypoint php \
    --mount "type=bind,source=$file,target=$target,readonly" "$image" -r "$(joomlaPHPConfigurationReader)"'
      if (!is_file($argv[1]) || @parse_ini_file($argv[1]) === false || strpos((string)php_ini_scanned_files(), $argv[1]) === false) {
        fwrite(STDERR,"PHP could not load the proposed override file.\n"); exit(1);
      }
      for ($i=2; $i<count($argv); $i+=2) {
        $expected=parse_ini_string($argv[$i]."=".$argv[$i+1]);
        $actual=octojoomConfiguredPHPValue($argv[$i]);
        if ($expected===false || !isset($expected[$argv[$i]]) || strcasecmp((string)$actual,(string)$expected[$argv[$i]])!==0) {
          fwrite(STDERR,"PHP did not accept the proposed ".$argv[$i]." setting.\n"); exit(1);
        }
      }
    ' -- "$target" "$@"
}

# The application credentials stay inside its container. HTTP and effective PHP
# checks run only for a service which was already running before the change.
# PHP fragments below intentionally use literal PHP variable names.
# shellcheck disable=SC2016
function joomlaRuntimeValidatePublished() {
  local site="$1" actual setting value
  readJoomlaSiteFacts "$site" || return 1
  actual=$(joomlaSiteCompose "$site" exec -T "$VDM_SITE_SERVICE" php -r 'echo PHP_VERSION;') || return 1
  if [ -n "${OCTOJOOM_EXPECTED_PHP:-}" ] && [ "$actual" != "$OCTOJOOM_EXPECTED_PHP" ]; then
    printf 'The recreated service did not load the selected PHP runtime.\n' >&2; return 1
  fi
  for setting in ${OCTOJOOM_PHP_CHANGED_SETTINGS:-}; do
    value="VDM_$setting"
    # Parse expressions natively, never eval. CLI overrides both timeouts, so
    # their configured values come from the actual loaded startup files.
    joomlaSiteCompose "$site" exec -T "$VDM_SITE_SERVICE" php -r "$(joomlaPHPConfigurationReader)"'
      $expected = parse_ini_string($argv[1] . "=" . $argv[2]);
      $actual = octojoomConfiguredPHPValue($argv[1]);
      exit($expected !== false && isset($expected[$argv[1]]) && strcasecmp((string)$actual, (string)$expected[$argv[1]]) === 0 ? 0 : 1);
    ' -- "$setting" "${!value}" || {
      printf 'PHP did not load the requested %s value.\n' "$setting" >&2; return 1;
    }
  done
  joomlaDatabaseVerifyConnection "$site" || return 1
  [[ "$VDM_SITE_URL" == http://* || "$VDM_SITE_URL" == https://* ]] || { printf 'No HTTP route was identified for application verification.\n' >&2; return 1; }
  curl --fail --silent --show-error --location --max-redirs 5 --connect-timeout 5 --max-time 30 --output /dev/null "$VDM_SITE_URL"
}

# shellcheck disable=SC2016
function joomlaPHPSettingsAction() {
  local site="$1" stage="$2" model mounts source='' old_target='' ini_target setting variable saved default answer has_values=false
  local -a changes=()
  model=$(joomlaSiteCompose "$site" config --format json) || return 1
  mounts=$(jq -c --arg service "$VDM_SITE_SERVICE" '[.services[$service].volumes[]? | select(.type == "bind" and ((.target | endswith("/php.ini")) or (.target | endswith("/zz-octojoom.ini"))))]' <<< "$model") || return 1
  [ "$(jq 'length' <<< "$mounts")" -le 1 ] || { printf 'Several PHP override mounts exist; select the intended file in the Compose editor.\n' >&2; return 1; }
  if [ "$(jq 'length' <<< "$mounts")" -eq 1 ]; then
    source=$(jq -r '.[0].source' <<< "$mounts")
    old_target=$(jq -r '.[0].target' <<< "$mounts")
    [[ -f "$source" && -r "$source" ]] || { printf 'The existing PHP overrides are not readable.\n' >&2; return 1; }
  fi
  ini_target=$(joomlaRuntimeIniTarget "$VDM_SITE_IMAGE") || return 1
  OCTOJOOM_PHP_CHANGED_SETTINGS=''
  for setting in max_execution_time max_input_time max_input_vars error_reporting upload_max_filesize post_max_size memory_limit; do
    variable="VDM_$setting"
    if cliHasValue "$variable"; then
      answer="${!variable}"
      has_values=true
    elif [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ]; then
      continue
    else
      case "$setting" in
        max_execution_time) default=124;; max_input_time) default=1500;; max_input_vars) default=3000;;
        error_reporting) default='E_ALL & ~E_DEPRECATED & ~E_STRICT';; *) default=256M;;
      esac
      saved=''
      [ -z "$source" ] || saved=$(awk -v key="$setting" '/^[[:space:]]*\[/ { scoped=($0 ~ /^[[:space:]]*\[(HOST|PATH)[[:space:]]*=/) } !scoped && $0 ~ ("^[[:space:]]*" key "[[:space:]]*=") { sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]*;.*$/, ""); value=$0 } END { print value }' "$source")
      if [ -z "$saved" ] && [ "$VDM_SITE_RUNNING" = running ]; then
        saved=$(joomlaSiteCompose "$site" exec -T "$VDM_SITE_SERVICE" php -r 'echo ini_get($argv[1]);' -- "$setting") || return 1
      fi
      answer=$(joomlaPHPQuestion "$setting" "${saved:-$default}") || return $?
      has_values=true
    fi
    joomlaPHPValidateValue "$setting" "$answer" || { printf 'Invalid PHP value for %s.\n' "$setting" >&2; return 2; }
    printf -v "$variable" '%s' "$answer"
    changes+=("$setting" "$answer")
    OCTOJOOM_PHP_CHANGED_SETTINGS+="$setting "
    writeEnvVariable "$stage/.env" "VDM_${VDM_SITE_ENV_KEY}_PHP_${setting^^}=$answer" true || return 1
  done
  "$has_values" || { printf 'Supply at least one PHP setting.\n' >&2; return 2; }
  joomlaPHPPatchIni "$source" "$stage/php.ini" "${changes[@]}" || return 1
  joomlaPHPValidateIni "$VDM_SITE_IMAGE" "$stage/php.ini" "$ini_target" "${changes[@]}" || return 1
  joomlaPHPReplaceMount "$VDM_SITE_COMPOSE" "$stage/docker-compose.yml" "$VDM_SITE_SERVICE" "$old_target" "$VDM_SITE_DIR/php.ini" "$ini_target" || return 1
  OCTOJOOM_SITE_FILE_TARGETS=("$VDM_SITE_DIR/php.ini")
  OCTOJOOM_SITE_FILE_SOURCES=("$stage/php.ini")
}

# A PHP image switch retains existing overrides and relocates their mount to
# the measured scan directory. Copy shared bulk files before changing one site.
function joomlaPHPStageExistingOverrides() {
  local site="$1" stage="$2" candidate="$3" model mounts source old_target target
  model=$(joomlaSiteCompose "$site" config --format json) || return 1
  mounts=$(jq -c --arg service "$VDM_SITE_SERVICE" '[.services[$service].volumes[]? | select(.type == "bind" and ((.target | endswith("/php.ini")) or (.target | endswith("/zz-octojoom.ini"))))]' <<< "$model") || return 1
  case "$(jq 'length' <<< "$mounts")" in
    0) return 0;;
    1) ;;
    *) printf 'Several PHP override mounts exist; choose the intended file in the Compose editor.\n' >&2; return 1;;
  esac
  source=$(jq -r '.[0].source' <<< "$mounts")
  old_target=$(jq -r '.[0].target' <<< "$mounts")
  [[ -f "$source" && -r "$source" ]] || { printf 'Existing PHP overrides are not readable.\n' >&2; return 1; }
  target=$(joomlaRuntimeIniTarget "$candidate") || return 1
  if ! cp "$source" "$stage/php.ini" || ! chmod 644 "$stage/php.ini"; then return 1; fi
  joomlaPHPValidateIni "$candidate" "$stage/php.ini" "$target" || return 1
  joomlaPHPReplaceMount "$stage/docker-compose.yml" "$stage/compose.next" "$VDM_SITE_SERVICE" "$old_target" "$VDM_SITE_DIR/php.ini" "$target" || return 1
  mv "$stage/compose.next" "$stage/docker-compose.yml" || return 1
  OCTOJOOM_SITE_FILE_TARGETS=("$VDM_SITE_DIR/php.ini")
  OCTOJOOM_SITE_FILE_SOURCES=("$stage/php.ini")
}

# Callback and companion arrays are consumed by sitePublishConfiguration.
# shellcheck disable=SC2034
function joomla__TRuST__php() {
  (
    local site="${VDM_CONTAINER:-}" action="${VDM_ACTION:-list}" repository version flavor tags tag stage candidate probe result=0
    local OCTOJOOM_SITE_VALIDATE_FUNCTION=joomlaRuntimeValidatePublished OCTOJOOM_EXPECTED_PHP='' OCTOJOOM_PHP_CHANGED_SETTINGS=''
    local -a OCTOJOOM_SITE_FILE_TARGETS=() OCTOJOOM_SITE_FILE_SOURCES=()
    [ -n "$site" ] || { printf 'Select a website with --container.\n' >&2; exit 2; }
    joomlaRuntimeRequireTools || exit 1
    readJoomlaSiteFacts "$site" || exit 1
    [[ -n "$VDM_SITE_SERVICE" && -n "$VDM_SITE_IMAGE" ]] || { printf 'The website PHP service could not be identified.\n' >&2; exit 1; }
    case "$action" in
      list)
        repository=$(joomlaRuntimeRepository "$VDM_SITE_IMAGE") || exit 1
        version=$(joomlaRuntimeInstalledVersion "$site") || exit 1
        probe=$(joomlaRuntimeProbeImage "$VDM_SITE_IMAGE") || exit 1
        flavor=$(jq -r '.flavor' <<< "$probe")
        tags=$(joomlaRuntimeTags "$repository") || exit 1
        candidate=''
        while IFS= read -r tag; do
          [[ "$tag" != "$version"-* || "$tag" != *"$flavor"* ]] || candidate+="$repository:$tag"$'\n'
        done <<< "$tags"
        if [ "${OCTOJOOM_OUTPUT:-text}" = json ]; then
          jq -n --arg image "$VDM_SITE_IMAGE" --arg version "$version" --argjson runtime "$probe" --arg candidates "$candidate" \
            '{image:$image,installed_joomla:$version,runtime:$runtime,candidates:($candidates|split("\n")|map(select(length>0))),candidates_verified:false}'
        else
          printf 'Current image: %s\nInstalled Joomla: %s\nPHP: %s (%s)\nPublished candidates (verified on selection):\n%s' "$VDM_SITE_IMAGE" "$version" "$(jq -r '.php' <<< "$probe")" "$flavor" "$candidate"
        fi
        exit 0;;
      switch|settings) ;;
      *) printf 'Unknown PHP action: %s\n' "$action" >&2; exit 2;;
    esac
    [[ "$VDM_SITE_ENV_KEY" =~ ^[A-Za-z][A-Za-z0-9_]*$ ]] || { printf 'This site has no unambiguous scoped environment key.\n' >&2; exit 1; }
    if [ "$action" = switch ]; then
      tag=''
      if cliHasValue VDM_PHP_IMAGE; then tag="$VDM_PHP_IMAGE"; elif cliHasValue VDM_JV; then tag="$VDM_JV"; fi
      candidate=$(joomlaRuntimeSelectImage "$site" '' "$tag") || { result=$?; [ "$result" -eq 3 ] && exit 0; exit "$result"; }
      probe=$(joomlaRuntimeProbeImage "$candidate") || exit 1
      OCTOJOOM_EXPECTED_PHP=$(jq -r '.php' <<< "$probe")
      printf 'PHP image: %s -> %s\n' "$VDM_SITE_IMAGE" "$candidate" >&2
    fi
    stage=$(mktemp -d "$VDM_SITE_DIR/.php-stage.XXXXXX") || exit 1
    trap 'rm -rf "$stage"' EXIT
    siteWriteScopedEnv "$VDM_SITE_COMPOSE" "$VDM_SITE_ENV" "$VDM_SITE_ENV_KEY" "$stage/.env" || exit 1
    if [ "$action" = switch ]; then
      siteReplaceServiceScalar "$VDM_SITE_COMPOSE" "$stage/docker-compose.yml" "$VDM_SITE_SERVICE" image "$candidate" || exit 1
      writeEnvVariable "$stage/.env" "VDM_${VDM_SITE_ENV_KEY}_IMAGE=$candidate" true || exit 1
      joomlaPHPStageExistingOverrides "$site" "$stage" "$candidate" || exit 1
    else
      joomlaPHPSettingsAction "$site" "$stage" || exit $?
    fi
    sitePublishConfiguration "$site" "$stage/docker-compose.yml" "$stage/.env" "$VDM_SITE_SERVICE" || exit $?
    printf 'PHP %s saved for %s.\n' "$action" "$site"
  )
}

# check version
function isVersionAbove() {
  local tag="$1" target_version="$2" tag_major tag_minor target_major target_minor
  local numeric_version='^([0-9]{1,9})(\.([0-9]{1,9}))?(\.[0-9]{1,9})?$'
  local image_version='^([0-9]{1,9})(\.([0-9]{1,9}))?(\.[0-9]{1,9})?(-[a-zA-Z0-9_.-]+)?$'
  # Validate digits and their size before arithmetic: Bash otherwise evaluates
  # variable names and array subscripts supplied inside a malicious image tag.
  [[ "$target_version" =~ $numeric_version ]] || return 1
  target_major=$((10#${BASH_REMATCH[1]}))
  target_minor=$((10#${BASH_REMATCH[3]:-0}))
  [[ "$tag" =~ ^latest(-[a-zA-Z0-9_.-]+)?$ ]] && return 0
  [[ "$tag" =~ $image_version ]] || return 1
  tag_major=$((10#${BASH_REMATCH[1]}))
  tag_minor=$((10#${BASH_REMATCH[3]:-0}))
  (( tag_major > target_major || (tag_major == target_major && tag_minor >= target_minor) ))
}

# Alias tags (for example php8.3-apache) do not identify the Joomla release.
# Inspect their published contents only when installation might be requested;
# manual setup remains usable without requiring an extra Docker inspection.
function joomlaImageSupportsAutoInstall() {
  local image="${VDM_J_REPO}:${VDM_JV}" probe version
  isVersionAbove "$VDM_JV" 4.3 && return 0
  [[ "$VDM_JV" =~ ^[0-9]+(\.[0-9]+)*(\-[a-zA-Z0-9_.-]+)?$ ]] && return 1
  [ "${VDM_AUTO_INSTALL:-}" != false ] || return 1
  if [ "${VDM_SETUP_JOOMLA_IMAGE:-}" != "$image" ]; then
    joomlaRuntimeRequireTools || return 1
    probe=$(joomlaRuntimeProbeImage "$image") || return 1
    version=$(printf '%s' "$probe" | jq -er '.joomla | select(type == "string")') || return 1
    VDM_SETUP_JOOMLA_IMAGE="$image"
    VDM_SETUP_JOOMLA_VERSION="$version"
  fi
  isVersionAbove "$VDM_SETUP_JOOMLA_VERSION" 4.3
}

