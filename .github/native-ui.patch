@@ -3550,33 +3550,125 @@ function saveContainerCompose() {
 
 # Run Compose exactly once with the selected environment. A failed operation must
 # never be retried without its credentials or hidden by later filesystem changes.
+# Keep Docker status text inside native whiptail controls. Never interpret its
+# escape sequences or allow resource output to inject gauge protocol frames.
+function actionProgressText() {
+  LC_ALL=C sed -E $'s/\033\\[[0-?]*[ -/]*[@-~]//g' |
+    LC_ALL=C tr -d '\000-\010\013-\037\177' | tr '\t' ' '
+}
+
+function actionProgressLogSummary() {
+  [ -f "${OCTOJOOM_PROGRESS_DIR:-}/compose-output" ] || return 0
+  tail -n 60 "$OCTOJOOM_PROGRESS_DIR/compose-output" 2>/dev/null | actionProgressText | awk '
+    NF {
+      sub(/^[[:space:]]+/, "")
+      key = ($1 ~ /^(Container|Network|Volume)$/ ? $1 " " $2 : $0)
+      latest[key] = substr($0, 1, 160)
+      order[key] = NR
+    }
+    END {
+      for (i = 0; i < 3; i++) {
+        best = ""; n = -1
+        for (key in order) if (order[key] > n) { best = key; n = order[key] }
+        if (n < 0) break
+        result[i] = latest[best]
+        delete order[best]
+      }
+      for (j = i - 1; j >= 0; j--) print "  " result[j]
+    }'
+}
+
+# Configuration accounts for the first completed stage. Container milestones
+# account for the next stage; only successful command completion reaches 100.
+# This measures service work, not elapsed time or HTTP/browser readiness.
+function actionProgressComposePercent() {
+  local total=0 completed=0 operation="${OCTOJOOM_COMPOSE_OPERATION:-}"
+  [ -f "$OCTOJOOM_PROGRESS_DIR/compose-count" ] || { printf '0\n'; return; }
+  IFS= read -r total 2>/dev/null < "$OCTOJOOM_PROGRESS_DIR/compose-count" || total=0
+  [[ "$total" =~ ^[1-9][0-9]*$ ]] || { printf '10\n'; return; }
+  if [ -f "$OCTOJOOM_PROGRESS_DIR/compose-output" ]; then
+    completed=$(awk -v operation="$operation" '
+      $1 == "Container" {
+        if ((operation ~ /^(up|start|restart)$/ && $3 ~ /^(Started|Running|Healthy)$/) ||
+            (operation == "stop" && $3 == "Stopped") ||
+            (operation == "down" && $3 == "Removed")) done[$2] = 1
+      }
+      END { for (name in done) count++; print count + 0 }
+    ' "$OCTOJOOM_PROGRESS_DIR/compose-output" 2>/dev/null) || completed=0
+  fi
+  [ "$completed" -le "$total" ] || completed=$total
+  printf '%s\n' "$((10 + 80 * completed / total))"
+}
+
+function composeProgressCanCapture() {
+  actionProgressActive || { [ -t 1 ] && [ -t 2 ]; }
+}
+
+# Only interactive lifecycle output is captured. Docker runs the requested
+# operation exactly once. The preliminary config query is read-only and does
+# not render credentials. A failed query never substitutes for command status.
+function runComposeActivity() {
+  if ! actionProgressActive || [ "${OCTOJOOM_COMPOSE_CAPTURE:-false}" != true ]; then
+    docker "$@"
+    return $?
+  fi
+  local result=0 log="$OCTOJOOM_PROGRESS_DIR/compose-output" total=0
+  : > "$log" || return 1
+  rm -f "$OCTOJOOM_PROGRESS_DIR/compose-count"
+  if COMPOSE_ANSI=never docker "${OCTOJOOM_COMPOSE_PREFIX[@]}" config --services \
+      > "$OCTOJOOM_PROGRESS_DIR/compose-services" 2> "$OCTOJOOM_PROGRESS_DIR/compose-config-errors"; then
+    total=$(awk 'NF {count++} END {print count + 0}' "$OCTOJOOM_PROGRESS_DIR/compose-services")
+    printf '%s\n' "$total" > "$OCTOJOOM_PROGRESS_DIR/compose-count.next"
+    mv -f "$OCTOJOOM_PROGRESS_DIR/compose-count.next" "$OCTOJOOM_PROGRESS_DIR/compose-count"
+  fi
+  COMPOSE_ANSI=never COMPOSE_PROGRESS=plain docker "$@" > "$log" 2>&1 || result=$?
+  if [ "$result" -ne 0 ]; then
+    cat "$log" >&2
+  else
+    # Keep warnings, but do not replay routine Creating/Waiting/Started chatter.
+    LC_ALL=C grep -E '(^|[[:space:]])(WARN(ING)?([[:space:]:\[]|$)|level=warning)' "$log" | awk '!seen[$0]++' >&2 || true
+  fi
+  rm -f "$log" "$OCTOJOOM_PROGRESS_DIR/compose-count" \
+    "$OCTOJOOM_PROGRESS_DIR/compose-services" "$OCTOJOOM_PROGRESS_DIR/compose-config-errors"
+  return "$result"
+}
+
