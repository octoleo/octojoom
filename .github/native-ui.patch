+  local OCTOJOOM_PROGRESS_MODE=compose OCTOJOOM_COMPOSE_CAPTURE=false
+  local OCTOJOOM_COMPOSE_OPERATION="$operation"
+  if composeProgressCanCapture; then OCTOJOOM_COMPOSE_CAPTURE=true; fi
   runActionProgress 'Docker Compose' "$message
-Configuration: $compose_file" docker "$@"
+Configuration: $compose_file" runComposeActivity "$@"
 }
 
