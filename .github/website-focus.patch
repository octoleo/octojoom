+# Supply one focus traversal only after newt has initialized its terminal.
+# stdin remains the real keyboard; script owns the private pseudo-terminal.
+function joomlaWebsiteMenuInput() {
+  local work="$1" terminal_fd="$2" dialog_pid="$3" child_tty='' deadline=$((SECONDS + 10))
+  while kill -0 "$dialog_pid" 2>/dev/null && [ ! -f "$work/status" ]; do
+    if [ -s "$work/tty" ]; then
+      IFS= read -r child_tty < "$work/tty" || return 1
+      if LC_ALL=C stty -a < "$child_tty" 2>/dev/null | grep -q -- '-icanon'; then
+        printf '\t'
+        # Do not interpret, translate or buffer any subsequent key sequences.
+        exec cat <&"$terminal_fd"
+      fi
+    fi
+    if [ "$SECONDS" -ge "$deadline" ]; then
+      kill -TERM "$dialog_pid" 2>/dev/null || true
+      return 1
+    fi
+    sleep 0.01
+  done
+}
+
+# Forward terminal-size changes; whiptail still owns its normal resize behavior.
+function joomlaWebsiteMenuResize() {
+  local work="$1" terminal_fd="$2" child_tty rows columns
+  [ -s "$work/tty" ] || return 0
+  IFS= read -r child_tty < "$work/tty" || return 0
+  read -r rows columns < <(stty size <&"$terminal_fd") || return 0
+  [[ "$rows" =~ ^[1-9][0-9]*$ && "$columns" =~ ^[1-9][0-9]*$ ]] || return 0
+  stty rows "$rows" cols "$columns" < "$child_tty" 2>/dev/null || true
+}
+
+# Keep the native dialog, theme, dimensions, button order and default item.
+# Stock whiptail offers no initial-focus option for --scrolltext. A private PTY
+# lets us supply its initial Tab without TIOCSTI, sleeps guessing startup time,
+# replacing widgets, or changing input for any other OctoJoom screen.
+function joomlaWebsiteMenuFocused() {
+  local variant
+  case "${OSTYPE:-}" in
+    linux*|cygwin*|msys*) variant=util-linux ;;
+    darwin*|freebsd*) variant=bsd ;;
+    *) variant='' ;;
+  esac
+  if [ -z "$variant" ] || [ ! -t 0 ] || [ "${OCTOJOOM_NON_INTERACTIVE:-false}" = true ] ||
+    ! command -v script >/dev/null 2>&1 || ! ( : </dev/tty >/dev/tty ) 2>/dev/null; then
+    whiptail "$@" 3>&2 2>&1 1>&3
+    return $?
+  fi
+  (
+    umask 077
+    local work terminal_fd input_fd saved rows columns command_line invocation
+    local dialog_pid='' input_pid='' result=1
+    exec {terminal_fd}<>/dev/tty || exit 1
+    saved=$(stty -g <&"$terminal_fd") || exit 1
+    work=$(mktemp -d "${TMPDIR:-/tmp}/octojoom-menu.XXXXXX") || exit 1
+    trap '
+      [ -z "$input_pid" ] || { kill "$input_pid" 2>/dev/null || true; wait "$input_pid" 2>/dev/null || true; }
+      if [ -n "$dialog_pid" ]; then
+        kill -TERM "$dialog_pid" 2>/dev/null || true
+        wait "$dialog_pid" 2>/dev/null || true
+        tput sgr0 >&"$terminal_fd" 2>/dev/null || true
+        tput cnorm >&"$terminal_fd" 2>/dev/null || true
+        tput rmcup >&"$terminal_fd" 2>/dev/null || true
+      fi
+      stty "$saved" <&"$terminal_fd" 2>/dev/null || true
+      rm -rf "$work"
+    ' EXIT
+    trap 'exit 130' INT
+    trap 'exit 143' HUP TERM
+    read -r rows columns < <(stty size <&"$terminal_fd") || exit 1
+    [[ "$rows" =~ ^[1-9][0-9]*$ && "$columns" =~ ^[1-9][0-9]*$ ]] || exit 1
+    mkfifo "$work/input" || exit 1
+    exec {input_fd}<>"$work/input" || exit 1
+    # Preserve CR, escape sequences and typeahead exactly for whiptail.
+    stty raw -echo <&"$terminal_fd" || exit 1
+    printf -v command_line '%q ' whiptail "$@" --output-fd 3
+    # The canonical marker makes initialization observable, not time-dependent.
+    # Every substituted shell argument is quoted, including the complete report.
+    printf -v invocation 'stty rows %q cols %q icanon -echo; tty >%q; %s 3>%q; printf "%%s\\n" "$?" >%q' \
+      "$rows" "$columns" "$work/tty" "$command_line" "$work/result" "$work/status"
+    if [ "$variant" = bsd ]; then
+      SHELL="$BASH" script -q /dev/null "$BASH" -c "$invocation" <&"$input_fd" >&"$terminal_fd" 2>&"$terminal_fd" &
+    else
+      SHELL="$BASH" script -q -c "$invocation" /dev/null <&"$input_fd" >&"$terminal_fd" 2>&"$terminal_fd" &
+    fi
+    dialog_pid=$!
+    joomlaWebsiteMenuInput "$work" "$terminal_fd" "$dialog_pid" >&"$input_fd" &
+    input_pid=$!
+    trap 'joomlaWebsiteMenuResize "$work" "$terminal_fd"' WINCH
+    # A resize can interrupt wait before the dialog has actually finished.
+    while kill -0 "$dialog_pid" 2>/dev/null; do wait "$dialog_pid" || true; done
+    trap - WINCH
+    dialog_pid=''
+    # Native status, not script's platform-dependent exit code, is authoritative.
+    if [ -f "$work/status" ]; then IFS= read -r result < "$work/status" || result=1; fi
+    [[ "$result" =~ ^[0-9]+$ && "$result" -le 255 ]] || result=1
+    [ ! -f "$work/result" ] || cat "$work/result"
+    exit "$result"
+  )
+}
+
