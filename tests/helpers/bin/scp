#!/usr/bin/env bash
#
# Test stand-in for scp: logs the call and returns the status in
# ${STUB_DIR}/fail/scp (default 0). Write a hook to ${STUB_DIR}/hooks/scp
# to simulate a remote system.

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "scp $*"
stub_hook scp "$@"
exit "$(stub_status scp)"
