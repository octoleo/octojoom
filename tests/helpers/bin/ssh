#!/usr/bin/env bash
#
# Test stand-in for ssh: logs the call and returns the status in
# ${STUB_DIR}/fail/ssh (default 0). Write a hook to ${STUB_DIR}/hooks/ssh
# to simulate a remote system.

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "ssh $*"
stub_hook ssh "$@"
exit "$(stub_status ssh)"
