#!/usr/bin/env bash
#
# Test stand-in for launchctl: logs the call, changes nothing, and returns the
# status in ${STUB_DIR}/fail/launchctl (default 0).

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "launchctl $*"
stub_hook launchctl "$@"
exit "$(stub_status launchctl)"
