#!/usr/bin/env bash
#
# Test stand-in for usermod: logs the call, changes nothing, and returns the
# status in ${STUB_DIR}/fail/usermod (default 0).

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "usermod $*"
stub_hook usermod "$@"
exit "$(stub_status usermod)"
