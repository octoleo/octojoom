#!/usr/bin/env bash
#
# Test stand-in for gpg: logs the call, changes nothing, and returns the
# status in ${STUB_DIR}/fail/gpg (default 0).

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "gpg $*"
stub_hook gpg "$@"
exit "$(stub_status gpg)"
