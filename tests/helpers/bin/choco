#!/usr/bin/env bash
#
# Test stand-in for choco: logs the call, changes nothing, and returns the
# status in ${STUB_DIR}/fail/choco (default 0).

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "choco $*"
stub_hook choco "$@"
exit "$(stub_status choco)"
