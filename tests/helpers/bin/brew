#!/usr/bin/env bash
#
# Test stand-in for brew: logs the call, changes nothing, and returns the
# status in ${STUB_DIR}/fail/brew (default 0).

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "brew $*"
stub_hook brew "$@"
exit "$(stub_status brew)"
