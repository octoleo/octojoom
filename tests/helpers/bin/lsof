#!/usr/bin/env bash
#
# Test stand-in for lsof: logs the call, changes nothing, and returns the
# status in ${STUB_DIR}/fail/lsof (default 0).

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "lsof $*"
stub_hook lsof "$@"
exit "$(stub_status lsof)"
