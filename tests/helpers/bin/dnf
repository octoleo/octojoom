#!/usr/bin/env bash
#
# Test stand-in for dnf: logs the call, changes nothing, and returns the
# status in ${STUB_DIR}/fail/dnf (default 0).

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "dnf $*"
stub_hook dnf "$@"
exit "$(stub_status dnf)"
