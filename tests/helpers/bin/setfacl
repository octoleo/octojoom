#!/usr/bin/env bash
#
# Test stand-in for setfacl: logs the call, changes nothing, and returns the
# status in ${STUB_DIR}/fail/setfacl (default 0).

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "setfacl $*"
stub_hook setfacl "$@"
exit "$(stub_status setfacl)"
