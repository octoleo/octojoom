#!/usr/bin/env bash
#
# Test stand-in for zypper: logs the call, changes nothing, and returns the
# status in ${STUB_DIR}/fail/zypper (default 0).

# shellcheck source=tests/helpers/stub-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/../stub-lib.bash"
stub_log "zypper $*"
stub_hook zypper "$@"
exit "$(stub_status zypper)"
